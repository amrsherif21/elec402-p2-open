digraph dp800 {
  rankdir=TB; newrank=true; bgcolor=white; nodesep=0.2; ranksep=0.22;
  node [fontname="Helvetica", fontsize=9];
  in [shape=plaintext, label="a, b, EN_mult & RDY_mult"];
  enc [shape=box, style=rounded, label="Booth recode b\n+ isolation"];
  r1 [shape=box, style=filled, fillcolor="#dde8f5", label="R1 (40)\na + digits"];
  pp [shape=box, style=rounded, label="select\n8 PP rows"];
  r2 [shape=box, style=filled, fillcolor="#dde8f5", label="R2 (144)\n8x17b PP + 8 '+1'"];
  c12 [shape=box, style=rounded, label="3:2 levels 1-2\n9->6->4 rows\n(late input last)"];
  r3 [shape=box, style=filled, fillcolor="#dde8f5", label="R3 (92)\n4 rows"];
  c34 [shape=box, style=rounded, label="3:2 levels 3-4\n4->3->2 rows"];
  r4 [shape=box, style=filled, fillcolor="#dde8f5", label="R4 (60)\n2 rows"];
  ca [shape=box, style=rounded, label="4-bit block sums\n(carry-in 0),\nblock carry-outs\n(carry-in 0 and 1)"];
  r5 [shape=box, style=filled, fillcolor="#dde8f5", label="R5 (43)"];
  cb [shape=box, style=rounded, label="block-carry prefix\n+ increment select"];
  r6 [shape=box, style=filled, fillcolor="#dde8f5", label="R6 (32)\nproduct"];
  out [shape=plaintext, label="writeMem_val\nEN_writeMem = v[5]"];
  in -> enc -> r1 -> pp -> r2 -> c12 -> r3 -> c34 -> r4 -> ca -> r5 -> cb -> r6 -> out;
  {rank=same; enc; r1;} {rank=same; pp; r2;} {rank=same; c12; r3;} {rank=same; c34; r4;} {rank=same; ca; r5;} {rank=same; cb; r6;}
}
