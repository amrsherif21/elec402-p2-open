digraph dp400 {
  rankdir=TB; newrank=true; bgcolor=white; nodesep=0.25; ranksep=0.3;
  node [fontname="Helvetica", fontsize=10];
  in [shape=plaintext, label="mult_input0 (a), mult_input1 (b)\nEN_mult & RDY_mult"];
  enc [shape=box, style=rounded, label="Booth radix-4\nrecode b\n+ operand isolation"];
  r1 [shape=box, style=filled, fillcolor="#dde8f5", label="Rank 1 (40)\na 16b + digits 24b"];
  tree [shape=box, style=rounded, label="select 8 PP rows,\nWallace bit-level\ncompression, 4 levels\n(low 8 columns resolved)"];
  r2 [shape=box, style=filled, fillcolor="#dde8f5", label="Rank 2 (51)\ntwo rows +\nresolved low bits"];
  cpa [shape=box, style=rounded, label="carry-propagate\nadder"];
  r3 [shape=box, style=filled, fillcolor="#dde8f5", label="Rank 3 (32)\nproduct"];
  out [shape=plaintext, label="writeMem_val, EN_writeMem = v[2]"];
  in -> enc -> r1 -> tree -> r2 -> cpa -> r3 -> out;
  {rank=same; enc; r1;} {rank=same; tree; r2;} {rank=same; cpa; r3;}
}
