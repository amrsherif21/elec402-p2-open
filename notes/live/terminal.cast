[2356.08, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nt=open('build/exp/top.sv').read()\r\nt=t.replace(\"    logic       rdy_mult_q, rdy_rd_q, vld_q;\\n\",\"\"\"    logic       rdy_mult_q, rdy_rd_q, vld_q;\r\n    // copies of the two ready flags that drive only the output ports, so the\r\n    // port load does not slow the internal handshake logic (kept: not merged)\r\n    (* keep *) logic rdy_mult_o, rdy_rd_o;\r\n\"\"\")\r\nt=t.replace(\"rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0;\",\"rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0;\\n            rdy_mult_o <= 1'b1; rdy_rd_o <= 1'b0;\")\r\nt=t.replace(\"\"\"                if (acc_q == 6'd63) rdy_mult_q <= 1'b0;\"\"\",\"\"\"                if (acc_q == 6'd63) begin rdy_mult_q <= 1'b0; rdy_mult_o <= 1'b0; end\"\"\")\r\nt=t.replace(\"\"\"            if (wr && wp_q == 6'd63) rdy_rd_q <= 1'b1;\"\"\",\"\"\"            if (wr && wp_q == 6'd63) begin rdy_rd_q <= 1'b1; rdy_rd_o <= 1'b1; end\"\"\")\r\nt=t.replace(\"\"\"                rdy_rd_q <= 1'b0; rdy_mult_q <= 1'b1;\"\"\",\"\"\"                rdy_rd_q <= 1'b0; rdy_mult_q <= 1'b1;\r\n                rdy_rd_o <= 1'b0; rdy_mult_o <= 1'b1;\"\"\")\r\nt=t.replace(\"assign RDY_mult      = rdy_mult_q;\",\"assign RDY_mult      = rdy_mult_o;\").replace(\"assign RDY_blockRead = rdy_rd_q;\",\"assign RDY_blockRead = rdy_rd_o;\")\r\nopen('build/exp/top.sv','w').write(t)\r\nEOF\r\ngrep -n \"rdy_.*_o\" build/exp/top.sv | head; sed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/4/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head; echo \"$(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; (MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh o800b 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh o800c 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; for d in o800b o800c; do build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p'; grep -A2 \" $(build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p' | cut -d/ -f1) (\" build/exp/$d/rsz.v | grep \"\\.Q\"; done; grep -c \"rdy_rd_o\\|rdy_mult_o\" build/exp/o800b/syn.v\r\n33:    (* keep *) logic rdy_mult_o, rdy_rd_o;\r\n45:            rdy_mult_o <= 1'b1; rdy_rd_o <= 1'b0;\r\n51:                if (acc_q == 6'd63) begin rdy_mult_q <= 1'b0; rdy_mult_o <= 1'b0; end\r\n55:            if (wr && wp_q == 6'd63) begin rdy_rd_q <= 1'b1; rdy_rd_o <= 1'b1; end\r\n58:                rdy_rd_o <= 1'b0; rdy_mult_o <= 1'b1;\r\n67:    assign RDY_mult      = rdy_mult_o;\r\n68:    assign RDY_blockRead = rdy_rd_o;\r\nALL PASS\r\no800c P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5660.746000 rsz_area=5816 wns=-0.076 whs=0.024 pwr_est=3.1305e-03\r\no800b P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5670.588000 rsz_area=5826 wns=-0.076 whs=0.024 pwr_est=3.1306e-03\r\n_5322_/Q (DFF_X1) fo=4 d=0.575 t=0.575\r\n    .Q(readMem_addr[0]),\r\n_5292_/Q (DFF_X1) fo=4 d=0.575 t=0.575\r\n    .Q(readMem_addr[0]),\r\n4\r\n"]
[2360.218, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime/src && python3 - <<'EOF'\r\np='f14check.tcl'\r\nt=open(p).read()\r\nold=t[t.index('foreach n $nets {'):t.index('yosys log \"F14CHECK')]\r\nnew='''set tf $::env(DNETS).sat\r\nproc proved {w v} {\r\n    global tf\r\n    yosys tee -q -o $tf sat -set RST_N 0 -prove $w $v -ignore_unknown_cells\r\n    set fh [open $tf r]; set s [read $fh]; close $fh\r\n    return [string match \"*no model found: SUCCESS*\" $s]\r\n}\r\nset one 0\r\nforeach w $nets {\r\n    if {[proved $w 1'0]} { incr ok } elseif {[proved $w 1'1]} { incr ok; incr one } else { lappend bad $w }\r\n}\r\n'''\r\nt=t.replace(old,new)\r\nt=t.replace('reset-gated $ok,','reset-gated $ok (of which reset-to-1 $one),')\r\nt=t.replace('NOT reset-gated [llength $bad]\"','NOT reset-gated [llength $bad]: [lrange $bad 0 9]\"')\r\nopen(p,'w').write(t)\r\nEOF\r\ncd /home/user/elec402-p2-open && time build/cand_retime/src/f14.sh build/cand_retime/ref400.v\r\nF14CHECK: flops 166, reset-gated 166 (of which reset-to-1 1), NOT reset-gated 0: \r\n\r\nreal\t0m7.681s\r\nuser\t0m0.069s\r\nsys\t0m0.014s\r\n"]
[2364.023, "o", "\u001b[1;32m$\u001b[0m grep -E \"RSZ-|worst|Design area|^\\s+final\" build/exp/o800b/rsz.log | grep -v \"RSZ-0075\" | head -20; docker run --rm openroad/orfs:26Q4-365-g898576f04 bash -c 'echo \"help repair_timing\" > /tmp/h.tcl; /OpenROAD-flow-scripts/tools/install/OpenROAD/bin/openroad -no_init -exit /tmp/h.tcl' 2>&1 | head -12\r\n    final |     +0.0% |       0 |       0 |             0 |         0\r\n[INFO RSZ-0504] Runtime: 5.08s\r\n[INFO RSZ-0100] Repair move sequence: UnbufferMove SizeUpMove SwapPinsMove BufferMove CloneMove SplitLoadMove \r\n[INFO RSZ-0094] Found 143 endpoints with setup violations.\r\n[INFO RSZ-0099] Repairing 143 out of 143 (100.00%) violating endpoints...\r\n    final |       0 |     189 |        0 |      1 |    71 |    +2.7% |   -0.065 |       -0.4 |     44 | _5326_/D\r\n[INFO RSZ-0051] Resized 189 instances: 189 up, 0 up match, 0 down, 0 VT\r\n[INFO RSZ-0043] Swapped pins on 71 instances.\r\n[INFO RSZ-0049] Cloned 1 instances.\r\n[WARNING RSZ-0062] Unable to repair all setup violations.\r\n[INFO RSZ-0505] Runtime: 5.03s\r\n[INFO RSZ-0046] Found 1 endpoints with hold violations.\r\n    final |       0 |       1 |            0 |    +0.0% |   0.024 |   0.000 | _5069_/D\r\n[INFO RSZ-0032] Inserted 1 hold buffers.\r\n[INFO RSZ-0506] Runtime: 2.53s\r\nworst slack max -0.07\r\nworst slack min 0.02\r\nDesign area 5826 um^2 42% utilization.\r\nOpenROAD unknown \r\nFeatures included (+) or not (-): -GPU +GUI\r\nThis program is licensed under the BSD-3 license. See the LICENSE file for details.\r\nComponents of this program may be licensed under more restrictive licenses which must be honored.\r\nrepair_timing [-setup] [-hold] [-recover_power percent_of_paths_with_slack]\r\n   [-setup_margin setup_margin] [-hold_margin hold_margin]\r\n   [-slack_margin slack_margin] [-libraries libs] [-allow_setup_violations]\r\n   [-sequence move_list] [-phases phases] [-path_group path_group]\r\n   [-skip_pin_swap] [-skip_gate_cloning] [-skip_size_down] [-skip_buffering]\r\n   [-skip_buffer_removal] [-skip_buffer_to_inverters] [-skip_last_gasp]\r\n   [-skip_vt_swap] [-skip_crit_vt_swap] [-skip_crpr] [-effort low|medium|high]\r\n   [-profile_mode mode] [-profile_dir dir] [-repair_tns tns_end_percent]\r\n"]
[2385.412, "o", "\u001b[1;32m$\u001b[0m sed -i 's/^repair_timing -setup -repair_tns 100 -setup_margin $margin$/repair_timing -setup -repair_tns 100 -setup_margin $margin -effort high/' submission/scripts/resize.tcl && grep -n \"repair_timing -setup\" submission/scripts/resize.tcl && (MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh p800b 1.25 0 1111 0 1000 0 kogge-stone & PRE=1 build/exp/run.sh p400 2.5 0 0100 0 2000 0 kogge-stone & wait) 2>&1 | grep -v Warning\r\n30:repair_timing -setup -repair_tns 100 -setup_margin $margin -effort high\r\np400 P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2519.286000 rsz_area=2548 wns=-0.432 whs=0.053 pwr_est=6.7171e-04\r\np800b P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5670.588000 rsz_area=5826 wns=-0.076 whs=0.024 pwr_est=3.1306e-03\r\n"]
[2386.641, "o", "\u001b[1;32m$\u001b[0m mkdir -p /home/user/elec402-p2-open/build/cand_dadda && cat > /home/user/elec402-p2-open/build/cand_dadda/top2.sv.in <<'EOF'\r\n// mkMultBuff.sv -- 800 MHz candidate (1.25 ns clock), Nangate45 slow corner.\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_tree (Baugh-Wooley partial products, timing-driven carry-save\r\n// reduction with hand-placed pipeline registers, pipelined carry-select adder).\r\n// Latency (accept -> EN_writeMem) = LAT cycles; a LAT-bit valid shift register\r\n// runs alongside the datapath and drives EN_writeMem (F4).\r\n//\r\n// Control: same state machine as the 400 MHz implementation (registered ready\r\n// flags RDY_mult / RDY_blockRead: FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1};\r\n// acc_q counts accepted pairs (F5); ptr_q is the shared write / read address,\r\n// F13). For 800 MHz, every flag or counter that drives an output port has an\r\n// internal copy, stored inverted, that feeds the next-state logic, so that the\r\n// output load (4 x NAND2_X4) is not on the internal paths. Each copy always\r\n// holds the complement of its output twin (same next-state value, same reset).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\nmodule mkMultBuff #(parameter N = 32) (\r\n    input  logic         clk,\r\n    input  logic         RST_N,\r\n    input  logic         EN_mult,\r\n    input  logic [15:0]  mult_input0,\r\n    input  logic [15:0]  mult_input1,\r\n    output logic         RDY_mult,\r\n    input  logic         EN_blockRead,\r\n    output logic         RDY_blockRead,\r\n    output logic         VALID_memVal,\r\n    output logic [N-1:0] memVal_data,\r\n    output logic         EN_writeMem,\r\n    output logic [5:0]   writeMem_addr,\r\n    output logic [N-1:0] writeMem_val,\r\n    output logic         EN_readMem,\r\n    output logic [5:0]   readMem_addr,\r\n    input  logic [N-1:0] readMem_val\r\n);\r\n    localparam int LAT = @LAT@;          // multiplier latency (register ranks)\r\n\r\n    // output-port registers\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q, wr_q;\r\n    logic [5:0] ptr_q;\r\n    // internal copies (complemented): n*_q == ~(output twin) at all times\r\n    logic       nrdy_mult_q, nrdy_rd_q, nwr_q;\r\n    logic [5:0] nptr_q;\r\n    logic [5:0] acc_q;\r\n    logic [LAT-2:0] v_q;                 // valid bit of pipeline ranks 1..LAT-1\r\n\r\n    wire       acc = EN_mult & ~nrdy_mult_q;\r\n    wire       rd  = EN_blockRead & ~nrdy_rd_q;\r\n    wire       wr  = ~nwr_q;\r\n    wire [5:0] ptr = ~nptr_q;\r\n\r\n    // next state (computed once, loaded into both twins)\r\n    logic       rdy_mult_d, rdy_rd_d;\r\n    logic [5:0] ptr_d;\r\n    always_comb begin\r\n        rdy_mult_d = ~nrdy_mult_q;\r\n        rdy_rd_d   = ~nrdy_rd_q;\r\n        ptr_d      = ptr;\r\n        if (acc && acc_q == 6'd63) rdy_mult_d = 1'b0;\r\n        if (wr | rd) ptr_d = ptr + 6'd1;\r\n        if (wr && ptr == 6'd63) rdy_rd_d = 1'b1;\r\n        if (rd && ptr == 6'd63) begin\r\n            rdy_rd_d = 1'b0; rdy_mult_d = 1'b1;\r\n        end\r\n    end\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0; wr_q <= 1'b0; ptr_q <= '0;\r\n            nrdy_mult_q <= 1'b0; nrdy_rd_q <= 1'b1; nwr_q <= 1'b1; nptr_q <= '1;\r\n            acc_q <= '0; v_q <= '0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-3:0], acc};\r\n            wr_q <= v_q[LAT-2];   nwr_q <= ~v_q[LAT-2];\r\n            if (acc) acc_q <= acc_q + 6'd1;\r\n            rdy_mult_q <= rdy_mult_d; nrdy_mult_q <= ~rdy_mult_d;\r\n            rdy_rd_q   <= rdy_rd_d;   nrdy_rd_q   <= ~rdy_rd_d;\r\n            ptr_q      <= ptr_d;      nptr_q      <= ~ptr_d;\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n\r\n    logic signed [31:0] p;\r\n    mult_tree u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n\r\n    assign RDY_mult      = rdy_mult_q;\r\n    assign RDY_blockRead = rdy_rd_q;\r\n    assign EN_writeMem   = wr_q;\r\n    assign writeMem_addr = ptr_q;\r\n    assign writeMem_val  = p;\r\n    assign EN_readMem    = EN_blockRead & rdy_rd_q;\r\n    assign readMem_addr  = ptr_q;\r\n    assign VALID_memVal  = vld_q;\r\n    assign memVal_data   = readMem_val;\r\nendmodule : mkMultBuff\r\nEOF\r\n\r\n"]
[2421.08, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nt=open('build/exp/top.sv').read()\r\nt=t.replace(\"\"\"    (* keep *) logic rdy_mult_o, rdy_rd_o;\r\n\"\"\",\"\"\"    (* keep *) logic rdy_mult_o, rdy_rd_o;\r\n    // likewise port-only copies of the memory addresses and write enable\r\n    (* keep *) logic [5:0] wp_o, rp_o;\r\n    (* keep *) logic       wr_o;\r\n\"\"\")\r\nt=t.replace(\"            rdy_mult_o <= 1'b1; rdy_rd_o <= 1'b0;\\n\",\"            rdy_mult_o <= 1'b1; rdy_rd_o <= 1'b0;\\n            wp_o <= '0; rp_o <= '0; wr_o <= 1'b0;\\n\")\r\nt=t.replace(\"            if (wr) wp_q <= wp_q + 6'd1;\\n            if (rd) rp_q <= rp_q + 6'd1;\\n\",\r\n\"            if (wr) begin wp_q <= wp_q + 6'd1; wp_o <= wp_q + 6'd1; end\\n            if (rd) begin rp_q <= rp_q + 6'd1; rp_o <= rp_q + 6'd1; end\\n            wr_o <= v_q[LAT-2];\\n\")\r\nt=t.replace(\"assign EN_writeMem   = wr;\",\"assign EN_writeMem   = wr_o;\").replace(\"assign writeMem_addr = wp_q;\",\"assign writeMem_addr = wp_o;\").replace(\"assign readMem_addr  = rp_q;\",\"assign readMem_addr  = rp_o;\")\r\nopen('build/exp/top.sv','w').write(t)\r\nEOF\r\nsed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/4/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head; echo \"$(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; (MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh q800b 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh q800c 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; for d in q800b q800c; do build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p'; grep -A2 \" $(build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p' | cut -d/ -f1) (\" build/exp/$d/rsz.v | grep \"\\.Q\"; done\r\nALL PASS\r\nq800c P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5654.096000 rsz_area=5815 wns=-0.076 whs=0.020 pwr_est=3.1322e-03\r\nq800b P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5656.490000 rsz_area=5817 wns=-0.076 whs=0.024 pwr_est=3.1280e-03\r\n_5322_/Q (DFF_X1) fo=4 d=0.575 t=0.575\r\n    .Q(readMem_addr[0]),\r\n_5292_/Q (DFF_X1) fo=4 d=0.575 t=0.575\r\n    .Q(readMem_addr[0]),\r\n"]
[2448.462, "o", "\u001b[2m# write /home/user/elec402-p2-open/build/cand_dadda/gen2.py\u001b[0m\r\n"]
[2458.786, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\ns = open('gen2.py').read()\r\nold = s[s.index(\"# column c is final if no generate\"):s.index(\"# columns 0..lo-1 are final\")]\r\ns = s.replace(old, \"\"\"# columns below the first non-zero generate receive no carry: their sum is p\r\nlo = 0\r\nwhile lo < W and pg[lo][1] == ZERO:\r\n    lo += 1\r\n\"\"\")\r\ns = s.replace(\"LAT = st + 1 - 1 + 1 - 1   # ranks: operand (1) + stages 1..st each ending in a register\\n\", \"\")\r\nopen('gen2.py','w').write(s)\r\nEOF\r\nfor o in \"\" \"--pg\" \"--cpa3\" \"--pg --cpa3\" \"--pg --k 4 --cpa3\"; do echo \"== $o\"; python3 gen2.py /tmp/claude-0/x --b1 0.66 $o; done\r\n== \r\nLAT=7 datapath flops=510\r\n  stage 1: 84 FA 1 HA, max height 11, 173 flops\r\n  stage 2: 71 FA 3 HA, max height 6, 102 flops\r\n  stage 3: 38 FA 7 HA, max height 5, 64 flops\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 6: selection, product register 32 flops\r\n== --pg\r\nLAT=8 datapath flops=560\r\n  stage 1: 84 FA 1 HA, max height 11, 173 flops\r\n  stage 2: 71 FA 3 HA, max height 6, 102 flops\r\n  stage 3: 38 FA 7 HA, max height 5, 64 flops\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: selection, product register 32 flops\r\n== --cpa3\r\nLAT=8 datapath flops=565\r\n  stage 1: 84 FA 1 HA, max height 11, 173 flops\r\n  stage 2: 71 FA 3 HA, max height 6, 102 flops\r\n  stage 3: 38 FA 7 HA, max height 5, 64 flops\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 6: CPA part 2 (block prefix), 55 flops\r\n  stage 7: selection, product register 32 flops\r\n== --pg --cpa3\r\nLAT=9 datapath flops=615\r\n  stage 1: 84 FA 1 HA, max height 11, 173 flops\r\n  stage 2: 71 FA 3 HA, max height 6, 102 flops\r\n  stage 3: 38 FA 7 HA, max height 5, 64 flops\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: CPA part 2 (block prefix), 55 flops\r\n  stage 8: selection, product register 32 flops\r\n== --pg --k 4 --cpa3\r\nLAT=9 datapath flops=627\r\n  stage 1: 84 FA 1 HA, max height 11, 173 flops\r\n  stage 2: 71 FA 3 HA, max height 6, 102 flops\r\n  stage 3: 38 FA 7 HA, max height 5, 64 flops\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)], 65 flops\r\n  stage 7: CPA part 2 (block prefix), 59 flops\r\n  stage 8: selection, product register 32 flops\r\n"]
[2463.593, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nt=open('build/exp/top.sv').read()\r\nt=t.replace(\"\"\"    // likewise port-only copies of the memory addresses and write enable\r\n    (* keep *) logic [5:0] wp_o, rp_o;\r\n    (* keep *) logic       wr_o;\r\n\"\"\",\"\"\"    // likewise port-only copies of the memory addresses and write enable; they\r\n    // are stored inverted (reset value all ones) so that synthesis does not\r\n    // merge them with the internal registers, which have the same next state\r\n    logic [5:0] wp_on, rp_on;\r\n    logic       wr_on;\r\n\"\"\")\r\nt=t.replace(\"            wp_o <= '0; rp_o <= '0; wr_o <= 1'b0;\\n\",\"            wp_on <= '1; rp_on <= '1; wr_on <= 1'b1;\\n\")\r\nt=t.replace(\"            if (wr) begin wp_q <= wp_q + 6'd1; wp_o <= wp_q + 6'd1; end\\n            if (rd) begin rp_q <= rp_q + 6'd1; rp_o <= rp_q + 6'd1; end\\n            wr_o <= v_q[LAT-2];\\n\",\r\n\"            if (wr) begin wp_q <= wp_q + 6'd1; wp_on <= ~(wp_q + 6'd1); end\\n            if (rd) begin rp_q <= rp_q + 6'd1; rp_on <= ~(rp_q + 6'd1); end\\n            wr_on <= ~v_q[LAT-2];\\n\")\r\nt=t.replace(\"assign EN_writeMem   = wr_o;\",\"assign EN_writeMem   = ~wr_on;\").replace(\"assign writeMem_addr = wp_o;\",\"assign writeMem_addr = ~wp_on;\").replace(\"assign readMem_addr  = rp_o;\",\"assign readMem_addr  = ~rp_on;\")\r\nopen('build/exp/top.sv','w').write(t)\r\nEOF\r\nsed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/4/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head; echo \"$(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; (MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh r800b 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh r800c 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; for d in r800b r800c; do build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p'; grep -A2 \" $(build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p' | cut -d/ -f1) (\" build/exp/$d/rsz.v | grep \"\\.Q\"; done\r\nALL PASS\r\nr800b P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5613.132000 rsz_area=5786 wns=-0.014 whs=0.024 pwr_est=3.1643e-03\r\nr800c P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5607.014000 rsz_area=5771 wns=-0.014 whs=0.024 pwr_est=3.1593e-03\r\n_4799_/Q (DFF_X1) fo=3 d=0.338 t=0.338\r\n    .Q(\\u_mult.g_csel.co0q [5]),\r\n_4775_/Q (DFF_X1) fo=3 d=0.338 t=0.338\r\n    .Q(\\u_mult.g_csel.co0q [5]),\r\n"]
[2467.114, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && for b in 0.62 0.66 0.70 0.74; do echo \"== B=$b --pg\"; python3 gen2.py /tmp/claude-0/x --b1 0.66 --budget $b --pg | grep -v \"^ *stage [123]:\"; done\r\n== B=0.62 --pg\r\nLAT=8 datapath flops=560\r\n  stage 4: 14 FA 4 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: selection, product register 32 flops\r\n== B=0.66 --pg\r\nLAT=8 datapath flops=560\r\n  stage 4: 14 FA 3 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: selection, product register 32 flops\r\n== B=0.70 --pg\r\nLAT=8 datapath flops=560\r\n  stage 4: 14 FA 3 HA, max height 2, 50 flops\r\n  stage 5: 0 FA 0 HA + p/g, 50 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: selection, product register 32 flops\r\n== B=0.74 --pg\r\nLAT=8 datapath flops=563\r\n  stage 4: 14 FA 2 HA, max height 2, 51 flops\r\n  stage 5: 0 FA 0 HA + p/g, 51 flops\r\n  stage 6: CPA part 1, blocks [(1, 9), (9, 17), (17, 25), (25, 32)], 57 flops\r\n  stage 7: selection, product register 32 flops\r\n"]
[2484.205, "o", "\u001b[1;32m$\u001b[0m build/cand_retime/src/f14.sh build/cand_retime/b1_r5_naive/map.v; build/cand_retime/src/f14.sh build/cand_retime/b1_r5_fix/map.v; grep -n \"module .rmult\" build/cand_retime/b1_r5_fix/syn.rt.il; for s in pre_rt rt_in rt_out; do echo $s; grep -E \"DFF|SDFF|cells\" build/cand_retime/b1_r5_naive/syn.$s.stat; done\r\nF14CHECK: flops 432, reset-gated 113 (of which reset-to-1 1), NOT reset-gated 319: net67 _0107_ _0108_ _0110_ _0112_ _0114_ _0115_ _0117_ _0123_ _0106_\r\n"]
[2489.613, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime && sed -i 's/if {\\[string match \"module \\\\\\\\\\\\\\\\rmult\" \\$l\\]}/if {$l eq \"module \\\\\\\\rmult\"}/' src/synth_rt.tcl && grep -n 'module \\\\' src/synth_rt.tcl; grep -E \"^Startpoint|^Endpoint|slack \\(\" b1_r5_fix/rep/sta.rpt | head -9\r\n44:        if {[string match \"module \\\\rmult\" $l]} { set inmod 1 }\r\nStartpoint: _4725_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _4762_ (rising edge-triggered flip-flop clocked by clk)\r\n                                    -0.300   slack (VIOLATED)\r\nStartpoint: _4363_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _4477_ (rising edge-triggered flip-flop clocked by clk)\r\n                                    -0.298   slack (VIOLATED)\r\nStartpoint: _4363_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _4521_ (rising edge-triggered flip-flop clocked by clk)\r\n                                    -0.295   slack (VIOLATED)\r\n"]
