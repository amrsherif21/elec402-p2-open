[22452.608, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''        rb = args.res_budget if last else (args.res_mid if lv in cuts else 0)'''\r\nnew = '''        if not last and lv in cuts and args.extra > 0:\r\n            cols, ne = extra_fa(cols, args.extra, args.extra_h)\r\n            net.lines.append(f\"    // extra full adders on early bits before the cut: {ne}\")\r\n            summary.append(f\"S{stage}: {ne} extra full adders on early bits\")\r\n            sf += ne\r\n        rb = args.res_budget if last else (args.res_mid if lv in cuts else 0)'''\r\nassert old in s; s = s.replace(old, new)\r\nold = \"# ---------------------------------------------------------------------------\\ndef emit_stage_comment\"\r\nnew = '''def extra_fa(cols, budget, hmax):\r\n    \"\"\"full adders on the three earliest bits of a column where the sum and carry fit\r\n    the budget and no column grows above hmax (keeps the remaining level count)\"\"\"\r\n    cols = [list(c) for c in cols]\r\n    n = 0\r\n    for c in range(W):\r\n        while len(cols[c]) >= 3:\r\n            bs = sorted(cols[c], key=lambda b: b[1])\r\n            x, y, z = bs[0], bs[1], bs[2]\r\n            if any(is_const(b_[0]) for b_ in (x, y, z)): break\r\n            tt = max(x[1], y[1]) + DX\r\n            if max(tt, z[1]) + DX > budget + EPS: break\r\n            if c + 1 < W and len(cols[c + 1]) + 1 > hmax: break\r\n            for b_ in (x, y, z): cols[c].remove(b_)\r\n            s_, cy = fa(x, y, z); n += 1\r\n            cols[c].append(s_)\r\n            if c + 1 < W: cols[c + 1].append(cy)\r\n    return cols, n\r\n\r\n# ---------------------------------------------------------------------------\r\ndef emit_stage_comment'''\r\ns = s.replace(old, new, 1)\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--extra\", type=float, default=0.0, help=\"level mode: extra full adders on early bits before mid-tree cuts, up to this arrival\")\\nap.add_argument(\"--extra-h\", type=int, default=4, help=\"column height limit for --extra\")\\nap.add_argument(\"--stats\"')\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor e in 0 0.72 0.76; do for h in 3 4 5; do echo \"extra $e h $h: $(python3 gen_tree.py /dev/null --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra $e --extra-h $h | grep 'LAT\\|extra\\|R4' | tr '\\n' ' ')\"; done; done\r\nextra 0 h 3: LAT=6 ranks=[40, 144, 84, 52, 39, 32] datapath flops=391 FA=100 HA=24   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0 h 4: LAT=6 ranks=[40, 144, 84, 52, 39, 32] datapath flops=391 FA=100 HA=24   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0 h 5: LAT=6 ranks=[40, 144, 84, 52, 39, 32] datapath flops=391 FA=100 HA=24   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.72 h 3: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.72 h 4: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.72 h 5: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.76 h 3: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.76 h 4: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops \r\nextra 0.76 h 5: LAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26   S3: 2 extra full adders on early bits   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops\r\n"]
