[22700.492, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && for m in \"dadda\" \"wallace\" \"wallace --rawlevels 3\"; do echo \"== $m\"; python3 gen_tree.py /dev/null --mode $m --cuts 1,2,3,4 --gp cpa | grep \"after level\"; done\r\n== dadda\r\n  R3 after level 1: 15 FA 10 HA, model arrival 0.36, 132 flops\r\n  R4 after level 2: 30 FA 6 HA, model arrival 0.36, 104 flops\r\n  R5 after level 3: 21 FA 3 HA, model arrival 0.36, 84 flops\r\n  R6 after level 4: 25 FA 3 HA, model arrival 0.36, 60 flops\r\n== wallace\r\n  R3 after level 1: 39 FA 13 HA, model arrival 0.36, 112 flops\r\n  R4 after level 2: 27 FA 11 HA, model arrival 0.36, 86 flops\r\n  R5 after level 3: 17 FA 12 HA, model arrival 0.36, 69 flops\r\n  R6 after level 4: 9 FA 19 HA, model arrival 0.36, 59 flops\r\n== wallace --rawlevels 3\r\n  R3 after level 1: 39 FA 9 HA, model arrival 0.36, 112 flops\r\n  R4 after level 2: 28 FA 3 HA, model arrival 0.36, 84 flops\r\n  R5 after level 3: 20 FA 0 HA, model arrival 0.36, 65 flops\r\n  R6 after level 4: 13 FA 8 HA, model arrival 0.36, 52 flops\r\n"]
[22709.65, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''usage: gen_tree.py OUT.sv [options]   (prints a stage / cutset summary; --stats only\r\n       prints the level statistics of Dadda and Wallace)\r\n\"\"\"'''\r\nnew = '''usage: gen_tree.py OUT.sv [options]   (prints a stage / cutset summary; --stats only\r\n       prints the level statistics of Dadda and Wallace)\r\n  run.sh RUN NAME [options] generates NAME/rtl, unit-tests it (tb_mult.sv, 200k random +\r\n  corner operands) and runs submission/scripts/eval_candidate.sh.\r\nBest configurations found (see the per-candidate eval.txt):\r\n  800 MHz, 6 ranks, 431 flops, WNS +0.096 (w24r3gt5re):\r\n    --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra 0.72\r\n  400 MHz, 3 ranks, 141 flops, WNS +0.151 (w4r3cpa):\r\n    --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9\r\nDelay model (model ns): XOR --dx, AND/OR --da; the level-based modes ignore it except for\r\nthe input assignment (latest input on the fast input) and the optional extras.\r\n\"\"\"'''\r\nassert old in s; s = s.replace(old, new)\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\npython3 gen_tree.py /tmp/claude-0/chk.sv --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra 0.72 | head -1; diff <(sed 1,2d /tmp/claude-0/chk.sv) <(sed 1,2d w24r3gt5re/rtl/mult_pipe.sv) && echo identical; rm -f */unit.vvp; du -sh .\r\nLAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26\r\nidentical\r\n331M\t.\r\n"]
[22745.779, "o", "\u001b[1;32m$\u001b[0m git fetch -q origin check-results && for d in $(git ls-tree --name-only origin/check-results results/ | grep e18); do git show origin/check-results:$d/scorecard.md | sed -n '3p;/^| GPDK/p;/^| Gate/p'; done; ls build/cand800b/w24r3gt5re/rtl build/cand800b/w4r3cpa/rtl; SP=/tmp/claude-0/-home-user-elec402-p2-open/6503db16-82a0-5ee1-9a2e-83eb2b44d2ca/scratchpad && cd $SP/wt_c400 && git rm -q submission/rtl_800/*.sv submission/rtl_400/*.sv && mkdir -p submission/rtl_800 submission/rtl_400 && cp /home/user/elec402-p2-open/build/cand800b/w24r3gt5re/rtl/*.sv submission/rtl_800/ && cp /home/user/elec402-p2-open/build/cand800b/w4r3cpa/rtl/*.sv submission/rtl_400/ && git add -A submission && git commit -q -m \"Sign-off candidate: Wallace bit-level trees, 800 MHz w24r3gt5re (431 flops), 400 MHz w4r3cpa (141 flops)\r\n\r\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\r\nClaude-Session: https://claude.ai/code/session_0126GMUJKG14LrQMZ4a6y2it\" && git push -q origin HEAD:refs/heads/check/c-wallace 2>&1 | tail -1; git log --oneline -1\r\nCommit `89c8d9950535`, checked 2026-11-08 08:23 UTC.\r\n| GPDK045 static timing, 400 MHz at 2.5 ns | WNS 441 ps, meets the slack target (target 125 ps) |\r\n| GPDK045 cell area, 400 MHz | 2648.1 \u00b5m\u00b2, within budget (limit 6000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 400 MHz | 218.6 \u00b5W (vectorless) |\r\n| GPDK045 static timing, 800 MHz at 1.25 ns | WNS 158 ps, meets the slack target (target 62 ps) |\r\n| GPDK045 cell area, 800 MHz | 4416.2 \u00b5m\u00b2, within budget (limit 12000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 800 MHz | 829.7 \u00b5W (vectorless) |\r\n| Gate-level simulation with SDF, 400 MHz at 2.5 ns | Pass, 1204/1204 products, 0 timing-check messages |\r\n| Gate-level simulation with SDF, 800 MHz at 1.25 ns | Pass, 1162/1162 products, 0 timing-check messages |\r\nbuild/cand800b/w24r3gt5re/rtl:\r\nmkMultBuff.sv\r\nmult_pipe.sv\r\n\r\nbuild/cand800b/w4r3cpa/rtl:\r\nmkMultBuff.sv\r\nmult_pipe.sv\r\nremote: \r\n2a1eae3 Sign-off candidate: Wallace bit-level trees, 800 MHz w24r3gt5re (431 flops), 400 MHz w4r3cpa (141 flops)\r\nShell cwd was reset to /home/user/elec402-p2-open\r\n"]
[22756.077, "o", "\u001b[1;32m$\u001b[0m diff <(grep -v \"^\\s*//\" build/cand800a/e18_gt0/rtl/mkMultBuff.sv) <(grep -v \"^\\s*//\" build/cand800b/w24r3gt5re/rtl/mkMultBuff.sv) | head -80; grep -n \"module mult_pipe\\|parameter\\|input\\|output\" build/cand800b/w24r3gt5re/rtl/mult_pipe.sv | head -15; grep -n \"mult_pipe\" build/cand800a/e18_gt0/rtl/mkMultBuff.sv\r\n19,37c19\r\n<     localparam bit       PRE_ENC   = 1'b1;\r\n<     localparam bit       ENC_REG   = 1'b0;\r\n<     localparam bit [3:0] CSA_REG   = 4'b1010;\r\n<     localparam bit       SEL_REG   = 1'b1;\r\n<     localparam bit       CPA_SPLIT = 1'b0;\r\n<     localparam bit       CPA_CSEL  = 1'b1;\r\n<     localparam int       CPA       = 1;\r\n<     localparam int       PFX       = 0;\r\n<     localparam bit       CI1       = 1'b1;\r\n<     localparam int       CSW       = 4;\r\n<     localparam bit       GP4       = 1'b0;\r\n<     localparam bit       GT        = 1'b0;\r\n<     localparam bit       ORD       = 1'b1;\r\n<     localparam bit       CNT       = 1'b1;   // pointers as 3+3 bits with a registered low-half carry\r\n<     localparam bit       RDS       = 1'b1;   // drain starts at the write made when fill is closed and nothing else is in flight\r\n<     localparam bit [4:0] DUP       = 5'b00011; // {rp, wp, wr, rdy_rd, rdy_mult}   // port-only copies of the ready flags, addresses, write enable\r\n<     localparam int       LAT       = 1 + (PRE_ENC ? 0 : ENC_REG) + SEL_REG + CSA_REG[0] + CSA_REG[1]\r\n<                                      + CSA_REG[2] + CSA_REG[3]\r\n<                                      + ((CPA == 1 || (CPA == 0 && (CPA_SPLIT | CPA_CSEL))) ? 1 : 0) + 1;\r\n---\r\n>     localparam int LAT = 6;\r\n44d25\r\n<     logic       wc_q, rc_q;              // CNT: wp_q[2:0] == 7, rp_q[2:0] == 7\r\n51,53d31\r\n<     wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\r\n<     wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\r\n<     wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\r\n60c38\r\n<             acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0; wc_q <= 1'b0; rc_q <= 1'b0;\r\n---\r\n>             acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0;\r\n67,82c45,46\r\n<             if (wr) begin\r\n<                 wp_on <= ~(wp_q + 6'd1);\r\n<                 if (CNT) begin\r\n<                     wp_q[2:0] <= wp_q[2:0] + 3'd1;\r\n<                     if (wc_q) wp_q[5:3] <= wp_q[5:3] + 3'd1;\r\n<                     wc_q <= (wp_q[2:0] == 3'd6);\r\n<                 end else wp_q <= wp_q + 6'd1;\r\n<             end\r\n<             if (rd) begin\r\n<                 rp_on <= ~(rp_q + 6'd1);\r\n<                 if (CNT) begin\r\n<                     rp_q[2:0] <= rp_q[2:0] + 3'd1;\r\n<                     if (rc_q) rp_q[5:3] <= rp_q[5:3] + 3'd1;\r\n<                     rc_q <= (rp_q[2:0] == 3'd6);\r\n<                 end else rp_q <= rp_q + 6'd1;\r\n<             end\r\n---\r\n>             if (wr) begin wp_q <= wp_q + 6'd1; wp_on <= ~(wp_q + 6'd1); end\r\n>             if (rd) begin rp_q <= rp_q + 6'd1; rp_on <= ~(rp_q + 6'd1); end\r\n84,85c48,49\r\n<             if (wr_last) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\n<             if (rd && rp_last) begin\r\n---\r\n>             if (wr && wp_q == 6'd63) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\n>             if (rd && rp_q == 6'd63) begin\r\n93,94c57\r\n<     mult_pipe #(.PRE_ENC(PRE_ENC), .ENC_REG(ENC_REG), .CSA_REG(CSA_REG), .SEL_REG(SEL_REG), .CPA_SPLIT(CPA_SPLIT), .CPA_CSEL(CPA_CSEL), .CSW(CSW), .GP4(GP4), .GT(GT), .ORD(ORD), .CPA(CPA), .PFX(PFX), .CI1(CI1))\r\n<         u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n---\r\n>     mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n96,100c59,62\r\n<     assign RDY_mult      = DUP[0] ? ~rdy_mult_on : rdy_mult_q;\r\n<     assign RDY_blockRead = DUP[1] ? ~rdy_rd_on   : rdy_rd_q;\r\n<     assign EN_writeMem   = DUP[2] ? ~wr_on       : wr;\r\n<     assign writeMem_addr = DUP[3] ? ~wp_on       : wp_q;\r\n<     assign readMem_addr  = DUP[4] ? ~rp_on       : rp_q;\r\n---\r\n>     assign RDY_mult      = ~rdy_mult_on;\r\n>     assign RDY_blockRead = ~rdy_rd_on;\r\n>     assign EN_writeMem   = ~wr_on;\r\n>     assign writeMem_addr = ~wp_on;\r\n102a65\r\n>     assign readMem_addr  = ~rp_on;\r\n20:module mult_pipe (\r\n21:    input  logic               clk,\r\n22:    input  logic               RST_N,\r\n23:    input  logic               en,     // accept: load operands, else load zeros\r\n24:    input  logic signed [15:0] a,      // multiplicand (unregistered input)\r\n25:    input  logic signed [15:0] b,      // multiplier   (unregistered input)\r\n26:    output logic signed [31:0] p       // product, registered\r\n29:    function automatic logic [23:0] booth_enc(input logic [15:0] y);\r\n4:// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, carry-select adder),\r\n47:    // multiplier pipeline configuration (see mult_pipe.sv)\r\n128:    mult_pipe #(.PRE_ENC(PRE_ENC), .ENC_REG(ENC_REG), .CSA_REG(CSA_REG), .SEL_REG(SEL_REG), .CPA_SPLIT(CPA_SPLIT), .CPA_CSEL(CPA_CSEL), .CSW(CSW), .GP4(GP4), .GT(GT), .ORD(ORD), .CPA(CPA), .PFX(PFX), .CI1(CI1))\r\n"]
[22800.048, "o", "\u001b[1;32m$\u001b[0m d=build/cand800c/combo && mkdir -p $d/rtl && cp build/cand800b/w24r3gt5re/rtl/mult_pipe.sv $d/rtl/ && python3 - <<'EOF'\r\ns=open('build/cand800a/e18_gt0/rtl/mkMultBuff.sv').read()\r\nimport re\r\ni=s.index('    mult_pipe #(')\r\nj=s.index(';',i)\r\ns=s[:i]+'    mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));'+s[j+1:]\r\nopen('build/cand800c/combo/rtl/mkMultBuff.sv','w').write(s)\r\nEOF\r\nexport ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; bash submission/scripts/eval_candidate.sh 800 $d/rtl $d 2>&1 | sed -n 2,4p; sort -k3 -n $d/rep/ranks.rpt | grep -v Warn | head -4\r\ncheck=PASS sim=PASS wns=0.085 whs=0.041\r\narea=3849.552 seq=1901.368 comb=1948.2 flops=420 vectorless_uW=2103.9\r\nactivity_uW: run:=2392.30 fill:=4406.80 drain:=1852.40 \r\nwriteMem_val                           32    0.085\r\nu_mult.r3                              82    0.091\r\nacc_q                                   6    0.119\r\nrdy_rd_on                               1    0.138\r\n"]
[22810.472, "o", "\u001b[1;32m$\u001b[0m SP=/tmp/claude-0/-home-user-elec402-p2-open/6503db16-82a0-5ee1-9a2e-83eb2b44d2ca/scratchpad && cd $SP/wt_c400 && cp /home/user/elec402-p2-open/build/cand800c/combo/rtl/*.sv submission/rtl_800/ && git add -A submission && git commit -q -m \"Sign-off candidate: 800 MHz Wallace tree + e18 control (420 flops), 400 MHz w4r3cpa\r\n\r\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\r\nClaude-Session: https://claude.ai/code/session_0126GMUJKG14LrQMZ4a6y2it\" && git push -q origin HEAD:refs/heads/check/c-combo 2>&1 | tail -1; git log --oneline -1; cd /home/user/elec402-p2-open && git fetch -q origin check-results && git ls-tree --name-only origin/check-results results/\r\nremote: \r\n5de557d Sign-off candidate: 800 MHz Wallace tree + e18 control (420 flops), 400 MHz w4r3cpa\r\nresults/check_400-60ed005585\r\nresults/check_800-b6917e9eb1\r\nresults/check_c400-p1c4-0fbf037449\r\nresults/check_c800-e18-89c8d99505\r\n"]
[22817.694, "o", "\u001b[1;32m$\u001b[0m sed -n 1,140p build/cand800c/combo/rtl/mkMultBuff.sv\r\n// mkMultBuff.sv -- 800 MHz implementation (1.25 ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, carry-select adder),\r\n// with\r\n// seven register ranks (LAT = 7):\r\n//   rank 1: operand register; mult_input1 is Booth-recoded before it\r\n//   rank 2: selected partial products (8 rows of 17 bits + 8 \"+1\" bits)\r\n//   rank 3: carry-save level 1 (9 -> 6 rows)\r\n//   rank 4: carry-save levels 2 and 3 (6 -> 4 -> 3 rows)\r\n//   rank 5: carry-save level 4 (3 -> 2 rows), stored as generate/propagate\r\n//   rank 6: carry-select adder stage A (4-bit blocks: sums for carry-in 0/1,\r\n//           block carry-outs)\r\n//   rank 7: product, after the block-carry prefix and the sum selection;\r\n//           drives writeMem_val directly\r\n// A LAT-bit valid shift register runs alongside the datapath and drives\r\n// EN_writeMem (F4).\r\n//\r\n// Control: the registered ready flags rdy_mult_q / rdy_rd_q are the fill /\r\n// drain state machine (FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1}); acc_q counts\r\n// pairs accepted in the fill phase, so pairs in flight count against the\r\n// capacity (F5); wp_q / rp_q are the write and read pointers. Changes from the\r\n// 400 MHz control for timing at 1.25 ns: separate write and read pointers, and\r\n// port-only copies of RDY_mult, RDY_blockRead, writeMem_addr, readMem_addr and\r\n// EN_writeMem, so the output load does not slow the internal handshake logic.\r\n// All outputs come from registers except EN_readMem (= EN_blockRead &\r\n// RDY_blockRead, F7) and memVal_data (= readMem_val, F8).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\nmodule mkMultBuff #(parameter N = 32) (\r\n    input  logic         clk,\r\n    input  logic         RST_N,\r\n    input  logic         EN_mult,\r\n    input  logic [15:0]  mult_input0,\r\n    input  logic [15:0]  mult_input1,\r\n    output logic         RDY_mult,\r\n    input  logic         EN_blockRead,\r\n    output logic         RDY_blockRead,\r\n    output logic         VALID_memVal,\r\n    output logic [N-1:0] memVal_data,\r\n    output logic         EN_writeMem,\r\n    output logic [5:0]   writeMem_addr,\r\n    output logic [N-1:0] writeMem_val,\r\n    output logic         EN_readMem,\r\n    output logic [5:0]   readMem_addr,\r\n    input  logic [N-1:0] readMem_val\r\n);\r\n    // multiplier pipeline configuration (see mult_pipe.sv)\r\n    localparam bit       PRE_ENC   = 1'b1;\r\n    localparam bit       ENC_REG   = 1'b0;\r\n    localparam bit [3:0] CSA_REG   = 4'b1010;\r\n    localparam bit       SEL_REG   = 1'b1;\r\n    localparam bit       CPA_SPLIT = 1'b0;\r\n    localparam bit       CPA_CSEL  = 1'b1;\r\n    localparam int       CPA       = 1;\r\n    localparam int       PFX       = 0;\r\n    localparam bit       CI1       = 1'b1;\r\n    localparam int       CSW       = 4;\r\n    localparam bit       GP4       = 1'b0;\r\n    localparam bit       GT        = 1'b0;\r\n    localparam bit       ORD       = 1'b1;\r\n    localparam bit       CNT       = 1'b1;   // pointers as 3+3 bits with a registered low-half carry\r\n    localparam bit       RDS       = 1'b1;   // drain starts at the write made when fill is closed and nothing else is in flight\r\n    localparam bit [4:0] DUP       = 5'b00011; // {rp, wp, wr, rdy_rd, rdy_mult}   // port-only copies of the ready flags, addresses, write enable\r\n    localparam int       LAT       = 1 + (PRE_ENC ? 0 : ENC_REG) + SEL_REG + CSA_REG[0] + CSA_REG[1]\r\n                                     + CSA_REG[2] + CSA_REG[3]\r\n                                     + ((CPA == 1 || (CPA == 0 && (CPA_SPLIT | CPA_CSEL))) ? 1 : 0) + 1;\r\n\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q;\r\n    // copies of the two ready flags that drive only the output ports, so the\r\n    // port load does not slow the internal handshake logic (stored inverted,\r\n    // see below)\r\n    logic rdy_mult_on, rdy_rd_on;\r\n    // likewise port-only copies of the memory addresses and write enable; they\r\n    // are stored inverted (reset value all ones) so that synthesis does not\r\n    // merge them with the internal registers, which have the same next state\r\n    logic [5:0] wp_on, rp_on;\r\n    logic       wr_on;\r\n    logic [5:0] acc_q, wp_q, rp_q;\r\n    logic       wc_q, rc_q;              // CNT: wp_q[2:0] == 7, rp_q[2:0] == 7\r\n    logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\r\n    logic signed [31:0] p;\r\n\r\n    wire acc = EN_mult & rdy_mult_q;\r\n    wire rd  = EN_blockRead & rdy_rd_q;\r\n    wire wr  = v_q[LAT-1];\r\n    wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\r\n    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\r\n    wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0;\r\n            rdy_mult_on <= 1'b0; rdy_rd_on <= 1'b1;\r\n            wp_on <= '1; rp_on <= '1; wr_on <= 1'b1;\r\n            acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0; wc_q <= 1'b0; rc_q <= 1'b0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-2:0], acc};\r\n            if (acc) begin\r\n                acc_q <= acc_q + 6'd1;\r\n                if (acc_q == 6'd63) begin rdy_mult_q <= 1'b0; rdy_mult_on <= 1'b1; end\r\n            end\r\n            if (wr) begin\r\n                wp_on <= ~(wp_q + 6'd1);\r\n                if (CNT) begin\r\n                    wp_q[2:0] <= wp_q[2:0] + 3'd1;\r\n                    if (wc_q) wp_q[5:3] <= wp_q[5:3] + 3'd1;\r\n                    wc_q <= (wp_q[2:0] == 3'd6);\r\n                end else wp_q <= wp_q + 6'd1;\r\n            end\r\n            if (rd) begin\r\n                rp_on <= ~(rp_q + 6'd1);\r\n                if (CNT) begin\r\n                    rp_q[2:0] <= rp_q[2:0] + 3'd1;\r\n                    if (rc_q) rp_q[5:3] <= rp_q[5:3] + 3'd1;\r\n                    rc_q <= (rp_q[2:0] == 3'd6);\r\n                end else rp_q <= rp_q + 6'd1;\r\n            end\r\n            wr_on <= ~v_q[LAT-2];\r\n            if (wr_last) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\n            if (rd && rp_last) begin\r\n                rdy_rd_q <= 1'b0; rdy_mult_q <= 1'b1;\r\n                rdy_rd_on <= 1'b1; rdy_mult_on <= 1'b0;\r\n            end\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n\r\n    mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n\r\n    assign RDY_mult      = DUP[0] ? ~rdy_mult_on : rdy_mult_q;\r\n    assign RDY_blockRead = DUP[1] ? ~rdy_rd_on   : rdy_rd_q;\r\n    assign EN_writeMem   = DUP[2] ? ~wr_on       : wr;\r\n    assign writeMem_addr = DUP[3] ? ~wp_on       : wp_q;\r\n    assign readMem_addr  = DUP[4] ? ~rp_on       : rp_q;\r\n    assign writeMem_val  = p;\r\n    assign EN_readMem    = rd;\r\n    assign VALID_memVal  = vld_q;\r\n    assign memVal_data   = readMem_val;\r\nendmodule : mkMultBuff\r\n"]
[22825.77, "o", "\u001b[1;32m$\u001b[0m sed -n 1,19p build/cand800b/w24r3gt5re/rtl/mult_pipe.sv; grep -c \"\" build/cand800b/w24r3gt5re/rtl/mult_pipe.sv; cat build/cand800b/w24r3gt5re/gen.txt 2>/dev/null | head -20; sed -n 1,40p build/cand800b/gen_tree.py | head -50\r\n// mult_pipe.sv -- GENERATED by build/cand800b/gen_tree.py; edit the generator, not this file.\r\n// generator arguments: --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra 0.72\r\n//\r\n// Pipelined signed 16x16 multiplier: radix-4 Booth partial products (8 rows of 17\r\n// bits, classic sign extension {~s0,s0,s0} / {1,~si}, the +1 of each negative row as\r\n// a separate bit), bit-level column compression (wallace cuts after levels 2,4),\r\n// final adder: two-stage carry-increment, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)].\r\n// Register ranks (latency from 'en' to 'p'): 6; datapath flops 389:\r\n//   R1 operands + Booth digits: 40 flops\r\n//   R2 selected partial products + neg bits: 144 flops\r\n//   S3: 2 extra full adders on early bits\r\n//   R3 after level 2: 69 FA 12 HA, model arrival 0.72, 82 flops\r\n//   S4: low columns resolved below 5 by ripple (4 adders)\r\n//   R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops\r\n//   R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\n//   R6 product: 32 flops\r\n// Full adders 100, half adders 26. Constant bits are never registered.\r\n// Every register has a synchronous active-low reset (SPEC F14); the operand register\r\n// loads zeros when en = 0 (operand isolation).\r\n1238\r\nLAT=6 ranks=[40, 144, 82, 52, 39, 32] datapath flops=389 FA=100 HA=26\r\n  R1 operands + Booth digits: 40 flops\r\n  R2 selected partial products + neg bits: 144 flops\r\n  S3: 2 extra full adders on early bits\r\n  R3 after level 2: 69 FA 12 HA, model arrival 0.72, 82 flops\r\n  S4: low columns resolved below 5 by ripple (4 adders)\r\n  R4 tree end, generate / transmit per column (model arrival 0.78): 52 flops\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\n  R6 product: 32 flops\r\n#!/usr/bin/env python3\r\n\"\"\"gen_tree.py -- generator for a drop-in mult_pipe.sv (ports clk, RST_N, en, a, b, p):\r\npipelined signed 16x16 multiplier with radix-4 Booth partial products, a BIT-LEVEL\r\ncolumn-compression tree (Dadda 1965 / Wallace 1964 / timing-driven fill) and a\r\npipelined final adder.  Written for this project (build/cand800b).\r\n\r\nDatapath (every stage ends in a register rank):\r\n  R1  operand register: a (16) and the Booth digits one/two/neg of b (24); b is recoded\r\n      before the register; the register loads zeros when en = 0 (operand isolation)\r\n  S2  Booth selection  pp_i = ((one_i & a) | (two_i & 2a)) ^ neg_i  (8 rows x 17 bits)\r\n  R2  selected partial products (136) + the 8 neg bits (the \"+1\" of negative rows)\r\n  ... tree stages: column compression with full / half adders; the cut positions are\r\n      either \"after level k\" (level-based Dadda / Wallace) or arrival-budget driven\r\n  ... adder stages: carry-increment (default) or carry-select, then the product register\r\nSign extension: classic form, row 0 top bits {~s0, s0, s0}, rows i >= 1 {1, ~s_i}; the\r\nconstant ones are tree inputs that are never registered.  Every register has a\r\nsynchronous active-low reset.\r\n\r\nusage: gen_tree.py OUT.sv [options]   (prints a stage / cutset summary; --stats only\r\n       prints the level statistics of Dadda and Wallace)\r\n  run.sh RUN NAME [options] generates NAME/rtl, unit-tests it (tb_mult.sv, 200k random +\r\n  corner operands) and runs submission/scripts/eval_candidate.sh.\r\nBest configurations found (see the per-candidate eval.txt):\r\n  800 MHz, 6 ranks, 431 flops, WNS +0.096 (w24r3gt5re):\r\n    --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra 0.72\r\n  400 MHz, 3 ranks, 141 flops, WNS +0.151 (w4r3cpa):\r\n    --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9\r\nDelay model (model ns): XOR --dx, AND/OR --da; the level-based modes ignore it except for\r\nthe input assignment (latest input on the fast input) and the optional extras.\r\n\"\"\"\r\nimport argparse, sys\r\n\r\nap = argparse.ArgumentParser()\r\nap.add_argument(\"out\", nargs=\"?\")\r\nap.add_argument(\"--mode\", default=\"dadda\", choices=[\"dadda\", \"wallace\", \"fill\"])\r\nap.add_argument(\"--wlevels\", type=int, default=99, help=\"wallace: levels done Wallace-style; the rest Dadda\")\r\nap.add_argument(\"--cuts\", default=\"2,4\", help=\"level-based: register after these levels (last = 2 rows)\")\r\nap.add_argument(\"--budgets\", default=\"0.72,0.72\", help=\"fill: logic budget (model ns) of each tree stage\")\r\nap.add_argument(\"--target\", default=\"\", help=\"fill: per-stage target column height (default 2 = greedy)\")\r\nap.add_argument(\"--res\", action=\"store_true\", help=\"resolve low columns to 1 bit (ripple) inside tree stages\")\r\n"]
[22831.335, "o", "\u001b[1;32m$\u001b[0m git fetch -q origin check-results && for d in $(git ls-tree --name-only origin/check-results results/ | grep -E \"wallace|combo\"); do echo \"== $d\"; git show origin/check-results:$d/scorecard.md | sed -n '3p;/^| GPDK/p;/^| Gate/p'; done\r\n\r\n"]
[22851.168, "o", "\u001b[2m# write /home/user/elec402-p2-open/build/final800/rtl/mkMultBuff.sv\u001b[0m\r\n"]
[22853.926, "o", "\u001b[1;32m$\u001b[0m cp build/cand800b/gen_tree.py submission/scripts/gen_tree.py && sed -i 's|build/cand800b/gen_tree.py|submission/scripts/gen_tree.py|g; s|Written for this project (build/cand800b).|Written for this project.|' submission/scripts/gen_tree.py && grep -n \"cand800b\" submission/scripts/gen_tree.py | head; python3 -I submission/scripts/gen_tree.py build/final800/rtl/mult_pipe.sv --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 8 --k 5 --res-budget 0.66 --extra 0.72 | tail -2; diff <(sed 1,2d build/final800/rtl/mult_pipe.sv) <(sed 1,2d build/cand800b/w24r3gt5re/rtl/mult_pipe.sv) && echo IDENTICAL_BODY\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\n  R6 product: 32 flops\r\nIDENTICAL_BODY\r\n"]
[22924.656, "o", "\u001b[1;32m$\u001b[0m export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; d=build/final800; bash submission/scripts/eval_candidate.sh 800 $d/rtl $d 2>&1 | sed -n 2,4p; M=\"RUN=800 RTL_DIR=$d/rtl BUILD=$d REP=$d/rep NETLIST=$d/map.v SDF=$d/map.sdf\"; make -s timing $M 2>&1 | grep -E \"summary|^ALL PASS|TIMING FAIL\" | head -2; make -s f14 $M 2>&1 | tail -1\r\ncheck=PASS sim=PASS wns=0.085 whs=0.041\r\narea=3848.754 seq=1901.368 comb=1947.4 flops=420 vectorless_uW=2104.4\r\nactivity_uW: run:=2392.70 fill:=4409.70 drain:=1852.40 \r\n==== mkMultBuff_sdf_checker_800 summary: period 1.250 ns, seed 402, latency 6, 912 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nF14CHECK: flops 420, reset-gated 420 (of which reset-to-1 2), NOT reset-gated 0:\r\n"]
[22933.269, "o", "\u001b[1;32m$\u001b[0m git fetch -q origin check-results && for d in $(git ls-tree --name-only origin/check-results results/ | grep -E \"wallace|combo\"); do echo \"== $d\"; git show origin/check-results:$d/scorecard.md | sed -n '3p;/^| GPDK/p;/^| Gate/p'; done; date -u +%H:%M\r\n08:55\r\n"]
[22942.897, "o", "\u001b[1;32m$\u001b[0m until git fetch -q origin check-results 2>/dev/null && git ls-tree --name-only origin/check-results results/ | grep -q \"combo\"; do sleep 30; done; git ls-tree --name-only origin/check-results results/\r\n\r\n"]
[22950.009, "o", "\u001b[1;32m$\u001b[0m d=build/final400 && mkdir -p $d/rtl && python3 -I submission/scripts/gen_tree.py $d/rtl/mult_pipe.sv --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9 | tail -1 && diff <(sed 1,2d $d/rtl/mult_pipe.sv) <(sed 1,2d build/cand800b/w4r3cpa/rtl/mult_pipe.sv) && echo IDENTICAL_BODY; cp build/cand800b/w4r3cpa/rtl/mkMultBuff.sv $d/rtl/; sed -n 1,30p $d/rtl/mkMultBuff.sv | grep -v \"^\\s*input\\|^\\s*output\"; grep -n \"localparam\\|ptr\\|mult_pipe\" $d/rtl/mkMultBuff.sv | head\r\n  R3 product: 32 flops\r\nIDENTICAL_BODY\r\n// mkMultBuff.sv -- 400 MHz implementation (2.5 ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n// 3 register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\r\n// Latency (accept -> EN_writeMem) = LAT cycles; a LAT-bit valid shift register\r\n// runs alongside the datapath and drives EN_writeMem (F4).\r\n//\r\n// Control: the two registered ready flags RDY_mult / RDY_blockRead are the\r\n// fill / drain state machine (states FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1});\r\n// acc_q counts operand pairs accepted in the fill phase, so pairs still in the\r\n// pipeline count against the capacity (F5); ptr_q is the memory address, shared\r\n// by the write pointer (fill) and the read pointer (drain), which never run in\r\n// the same cycle (F13). All outputs come from registers except EN_readMem\r\n// (= EN_blockRead & RDY_blockRead, F7) and memVal_data (= readMem_val, F8).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\nmodule mkMultBuff #(parameter N = 32) (\r\n4:// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n5:// 3 register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\r\n12:// pipeline count against the capacity (F5); ptr_q is the memory address, shared\r\n35:    // multiplier pipeline latency (register ranks of the generated mult_pipe.sv)\r\n36:    localparam int LAT = 3;\r\n39:    logic [5:0] acc_q, ptr_q;\r\n50:            acc_q <= '0; ptr_q <= '0; v_q <= '0;\r\n57:            if (wr | rd) ptr_q <= ptr_q + 6'd1;\r\n58:            if (wr && ptr_q == 6'd63) rdy_rd_q <= 1'b1;\r\n59:            if (rd && ptr_q == 6'd63) begin\r\n"]
[22974.93, "o", "\u001b[1;32m$\u001b[0m d=build/final400 && python3 - <<'EOF'\r\np='build/final400/rtl/mkMultBuff.sv'\r\ns=open(p).read()\r\ns=s.replace(\"\"\"// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n// 3 register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\"\"\",\"\"\"// Datapath: mult_pipe.sv (generated by submission/scripts/gen_tree.py): radix-4\r\n// Booth partial products, bit-level Wallace column compression and a one-stage\r\n// final adder, three register ranks (latency 3):\r\n//   R1 operand a + Booth digits of b (40)   R2 two carry-save rows after the\r\n//   tree (51)                               R3 product (32), drives writeMem_val\"\"\")\r\nopen(p,'w').write(s)\r\nEOF\r\nexport ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; bash submission/scripts/eval_candidate.sh 400 $d/rtl $d 2>&1 | sed -n 2,4p; M=\"RUN=400 RTL_DIR=$d/rtl BUILD=$d REP=$d/rep NETLIST=$d/map.v SDF=$d/map.sdf\"; make -s timing $M 2>&1 | grep -E \"^ALL PASS|TIMING FAIL\" | head -1; make -s f14 $M 2>&1 | tail -1\r\ncheck=PASS sim=PASS wns=0.263 whs=0.061\r\narea=2449.594 seq=637.602 comb=1812.0 flops=141 vectorless_uW=633.4\r\nactivity_uW: run:=644.71 fill:=1599.60 drain:=379.96 \r\nALL PASS\r\nF14CHECK: flops 141, reset-gated 141 (of which reset-to-1 1), NOT reset-gated 0:\r\n"]
[22983.508, "o", "\u001b[2m# --- end of turn ---\u001b[0m\r\n"]
[22992.569, "o", "\u001b[1;32m$\u001b[0m git status --short | head; git add -A submission/scripts notes && git commit -q -m \"Add the bit-level tree generator (gen_tree.py) to the flow scripts\r\n\r\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\r\nClaude-Session: https://claude.ai/code/session_0126GMUJKG14LrQMZ4a6y2it\" && git push -q origin claude/focused-dijkstra-3f079i 2>&1 | tail -1; git status --short | wc -l\r\n?? submission/scripts/gen_tree.py\r\n0\r\n"]
[22996.065, "o", "\u001b[2m# --- end of turn ---\u001b[0m\r\n"]
[23070.752, "o", "\u001b[1;32m$\u001b[0m git fetch -q origin check-results && for d in $(git ls-tree --name-only origin/check-results results/ | grep -E \"wallace|combo\"); do echo \"== $d\"; git show origin/check-results:$d/scorecard.md | sed -n '3p;/^| GPDK/p;/^| Gate/p;/Notes/,$p'; done\r\n== results/check_c-combo-5de557d5e2\r\nCommit `5de557d5e2d6`, checked 2026-11-08 08:56 UTC.\r\n| GPDK045 static timing, 400 MHz at 2.5 ns | WNS 203 ps, meets the slack target (target 125 ps) |\r\n| GPDK045 cell area, 400 MHz | 2660.8 \u00b5m\u00b2, within budget (limit 6000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 400 MHz | 215.2 \u00b5W (vectorless) |\r\n| GPDK045 static timing, 800 MHz at 1.25 ns | WNS 90 ps, meets the slack target (target 62 ps) |\r\n| GPDK045 cell area, 800 MHz | 4192.9 \u00b5m\u00b2, within budget (limit 12000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 800 MHz | 929.8 \u00b5W (vectorless) |\r\n| Gate-level simulation with SDF, 400 MHz at 2.5 ns | Pass, 1204/1204 products, 0 timing-check messages |\r\n| Gate-level simulation with SDF, 800 MHz at 1.25 ns | Pass, 1162/1162 products, 0 timing-check messages |\r\n== results/check_c-wallace-2a1eae3e25\r\nCommit `2a1eae3e2568`, checked 2026-11-08 08:57 UTC.\r\n| GPDK045 static timing, 400 MHz at 2.5 ns | WNS 203 ps, meets the slack target (target 125 ps) |\r\n| GPDK045 cell area, 400 MHz | 2660.8 \u00b5m\u00b2, within budget (limit 6000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 400 MHz | 215.2 \u00b5W (vectorless) |\r\n| GPDK045 static timing, 800 MHz at 1.25 ns | WNS 91 ps, meets the slack target (target 62 ps) |\r\n| GPDK045 cell area, 800 MHz | 4192.6 \u00b5m\u00b2, within budget (limit 12000 \u00b5m\u00b2) |\r\n| GPDK045 power estimate, 800 MHz | 922.4 \u00b5W (vectorless) |\r\n| Gate-level simulation with SDF, 400 MHz at 2.5 ns | Pass, 1204/1204 products, 0 timing-check messages |\r\n| Gate-level simulation with SDF, 800 MHz at 1.25 ns | Pass, 1162/1162 products, 0 timing-check messages |\r\n"]
[23098.035, "o", "\u001b[1;32m$\u001b[0m d=build/final800e && mkdir -p $d/rtl && cp build/cand800a/e18_gt0/rtl/mult_pipe.sv $d/rtl/ && sed -n 1,40p $d/rtl/mult_pipe.sv; grep -n \"parameter\" $d/rtl/mult_pipe.sv | head -20\r\n// mult_pipe.sv -- pipelined signed 16x16 multiplier: radix-4 (modified) Booth\r\n// partial products, carry-save (3:2) reduction 9->6->4->3->2 rows and a final\r\n// carry-propagate adder. Every pipeline cut is optional (parameters).\r\n//   PRE_ENC  : Booth-recode the multiplier before the operand register\r\n//   ENC_REG  : (PRE_ENC = 0 only) extra rank after the Booth recoding\r\n//   SEL_REG  : register the selected partial products (8 x 17 bits + 8 \"+1\" bits)\r\n//   CSA_REG  : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   GP4      : the level-4 register holds generate/propagate (c&s, c^s) of the\r\n//              two final rows instead of the rows themselves (same width)\r\n//   CPA_CSEL : two-stage carry-select final adder with CSW-bit blocks and\r\n//              Kogge-Stone prefixes inside the blocks and across the blocks\r\n//   CPA_SPLIT: (alternative) low 16 bits in one stage, high 16 bits in the next\r\n// Register ranks (= latency from 'en' to 'p'): 1 (operand) + (PRE_ENC ? 0 : ENC_REG)\r\n//   + SEL_REG + popcount(CSA_REG) + (CPA_CSEL | CPA_SPLIT) + 1 (product)\r\n// Every register has a synchronous active-low reset. When 'en' is 0 the operand\r\n// register loads zeros (operand isolation), so an idle multiplier does not toggle.\r\n// Written for this project; the Booth recoding, the sign-extension constant and\r\n// the prefix adders follow textbook schemes (see the report's references).\r\nmodule mult_pipe #(\r\n    parameter bit       PRE_ENC   = 1'b1,\r\n    parameter bit       ENC_REG   = 1'b0,\r\n    parameter bit [3:0] CSA_REG   = 4'b1000,\r\n    parameter bit       SEL_REG   = 1'b0,\r\n    parameter bit       CPA_SPLIT = 1'b0,\r\n    parameter bit       CPA_CSEL  = 1'b0,\r\n    parameter int       CSW       = 8,\r\n    parameter bit       GP4       = 1'b0,\r\n    parameter bit       GT        = 1'b0,  // with GP4: store generate / transmit (c|s) instead of propagate\r\n    parameter bit       ORD       = 1'b0,  // arrival-aware 3:2 input order\r\n    parameter int       CPA       = 0,     // 0: per CPA_CSEL/CPA_SPLIT, 1: 2-stage carry-increment, 2: 1-stage prefix, 3: 1-stage '+'\r\n    parameter bit       CI1       = 1'b0,  // CPA=1: also register block carry-outs for carry-in 1\r\n    parameter int       PFX       = 0      // CPA=2: 0 Kogge-Stone, 1 Sklansky, 2 Brent-Kung, 3 Han-Carlson\r\n) (\r\n    input  logic               clk,\r\n    input  logic               RST_N,\r\n    input  logic               en,     // accept: load operands, else load zeros\r\n    input  logic signed [15:0] a,      // multiplicand (unregistered input)\r\n    input  logic signed [15:0] b,      // multiplier   (unregistered input)\r\n    output logic signed [31:0] p       // product, registered\r\n);\r\n3:// carry-propagate adder. Every pipeline cut is optional (parameters).\r\n20:    parameter bit       PRE_ENC   = 1'b1,\r\n21:    parameter bit       ENC_REG   = 1'b0,\r\n22:    parameter bit [3:0] CSA_REG   = 4'b1000,\r\n23:    parameter bit       SEL_REG   = 1'b0,\r\n24:    parameter bit       CPA_SPLIT = 1'b0,\r\n25:    parameter bit       CPA_CSEL  = 1'b0,\r\n26:    parameter int       CSW       = 8,\r\n27:    parameter bit       GP4       = 1'b0,\r\n28:    parameter bit       GT        = 1'b0,  // with GP4: store generate / transmit (c|s) instead of propagate\r\n29:    parameter bit       ORD       = 1'b0,  // arrival-aware 3:2 input order\r\n30:    parameter int       CPA       = 0,     // 0: per CPA_CSEL/CPA_SPLIT, 1: 2-stage carry-increment, 2: 1-stage prefix, 3: 1-stage '+'\r\n31:    parameter bit       CI1       = 1'b0,  // CPA=1: also register block carry-outs for carry-in 1\r\n32:    parameter int       PFX       = 0      // CPA=2: 0 Kogge-Stone, 1 Sklansky, 2 Brent-Kung, 3 Han-Carlson\r\n"]
[23153.812, "o", "\u001b[1;32m$\u001b[0m d=build/final800e && python3 - <<'EOF'\r\ns=open('build/final800/rtl/mkMultBuff.sv').read()\r\ns=s.replace(\"\"\"// Datapath: mult_pipe.sv (generated by submission/scripts/gen_tree.py): radix-4\r\n// Booth partial products, bit-level Wallace column compression, two-stage\r\n// carry-increment adder, six register ranks (latency 6):\r\n//   R1 operand a + Booth digits of b (40)   R2 selected partial products (144)\r\n//   R3 after compression level 2 (82)       R4 generate/transmit after level 4 (52)\r\n//   R5 adder stage A (39)                   R6 product (32), drives writeMem_val\"\"\",\"\"\"// Datapath: mult_pipe.sv: radix-4 Booth partial products, row-wise 3:2\r\n// carry-save reduction 9 -> 6 -> 4 -> 3 -> 2 rows with each 3:2 adding its\r\n// latest input last, and a two-stage carry-increment adder with 4-bit blocks.\r\n// Six register ranks (latency 6):\r\n//   R1 operand a + Booth digits of b (40)   R2 selected partial products (144)\r\n//   R3 four rows after levels 1-2 (92)      R4 two rows after levels 3-4 (60)\r\n//   R5 adder stage A: block sums for carry-in 0, block carry-outs for carry-in\r\n//      0 and 1 (43)                         R6 product (32), drives writeMem_val\"\"\")\r\ns=s.replace(\"\"\"    localparam int LAT = 6;              // register ranks of mult_pipe\"\"\",\"\"\"    // multiplier configuration (see mult_pipe.sv); LAT = register ranks\r\n    localparam int LAT = 6;\"\"\")\r\ns=s.replace(\"\"\"    mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\"\"\",\"\"\"    mult_pipe #(.PRE_ENC(1'b1), .SEL_REG(1'b1), .CSA_REG(4'b1010), .ORD(1'b1),\r\n                .CPA(1), .CI1(1'b1), .CSW(4))\r\n        u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\"\"\")\r\nopen('build/final800e/rtl/mkMultBuff.sv','w').write(s)\r\np='build/final800e/rtl/mult_pipe.sv'\r\nm=open(p).read()\r\nm=m.replace(\"\"\"//   CPA_SPLIT: (alternative) low 16 bits in one stage, high 16 bits in the next\r\n// Register ranks\"\"\",\"\"\"//   CPA_SPLIT: (alternative) low 16 bits in one stage, high 16 bits in the next\r\n//   CPA      : 1 two-stage carry-increment adder (CSW-bit blocks; stage A\r\n//              registers the block sums for carry-in 0 and the block carry-outs,\r\n//              with CI1 also those for carry-in 1), 2 one-stage prefix adder\r\n//              (PFX selects Kogge-Stone, Sklansky, Brent-Kung, Han-Carlson),\r\n//              3 one-stage '+'; 0 uses CPA_CSEL / CPA_SPLIT\r\n//   ORD      : each 3:2 compressor adds its latest-arriving input last\r\n//   GT       : with GP4, store generate/transmit instead of generate/propagate\r\n// The 800 MHz design uses PRE_ENC, SEL_REG, CSA_REG = 4'b1010, ORD, CPA = 1,\r\n// CI1, CSW = 4. The alternatives were measured during design (notes/WORKLOG.md).\r\n// Register ranks\"\"\")\r\nopen(p,'w').write(m)\r\nEOF\r\ngrep -n \"CSA_REG\\[\\|LAT\\b\" $d/rtl/mkMultBuff.sv | head -3; export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; bash submission/scripts/eval_candidate.sh 800 $d/rtl $d 2>&1 | sed -n 2,4p; M=\"RUN=800 RTL_DIR=$d/rtl BUILD=$d REP=$d/rep NETLIST=$d/map.v SDF=$d/map.sdf\"; make -s timing $M 2>&1 | grep -E \"^ALL PASS|TIMING FAIL\" | head -1; make -s f14 $M 2>&1 | tail -1\r\n12:// A LAT-bit valid shift register runs alongside the datapath; its last bit is\r\n46:    // multiplier configuration (see mult_pipe.sv); LAT = register ranks\r\n47:    localparam int LAT = 6;\r\ncheck=PASS sim=PASS wns=0.140 whs=0.041\r\narea=4017.930 seq=2000.852 comb=2017.1 flops=442 vectorless_uW=2186.6\r\nactivity_uW: run:=2491.90 fill:=4530.00 drain:=1945.60 \r\nALL PASS\r\nF14CHECK: flops 442, reset-gated 442 (of which reset-to-1 2), NOT reset-gated 0:\r\n"]
[23166.398, "o", "\u001b[1;32m$\u001b[0m git rm -q submission/rtl_400/*.sv submission/rtl_800/*.sv && cp build/final400/rtl/*.sv submission/rtl_400/ && cp build/final800e/rtl/*.sv submission/rtl_800/ && ls submission/rtl_400 submission/rtl_800 && python3 - <<'EOF'\r\nm=open('Makefile').read()\r\nold400=m[m.index(\"  # ABC mapping knobs (see notes/WORKLOG.md): no input-driver model\"):m.index(\"else ifeq ($(RUN),800)\")]\r\nnew400='''  # ABC mapping knobs: as for 800 MHz (round 3 measurements, notes/WORKLOG.md)\r\n  ABC_DRIVER ?= BUF_X1\r\n  ABC_LOAD   ?= 1.0\r\n  DONT_USE   ?= OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\r\n'''\r\nm=m.replace(old400,new400)\r\nopen('Makefile','w').write(m)\r\nEOF\r\nsed -n 8,32p Makefile; grep -n \"ptr_q\\|wp_q\\|rp_q\\|v_q <= \\|vld_q <= rd\\|assign memVal\\|assign EN_readMem\" submission/rtl_400/mkMultBuff.sv submission/rtl_800/mkMultBuff.sv | head -20\r\nsubmission/rtl_400:\r\nmkMultBuff.sv\r\nmult_pipe.sv\r\n\r\nsubmission/rtl_800:\r\nmkMultBuff.sv\r\nmult_pipe.sv\r\n  HALF    := 1.25\r\n  ABC_D   ?= 2200\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone\r\n  # ABC mapping knobs: as for 800 MHz (round 3 measurements, notes/WORKLOG.md)\r\n  ABC_DRIVER ?= BUF_X1\r\n  ABC_LOAD   ?= 1.0\r\n  DONT_USE   ?= OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\r\nelse ifeq ($(RUN),800)\r\n  PERIOD  ?= 1.25\r\n  HALF    := 0.625\r\n  ABC_D   ?= 1050\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone\r\n  # ABC mapping knobs: BUF_X1 input driver, 1 fF load (ABC outputs are mostly\r\n  # flip-flop D pins), and no cells with 3- or 4-high stacks or MUX2 (slow at\r\n  # the slow corner) during mapping\r\n  ABC_DRIVER ?= BUF_X1\r\n  ABC_LOAD   ?= 1.0\r\n  DONT_USE   ?= OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\r\nelse\r\n  $(error RUN must be 400 or 800)\r\nendif\r\n\r\nROOT     := $(CURDIR)\r\nsubmission/rtl_400/mkMultBuff.sv:15:// pipeline count against the capacity (F5); ptr_q is the memory address, shared\r\nsubmission/rtl_400/mkMultBuff.sv:42:    logic [5:0] acc_q, ptr_q;\r\nsubmission/rtl_400/mkMultBuff.sv:53:            acc_q <= '0; ptr_q <= '0; v_q <= '0;\r\nsubmission/rtl_400/mkMultBuff.sv:55:            v_q <= {v_q[LAT-2:0], acc};\r\nsubmission/rtl_400/mkMultBuff.sv:60:            if (wr | rd) ptr_q <= ptr_q + 6'd1;\r\nsubmission/rtl_400/mkMultBuff.sv:61:            if (wr && ptr_q == 6'd63) rdy_rd_q <= 1'b1;\r\nsubmission/rtl_400/mkMultBuff.sv:62:            if (rd && ptr_q == 6'd63) begin\r\nsubmission/rtl_400/mkMultBuff.sv:65:            vld_q <= rd;\r\nsubmission/rtl_400/mkMultBuff.sv:74:    assign writeMem_addr = ptr_q;\r\nsubmission/rtl_400/mkMultBuff.sv:76:    assign EN_readMem    = rd;\r\nsubmission/rtl_400/mkMultBuff.sv:77:    assign readMem_addr  = ptr_q;\r\nsubmission/rtl_400/mkMultBuff.sv:79:    assign memVal_data   = readMem_val;\r\nsubmission/rtl_800/mkMultBuff.sv:51:    logic [5:0]     acc_q, wp_q, rp_q;\r\nsubmission/rtl_800/mkMultBuff.sv:52:    logic           wc_q, rc_q;               // wp_q[2:0] == 7, rp_q[2:0] == 7\r\nsubmission/rtl_800/mkMultBuff.sv:61:    wire rp_last = rc_q && rp_q[5:3] == 3'd7;                 // read of address 63\r\nsubmission/rtl_800/mkMultBuff.sv:67:            acc_q <= '0; wp_q <= '0; rp_q <= '0; wc_q <= 1'b0; rc_q <= 1'b0;\r\nsubmission/rtl_800/mkMultBuff.sv:68:            v_q <= '0; vld_q <= 1'b0;\r\nsubmission/rtl_800/mkMultBuff.sv:70:            v_q <= {v_q[LAT-2:0], acc};\r\nsubmission/rtl_800/mkMultBuff.sv:76:                wp_q[2:0] <= wp_q[2:0] + 3'd1;\r\nsubmission/rtl_800/mkMultBuff.sv:77:                if (wc_q) wp_q[5:3] <= wp_q[5:3] + 3'd1;\r\n"]
[23174.242, "o", "\u001b[1;32m$\u001b[0m grep -n \"g_cinc\\|CPA == 1\\|cin\\b\\|assign .*ci\\b\\|bg\\b\" submission/rtl_800/mult_pipe.sv | head -20\r\n290:    end else if (CPA == 1) begin : g_cinc\r\n295:        logic [NB-1:0] co0, co0q, co1, co1q, bpq, cin;\r\n329:        assign cin = {bgg[NB-2:0], 1'b0};\r\n335:            assign psum[CSW*i +: CSW] = ({CSW{cin[i]}} & s0i[CSW*i +: CSW] & {CSW{RST_N}})\r\n336:                                      | ({CSW{~cin[i]}} & s0q[CSW*i +: CSW] & {CSW{RST_N}});\r\n345:        logic [NB-1:0] co0, co1, co0q, co1q, cin;\r\n366:        logic [NB-1:0] bg;\r\n367:        assign bg  = bprefix(co0q, co1q);\r\n368:        assign cin = {bg[NB-2:0], 1'b0};\r\n371:            assign psel[CSW*i +: CSW] = cin[i] ? s1q[CSW*i +: CSW] : s0q[CSW*i +: CSW];\r\n"]
[23197.547, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/scripts/mutate.sh'\r\ns=open(p).read()\r\na=s.index('else\\nmutants=(')\r\nb=s.index(')\\nfi', a)\r\nnew=r'''else\r\nmutants=(\r\n  \"if (acc_q == 6'd63) begin rdy_mult_q|if (acc_q == 6'd62) begin rdy_mult_q|RDY_mult drops one pair early\"\r\n  \"wire wr_last = wr \\&\\& !rdy_mult_q \\&\\& v_q\\[LAT-2:0\\] == '0;|wire wr_last = wr \\&\\& !rdy_mult_q;|drain starts before the last write\"\r\n  \"wire rp_last = rc_q \\&\\& rp_q\\[5:3\\] == 3'd7;|wire rp_last = rc_q \\&\\& rp_q[5:3] == 3'd6;|drain ends early\"\r\n  \"vld_q <= rd;|vld_q <= EN_blockRead;|VALID_memVal ignores RDY_blockRead\"\r\n  \"wire acc     = EN_mult \\& rdy_mult_q;|wire acc     = EN_mult;|EN_mult accepted while not ready\"\r\n  \"wire rd      = EN_blockRead \\& rdy_rd_q;|wire rd      = rdy_rd_q;|reads without EN_blockRead\"\r\n  \"rdy_rd_q   <= 1'b0; rdy_rd_on   <= 1'b1;|rdy_rd_q   <= 1'b0;|RDY_blockRead port copy not reset\"\r\n  \"v_q <= '0; vld_q <= 1'b0;|vld_q <= 1'b0;|valid pipeline not reset\"\r\n  \"v_q <= {v_q\\[LAT-2:0\\], acc};|v_q <= {v_q[LAT-2:0], EN_mult};|valid bit set by unaccepted pairs\"\r\n  \"assign memVal_data   = readMem_val;|assign memVal_data   = writeMem_val;|wrong data source\"\r\n  \"assign EN_readMem    = rd;|assign EN_readMem    = rdy_rd_q;|EN_readMem held during drain\"\r\n  \"wc_q <= (wp_q\\[2:0\\] == 3'd6);|wc_q <= (wp_q[2:0] == 3'd5);|write-pointer carry one step early\"\r\n  \"assign cin = {bgg\\[NB-2:0\\], 1'b0};|assign cin = {bgg[NB-2:0], 1'b1};|adder carry-in error (mult_pipe)\"\r\n)'''\r\ns=s[:a]+new+s[b+1:]\r\nopen(p,'w').write(s)\r\nEOF\r\nbash submission/scripts/mutate.sh 800 2>&1 | grep -E \"^mutant|killed\"; bash submission/scripts/mutate.sh 400 2>&1 | grep -E \"^mutant|killed\" | tail -4\r\nmutant 1 (RDY_mult drops one pair early): FAIL 5900 check(s) failed\r\nmutant 2 (drain starts before the last write): FAIL 6491 check(s) failed\r\nmutant 3 (drain ends early): FAIL 6405 check(s) failed\r\nmutant 4 (VALID_memVal ignores RDY_blockRead): FAIL 1464 check(s) failed\r\nmutant 5 (EN_mult accepted while not ready): FAIL 11272 check(s) failed\r\nmutant 6 (reads without EN_blockRead): FAIL 12678 check(s) failed\r\nmutant 7 (RDY_blockRead port copy not reset): FAIL 388 check(s) failed\r\nmutant 8 (valid pipeline not reset): FAIL 1399 check(s) failed\r\nmutant 9 (valid bit set by unaccepted pairs): FAIL 11023 check(s) failed\r\nmutant 10 (wrong data source): FAIL 1818 check(s) failed\r\nmutant 11 (EN_readMem held during drain): FAIL 2240 check(s) failed\r\nmutant 12 (write-pointer carry one step early): FAIL 259 check(s) failed\r\nmutant 13 (adder carry-in error (mult_pipe)): FAIL 1981 check(s) failed\r\nkilled 13 of 13 mutants\r\nmutant 9 (valid bit set by unaccepted pairs): FAIL 7987 check(s) failed\r\nmutant 10 (wrong data source): FAIL 1818 check(s) failed\r\nmutant 11 (EN_readMem held during drain): FAIL 2158 check(s) failed\r\nkilled 11 of 11 mutants\r\n"]
[23294.447, "o", "\u001b[1;32m$\u001b[0m for R in 400 800; do make synth check sim timing power f14 RUN=$R 2>&1 | grep -E \"^(worst slack|tns|cell area|ALL PASS|F14CHECK|fill|drain|run:|synthesis)|summary|rror\"; make timing_fail RUN=$R 2>&1 | grep -E \"^worst slack max|timing_fail:\"; done; for R in 400 800; do bash submission/scripts/waves/waves.sh $R 2>&1 | grep \"^waves\"; done\r\nworst slack max 0.263\r\nworst slack min 0.061\r\ntns max 0.000\r\ncell area 2449.594 um^2 (sequential 637.602 um^2, 1518 instances)\r\n==== mkMultBuff_tb summary (seed=402, period=2.500 ns, latency=3, cycles=5856) ====\r\nALL PASS\r\n==== mkMultBuff_tb summary (seed=402, period=2.500 ns, latency=3, cycles=5856) ====\r\nALL PASS\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 3, 894 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nsynthesis estimate (vectorless, activity 0.1)         433.89    162.91     36.55    633.36\r\nrun: window whole run                                 433.69    174.52     36.50    644.71\r\nfill: window 521250..681250 ps                        876.45    684.23     38.93   1599.60\r\ndrain: window 688750..848750 ps                       317.23     26.92     35.81    379.96\r\nF14CHECK: flops 141, reset-gated 141 (of which reset-to-1 1), NOT reset-gated 0: \r\nworst slack max -0.675\r\ntiming_fail: checker reported TIMING FAIL as expected\r\nworst slack max 0.140\r\nworst slack min 0.041\r\ntns max 0.000\r\ncell area 4017.930 um^2 (sequential 2000.852 um^2, 2167 instances)\r\n==== mkMultBuff_tb summary (seed=402, period=1.250 ns, latency=6, cycles=5894) ====\r\nALL PASS\r\n==== mkMultBuff_tb summary (seed=402, period=1.250 ns, latency=6, cycles=5894) ====\r\nALL PASS\r\n==== mkMultBuff_sdf_checker_800 summary: period 1.250 ns, seed 402, latency 6, 912 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nsynthesis estimate (vectorless, activity 0.1)        1913.60    218.31     54.67   2186.60\r\nrun: window whole run                                2082.50    354.08     55.33   2491.90\r\nfill: window 268125..348125 ps                       3099.50   1372.30     58.25   4530.00\r\ndrain: window 355625..435625 ps                      1857.40     33.65     54.50   1945.60\r\nF14CHECK: flops 442, reset-gated 442 (of which reset-to-1 2), NOT reset-gated 0: \r\nworst slack max -0.951\r\ntiming_fail: checker reported TIMING FAIL as expected\r\nwaves 400: first write 21250 ps, drain start 181250 ps, drain end 341250 ps\r\nwaves 800: first write 14375 ps, drain start 94375 ps, drain end 174375 ps\r\n"]
[23319.919, "o", "\u001b[1;32m$\u001b[0m cat >> notes/WORKLOG.md <<'EOF'\r\n\r\n**Bit-level tree worker (b), `build/cand800b/`.** The generator `gen_tree.py`, now `submission/scripts/gen_tree.py`, emits a drop-in mult_pipe with Booth PPs and a Dadda or Wallace bit-level tree.\r\n\r\n*Booth matrix (144 bits, height 9, 4 levels):*\r\n\r\n| tree | FA/HA | cutsets after L1/L2/L3/L4 |\r\n|---|---|---|\r\n| Dadda | 91/22 | 132/104/84/60 |\r\n| Wallace | 92/55 | 112/86/69/59 |\r\n| Wallace, no HA on short columns | 100/20 | 112/84/65/52 |\r\n\r\nWallace reduces bits earlier, so its mid-tree cutsets are narrower, which is what pipelining needs.\r\n\r\n*Best results in our flow:*\r\n- 800 MHz, w24r3gt5re: 6 ranks, 431 flops, +0.096 ns, 3951 \u00b5m\u00b2, vectorless 2155 \u00b5W.\r\n- 400 MHz, w4r3cpa: 3 ranks, 141 flops, +0.151 ns.\r\n- 800 MHz combined with e18's control (build/cand800c/combo): 420 flops, +0.085 ns.\r\n\r\n**Sign-off of the candidates** (all meet timing, all pass SDF simulation):\r\n\r\n| check | 400 area / power / WNS | 800 area / power / WNS |\r\n|---|---|---|\r\n| previous designs | 2752.1 / 224.6 / 156 | 5674.5 / 1121.9 / 148 |\r\n| c400-p1c4 | 2648.1 / 218.6 / 441 | (old 800) |\r\n| c800-e18 | (p1c4) | **4416.2 / 829.7 / 158** |\r\n| c-wallace (w4r3cpa + w24r3gt5re) | **2660.8 / 215.2 / 203** | 4192.6 / 922.4 / 91 |\r\n| c-combo (w4r3cpa + Wallace tree, e18 control) | 2660.8 / 215.2 / 203 | 4192.9 / 929.8 / 90 |\r\n\r\nUnits: area \u00b5m\u00b2, power \u00b5W, WNS ps.\r\n\r\n**Decision.** Area and power disagree, so I took the sum of the relative changes in area and power:\r\n- 800 MHz: Wallace is \u22125.1 % area but +11.2 % power against e18, so **e18** wins.\r\n- 400 MHz: Wallace is +0.5 % area and \u22121.6 % power against p1c4, so **w4r3cpa** wins, with 8 fewer flops.\r\n\r\nThe Wallace 800 MHz design probably loses on vectorless power because its bit-level XOR network is larger: 100 FA + 26 HA against e18's row tree, and vectorless analysis charges every cell at default activity. The control simplification (\u221211 flops) did not change the sign-off area at all (the commercial flow probably merges the duplicates itself).\r\n\r\n**Final RTL.**\r\n- *rtl_400:* w4r3cpa, regenerated from `submission/scripts/gen_tree.py --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9` (identical body); top unchanged except the header.\r\n- *rtl_800:* e18's parameterised mult_pipe (header documents the new options) under a cleaned top with only the chosen control (31 flops, same function as e18).\r\n- *Makefile:* the 400 knobs become the 800 knobs.\r\n- *Mutation test:* new 800 MHz mutant set, 13/13 killed; 400 still 11/11.\r\n\r\n**Full flow on the final designs:**\r\n\r\n| | 400 MHz | 800 MHz |\r\n|---|---|---|\r\n| WNS | +0.263 ns | +0.140 ns |\r\n| area (seq) | 2449.6 \u00b5m\u00b2 (637.6) | 4017.9 \u00b5m\u00b2 (2000.9) |\r\n| flops | 141 | 442 |\r\n| vectorless | 633.4 \u00b5W | 2186.6 \u00b5W |\r\n| run / fill / drain | 644.7 / 1599.6 / 380.0 \u00b5W | 2491.9 / 4530.0 / 1945.6 \u00b5W |\r\n| check / sim / timing | ALL PASS | ALL PASS |\r\n| F14 | 141/141 | 442/442 |\r\n| timing_fail | TIMING FAIL (\u22120.675 ns) | TIMING FAIL (\u22120.951 ns) |\r\n\r\nWaveforms were regenerated.\r\nEOF\r\ngit add -A submission notes Makefile && git commit -q -m \"Round 3: final RTL (400 MHz Wallace tree, 141 flops; 800 MHz 6-rank row tree with carry-increment adder, 442 flops), flow and mutation updates\r\n\r\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\r\nClaude-Session: https://claude.ai/code/session_0126GMUJKG14LrQMZ4a6y2it\" && git push -q origin claude/focused-dijkstra-3f079i 2>&1 | tail -1; git push -q origin HEAD:refs/heads/check/final 2>&1 | tail -1; git log --oneline -1; git status --short | wc -l\r\nremote: \r\nefbfecd Round 3: final RTL (400 MHz Wallace tree, 141 flops; 800 MHz 6-rank row tree with carry-increment adder, 442 flops), flow and mutation updates\r\n0\r\n"]
[23329.68, "o", "\u001b[1;32m$\u001b[0m (until git fetch -q origin check-results 2>/dev/null && git ls-tree --name-only origin/check-results results/ | grep -q \"final\"; do sleep 30; done) > /dev/null 2>&1 & for r in 400 800; do echo \"== $r\"; build/exp/path.sh submission/syn_reports/$r/sta.rpt | sed -n '3,30p' | grep -v \"data arrival\\|^ *-\"; s=$(build/exp/path.sh submission/syn_reports/$r/sta.rpt | sed -n 3p | cut -d/ -f1); e=$(grep -m1 \"^Endpoint\" submission/syn_reports/$r/sta.rpt | awk '{print $2}'); for i in $s $e; do grep -A3 \" $i (\" submission/outputs/mkMultBuff_${r}_map.v | grep -o \"\\.Q([^)]*)\"; done; awk '/^Startpoint/{n++} n==1' submission/syn_reports/$r/sta.rpt | grep -E \"library setup|data arrival\" | head -2; sort -k3 -n submission/syn_reports/$r/ranks.rpt 2>/dev/null | head -3; done\r\n== 400\r\n_2965_/Q (DFF_X1) fo=1 d=0.344 t=0.344\r\n_1820_/Z (BUF_X4) fo=9 d=0.101 t=0.445\r\n_2386_/ZN (AOI22_X2) fo=2 d=0.216 t=0.661\r\n_2387_/Z (XOR2_X2) fo=5 d=0.281 t=0.942\r\n_2434_/ZN (XNOR2_X2) fo=1 d=0.166 t=1.108\r\n_2435_/ZN (XNOR2_X2) fo=1 d=0.133 t=1.240\r\n_2436_/ZN (XNOR2_X1) fo=4 d=0.180 t=1.420\r\n_2445_/ZN (AND3_X1) fo=1 d=0.205 t=1.626\r\n_2446_/ZN (NAND3_X2) fo=3 d=0.076 t=1.702\r\n_2457_/ZN (AOI21_X2) fo=1 d=0.114 t=1.816\r\n_2458_/ZN (OAI21_X2) fo=2 d=0.067 t=1.883\r\n_2467_/Z (XOR2_X1) fo=1 d=0.185 t=2.068\r\n_2468_/ZN (NOR2_X1) fo=1 d=0.104 t=2.173\r\nslack (MET) fo=0.263 d= t=\r\n.Q(\\u_mult.two_q [0])\r\n.Q(\\u_mult.prod [7])\r\n                                     2.173   data arrival time\r\n                           -0.065    2.435   library setup time\r\n== 800\r\n_4228_/Q (DFF_X1) fo=3 d=0.470 t=0.470\r\n_3013_/ZN (NAND3_X4) fo=4 d=0.124 t=0.594\r\n_3432_/ZN (AOI21_X4) fo=3 d=0.128 t=0.722\r\n_3433_/ZN (NAND3_X2) fo=1 d=0.070 t=0.791\r\n_3434_/Z (XOR2_X1) fo=1 d=0.193 t=0.984\r\n_3435_/ZN (NOR2_X2) fo=1 d=0.072 t=1.056\r\nslack (MET) fo=0.140 d= t=\r\n.Q(\\u_mult.genblk9.genblk1.g_cinc.bpq [3])\r\n.Q(writeMem_val[19])\r\n                                     1.057   data arrival time\r\n                           -0.054    1.196   library setup time\r\n"]
[23337.205, "o", "\u001b[1;32m$\u001b[0m sed -n 1,20p submission/rtl_400/mult_pipe.sv; grep -n \"always_ff\" submission/rtl_400/mult_pipe.sv | head; grep -n \"prod\\b\\|prod <=\\|prod\\[\" submission/rtl_400/mult_pipe.sv | head\r\n// mult_pipe.sv -- GENERATED by submission/scripts/gen_tree.py; edit the generator, not this file.\r\n// generator arguments: --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9\r\n//\r\n// Pipelined signed 16x16 multiplier: radix-4 Booth partial products (8 rows of 17\r\n// bits, classic sign extension {~s0,s0,s0} / {1,~si}, the +1 of each negative row as\r\n// a separate bit), bit-level column compression (wallace cuts after levels 4),\r\n// final adder: single-stage Kogge-Stone.\r\n// Register ranks (latency from 'en' to 'p'): 3; datapath flops 123:\r\n//   R1 operands + Booth digits: 40 flops\r\n//   S2: low columns resolved below 8 by ripple (7 adders)\r\n//   R2 after level 4: 100 FA 20 HA, model arrival 1.81, 51 flops\r\n//   R3 product: 32 flops\r\n// Full adders 101, half adders 26. Constant bits are never registered.\r\n// Every register has a synchronous active-low reset (SPEC F14); the operand register\r\n// loads zeros when en = 0 (operand isolation).\r\nmodule mult_pipe (\r\n    input  logic               clk,\r\n    input  logic               RST_N,\r\n    input  logic               en,     // accept: load operands, else load zeros\r\n    input  logic signed [15:0] a,      // multiplicand (unregistered input)\r\n40:    always_ff @(posedge clk) begin\r\n987:    always_ff @(posedge clk) begin\r\n1044:    always_ff @(posedge clk) begin\r\n49:    logic [31:0] prod;\r\n984:    assign prod = {x913, x912, x911, x910, x909, x908, x907, x906, x905, x904, x903, x902, x901, x900, x899, x898, x897, x896, x895, x894, x893, x892, x891, x540, r2[7], r2[6], r2[5], r2[4], r2[3], r2[2], r2[1], r2[0]};\r\n1046:        else        p <= prod;\r\n"]
[23357.124, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/submission/pdf_report/src && cat > dp400.dot <<'EOF'\r\ndigraph dp400 {\r\n  rankdir=TB; newrank=true; bgcolor=white; nodesep=0.25; ranksep=0.3;\r\n  node [fontname=\"Helvetica\", fontsize=10];\r\n  in [shape=plaintext, label=\"mult_input0 (a), mult_input1 (b)\\nEN_mult & RDY_mult\"];\r\n  enc [shape=box, style=rounded, label=\"Booth radix-4\\nrecode b\\n+ operand isolation\"];\r\n  r1 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"Rank 1 (40)\\na 16b + digits 24b\"];\r\n  tree [shape=box, style=rounded, label=\"select 8 PP rows,\\nWallace bit-level\\ncompression, 4 levels\\n(low 8 columns resolved)\"];\r\n  r2 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"Rank 2 (51)\\ntwo rows +\\nresolved low bits\"];\r\n  cpa [shape=box, style=rounded, label=\"carry-propagate\\nadder\"];\r\n  r3 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"Rank 3 (32)\\nproduct\"];\r\n  out [shape=plaintext, label=\"writeMem_val, EN_writeMem = v[2]\"];\r\n  in -> enc -> r1 -> tree -> r2 -> cpa -> r3 -> out;\r\n  {rank=same; enc; r1;} {rank=same; tree; r2;} {rank=same; cpa; r3;}\r\n}\r\nEOF\r\ncat > dp800.dot <<'EOF'\r\ndigraph dp800 {\r\n  rankdir=TB; newrank=true; bgcolor=white; nodesep=0.2; ranksep=0.22;\r\n  node [fontname=\"Helvetica\", fontsize=9];\r\n  in [shape=plaintext, label=\"a, b, EN_mult & RDY_mult\"];\r\n  enc [shape=box, style=rounded, label=\"Booth recode b\\n+ isolation\"];\r\n  r1 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R1 (40)\\na + digits\"];\r\n  pp [shape=box, style=rounded, label=\"select\\n8 PP rows\"];\r\n  r2 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R2 (144)\\n8x17b PP + 8 '+1'\"];\r\n  c12 [shape=box, style=rounded, label=\"3:2 levels 1-2\\n9->6->4 rows\\n(late input last)\"];\r\n  r3 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R3 (92)\\n4 rows\"];\r\n  c34 [shape=box, style=rounded, label=\"3:2 levels 3-4\\n4->3->2 rows\"];\r\n  r4 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R4 (60)\\n2 rows\"];\r\n  ca [shape=box, style=rounded, label=\"4-bit block sums\\n(carry-in 0),\\nblock carry-outs\\n(carry-in 0 and 1)\"];\r\n  r5 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R5 (43)\"];\r\n  cb [shape=box, style=rounded, label=\"block-carry prefix\\n+ increment select\"];\r\n  r6 [shape=box, style=filled, fillcolor=\"#dde8f5\", label=\"R6 (32)\\nproduct\"];\r\n  out [shape=plaintext, label=\"writeMem_val\\nEN_writeMem = v[5]\"];\r\n  in -> enc -> r1 -> pp -> r2 -> c12 -> r3 -> c34 -> r4 -> ca -> r5 -> cb -> r6 -> out;\r\n  {rank=same; enc; r1;} {rank=same; pp; r2;} {rank=same; c12; r3;} {rank=same; c34; r4;} {rank=same; ca; r5;} {rank=same; cb; r6;}\r\n}\r\nEOF\r\nfor f in dp400 dp800; do dot -Tpng -Gdpi=150 $f.dot -o ../fig/$f.png; done; sed -i 's|v\\[2\\]|v[2]|' dp400.dot; echo ok\r\nok\r\n"]
[23365.053, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open && git fetch -q origin check-results && for d in $(git ls-tree --name-only origin/check-results results/ | grep final); do git show origin/check-results:$d/scorecard.md | sed -n '3p;/^| GPDK/p;/^| Gate/p;/^| 400 MHz netlist/p'; done; date -u +%H:%M\r\n09:03\r\n"]
[23460.693, "o", "\u001b[2m# write /home/user/elec402-p2-open/submission/pdf_report/src/report.md\u001b[0m\r\n"]
[23483.84, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/pdf_report/src/report.md'\r\ns=open(p).read()\r\nrep=[(\"| Slow stacked cells and MUX2 excluded from mapping, correct ABC load | 800 MHz \u22120.61 \u2192 +0.15 ns, \u2212612 \u00b5m\u00b2 |\",\r\n\"| Slow stacked cells, then MUX2, excluded from mapping | 800 MHz \u22120.61 \u2192 \u22120.44 ns, \u22120.034 \u2192 +0.051 ns |\\n| Correct ABC output load (1 fF flip-flop input) | 800 MHz \u2212612 \u00b5m\u00b2 |\"),\r\n(\"| 800 MHz: 3:2 inputs ordered by arrival, level-1 rank removed | \u2212117 flops of rank, +92 for the new rank |\",\r\n\"| 800 MHz: 3:2 inputs ordered by arrival, two levels per stage | carry-save ranks 117 + 76 + 60 \u2192 92 + 60 flops |\"),\r\n(\"| 800 MHz: split pointers, drain start from the valid bits | control 44 \u2192 31 flops |\",\"| 800 MHz: split pointers, drain start from the valid bits | control 43 \u2192 31 flops |\"),\r\n(\"At 800 MHz it uses 31 flops, down from 44.\",\"At 800 MHz it uses 31 flops, down from 43.\"),\r\n(\"missed the 125 ps target at 400 MHz by 15 to 50 ps\",\"missed the 125 ps target at 400 MHz by 15 to 52 ps\")]\r\nfor a,b in rep:\r\n    assert a in s, a[:40]\r\n    s=s.replace(a,b)\r\nopen(p,'w').write(s)\r\nEOF\r\ngit fetch -q origin check-results && git ls-tree --name-only origin/check-results results/ | grep final\r\n\r\n"]
