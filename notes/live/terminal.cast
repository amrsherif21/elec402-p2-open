[20643.972, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && grep -n \"^gp_in_tree\" -A 14 gen_tree.py; grep -n 'choices=\\[\"tree\", \"cpa\"\\]' gen_tree.py; grep -n 'args.gp == \"tree\"' gen_tree.py\r\n421:gp_in_tree = not all(r == 0.0 or r == CONST_T for c in cols for (e, r) in c)\r\n422-if gp_in_tree:\r\n423-    # the tree's last level and p/g share a stage: register p/g\r\n424-    ex = [x for p_, g_ in pg for x in (p_, g_)]\r\n425-    mg, ng_ = register(f\"r{stage}\", ex)\r\n426-    summary.append(f\"R{stage} tree end, p/g per column (model arrival {tree_last_arr + DX:.2f}): {ng_} flops\")\r\n427-    ranks.append(ng_)\r\n428-    pg = [(mg[p_], mg[g_]) for p_, g_ in pg]\r\n429-    tp = {}\r\n430-    stage += 1\r\n431-    emit_stage_comment(f\"stage {stage}: final adder\")\r\n432-\r\n433-tpr = [tp.get(c, pg[c][0]) for c in range(W)]   # registered p/g: p itself\r\n434-lo_c = 0\r\n435-while lo_c < W and pg[lo_c][1] == ZERO:\r\n31:ap.add_argument(\"--gp\", default=\"tree\", choices=[\"tree\", \"cpa\"], help=\"where p = x^y, g = x&y is formed\")\r\n355:            if last and args.gp == \"tree\":\r\n379:        if done and args.gp == \"tree\":\r\n"]
