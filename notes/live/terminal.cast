[2268.747, "o", "\u001b[1;32m$\u001b[0m sed -i 's/^puts \"F14CHECK/yosys log \"F14CHECK/' build/cand_retime/src/f14check.tcl && sed -i 's/set ok 0; set bad {}/set ok 0; set bad {}\\nyosys log \"F14DBG [llength $nets] [lrange $nets 0 3]\"/' build/cand_retime/src/f14check.tcl && build/cand_retime/src/f14.sh build/cand_retime/ref400.v; grep F14DBG build/cand_retime/ref400.f14.log; cat build/cand_retime/*.out\r\nF14CHECK: flops 0, distinct D nets 0, reset-gated 0, NOT reset-gated 0\r\nF14DBG 0 \r\nRT: re-added reset to 0 rmult flops\r\nyosys 3s\r\nsdf_typmax: 29151 delay triples set to typ = max -> build/cand_retime/b1_r5_fix/map.sdf\r\nworst slack max -0.300\r\nworst slack min 0.073\r\ntns max -21.055\r\nTotal                2.4799e-03 7.1554e-04 8.8915e-05 3.2844e-03 100.0%\r\ncell area 5235.146 um^2 (sequential 2091.558 um^2, 2260 instances)\r\nyosys 3s\r\nsdf_typmax: 28777 delay triples set to typ = max -> build/cand_retime/b1_r5_naive/map.sdf\r\nworst slack max -0.431\r\nworst slack min 0.042\r\ntns max -38.248\r\nTotal                2.3331e-03 6.1909e-04 8.9826e-05 3.0420e-03 100.0%\r\ncell area 5352.452 um^2 (sequential 1965.208 um^2, 2410 instances)\r\n"]
