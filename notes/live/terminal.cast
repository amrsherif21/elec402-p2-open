[2258.68, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime/src && sed -i '/rename/d' f14check.tcl && cat > f14.sh <<'EOF'\r\n#!/usr/bin/env bash\r\n# f14.sh NETLIST -- SAT check that every flop's D is forced to 0 by RST_N = 0\r\ncd /home/user/elec402-p2-open\r\nN=$1; S=${N%.v}.f14in.v\r\npython3 - \"$N\" \"$S\" <<'PY'\r\nimport re, sys\r\nt = open(sys.argv[1]).read()\r\nt = re.sub(r'\\\\(\\S+)(\\s)', lambda m: 'e_' + re.sub(r'\\W', '_', m.group(1)) + m.group(2), t)\r\nopen(sys.argv[2], 'w').write(t)\r\nPY\r\nIMG=openroad/orfs@sha256:d3505fd5f930fcd20d3d25a41f3047230b7db7b7797e3448561c9e556cca3774\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$S $IMG \\\r\n  /OpenROAD-flow-scripts/tools/install/yosys/bin/yosys -q -l ${N%.v}.f14.log -c build/cand_retime/src/f14check.tcl >/dev/null 2>&1\r\ngrep F14CHECK ${N%.v}.f14.log || tail -3 ${N%.v}.f14.log\r\nEOF\r\ncd /home/user/elec402-p2-open && time build/cand_retime/src/f14.sh build/cand_retime/ref400.v; grep -c DFF_X build/cand_retime/ref400.v\r\nEnd of script. Logfile hash: baff93d5bd, time: 0.23s, user: 0.16s, system: 0.04s, MEM: 41.45 MB peak\r\nYosys 0.68+post (git sha1 UNKNOWN, Release, GNU /usr/local/bin/wrapped-cc/g++ 15.2.0)\r\nTime spent: 40% 2x read_verilog (0 sec), 25% 1x opt_clean (0 sec), ...\r\n\r\nreal\t0m0.866s\r\nuser\t0m0.048s\r\nsys\t0m0.018s\r\n166\r\n"]
