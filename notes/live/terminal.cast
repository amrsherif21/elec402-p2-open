[2194.609, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && sed -i 's|os.makedirs(args.outdir, exist_ok=True)|args.outdir = os.path.join(args.outdir, \"rtl\"); os.makedirs(args.outdir, exist_ok=True)|' gen.py && cd ../.. && D=build/cand_dadda/v1; time make synth RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 2>&1 | tail -6\r\nsdf_typmax: 31365 delay triples set to typ = max -> build/cand_dadda/v1/map.sdf\r\nworst slack max -0.195\r\nworst slack min 0.076\r\ntns max -3.179\r\nTotal                2.4199e-03 2.1354e-04 8.2563e-05 2.7160e-03 100.0%\r\ncell area 5768.210 um^2 (sequential 2555.196 um^2, 2988 instances)\r\n\r\nreal\t0m21.754s\r\nuser\t0m0.121s\r\nsys\t0m0.100s\r\n"]
[2199.516, "o", "\u001b[1;32m$\u001b[0m D=build/cand_dadda/v1; bash build/exp/path.sh $D/rep/sta.rpt; grep -B2 -A0 \"slack (VIOLATED)\" $D/rep/sta.rpt | head; grep -E \"^Startpoint|^Endpoint\" $D/rep/sta.rpt | head -8\r\nby clk) fo=Startpoint: d=edge-triggered t=flip-flop\r\nby clk) fo=Endpoint: d=edge-triggered t=flip-flop\r\n_5940_/Q (DFF_X2) fo=6 d=0.682 t=0.682\r\n_4610_/ZN (AND3_X4) fo=2 d=0.190 t=0.873\r\n_4620_/ZN (NAND4_X4) fo=2 d=0.095 t=0.968\r\n_4621_/ZN (INV_X4) fo=2 d=0.072 t=1.040\r\n_4622_/ZN (AOI21_X2) fo=1 d=0.040 t=1.080\r\n_4623_/ZN (AOI211_X2) fo=1 d=0.224 t=1.304\r\n_4624_/Z (BUF_X1) fo=1 d=0.096 t=1.400\r\n                                     1.400   data arrival time\r\n                           -0.044    1.206   library setup time\r\n                                    -1.400   data arrival time\r\nslack (VIOLATED) fo=-0.195 d= t=\r\n                                    -1.400   data arrival time\r\n---------------------------------------------------------------------------------\r\n                                    -0.195   slack (VIOLATED)\r\n--\r\n                                    -1.357   data arrival time\r\n---------------------------------------------------------------------------------\r\n                                    -0.194   slack (VIOLATED)\r\n--\r\n                                    -1.356   data arrival time\r\n---------------------------------------------------------------------------------\r\nStartpoint: _5940_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5951_ (rising edge-triggered flip-flop clocked by clk)\r\nStartpoint: _5804_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5920_ (rising edge-triggered flip-flop clocked by clk)\r\nStartpoint: _5811_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5930_ (rising edge-triggered flip-flop clocked by clk)\r\nStartpoint: readMem_val[0] (input port clocked by clk)\r\nEndpoint: memVal_data[0] (output port clocked by clk)\r\n"]
[2199.518, "o", "\u001b[1;32m$\u001b[0m sed -i '44s/-liberty $lib -script/-liberty $maplib -script/; 38s/set_driving_cell DFF_X1/set_driving_cell BUF_X1/' submission/scripts/synth.tcl && sed -n '36,46p' submission/scripts/synth.tcl && (MAPLIB=build/exp/lib_du1.lib SEL=1 CSL=1 PRE=1 build/exp/run.sh k800a 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib PRE=1 build/exp/run.sh k400 2.5 0 0100 0 2000 0 kogge-stone & wait) 2>&1 | grep -v Warning; PRE=1 build/exp/run.sh k400b 2.5 0 0100 0 2000 0 kogge-stone 2>&1 | grep -v Warning\r\n# constraint file gives ABC the input drive and the output load of SPEC Section 6\r\nset cf [open [file rootname $out].abc.constr w]\r\nputs $cf \"set_driving_cell BUF_X1\\nset_load 23.5\"\r\nclose $cf\r\nset abc_script [expr {[info exists ::env(ABC_SCRIPT)] ? $::env(ABC_SCRIPT) : \"submission/scripts/abc_speed.script\"}]\r\nif {$abc_script eq \"default\"} {\r\n    abc -D $abc_d -liberty $maplib -constr [file rootname $out].abc.constr\r\n} else {\r\n    abc -D $abc_d -liberty $maplib -script $abc_script -constr [file rootname $out].abc.constr\r\n}\r\nfile delete [file rootname $out].abc.constr\r\nk400 P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2543.226000 rsz_area=2563 wns=0.075 whs=0.053 pwr_est=6.7505e-04\r\nk800a P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5282.228000 rsz_area=5573 wns=-0.440 whs=0.020 pwr_est=2.9980e-03\r\nk400b P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2533.384000 rsz_area=2571 wns=-0.046 whs=0.053 pwr_est=6.7538e-04\r\n"]
[2203.94, "o", "\u001b[1;32m$\u001b[0m D=build/cand_dadda/v1; awk '/^Startpoint/{n++} n==1' $D/rep/sta.rpt | head -60; grep -A8 \"DFF_X2 _5940_\\|DFF_X1 _5951_\\|DFF_X2 _5951_\\|DFF_X1 _5940_\" $D/map.v | head -20\r\nStartpoint: _5940_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5951_ (rising edge-triggered flip-flop clocked by clk)\r\nPath Group: clk\r\nPath Type: max\r\n\r\nFanout      Cap     Slew    Delay     Time   Description\r\n---------------------------------------------------------------------------------\r\n                   0.156    0.000    0.000   clock clk (rise edge)\r\n                            0.000    0.000   clock network delay (ideal)\r\n                   0.156    0.000    0.000 ^ _5940_/CK (DFF_X2)\r\n     6   58.092    0.237    0.682    0.682 ^ _5940_/Q (DFF_X2)\r\n                   0.237    0.000    0.682 ^ _4610_/A1 (AND3_X4)\r\n     2    8.260    0.038    0.190    0.873 ^ _4610_/ZN (AND3_X4)\r\n                   0.038    0.000    0.873 ^ _4620_/A4 (NAND4_X4)\r\n     2    8.793    0.080    0.095    0.968 v _4620_/ZN (NAND4_X4)\r\n                   0.080    0.000    0.968 v _4621_/A (INV_X4)\r\n     2    6.795    0.034    0.072    1.040 ^ _4621_/ZN (INV_X4)\r\n                   0.034    0.000    1.040 ^ _4622_/B1 (AOI21_X2)\r\n     1    3.263    0.044    0.040    1.080 v _4622_/ZN (AOI21_X2)\r\n                   0.044    0.000    1.080 v _4623_/B (AOI211_X2)\r\n     1    1.244    0.113    0.224    1.304 ^ _4623_/ZN (AOI211_X2)\r\n                   0.113    0.000    1.304 ^ _4624_/A (BUF_X1)\r\n     1    1.402    0.023    0.096    1.400 ^ _4624_/Z (BUF_X1)\r\n                   0.023    0.000    1.400 ^ _5951_/D (DFF_X2)\r\n                                     1.400   data arrival time\r\n\r\n                   0.156    1.250    1.250   clock clk (rise edge)\r\n                            0.000    1.250   clock network delay (ideal)\r\n                            0.000    1.250   clock reconvergence pessimism\r\n  