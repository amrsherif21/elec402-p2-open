[21632.625, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && grep -n \"WALLACE_HA_MIN\" gen_tree.py && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\ns = s.replace(\"        if len(bits) == 2 and len(cols[c]) >= WALLACE_HA_MIN:\", \"        if len(bits) == 2 and len(cols[c]) >= ha_min:\")\r\ns = s.replace(\"def level_wallace(cols):\", \"def level_wallace(cols, ha_min=WALLACE_HA_MIN):\")\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--rawlevels\", type=int, default=0, help=\"wallace: in the first N levels no half adder in columns of height <= 2\")\\nap.add_argument(\"--stats\"')\r\ns = s.replace(\"\"\"        else:\r\n            cols, nf, nh = level_wallace(cols)\r\n        sf += nf; sh += nh\"\"\", \"\"\"        else:\r\n            cols, nf, nh = level_wallace(cols, 3 if lv <= args.rawlevels else 2)\r\n        sf += nf; sh += nh\"\"\")\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor r in 0 1 2 3; do python3 gen_tree.py /dev/null --mode wallace --cuts 2,4 --gp gt --k0 4 --k 4 --bpair --rawlevels $r | grep \"LAT\\|R3\\|R4\\|R5\"; done\r\n173:WALLACE_HA_MIN = 2   # a leftover pair goes to a half adder in columns at least this high\r\n202:        if len(bits) == 2 and len(cols[c]) >= WALLACE_HA_MIN:\r\nLAT=6 ranks=[40, 144, 86, 58, 42, 32] datapath flops=402 FA=92 HA=55\r\n  R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n  R4 tree end, generate / transmit per column (model arrival 0.78): 58 flops\r\n  R5 adder stage A (cinc, blocks [(4, 8), (8, 12), (12, 16), (16, 20), (20, 24), (24, 28), (28, 32)]): 42 flops\r\nLAT=6 ranks=[40, 144, 84, 58, 44, 32] datapath flops=402 FA=93 HA=48\r\n  R3 after level 2: 67 FA 18 HA, model arrival 0.72, 84 flops\r\n  R4 tree end, generate / transmit per column (model arrival 0.78): 58 flops\r\n  R5 adder stage A (cinc, blocks [(3, 7), (7, 11), (11, 15), (15, 19), (19, 23), (23, 27), (27, 31), (31, 32)]): 44 flops\r\nLAT=6 ranks=[40, 144, 84, 56, 44, 32] dat