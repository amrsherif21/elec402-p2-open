[833.539, "o", "\u001b[1;32m$\u001b[0m sed -i 's/localparam int LAT = .*/localparam int LAT = `LATM;/' tb_mult.sv && for cfg in \"0 4'b1000 0 1\" \"1 4'b0101 1 4\" \"0 4'b0011 0 3\" \"1 4'b1111 1 6\"; do set -- $cfg; iverilog -g2012 -DENC=$1 -DCSA=$2 -DSPL=$3 -DLATM=$4 -o m.vvp tb_mult.sv mult_pipe.sv 2>&1 | head -5 && vvp -n m.vvp | tail -2; done\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nLAT=1 checked=200000 errors=199994\r\ntb_mult.sv:17: $finish called at 400003100 (1ps)\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nLAT=4 checked=200000 errors=199994\r\ntb_mult.sv:17: $finish called at 400009100 (1ps)\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nLAT=3 checked=200000 errors=199993\r\ntb_mult.sv:17: $finish called at 400007100 (1ps)\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nmult_pipe.sv:55: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nLAT=6 checked=200000 errors=199994\r\ntb_mult.sv:17: $finish called at 400013100 (1ps)\r\n"]
[964.68, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='mult_pipe.sv'\r\ns=open(p).read()\r\nstart=s.index('    // ------------------------------------------------------------------\\n    // Booth radix-4 recoding')\r\nend=s.index('    // ------------------------------------------------------------------\\n    // final carry-propagate adder')\r\nnew='''    // ------------------------------------------------------------------\r\n    // Booth radix-4 recoding of b: digit_i = -2 b[2i+1] + b[2i] + b[2i-1]\r\n    wire  [16:0] bx = {b, 1'b0};          // bx[k+1] = b[k], bx[0] = b[-1] = 0\r\n    logic [7:0]  one_d, two_d, neg_d;\r\n    genvar i;\r\n    generate for (i = 0; i < 8; i++) begin : g_enc_d\r\n        assign one_d[i] = bx[2*i+1] ^ bx[2*i];\r\n        assign two_d[i] = (bx[2*i+2] & ~bx[2*i+1] & ~bx[2*i]) | (~bx[2*i+2] & bx[2*i+1] & bx[2*i]);\r\n        assign neg_d[i] = bx[2*i+2];\r\n    end endgenerate\r\n\r\n    logic [7:0]  one_e, two_e, neg_e;\r\n    logic [15:0] a_e;\r\n    generate if (ENC_REG) begin : g_enc\r\n        always_ff @(posedge clk) begin\r\n            if (!RST_N) begin\r\n                one_e <= '0; two_e <= '0; neg_e <= '0; a_e <= '0;\r\n            end else begin\r\n                one_e <= one_d; two_e <= two_d; neg_e <= neg_d; a_e <= a;\r\n            end\r\n        end\r\n    end else begin : g_noenc\r\n        assign one_e = one_d; assign two_e = two_d; assign neg_e = neg_d; assign a_e = a;\r\n    end endgenerate\r\n\r\n    // ------------------------------------------------------------------\r\n    // Partial-product rows. Sign extension is replaced by inverting each row's\r\n    // sign bit and adding the constant K = -sum(2^(16+2i)) (mod 2^32); the\r\n    // \"+1\" of each negative row is placed in the free bit of the next row.\r\n    localparam logic [31:0] K = 32'hAAAB_0000;  // -(2^16+2^18+...+2^30) mod 2^32\r\n    wire [16:0] a17 = {a_e[15], a_e};\r\n    wire [16:0] a2  = {a_e, 1'b0};\r\n    logic [31:0] r0, r1, r2, r3, r4, r5, r6, r7, r8;\r\n    logic [16:0] pp [0:7];\r\n    logic [31:0] rw [0:7];\r\n    generate for (i = 0; i < 8; i++) begin : g_pp\r\n        assign pp[i] = (({17{one_e[i]}} & a17) | ({17{two_e[i]}} & a2)) ^ {17{neg_e[i]}};\r\n        if (i == 0) begin : g_r0\r\n            assign rw[i] = {15'd0, ~pp[i][16], pp[i][15:0]};\r\n        end else begin : g_ri\r\n            // bits [2i+16:2i] hold the row, bit 2i-2 holds the +1 of row i-1\r\n            assign rw[i] = 32'({~pp[i][16], pp[i][15:0], 1'b0, neg_e[i-1]}) << (2*i-2);\r\n        end\r\n    end endgenerate\r\n    assign {r0, r1, r2, r3, r4, r5, r6, r7} = {rw[0], rw[1], rw[2], rw[3], rw[4], rw[5], rw[6], rw[7]};\r\n    assign r8 = K | (32'(neg_e[7]) << 14);\r\n\r\n    // ------------------------------------------------------------------\r\n    // carry-save levels (3:2 compressors on whole rows); each optionally registered\r\n    function automatic logic [63:0] csa(input logic [31:0] x, y, z);\r\n        return {((x & y) | (x & z) | (y & z)) << 1, x ^ y ^ z};\r\n    endfunction\r\n\r\n    // level 1: 9 -> 6, level 2: 6 -> 4, level 3: 4 -> 3, level 4: 3 -> 2\r\n    logic [6*32-1:0] l1, l1q;\r\n    logic [4*32-1:0] l2, l2q;\r\n    logic [3*32-1:0] l3, l3q;\r\n    logic [2*32-1:0] l4, l4q;\r\n    assign l1 = {csa(r6, r7, r8), csa(r3, r4, r5), csa(r0, r1, r2)};\r\n    assign l2 = {csa(l1q[3*32 +: 32], l1q[4*32 +: 32], l1q[5*32 +: 32]),\r\n                 csa(l1q[0*32 +: 32], l1q[1*32 +: 32], l1q[2*32 +: 32])};\r\n    assign l3 = {l2q[3*32 +: 32], csa(l2q[0*32 +: 32], l2q[1*32 +: 32], l2q[2*32 +: 32])};\r\n    assign l4 = csa(l3q[0*32 +: 32], l3q[1*32 +: 32], l3q[2*32 +: 32]);\r\n\r\n    generate\r\n        if (CSA_REG[0]) begin : g_r1\r\n            always_ff @(posedge clk) l1q <= RST_N ? l1 : '0;\r\n        end else begin : g_n1\r\n            assign l1q = l1;\r\n        end\r\n        if (CSA_REG[1]) begin : g_r2\r\n            always_ff @(posedge clk) l2q <= RST_N ? l2 : '0;\r\n        end else begin : g_n2\r\n            assign l2q = l2;\r\n        end\r\n        if (CSA_REG[2]) begin : g_r3\r\n            always_ff @(posedge clk) l3q <= RST_N ? l3 : '0;\r\n        end else begin : g_n3\r\n            assign l3q = l3;\r\n        end\r\n        if (CSA_REG[3]) begin : g_r4\r\n            always_ff @(posedge clk) l4q <= RST_N ? l4 : '0;\r\n        end else begin : g_n4\r\n            assign l4q = l4;\r\n        end\r\n    endgenerate\r\n    wire [31:0] sx = l4q[31:0], sy = l4q[63:32];\r\n\r\n'''\r\ns=s[:start]+new+s[end:]\r\ns=s.replace(\"assign lo = {1'b0, l4q[0][15:0]} + {1'b0, l4q[1][15:0]};\",\"assign lo = {1'b0, sx[15:0]} + {1'b0, sy[15:0]};\")\r\ns=s.replace(\"xh_q <= l4q[0][31:16]; yh_q <= l4q[1][31:16];\",\"xh_q <= sx[31:16]; yh_q <= sy[31:16];\")\r\ns=s.replace(\"else        p <= l4q[0] + l4q[1];\",\"else        p <= sx + sy;\")\r\nopen(p,'w').write(s)\r\nEOF\r\nfor cfg in \"0 4'b1000 0 1\" \"1 4'b0101 1 4\" \"0 4'b0011 0 3\" \"1 4'b1111 1 6\"; do set -- $cfg; iverilog -g2012 -DENC=$1 -DCSA=$2 -DSPL=$3 -DLATM=$4 -o m.vvp tb_mult.sv mult_pipe.sv 2>&1 | head -5 && vvp -n m.vvp | tail -2 | head -1; done\r\nLAT=1 checked=200000 errors=199994\r\nLAT=4 checked=200000 errors=199994\r\nLAT=3 checked=200000 errors=199993\r\nLAT=6 checked=200000 errors=199994\r\n"]
[995.688, "o", "\u001b[1;32m$\u001b[0m cat > tb2.sv <<'EOF'\r\n`timescale 1ns/1ps\r\nmodule tb2;\r\n  logic clk=0, RST_N=1; logic signed [15:0] a,b; logic signed [31:0] p;\r\n  mult_pipe #(.ENC_REG(0), .CSA_REG(4'b0000), .CPA_SPLIT(0)) dut(.*);\r\n  initial begin\r\n    int e=0;\r\n    for (int t=0;t<100000;t++) begin\r\n      a=$urandom; b=$urandom; if (t<4) begin a = t==0 ? -32768 : 3; b = t==0? -32768 : t; end\r\n      #1 clk=1; #1 clk=0;\r\n      if (p !== a*b) begin e++; if (e<6) $display(\"a=%0d b=%0d p=%0d exp=%0d diff=%h\", a,b,p,a*b, p-a*b); end\r\n    end\r\n    $display(\"errors=%0d\",e);\r\n  end\r\nendmodule\r\nEOF\r\niverilog -g2012 -o t2.vvp tb2.sv mult_pipe.sv && vvp -n t2.vvp\r\ntb2.sv:6: warning: Static variable initialization requires explicit lifetime in this context.\r\nerrors=0\r\n"]
[1113.478, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\ns=open('tb_mult.sv').read()\r\ns=s.replace(\"      @(posedge clk);\\n      if (t>=LAT)\",\"      @(posedge clk); #0.5;\\n      if (t>=LAT)\")\r\ns=s.replace(\"#0.1 exp_q[t%16] = a*b;\",\"#0.1 exp_q[t%16] = a*b; // a,b now hold the values applied at this edge\")\r\nopen('tb_mult.sv','w').write(s)\r\nEOF\r\nfor cfg in \"0 4'b1000 0 1\" \"1 4'b0101 1 4\" \"0 4'b0011 0 3\" \"1 4'b1111 1 6\"; do set -- $cfg; iverilog -g2012 -DENC=$1 -DCSA=$2 -DSPL=$3 -DLATM=$4 -o m.vvp tb_mult.sv mult_pipe.sv 2>&1 | grep -v warning | head -3; vvp -n m.vvp | head -3 | grep -v finish; done\r\nERR t=1 p=0 exp=1073741824\r\nERR t=2 p=1073741824 exp=-1073709056\r\nERR t=3 p=-1073709056 exp=32768\r\nERR t=4 p=0 exp=1073741824\r\nERR t=5 p=1073741824 exp=-1073709056\r\nERR t=6 p=-1073709056 exp=32768\r\nLAT=3 checked=200000 errors=0\r\nERR t=6 p=0 exp=1073741824\r\nERR t=7 p=1073741824 exp=-1073709056\r\nERR t=8 p=-1073709056 exp=32768\r\n"]
[1145.047, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open && cat > build/exp/top.sv <<'EOF'\r\n// mkMultBuff.sv -- fill/drain buffer around the pipelined Booth multiplier.\r\nmodule mkMultBuff #(parameter N = 32) (\r\n    input  logic         clk,\r\n    input  logic         RST_N,\r\n    input  logic         EN_mult,\r\n    input  logic [15:0]  mult_input0,\r\n    input  logic [15:0]  mult_input1,\r\n    output logic         RDY_mult,\r\n    input  logic         EN_blockRead,\r\n    output logic         RDY_blockRead,\r\n    output logic         VALID_memVal,\r\n    output logic [N-1:0] memVal_data,\r\n    output logic         EN_writeMem,\r\n    output logic [5:0]   writeMem_addr,\r\n    output logic [N-1:0] writeMem_val,\r\n    output logic         EN_readMem,\r\n    output logic [5:0]   readMem_addr,\r\n    input  logic [N-1:0] readMem_val\r\n);\r\n    // multiplier pipeline configuration (see mult_pipe.sv)\r\n    localparam bit       ENC_REG   = `ENC;\r\n    localparam bit [3:0] CSA_REG   = `CSA;\r\n    localparam bit       CPA_SPLIT = `SPL;\r\n    localparam int       LAT_M     = ENC_REG + CSA_REG[0] + CSA_REG[1] + CSA_REG[2] + CSA_REG[3] + 1 + CPA_SPLIT;\r\n    localparam int       LAT       = 1 + LAT_M;   // operand register + multiplier\r\n\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q;\r\n    logic [5:0] acc_q, ptr_q;\r\n    logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\r\n    logic signed [15:0] a_q, b_q;\r\n    logic signed [31:0] p;\r\n\r\n    wire acc = EN_mult & rdy_mult_q;\r\n    wire rd  = EN_blockRead & rdy_rd_q;\r\n    wire wr  = v_q[LAT-1];\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0;\r\n            acc_q <= '0; ptr_q <= '0; v_q <= '0; a_q <= '0; b_q <= '0;\r\n        end else begin\r\n            a_q <= acc ? mult_input0 : 16'sd0;\r\n            b_q <= acc ? mult_input1 : 16'sd0;\r\n            v_q <= {v_q[LAT-2:0], acc};\r\n            if (acc) begin\r\n                acc_q <= acc_q + 6'd1;\r\n                if (acc_q == 6'd63) rdy_mult_q <= 1'b0;\r\n            end\r\n            if (wr | rd) ptr_q <= ptr_q + 6'd1;\r\n            if (wr && ptr_q == 6'd63) rdy_rd_q <= 1'b1;\r\n            if (rd && ptr_q == 6'd63) begin\r\n                rdy_rd_q <= 1'b0; rdy_mult_q <= 1'b1;\r\n            end\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n\r\n    mult_pipe #(.ENC_REG(ENC_REG), .CSA_REG(CSA_REG), .CPA_SPLIT(CPA_SPLIT))\r\n        u_mult (.clk(clk), .RST_N(RST_N), .a(a_q), .b(b_q), .p(p));\r\n\r\n    assign RDY_mult      = rdy_mult_q;\r\n    assign RDY_blockRead = rdy_rd_q;\r\n    assign EN_writeMem   = wr;\r\n    assign writeMem_addr = ptr_q;\r\n    assign writeMem_val  = p;\r\n    assign EN_readMem    = rd;\r\n    assign readMem_addr  = ptr_q;\r\n    assign VALID_memVal  = vld_q;\r\n    assign memVal_data   = readMem_val;\r\nendmodule : mkMultBuff\r\nEOF\r\ncat > submission/scripts/resize.tcl <<'EOF'\r\n# resize.tcl -- OpenROAD Resizer on the Yosys netlist (no placement): fix\r\n# slew/capacitance/fanout, then gate sizing and buffering for setup and hold,\r\n# timed with the library wire-load model. env: LIB, NETLIST_IN, NETLIST, PERIOD, PDK_LEF_DIR\r\nset period $::env(PERIOD)\r\nread_lef $::env(PDK_LEF_DIR)/NangateOpenCellLibrary.tech.lef\r\nread_lef $::env(PDK_LEF_DIR)/NangateOpenCellLibrary.macro.mod.lef\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST_IN)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nsource $::env(PDK_LEF_DIR)/../setRC.tcl\r\nset_dont_use {WELLTAP_X1 ANTENNA_X1 FILLCELL_* TBUF_* TINV_* CLKGATE* LOGIC* DLH_* DLL_* TLAT_*}\r\nputs \"== before: wns [sta::worst_slack_cmd max] area [rsz::design_area]\"\r\nreport_worst_slack -max\r\nrepair_design\r\nrepair_timing -setup -repair_tns 100 -setup_margin 0.0\r\nrepair_timing -hold -hold_margin 0.02\r\nreport_worst_slack -max\r\nreport_worst_slack -min\r\nreport_design_area\r\nwrite_verilog $::env(NETLIST)\r\nEOF\r\necho ok\r\nok\r\n"]
[1161.112, "o", "\u001b[1;32m$\u001b[0m sed -i 's|foreach f \\[lsort \\[glob submission/rtl_${run}/\\*.sv\\]\\]|set rtl_dir [expr {[info exists ::env(RTL_DIR)] ? $::env(RTL_DIR) : \"submission/rtl_${run}\"}]\\nforeach f [lsort [glob ${rtl_dir}/*.sv]]|' submission/scripts/synth.tcl && grep -n rtl_dir submission/scripts/synth.tcl && cat > build/exp/run.sh <<'EOF'\r\n#!/bin/bash\r\n# run.sh NAME PERIOD ENC CSA SPL ABC_D [BOOTH ADDER]  -- experiment: yosys + resizer + sta\r\nset -e\r\ncd /home/user/elec402-p2-open\r\nN=$1; P=$2; E=$3; C=$4; S=$5; D=$6\r\nD_DIR=build/exp/$N; mkdir -p $D_DIR/rtl\r\nsed \"s/\\`ENC/1'b$E/; s/\\`CSA/4'b$C/; s/\\`SPL/1'b$S/\" build/exp/top.sv > $D_DIR/rtl/mkMultBuff.sv\r\ncp build/exp/mult_pipe.sv $D_DIR/rtl/\r\nIMG_Y=openroad/orfs@sha256:d3505fd5f930fcd20d3d25a41f3047230b7db7b7797e3448561c9e556cca3774\r\nIMG_S=openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a\r\nDK=\"docker run --rm -v $PWD:$PWD -w $PWD\"\r\nLIB=tech/NangateOpenCellLibrary_slow.lib\r\n$DK -e RUN=x -e RTL_DIR=$D_DIR/rtl -e LIB=$LIB -e ABC_D=$D -e BOOTH=${7:-0} -e ADDER=${8:-sklansky} -e OUT=$D_DIR/syn.v $IMG_Y \\\r\n   /OpenROAD-flow-scripts/tools/install/yosys/bin/yosys -q -l $D_DIR/synth.log -c submission/scripts/synth.tcl >/dev/null\r\n$DK -e LIB=$LIB -e NETLIST_IN=$D_DIR/syn.v -e NETLIST=$D_DIR/rsz.v -e PERIOD=$P -e PDK_LEF_DIR=/OpenROAD-flow-scripts/flow/platforms/nangate45/lef $IMG_Y \\\r\n   /OpenROAD-flow-scripts/tools/install/OpenROAD/bin/openroad -no_init -exit submission/scripts/resize.tcl > $D_DIR/rsz.log 2>&1\r\n$DK -e LIB=$LIB -e NETLIST=$D_DIR/rsz.v -e SDF=$D_DIR/rsz.sdf -e PERIOD=$P --entrypoint /OpenSTA/build/sta $IMG_S -no_init -no_splash -exit submission/scripts/sta.tcl > $D_DIR/sta.rpt 2>&1\r\nA0=$(grep \"Chip area\" $D_DIR/syn.stat.rpt | awk '{print $NF}')\r\nA1=$(grep \"Design area\" $D_DIR/rsz.log | tail -1 | awk '{print $3}')\r\nW=$(grep \"^worst slack max\" $D_DIR/sta.rpt | awk '{print $NF}'); H=$(grep \"^worst slack min\" $D_DIR/sta.rpt | awk '{print $NF}')\r\nPW=$(grep \"^Total\" $D_DIR/sta.rpt | head -1 | awk '{print $5}')\r\necho \"$N P=$P enc=$E csa=$C spl=$S abcD=$D | yosys_area=$A0 rsz_area=$A1 wns=$W whs=$H pwr_est=$PW\"\r\nEOF\r\nchmod +x build/exp/run.sh && build/exp/run.sh t400a 2.5 0 1000 0 2000 && grep -E \"before|^worst\" build/exp/t400a/rsz.log\r\n21:set rtl_dir [expr {[info exists ::env(RTL_DIR)] ? $::env(RTL_DIR) : \"submission/rtl_${run}\"}]\r\n22:foreach f [lsort [glob ${rtl_dir}/*.sv]] { read_verilog -sv $f }\r\nbuild/exp/t400a/rtl/mult_pipe.sv:70: ERROR: syntax error, unexpected '{'\r\n"]
[1167.382, "o", "\u001b[1;32m$\u001b[0m sed -i \"s/assign rw\\[i\\] = 32'({~pp\\[i\\]\\[16\\], pp\\[i\\]\\[15:0\\], 1'b0, neg_e\\[i-1\\]}) << (2\\*i-2);/assign rw[i] = {13'd0, ~pp[i][16], pp[i][15:0], 1'b0, neg_e[i-1]} << (2*i-2);/; s/assign r8 = K | (32'(neg_e\\[7\\]) << 14);/assign r8 = K | ({31'd0, neg_e[7]} << 14);/\" build/exp/mult_pipe.sv && grep -n \"assign rw\\|assign r8\" build/exp/mult_pipe.sv && build/exp/run.sh t400a 2.5 0 1000 0 2000 && grep -E \"before|^worst\" build/exp/t400a/rsz.log\r\n58:            assign rw[i] = {15'd0, ~pp[i][16], pp[i][15:0]};\r\n61:            assign rw[i] = {13'd0, ~pp[i][16], pp[i][15:0], 1'b0, neg_e[i-1]} << (2*i-2);\r\n65:    assign r8 = K | ({31'd0, neg_e[7]} << 14);\r\nbuild/exp/t400a/rtl/mult_pipe.sv:70: ERROR: syntax error, unexpected '{'\r\n"]
[1170.458, "o", "\u001b[1;32m$\u001b[0m sed -n 66,72p build/exp/mult_pipe.sv\r\n    // ------------------------------------------------------------------\r\n    // carry-save levels (3:2 compressors on whole rows); each optionally registered\r\n    function automatic logic [63:0] csa(input logic [31:0] x, y, z);\r\n        return {((x & y) | (x & z) | (y & z)) << 1, x ^ y ^ z};\r\n    endfunction\r\n"]
[1197.869, "o", "\u001b[1;32m$\u001b[0m sed -i 's/        return {((x \\& y) | (x \\& z) | (y \\& z)) << 1, x ^ y ^ z};/        csa = {((x \\& y) | (x \\& z) | (y \\& z)) << 1, x ^ y ^ z};/' build/exp/mult_pipe.sv && sed -n 69p build/exp/mult_pipe.sv && build/exp/run.sh t400a 2.5 0 1000 0 2000 && grep -E \"before|^worst\" build/exp/t400a/rsz.log\r\n    function automatic logic [63:0] csa(input logic [31:0] x, y, z);\r\nWarning: Replacing memory \\rw with list of registers. See build/exp/t400a/rtl/mult_pipe.sv:58\r\nWarning: Replacing memory \\pp with list of registers. See build/exp/t400a/rtl/mult_pipe.sv:56\r\nt400a P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2808.162000 rsz_area=3146 wns=-0.202 whs=0.055 pwr_est=7.6262e-04\r\n== before: wns -1.8122030542855327e-9 area 2.808161925216268e-9\r\nworst slack max -1.81\r\nworst slack max -0.20\r\nworst slack min 0.05\r\n"]
