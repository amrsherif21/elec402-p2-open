[667.612, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/testbench/rtl_checker.sv'\r\ns=open(p).read()\r\nold='''        if (!ok(C_XZ, !$isunknown({RDY_mult, RDY_blockRead, VALID_memVal, EN_writeMem, EN_readMem,\r\n                                   writeMem_addr, readMem_addr, writeMem_val})))'''\r\nnew='''        // (XOR reduction is X iff any bit is X/Z; Icarus 12 mis-evaluates\r\n        //  $isunknown on concatenations.)\r\n        if (!ok(C_XZ, (^{RDY_mult, RDY_blockRead, VALID_memVal, EN_writeMem, EN_readMem,\r\n                         writeMem_addr, readMem_addr, writeMem_val}) !== 1'bx))'''\r\nassert old in s; s=s.replace(old,new)\r\nold='''            if (!ok(C_XZ, !$isunknown(memVal_data)))'''\r\nnew='''            if (!ok(C_XZ, (^memVal_data) !== 1'bx))'''\r\nassert old in s; s=s.replace(old,new)\r\nold=s[s.index('        $display(\"INFO t=%0t: phase %0d: fill'):s.index('                 rst_rd >= 0 ? \", reset mid-drain\" : \"\");\\n')+len('                 rst_rd >= 0 ? \", reset mid-drain\" : \"\");\\n')]\r\nnew='''        $write(\"INFO t=%0t: phase %0d: fill %0d%%, drain %0d%%, junk %0d%%, stalls %0d%%\",\r\n               $realtime, target, fill_pct, drain_pct, junk_pct, stall_pct);\r\n        if (pwr)        $write(\", POWER WINDOWS\");\r\n        if (directed)   $write(\", directed operands\");\r\n        if (rst_acc >= 0) $write(\", reset mid-fill\");\r\n        if (rst_full)   $write(\", reset when full\");\r\n        if (rst_rd >= 0) $write(\", reset mid-drain\");\r\n        $write(\"\\\\n\");\r\n'''\r\ns=s.replace(old,new)\r\ns=s.replace('''    int unsigned seed;\r\n    function''','''    int unsigned seed, seed0;\r\n    function''')\r\ns=s.replace('''        void'($value$plusargs(\"seed=%d\", seed));''','''        void'($value$plusargs(\"seed=%d\", seed));\r\n        seed0 = seed;''')\r\ns=s.replace('''                 seed, 2.0 * CLK_HALF_NS, lat, cyc);''','''                 seed0, 2.0 * CLK_HALF_NS, lat, cyc);''')\r\n# phase string in errors\r\ns=s.replace('''m_phase == PH_FILL ? \"fill\" : \"drain\", m_acc));''','''m_phase, m_acc));''')\r\ns=s.replace('''err(C_F5, $sformatf(\"RDY_mult=%b expected %b (phase=%s accepted=%0d)\"''','''err(C_F5, $sformatf(\"RDY_mult=%b expected %b (phase=%0d [0 fill,1 drain] accepted=%0d)\"''')\r\ns=s.replace('''                    m_phase == PH_FILL ? \"fill\" : \"drain\", m_wr, m_rd));''','''                    m_phase, m_wr, m_rd));''')\r\ns=s.replace('''err(C_F6, $sformatf(\"RDY_blockRead=%b expected %b (phase=%s writes=%0d reads=%0d)\"''','''err(C_F6, $sformatf(\"RDY_blockRead=%b expected %b (phase=%0d [0 fill,1 drain] writes=%0d reads=%0d)\"''')\r\nopen(p,'w').write(s)\r\nEOF\r\ngrep -n '? \"' submission/testbench/rtl_checker.sv\r\ncd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open; iverilog -g2012 -DLATV=2 -DBUGV=0 -o m.vvp $R/submission/testbench/rtl_checker.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv model.sv 2>&1 | grep -v sdf_annot; vvp -n m.vvp | grep -v \"complete$\" | tail -45\r\nINFO t=1350: applying reset for 3 cycle(s) (power-on; model accepted=0 written=0 read=0)\r\nINFO t=7500: phase 1: fill 70%, drain 70%, junk 50%, stalls 2%, directed operands\r\nINFO t=30000: latency learned from first product = 2 cycles\r\nINFO t=570000: phase 2: fill 100%, drain 100%, junk 0%, stalls 0%, POWER WINDOWS\r\nPWR_WIN fill 571250 731250\r\nPWR_WIN drain 736250 896250\r\nINFO t=895000: phase 3: fill 30%, drain 30%, junk 60%, stalls 0%\r\nINFO t=2032500: phase 4: fill 100%, drain 50%, junk 50%, stalls 0%, reset mid-fill\r\nINFO t=2133850: applying reset for 1 cycle(s) (mid-fill, products in flight; model accepted=40 written=38 read=0)\r\nINFO t=2640000: phase 5: fill 90%, drain 60%, junk 50%, stalls 3%, directed operands, reset mid-drain\r\nINFO t=2938850: applying reset for 2 cycle(s) (mid-drain, read data pending; model accepted=64 written=64 read=20)\r\nINFO t=3500000: phase 6: fill 100%, drain 100%, junk 100%, stalls 0%, reset when full\r\nINFO t=3661350: applying reset for 1 cycle(s) (all 64 accepted, writes pending; model accepted=64 written=62 read=0)\r\nINFO t=3987500: phase 7: fill 50%, drain 25%, junk 50%, stalls 0%\r\nINFO t=4857500: phase 8: fill 75%, drain 10%, junk 50%, stalls 2%\r\nINFO t=6732500: phase 9: fill 95%, drain 100%, junk 50%, stalls 4%\r\nINFO t=7227500: phase 10: fill 100%, drain 95%, junk 50%, stalls 0%, directed operands\r\nINFO t=7555000: phase 11: fill 10%, drain 75%, junk 50%, stalls 2%\r\nINFO t=9812500: phase 12: fill 25%, drain 50%, junk 50%, stalls 4%\r\nINFO t=11390000: phase 13: fill 50%, drain 25%, junk 50%, stalls 0%\r\nINFO t=12417500: phase 14: fill 75%, drain 10%, junk 50%, stalls 2%\r\n\r\n==== mkMultBuff_tb summary (seed=402, period=2.500 ns, latency=2, cycles=5904) ====\r\n  fill/drain phases completed: 14, products accepted: 1064, returned: 915\r\n  F1       checks=    1060  failures=0\r\n  F2       checks=    1060  failures=0\r\n  F3       checks=    1061  failures=0\r\n  F4       checks=    4837  failures=0\r\n  F5       checks=    7509  failures=0\r\n  F6       checks=    5883  failures=0\r\n  F7       checks=    4474  failures=0\r\n  F8       checks=    6812  failures=0\r\n  F9       checks=    1423  failures=0\r\n  F10      checks=      14  failures=0\r\n  F11      checks=      14  failures=0\r\n  F12      checks=    5897  failures=0\r\n  F13      checks=    5897  failures=0\r\n  F15      checks=      24  failures=0\r\n  DATA     checks=     915  failures=0\r\n  XZ       checks=    6812  failures=0\r\n  PHASES   checks=       2  failures=0\r\n  WATCHDOG checks=       0  failures=0\r\n  STIMULUS checks=       0  failures=0\r\nALL PASS\r\n/home/user/elec402-p2-open/submission/testbench/rtl_checker.sv:420: $finish called at 14760000 (1ps)\r\n"]
[683.398, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open\r\nfor cfg in \"1 0\" \"2 0\" \"4 0\" \"6 0\" \"2 1\" \"2 2\" \"2 3\" \"2 4\" \"4 5\" \"3 6\" \"2 7\" \"2 8\"; do set -- $cfg\r\niverilog -g2012 -DLATV=$1 -DBUGV=$2 -o m_$1_$2.vvp $R/submission/testbench/rtl_checker.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv model.sv 2>&1 | grep -v sdf_annot\r\nvvp -n m_$1_$2.vvp > log_$1_$2.txt\r\necho \"LAT=$1 BUG=$2: $(grep -E '^(ALL PASS|FAIL)' log_$1_$2.txt) | $(grep -E 'failures=[1-9]' log_$1_$2.txt | awk '{print $1\"=\"$NF}' | tr '\\n' ' ')\"\r\ndone\r\nLAT=1 BUG=0: ALL PASS | \r\nLAT=2 BUG=0: ALL PASS | \r\nLAT=4 BUG=0: ALL PASS | \r\nLAT=6 BUG=0: ALL PASS | \r\nmodel.sv:26: sorry: constant selects in always_* processes are not currently supported (all bits will be included).\r\nLAT=2 BUG=1: FAIL 150 check(s) failed | F1=failures=71 F11=failures=14 DATA=failures=65 \r\nLAT=2 BUG=2: FAIL 2329 check(s) failed | F2=failures=441 F3=failures=82 F4=failures=18 F5=failures=210 F6=failures=200 F7=failures=596 F8=failures=95 F9=failures=15 F10=failures=8 F11=failures=11 DATA=failures=653 \r\nLAT=2 BUG=3: FAIL 1981 check(s) failed | F2=failures=1060 F11=failures=14 F15=failures=4 DATA=failures=903 \r\nLAT=2 BUG=4: FAIL 2648 check(s) failed | F8=failures=1731 F11=failures=14 DATA=failures=903 \r\nLAT=4 BUG=5: FAIL 88 check(s) failed | F5=failures=88 \r\nLAT=3 BUG=6: FAIL 5468 check(s) failed | F2=failures=637 F3=failures=206 F4=failures=276 F5=failures=1344 F6=failures=1073 F7=failures=576 F8=failures=486 F9=failures=275 F10=failures=4 F11=failures=10 F13=failures=3 F15=failures=2 DATA=failures=576 \r\nLAT=2 BUG=7: FAIL 2259 check(s) failed | F7=failures=2259 \r\nLAT=2 BUG=8: FAIL 2533 check(s) failed | F2=failures=666 F3=failures=80 F4=failures=47 F5=failures=365 F6=failures=295 F7=failures=404 F8=failures=172 F9=failures=83 F10=failures=13 F11=failures=8 DATA=failures=400\r\n"]
[689.59, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open\r\niverilog -g2012 -P mkMultBuff_tb.CLK_HALF_NS=0.625 -DLATV=5 -o m800.vvp $R/submission/testbench/rtl_checker.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv model.sv 2>&1 | grep -v sdf_annot\r\nvvp -n m800.vvp +seed=12345 +vcd=/tmp/claude-0/checkers_scratch/w.vcd | grep -E \"PWR|ALL PASS|FAIL|summary|latency\"; ls -la w.vcd\r\nfor b in 2 3 4; do grep -m3 ERROR log_2_$b.txt; done; grep -m3 ERROR log_4_5.txt\r\nINFO t=11250: latency learned from first product = 5 cycles\r\nPWR_WIN fill 285625 365625\r\nPWR_WIN drain 371875 451875\r\n==== mkMultBuff_tb summary (seed=12345, period=1.250 ns, latency=5, cycles=6035) ====\r\nALL PASS\r\n-rw-r--r-- 1 root root 1041699 Nov  8 02:45 w.vcd\r\nERROR [F6] t=265000 cycle=106: RDY_blockRead=0 in the cycle after the write of address 63, expected 1\r\nERROR [F7] t=265000 cycle=106: accepted read #0: EN_readMem=0 readMem_addr=0, expected 1 and 0\r\nERROR [F8] t=267500 cycle=107: VALID_memVal=0 expected 1\r\nERROR [F15] t=10000 cycle=4: writeMem_addr=1 after reset, expected 0\r\nERROR [F2] t=30000 cycle=12: writeMem_addr=1 expected 0\r\nERROR [F2] t=32500 cycle=13: writeMem_addr=2 expected 1\r\nERROR [F8] t=267500 cycle=107: VALID_memVal=0 expected 1\r\nERROR [F8] t=267500 cycle=107: memVal_data=xxxxxxxx differs from readMem_val=40000000\r\nERROR [DATA] t=267500 cycle=107: memVal_data=xxxxxxxx expected product 40000000 (1073741824) for address 0\r\nERROR [F5] t=260000 cycle=104: RDY_mult=1 expected 0 (phase=0 [0 fill,1 drain] accepted=64)\r\nERROR [F5] t=262500 cycle=105: RDY_mult=1 expected 0 (phase=0 [0 fill,1 drain] accepted=64)\r\nERROR [F5] t=262500 cycle=105: EN_mult=1 while RDY_mult should be 0: DUT is ready\r\n"]
[718.47, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/testbench/rtl_checker.sv'\r\ns=open(p).read()\r\nold='''        RST_N = 0; EN_mult = 0; EN_blockRead = 0; mult_input0 = 0; mult_input1 = 0;\r\n        $display(\"INFO: mkMultBuff_tb'''\r\nnew='''        RST_N = 0; EN_mult = 0; EN_blockRead = 0; mult_input0 = 0; mult_input1 = 0;\r\n        $timeformat(-12, 0, \" ps\", 0);\r\n        $display(\"INFO: mkMultBuff_tb'''\r\nassert old in s; s=s.replace(old,new); open(p,'w').write(s)\r\nEOF\r\necho ok\r\nok\r\n"]
[750.91, "o", "\u001b[1;32m$\u001b[0m mkdir -p /home/user/elec402-p2-open/build/exp && cd /home/user/elec402-p2-open && cat > build/exp/mult_pipe.sv <<'EOF'\r\n// mult_pipe.sv -- pipelined signed 16x16 multiplier: radix-4 (modified) Booth\r\n// partial products, carry-save (3:2) reduction 9->6->4->3->2 rows and a final\r\n// carry-propagate adder. Every pipeline cut is optional (parameters), so the\r\n// same source serves the 400 MHz and 800 MHz implementations.\r\n//   ENC_REG : register the Booth-encoded multiplier digits + multiplicand\r\n//   CSA_REG : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   CPA_SPLIT: add the low 16 bits in one stage and the high 16 bits in the next\r\n// LAT = number of register ranks inside this module (product register included).\r\nmodule mult_pipe #(\r\n    parameter bit       ENC_REG   = 1'b0,\r\n    parameter bit [3:0] CSA_REG   = 4'b1000,\r\n    parameter bit       CPA_SPLIT = 1'b0\r\n) (\r\n    input  logic               clk,\r\n    input  logic               RST_N,\r\n    input  logic signed [15:0] a,      // multiplicand (registered by the caller)\r\n    input  logic signed [15:0] b,      // multiplier   (registered by the caller)\r\n    output logic signed [31:0] p       // product, registered\r\n);\r\n    // ------------------------------------------------------------------\r\n    // Booth radix-4 recoding of b: digit_i = -2 b[2i+1] + b[2i] + b[2i-1]\r\n    logic [7:0] one_d, two_d, neg_d;\r\n    always_comb begin\r\n        for (int i = 0; i < 8; i++) begin\r\n            logic b2, b1, b0;\r\n            b2 = b[2*i+1];\r\n            b1 = b[2*i];\r\n            b0 = (i == 0) ? 1'b0 : b[2*i-1];\r\n            one_d[i] = b1 ^ b0;\r\n            two_d[i] = (b2 & ~b1 & ~b0) | (~b2 & b1 & b0);\r\n            neg_d[i] = b2;\r\n        end\r\n    end\r\n\r\n    logic [7:0]  one_e, two_e, neg_e;\r\n    logic [15:0] a_e;\r\n    generate if (ENC_REG) begin : g_enc\r\n        always_ff @(posedge clk) begin\r\n            if (!RST_N) begin\r\n                one_e <= '0; two_e <= '0; neg_e <= '0; a_e <= '0;\r\n            end else begin\r\n                one_e <= one_d; two_e <= two_d; neg_e <= neg_d; a_e <= a;\r\n            end\r\n        end\r\n    end else begin : g_noenc\r\n        assign one_e = one_d; assign two_e = two_d; assign neg_e = neg_d; assign a_e = a;\r\n    end endgenerate\r\n\r\n    // ------------------------------------------------------------------\r\n    // Partial-product rows. Sign extension is replaced by inverting each row's\r\n    // sign bit and adding the constant K = -sum(2^(16+2i)) (mod 2^32); the\r\n    // \"+1\" of each negative row is placed in the free bit of the next row.\r\n    localparam logic [31:0] K = 32'hAAAB_0000;  // -(2^16+2^18+...+2^30) mod 2^32\r\n    logic [31:0] row [0:8];\r\n    always_comb begin\r\n        logic [16:0] a17, mag, pp;\r\n        a17 = {a_e[15], a_e};\r\n        for (int i = 0; i < 8; i++) begin\r\n            mag = ({17{one_e[i]}} & a17) | ({17{two_e[i]}} & {a_e, 1'b0});\r\n            pp  = mag ^ {17{neg_e[i]}};\r\n            row[i] = 32'({~pp[16], pp[15:0]}) << (2*i);\r\n            if (i > 0) row[i][2*i-2] = neg_e[i-1];\r\n        end\r\n        row[8] = K;\r\n        row[8][14] = neg_e[7];\r\n    end\r\n\r\n    // ------------------------------------------------------------------\r\n    // carry-save levels; each one optionally registered\r\n    function automatic logic [63:0] csa(input logic [31:0] x, y, z);\r\n        logic [31:0] s, c;\r\n        s = x ^ y ^ z;\r\n        c = ((x & y) | (x & z) | (y & z)) << 1;\r\n        return {c, s};\r\n    endfunction\r\n\r\n    // level 1: 9 -> 6\r\n    logic [31:0] l1 [0:5], l1q [0:5];\r\n    always_comb begin\r\n        {l1[1], l1[0]} = csa(row[0], row[1], row[2]);\r\n        {l1[3], l1[2]} = csa(row[3], row[4], row[5]);\r\n        {l1[5], l1[4]} = csa(row[6], row[7], row[8]);\r\n    end\r\n    // level 2: 6 -> 4\r\n    logic [31:0] l2 [0:3], l2q [0:3];\r\n    always_comb begin\r\n        {l2[1], l2[0]} = csa(l1q[0], l1q[1], l1q[2]);\r\n        {l2[3], l2[2]} = csa(l1q[3], l1q[4], l1q[5]);\r\n    end\r\n    // level 3: 4 -> 3\r\n    logic [31:0] l3 [0:2], l3q [0:2];\r\n    always_comb begin\r\n        {l3[1], l3[0]} = csa(l2q[0], l2q[1], l2q[2]);\r\n        l3[2] = l2q[3];\r\n    end\r\n    // level 4: 3 -> 2\r\n    logic [31:0] l4 [0:1], l4q [0:1];\r\n    always_comb begin\r\n        {l4[1], l4[0]} = csa(l3q[0], l3q[1], l3q[2]);\r\n    end\r\n\r\n    generate\r\n        if (CSA_REG[0]) begin : g_r1\r\n            always_ff @(posedge clk)\r\n                for (int k = 0; k < 6; k++) l1q[k] <= RST_N ? l1[k] : '0;\r\n        end else begin : g_n1\r\n            always_comb for (int k = 0; k < 6; k++) l1q[k] = l1[k];\r\n        end\r\n        if (CSA_REG[1]) begin : g_r2\r\n            always_ff @(posedge clk)\r\n                for (int k = 0; k < 4; k++) l2q[k] <= RST_N ? l2[k] : '0;\r\n        end else begin : g_n2\r\n            always_comb for (int k = 0; k < 4; k++) l2q[k] = l2[k];\r\n        end\r\n        if (CSA_REG[2]) begin : g_r3\r\n            always_ff @(posedge clk)\r\n                for (int k = 0; k < 3; k++) l3q[k] <= RST_N ? l3[k] : '0;\r\n        end else begin : g_n3\r\n            always_comb for (int k = 0; k < 3; k++) l3q[k] = l3[k];\r\n        end\r\n        if (CSA_REG[3]) begin : g_r4\r\n            always_ff @(posedge clk)\r\n                for (int k = 0; k < 2; k++) l4q[k] <= RST_N ? l4[k] : '0;\r\n        end else begin : g_n4\r\n            always_comb for (int k = 0; k < 2; k++) l4q[k] = l4[k];\r\n        end\r\n    endgenerate\r\n\r\n    // ------------------------------------------------------------------\r\n    // final carry-propagate adder, registered product\r\n    generate if (CPA_SPLIT) begin : g_split\r\n        logic [16:0] lo;\r\n        logic [15:0] lo_q, xh_q, yh_q;\r\n        logic        c_q;\r\n        assign lo = {1'b0, l4q[0][15:0]} + {1'b0, l4q[1][15:0]};\r\n        always_ff @(posedge clk) begin\r\n            if (!RST_N) begin\r\n                lo_q <= '0; c_q <= 1'b0; xh_q <= '0; yh_q <= '0; p <= '0;\r\n            end else begin\r\n                lo_q <= lo[15:0]; c_q <= lo[16];\r\n                xh_q <= l4q[0][31:16]; yh_q <= l4q[1][31:16];\r\n                p    <= {xh_q + yh_q + {15'd0, c_q}, lo_q};\r\n            end\r\n        end\r\n    end else begin : g_full\r\n        always_ff @(posedge clk) begin\r\n            if (!RST_N) p <= '0;\r\n            else        p <= l4q[0] + l4q[1];\r\n        end\r\n    end endgenerate\r\nendmodule : mult_pipe\r\nEOF\r\ncat > build/exp/tb_mult.sv <<'EOF'\r\n`timescale 1ns/1ps\r\nmodule tb_mult;\r\n  logic clk=0, RST_N=0; logic signed [15:0] a=0,b=0; logic signed [31:0] p;\r\n  mult_pipe #(.ENC_REG(`ENC), .CSA_REG(`CSA), .CPA_SPLIT(`SPL)) dut(.*);\r\n  localparam int LAT = `ENC + $countones(`CSA) - `CSA[3] + 1 + `SPL;\r\n  always #1 clk=~clk;\r\n  logic signed [31:0] exp_q [0:15]; int err=0, n=0;\r\n  initial begin\r\n    @(posedge clk); RST_N<=1;\r\n    for (int t=0; t<200000+LAT; t++) begin\r\n      @(posedge clk);\r\n      if (t>=LAT) begin n++; if (p !== exp_q[(t-LAT)%16]) begin err++; if (err<5) $display(\"ERR t=%0d p=%0d exp=%0d\",t,p,exp_q[(t-LAT)%16]); end end\r\n      if (t<64) begin a <= (t[2:0]==0)?-32768:(t[2:0]==1)?32767:(t[2:0]==2)?-1:(t[2:0]==3)?0:$urandom; b <= (t[5:3]==0)?-32768:(t[5:3]==1)?32767:(t[5:3]==2)?-1:(t[5:3]==3)?0:$urandom; end\r\n      else begin a <= $urandom; b <= $urandom; end\r\n      #0.1 exp_q[t%16] = a*b;\r\n    end\r\n    $display(\"LAT=%0d checked=%0d errors=%0d\", LAT, n, err); $finish;\r\n  end\r\nendmodule\r\nEOF\r\ncd build/exp && for cfg in \"0 4'b1000 0\" \"1 4'b0101 1\" \"0 4'b0011 0\" \"1 4'b1111 1\"; do set -- $cfg; iverilog -g2012 -DENC=$1 -DCSA=$2 -DSPL=$3 -o m.vvp tb_mult.sv mult_pipe.sv 2>&1 | head -5 && vvp -n m.vvp | tail -2; done\r\ntb_mult.sv:5: syntax error\r\ntb_mult.sv:5: error: Invalid module item.\r\nm.vvp: Unable to open input file.\r\ntb_mult.sv:5: syntax error\r\ntb_mult.sv:5: error: Invalid module item.\r\nm.vvp: Unable to open input file.\r\ntb_mult.sv:5: syntax error\r\ntb_mult.sv:5: error: Invalid module item.\r\nm.vvp: Unable to open input file.\r\ntb_mult.sv:5: syntax error\r\ntb_mult.sv:5: error: Invalid module item.\r\nm.vvp: Unable to open input file.\r\n"]
