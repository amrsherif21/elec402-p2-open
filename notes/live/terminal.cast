[21917.879, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''        if last and args.res_budget > 0:\r\n            cols, nr, rlo = ripple_low(cols, args.res_budget)'''\r\nnew = '''        rb = args.res_budget if last else (args.res_mid if lv in cuts else 0)\r\n        if rb > 0:\r\n            cols, nr, rlo = ripple_low(cols, rb)'''\r\nassert old in s; s = s.replace(old, new)\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--res-mid\", type=float, default=0.0, help=\"level mode: ripple-resolve low columns before each mid-tree cut up to this arrival\")\\nap.add_argument(\"--stats\"')\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor rm in 0 0.36 0.54 0.6 0.66 0.72; do python3 gen_tree.py /dev/null --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 4 --k 4 --bpair --res-budget 0.66 --res-mid $rm | grep \"LAT\\|ripple\\|R3\"; done\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\n  R3 after level 2: 67 FA 12 HA, model arrival 0.72, 84 flops\r\n  S4: low columns resolved below 5 by ripple (4 adders)\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\n  S3: low columns resolved below 2 by ripple (2 adders)\r\n  R3 after level 2: 67 FA 12 HA, model arrival 0.72, 84 flops\r\n  S4: low columns resolved below 5 by ripple (2 adders)\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\n  S3: low columns resolved below 3 by ripple (3 adders)\r\n  R3 after level 2: 67 FA 12 HA, model arrival 0.72, 84 flops\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\n  S3: low columns resolved below 3 by ripple (3 adders)\r\n  R3 after level 2: 67 FA 12 HA, model arrival 0.72, 84 flops\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\n"]
[21927.18, "o", "\u001b[1;32m$\u001b[0m pkill -f gen_tree.py; cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''        if not ok:\r\n            del net.lines[save_lines:]'''\r\nnew = '''        if not ok or m == 0 or (k < W and len(tc[k]) > 2 and not (k == c)):\r\n            del net.lines[save_lines:]'''\r\nassert old in s; s = s.replace(old, new)\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\ntimeout 20 python3 gen_tree.py /dev/null --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 4 --k 4 --bpair --res-budget 0.66 --res-mid 0.72 | head -1; python3 gen_tree.py /dev/null --mode wallace --rawlevels 3 --cuts 2,4 --gp gt --k0 4 --k 4 --bpair --res-budget 0.66 | head -1\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\nLAT=6 ranks=[40, 144, 84, 52, 42, 32] datapath flops=394 FA=100 HA=24\r\n"]
