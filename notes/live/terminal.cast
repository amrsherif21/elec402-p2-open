\n                   0.081    0.000    0.988 v _3794_/B1 (OAI21_X1)\r\n     2    3.175    0.096    0.157    1.145 ^ _3794_/ZN (OAI21_X1)\r\n                   0.096    0.000    1.145 ^ _3797_/A (AOI21_X1)\r\n     1    1.324    0.028    0.055    1.200 v _3797_/ZN (AOI21_X1)\r\n                   0.028    0.000    1.200 v _4285_/D (DFF_X2)\r\n                                     1.250 ^ _4285_/CK (DFF_X2)\r\n                                    -0.053   slack (VIOLATED)\r\nStartpoint: _4285_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _4254_ (rising edge-triggered flip-flop clocked by clk)\r\n                   0.156    0.000    0.000 ^ _4285_/CK (DFF_X2)\r\n     3   29.734    0.127    0.568    0.568 ^ _4285_/Q (DFF_X2)\r\n                   0.127    0.000    0.568 ^ _2163_/A2 (AND2_X4)\r\n     6   35.354    0.080    0.188    0.756 ^ _2163_/ZN (AND2_X4)\r\n                   0.080    0.000    0.756 ^ _2736_/A3 (AND3_X4)\r\n     4   10.740    0.042    0.150    0.906 ^ _2736_/ZN (AND3_X4)\r\n                   0.042    0.000    0.906 ^ _3769_/A3 (NAND3_X1)\r\n     2    4.204    0.081    0.081    0.988 v _3769_/ZN (NAND3_X1)\r\n                   0.081    0.000    0.988 v _3770_/A (XNOR2_X1)\r\n     1    1.802    0.025    0.155    1.143 v _3770_/ZN (XNOR2_X1)\r\n                   0.025    0.000    1.143 v _3771_/A2 (NOR2_X1)\r\n     1    1.419    0.056    0.100    1.243 ^ _3771_/ZN (NOR2_X1)\r\n                   0.056    0.000    1.243 ^ _4254_/D (DFF_X1)\r\n                                     1.250 ^ _4254_/CK (DFF_X1)\r\n                                    -0.052   slack (VIOLATED)\r\n"]
[20246.023, "o", "\u001b[1;32m$\u001b[0m W=build/cand800a/e6_nodup; for c in _4285_ _4253_ _4254_; do grep -A6 \"DFF_X[12] $c \" $W/map.v | grep -o \"\\.Q([^)]*)\"; done; awk '/^Startpoint/{n++} n>=1' $W/rep/sta.rpt | grep -E \"^Startpoint\" | sort | uniq -c | head\r\n.Q(RDY_blockRead)\r\n.Q(RDY_mult)\r\n.Q(readMem_addr[4])\r\n.Q(readMem_addr[5])\r\n.Q(readMem_addr[5])\r\n.Q(writeMem_addr[0])\r\n      1 Startpoint: RST_N (input port clocked by clk)\r\n      3 Startpoint: _4285_ (rising edge-triggered flip-flop clocked by clk)\r\n"]
[20255.479, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && python3 - <<'EOF'\r\ns = open('mkMultBuff.sv').read()\r\ns = s.replace(\"    localparam bit       DUP       = 1'b1;\", \"    localparam bit [4:0] DUP       = 5'b11111; // {rp, wp, wr, rdy_rd, rdy_mult}\")\r\nold = s[s.index(\"    generate if (DUP) begin : g_dup\"):s.index(\"    assign writeMem_val  = p;\")]\r\nnew = \"\"\"    assign RDY_mult      = DUP[0] ? ~rdy_mult_on : rdy_mult_q;\r\n    assign RDY_blockRead = DUP[1] ? ~rdy_rd_on   : rdy_rd_q;\r\n    assign EN_writeMem   = DUP[2] ? ~wr_on       : wr;\r\n    assign writeMem_addr = DUP[3] ? ~wp_on       : wp_q;\r\n    assign readMem_addr  = DUP[4] ? ~rp_on       : rp_q;\r\n\"\"\"\r\ns = s.replace(old, new)\r\nopen('mkMultBuff.sv','w').write(s)\r\nEOF\r\nsed -i -E 's/\\(localparam \\[a-z\\]\\+\\( \\\\\\[3:0\\\\\\]\\)\\? \\+\\$k \\+=\\)/(localparam [a-z]+( \\\\[[0-9]:0\\\\])? +$k +=)/' ../mk.sh; grep -n sed ../mk.sh\r\n11:  sed -i -E \"s/(localparam [a-z]+( \\[[0-9]:0\\])? +$k +=) [^;]*;/\\1 $v;/\" $D/rtl/mkMultBuff.sv\r\n"]
[20266.402, "o", "\u001b[1;32m$\u001b[0m S=build/cg/scripts; sed 's#^source submission/scripts/constraints.tcl#source submission/scripts/constraints.tcl\\nset_propagated_clock [all_clocks]#' submission/scripts/sta.tcl > $S/sta_prop.tcl; sed 's/-group_path_count 3/-group_path_count 3 -path_group clk/' $S/sta_prop.tcl > /dev/null; cat > $S/hold_prop.tcl <<'EOF'\r\n# hold_prop.tcl -- propagated-clock view of a netlist: gated-clock insertion delay,\r\n# worst setup/hold, and the hold-violating endpoints. env: LIB NETLIST PERIOD\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nset_propagated_clock [all_clocks]\r\nputs \"== ideal->propagated: setup/hold worst slack\"\r\nreport_worst_slack -max -digits 3\r\nreport_worst_slack -min -digits 3\r\nreport_tns -digits 3\r\n# clock arrival at the flops (rise), min/max over gated and ungated sinks\r\nset lo 1e9; set hi -1e9\r\nforeach inst [get_cells *] {\r\n  if {![string match DFF* [get_property $inst ref_name]]} continue\r\n  set p [get_pins [get_full_name $inst]/CK]\r\n  set a [get_property $p arrival_max_rise]\r\n  if {$a < $lo} {set lo $a}; if {$a > $hi} {set hi $a}\r\n}\r\nputs [format \"== CK arrival (rise, max) over flops: min %.3f ns, max %.3f ns\" [expr {$lo*1e9}] [expr {$hi*1e9}]]\r\nset n 0\r\nforeach inst [get_cells *] {\r\n  if {![string match DFF* [get_property $inst ref_name]]} continue\r\n  set s [get_property [get_pins [get_full_name $inst]/D] slack_min]\r\n  if {$s < 0} {incr n}\r\n}\r\nputs \"== flops with hold violation at D: $n\"\r\nreport_checks -path_delay min -group_path_count 3 -format full_clock_expanded -digits 3\r\nreport_checks -path_delay max -group_path_count 1 -format full_clock_expanded -digits 3\r\nEOF\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cg/a/map.v -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit $S/hold_prop.tcl > build/cg/a/rep/hold_prop.rpt 2>&1; grep -v \"^Warning\" build/cg/a/rep/hold_prop.rpt | head -60\r\n== ideal->propagated: setup/hold worst slack\r\nworst slack max -0.254\r\nworst slack min -2.175\r\ntns max -8.140\r\n== CK arrival (rise, max) over flops: min 14000.000 ns, max 3424416000.000 ns\r\n== flops with hold violation at D: 131\r\nStartpoint: _3121_ (negative level-sensitive latch clocked by clk)\r\nEndpoint: _1559_ (rising clock gating-check end-point clocked by clk)\r\nPath Group: gated clock\r\nPath Type: min\r\n\r\n   Delay     Time   Description\r\n-----------------------------------------------------------\r\n   1.250    1.250   clock clk (fall edge)\r\n   0.000    1.250   clock source latency\r\n   0.000    1.250 v clk (in)\r\n   0.000    1.250 v _3121_/GN (DLL_X1)\r\n   0.149    1.399 ^ _3121_/Q (DLL_X1)\r\n   0.000    1.399 ^ _1559_/A2 (AND2_X1)\r\n            1.399   data arrival time\r\n\r\n   1.250    1.250   clock clk (fall edge)\r\n   0.000    1.250   clock source latency\r\n   0.000    1.250 v clk (in)\r\n   0.000    1.250 v _1559_/A1 (AND2_X1)\r\n   0.000    1.250   clock reconvergence pessimism\r\n   0.000    1.250   clock gating hold time\r\n            1.250   data required time\r\n-----------------------------------------------------------\r\n            1.250   data required time\r\n           -1.399   data arrival time\r\n-----------------------------------------------------------\r\n            0.149   slack (MET)\r\n\r\n\r\nStartpoint: mult_input0[0] (input port clocked by clk)\r\nEndpoint: _3039_ (rising edge-triggered flip-flop clocked by clk)\r\nPath Group: clk\r\nPath Type: min\r\n\r\n   Delay     Time   Description\r\n-----------------------------------------------------------\r\n   0.000    0.000   clock clk (rise edge)\r\n   0.000    0.000   clock network delay (propagated)\r\n   0.000    0.000 ^ input external delay\r\n   0.007    0.007 ^ mult_input0[0] (in)\r\n   0.074    0.081 ^ hold1/Z (CLKBUF_X1)\r\n   0.083    0.165 ^ _1574_/ZN (AND2_X1)\r\n   0.000    0.165 ^ _3039_/D (DFF_X1)\r\n            0.165   data arrival time\r\n\r\n   0.000    0.000   clock clk (rise edge)\r\n   0.000    0.000   clock source latency\r\n   0.000    0.000 ^ clk (in)\r\n   2.009    2.009 ^ _1559_/ZN (AND2_X1)\r\n   0.000    2.009 ^ _3039_/CK (DFF_X1)\r\n   0.000    2.009   clock reconvergence pessimism\r\n   0.331    2.340   library hold time\r\n            2.340   data required time\r\n-----------------------------------------------------------\r\n"]
[20279.515, "o", "\u001b[1;32m$\u001b[0m S=build/cg/scripts; python3 - <<'PY'\r\np='submission/scripts/resize.tcl'; t=open(p).read()\r\nold=\"set margin [\"\r\nnew='''# --- clock gating experiment: real clock tree (TritonCTS) on the throw-away\r\n# placement, then propagated clocks so setup/hold repair sees the gated-clock\r\n# insertion delay and skew\r\nclock_tree_synthesis -buf_list {CLKBUF_X1 CLKBUF_X2 CLKBUF_X3} -root_buf CLKBUF_X3 -sink_clustering_enable\r\nset_propagated_clock [all_clocks]\r\nreport_clock_skew\r\nset margin ['''\r\nassert old in t; t=t.replace(old,new,1)\r\nt=t.replace(\"report_worst_slack -min\\n\",\"report_worst_slack -min\\nreport_clock_skew\\nreport_clock_skew -hold\\n\")\r\nopen('build/cg/scripts/resize_cts.tcl','w').write(t)\r\nPY\r\nsed -i '/CK arrival/,/^puts \\[format \"== CK arrival/d' $S/hold_prop.tcl; sed -i '/^# clock arrival at the flops/,/^}$/d' $S/hold_prop.tcl; grep -n \"lo\\b\\|hi\\b\\|arrival\" $S/hold_prop.tcl; mkdir -p build/cg/b && cp -r build/cg/a/rtl build/cg/b/\r\n\r\n"]
[20279.608, "o", "\u001b[1;32m$\u001b[0m build/cand800a/mk.sh e7_dup_rd CSA_REG=\"4'b1010\" ORD=\"1'b1\" GT=\"1'b1\" GP4=\"1'b0\" CPA=1 CI1=\"1'b1\" DUP=\"5'b00010\" 2>&1 | tail -4\r\ncheck=PASS sim=PASS wns=-0.006 whs=0.020\r\narea=4034.422 seq=1987.818 comb=2046.6 flops=439 vectorless_uW=2180.8\r\nactivity_uW: run:=2491.80 fill:=4565.20 drain:=1937.80 \r\nR1op:40(0.082) PP:144(0.151) L2:92(0.146) GP:60(0.156) ADD:43(0.180) PROD:32(0.132) CTRL:28(-0.006)\r\n"]
