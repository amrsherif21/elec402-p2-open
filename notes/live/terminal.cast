[20557.233, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && python3 - <<'EOF'\r\ns = open('mkMultBuff.sv').read()\r\na = \"    wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\\n\"\r\ns = s.replace(a, \"\")\r\ns = s.replace(\"    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\\n\", \"    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\\n\" + a)\r\nopen('mkMultBuff.sv','w').write(s)\r\nEOF\r\nsed -n 84,90p mkMultBuff.sv; cd /home/user/elec402-p2-open && build/cand800a/mk.sh e12_nodup CSA_REG=\"4'b1010\" ORD=\"1'b1\" GT=\"1'b1\" GP4=\"1'b0\" CPA=1 CI1=\"1'b1\" DUP=\"5'b00000\" CNT=\"1'b1\" RDS=\"1'b1\" 2>&1 | tail -4\r\n    wire rd  = EN_blockRead & rdy_rd_q;\r\n    wire wr  = v_q[LAT-1];\r\n    wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\r\n    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\r\n    wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\r\n\r\n    always_ff @(posedge clk) begin\r\ncheck=PASS sim=PASS wns=-0.007 whs=0.020\r\narea=4074.588 seq=1991.276 comb=2083.3 flops=440 vectorless_uW=2197.7\r\nactivity_uW: run:=2511.90 fill:=4610.10 drain:=1935.50 \r\nR1op:40(0.116) PP:144(0.150) L2:92(0.152) GP:60(0.149) ADD:43(0.178) PROD:32(0.117) CTRL:29(-0.007)\r\n"]
