[809.645, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open\r\nfor L in 1 3; do iverilog -g2012 -DLATV=$L -o r$L.vvp $R/submission/testbench/rtl_checker.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv model.sv 2>&1 | grep -v -e sdf_annot; for sd in 1 77 999; do echo \"L=$L seed=$sd: $(vvp -n r$L.vvp +seed=$sd | grep -E '^(ALL PASS|FAIL)|cycles=')\"; done; done\r\nfor sd in 5 6; do vvp -n s.vvp +seed=$sd >/dev/null; done\r\niverilog -g2012 -gspecify -DLATV=3 -o g.vvp $R/submission/testbench/sdf_checker_800.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv model.sv 2>/dev/null; for sd in 5 6; do vvp -n g.vvp +seed=$sd | tail -2 | head -1; done\r\nL=1 seed=1: ==== mkMultBuff_tb summary (seed=1, period=2.500 ns, latency=1, cycles=5869) ====\r\nALL PASS\r\nL=1 seed=77: ==== mkMultBuff_tb summary (seed=77, period=2.500 ns, latency=1, cycles=5886) ====\r\nALL PASS\r\nL=1 seed=999: ==== mkMultBuff_tb summary (seed=999, period=2.500 ns, latency=1, cycles=6264) ====\r\nALL PASS\r\nL=3 seed=1: ==== mkMultBuff_tb summary (seed=1, period=2.500 ns, latency=3, cycles=5978) ====\r\nALL PASS\r\nL=3 seed=77: ==== mkMultBuff_tb summary (seed=77, period=2.500 ns, latency=3, cycles=5829) ====\r\nALL PASS\r\nL=3 seed=999: ==== mkMultBuff_tb summary (seed=999, period=2.500 ns, latency=3, cycles=6183) ====\r\nALL PASS\r\nALL PASS\r\nALL PASS\r\n"]
