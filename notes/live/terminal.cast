[525.512, "o", "\u001b[1;32m$\u001b[0m docker run --rm openroad/orfs:26Q4-365-g898576f04 bash -c 'cd /OpenROAD-flow-scripts/flow/scripts; ls; cat abc_speed*.script 2>/dev/null | head -40; grep -n -i \"abc\\|booth\\|adder\\|lcu\\|kogge\\|han-carlson\\|brent\" synth*.tcl | head -40; ls /OpenROAD-flow-scripts/tools/install/yosys/share/yosys/choices/' 2>&1 | head -90\r\nREADME.md\r\nabc_area.script\r\nabc_retime.script\r\nabc_speed.script\r\nabc_speed_gia_only.script\r\ncdl.tcl\r\ncts.tcl\r\ndefaults.py\r\ndeleteNonClkNets.tcl\r\ndeletePowerNets.tcl\r\ndeleteRoutingObstructions.tcl\r\ndensity_fill.tcl\r\ndetail_place.tcl\r\ndetail_route.tcl\r\nescape.sh\r\nfillcell.tcl\r\nfinal_connect.tcl\r\nfinal_outputs.tcl\r\nfinal_report.tcl\r\nfloorplan.tcl\r\nfloorplan_to_place.tcl\r\nflow.sh\r\nflow.tcl\r\nformal_check.tcl\r\ngenerate-variables-docs.py\r\ngenerate_abstract.tcl\r\nglobal_place.tcl\r\nglobal_place_skip_io.tcl\r\nglobal_route.tcl\r\nio_placement.tcl\r\nklayout\r\nklayout.sh\r\nload.tcl\r\nmacro_place.tcl\r\nmacro_place_util.tcl\r\nmemories\r\nnon_stage_variables.py\r\nnoop.tcl\r\nopen.tcl\r\npdn.tcl\r\nread_liberty.tcl\r\nregfile_dissolve.tcl\r\nreport_metrics.tcl\r\nresize.tcl\r\nrun_command.py\r\nsave_images.tcl\r\nsynth.sh\r\nsynth.tcl\r\nsynth_canonicalize.tcl\r\nsynth_metrics.tcl\r\nsynth_odb.tcl\r\nsynth_preamble.tcl\r\nsynth_stdcells.tcl\r\nsynth_syn.tcl\r\nsynth_wrap_operators-booth.v\r\nsynth_wrap_operators.tcl\r\ntapcell.tcl\r\nutil.tcl\r\nvariables.json\r\nvariables.mk\r\nvariables.yaml\r\nview_cells.tcl\r\nwrite_binary_libs.tcl\r\nwrite_def.tcl\r\nwrite_ref_sdc.tcl\r\nwrite_verilog.tcl\r\nyaml_to_json.py\r\nyosys_keep.tcl\r\nyosys_load.tcl\r\n&get -n\r\n&st\r\n&dch\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&st\r\n&syn2\r\n"]
[529.434, "o", "\u001b[1;32m$\u001b[0m docker run --rm openroad/orfs:26Q4-365-g898576f04 bash -c 'cd /OpenROAD-flow-scripts/flow/scripts; tail -15 abc_speed.script; echo ===; cat abc_retime.script; echo ===; cat synth_wrap_operators.tcl | head -60; grep -n \"abc\\|lcu\\|alumacc\\|booth\" synth.tcl synth_syn.tcl synth_preamble.tcl | head -30' 2>&1\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&put\r\nbuffer -c\r\ntopo\r\nstime -c\r\nupsize -c\r\ndnsize -c\r\n===\r\nst\r\nretime -v -o\r\nretime -M 5 -v -o\r\nretime -M 5 -v -o\r\nretime -M 5 -v -o\r\nmap\r\n===\r\n# Set arithmetic operator modules. Default is the first module in the list.\r\nset deferred_cells [list \\\r\n  {\r\n    \\$alu\r\n    ALU_{A_WIDTH}_{A_SIGNED}_{B_WIDTH}_{B_SIGNED}_{Y_WIDTH}{%unused}\r\n    {HAN_CARLSON -map +/choices/han-carlson.v}\r\n    {KOGGE_STONE -map +/choices/kogge-stone.v}\r\n    {SKLANSKY -map +/choices/sklansky.v}\r\n    {BRENT_KUNG}\r\n  } \\\r\n  [list \\\r\n    \\$macc \\\r\n    MACC_\\{CONFIG\\}_\\{Y_WIDTH\\}\\{%unused\\} \\\r\n    [list BOOTH -max_iter 1 -map $::env(SCRIPTS_DIR)/synth_wrap_operators-booth.v] \\\r\n    {BASE -map +/choices/han-carlson.v}]]\r\n\r\n# Reorder the modules based on envar\r\nproc reorder_deferred_cells { deferred_cells_var index env_var } {\r\n  upvar $deferred_cells_var deferred_cells\r\n\r\n  if { ![info exists ::env($env_var)] } {\r\n    return\r\n  }\r\n\r\n  set cell_def [lindex $deferred_cells $index]\r\n\r\n  # Build lookup dict\r\n  set choice_map {}\r\n  foreach choice [lrange $cell_def 2 end] {\r\n    dict set choice_map [lindex $choice 0] $choice\r\n  }\r\n\r\n  # Build new choices\r\n  set new_choices {}\r\n  foreach name [split $::env($env_var) \",\"] {\r\n    if { [dict exists $choice_map $name] } {\r\n      lappend new_choices [dict get $choice_map $name]\r\n    } else {\r\n      puts \"Warning: Unknown choice '$name' ignored for $env_var\"\r\n    }\r\n  }\r\n\r\n  # Replace cell\r\n  lset deferred_cells $index [linsert $new_choices 0 {*}[lrange $cell_def 0 1]]\r\n}\r\n\r\n# Apply custom orders\r\nreorder_deferred_cells deferred_cells 0 SYNTH_WRAPPED_ADDERS\r\nreorder_deferred_cells deferred_cells 1 SYNTH_WRAPPED_MULTIPLIERS\r\n\r\ntechmap {*}[join [lmap cell $deferred_cells { string cat \"-dont_map [lindex $cell 0]\" }] \" \"]\r\n\r\nforeach info $deferred_cells {\r\n  set type [lindex $info 0]\r\n  set naming_template [lindex $info 1]\r\n  # default architecture and its suffix\r\n  set default [lindex $info 2]\r\n  set default_suffix [lindex $default 0]\r\n\r\n  log -header \"Generating architectural options for $type\"\r\nsynth.tcl:127:    \"-extra-map $::env(FLOW_HOME)/platforms/common/lcu_kogge_stone.v\"]\r\nsynth.tcl:197:  abc -dff -script $::env(SCRIPTS_DIR)/abc_retime.script\r\nsynth.tcl:207:  synth -top $::env(DESIGN_NAME) -run fine: -noabc {*}$synth_full_args\r\nsynth.tcl:292:  log_cmd abc {*}$abc_args\r\nsynth.tcl:294:  # Not dead code: abc_new mistakes the \"-script\" in /OpenROAD-flow-scripts/...\r\nsynth.tcl:296:  scratchpad -set abc9.script $::env(SCRIPTS_DIR)/abc_speed_gia_only.script\r\nsynth.tcl:297:  # abc_new maps each arithmetic operator module with the abc9_script\r\nsynth.tcl:301:  set abc_args [lrange $abc_args 2 end]\r\nsynth.tcl:302:  log_cmd abc_new {*}$abc_args\r\nsynth_preamble.tcl:282:  set abc_script $::env(ABC_SCRIPT)\r\nsynth_preamble.tcl:285:  set abc_script $::env(SCRIPTS_DIR)/abc_area.script\r\nsynth_preamble.tcl:288:  set abc_script $::env(SCRIPTS_DIR)/abc_speed.script\r\nsynth_preamble.tcl:314:set abc_args [list -script $abc_script \\\r\nsynth_preamble.tcl:315:  {*}$lib_args {*}$lib_dont_use_args -constr $::env(OBJECTS_DIR)/abc.constr]\r\nsynth_preamble.tcl:317:set constr [open $::env(OBJECTS_DIR)/abc.constr w]\r\n"]
[551.176, "o", "\u001b[1;32m$\u001b[0m cat > submission/scripts/abc_speed.script <<'EOF'\r\n&get -n\r\n&st\r\n&dch\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&st\r\n&syn2\r\n&if -g -K 6\r\n&synch2\r\n&nf\r\n&put\r\nbuffer -c\r\ntopo\r\nstime -c\r\nupsize -c\r\ndnsize -c\r\nEOF\r\npython3 - <<'EOF'\r\np='submission/scripts/synth.tcl'\r\ns=open(p).read()\r\ns=s.replace('''set out   $::env(OUT)''','''set out   $::env(OUT)\r\n# final-adder architecture for $lcu (carry look-ahead unit): a Yosys parallel-prefix choice\r\nset adder [expr {[info exists ::env(ADDER)] ? $::env(ADDER) : \"sklansky\"}]\r\nset extra {}\r\nif {$adder ne \"ripple\"} { set extra [list -extra-map +/choices/${adder}.v] }''')\r\ns=s.replace('''if {$booth} { synth -top mkMultBuff -flatten -booth } else { synth -top mkMultBuff -flatten }''',\r\n'''set sargs [list -top mkMultBuff -flatten {*}$extra]\r\nif {$booth} { lappend sargs -booth }\r\nsynth {*}$sargs''')\r\ns=s.replace('''abc -D $abc_d -liberty $lib''','''# ABC: delay-oriented mapping followed by buffering and gate sizing; the\r\n# constraint file gives ABC the input drive and the output load of SPEC Section 6\r\nset cf [open [file rootname $out].abc.constr w]\r\nputs $cf \"set_driving_cell DFF_X1\\\\nset_load 23.5\"\r\nclose $cf\r\nabc -D $abc_d -liberty $lib -script submission/scripts/abc_speed.script -constr [file rootname $out].abc.constr\r\nfile delete [file rootname $out].abc.constr''')\r\nopen(p,'w').write(s)\r\nEOF\r\nsed -i 's/-e BOOTH=$(BOOTH) -e OUT/-e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT/; s/^  BOOTH   ?= 1$/  BOOTH   ?= 1\\n  ADDER   ?= sklansky/' Makefile; grep -n ADDER Makefile | head; for a in sklansky kogge-stone; do make synth RUN=400 ADDER=$a 2>&1 | tail -4; done\r\n11:  ADDER   ?= sklansky\r\n17:  ADDER   ?= sklansky\r\n38:YOSYS       := $(DOCKER) -e RUN=$(RUN) -e LIB=$(LIB) -e ABC_D=$(ABC_D) -e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT=$(NETLIST) \\\r\n     of which used for sequential elements: 366.282000 (13