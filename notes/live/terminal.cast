[2311.045, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nt=open('build/exp/top.sv').read()\r\nt=t.replace(\"logic [5:0] acc_q, ptr_q;\",\"logic [5:0] acc_q, wp_q, rp_q;\")\r\nt=t.replace(\"acc_q <= '0; ptr_q <= '0; v_q <= '0;\",\"acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0;\")\r\nt=t.replace(\"\"\"            if (wr | rd) ptr_q <= ptr_q + 6'd1;\r\n            if (wr && ptr_q == 6'd63) rdy_rd_q <= 1'b1;\r\n            if (rd && ptr_q == 6'd63) begin\"\"\",\"\"\"            if (wr) wp_q <= wp_q + 6'd1;\r\n            if (rd) rp_q <= rp_q + 6'd1;\r\n            if (wr && wp_q == 6'd63) rdy_rd_q <= 1'b1;\r\n            if (rd && rp_q == 6'd63) begin\"\"\")\r\nt=t.replace(\"assign writeMem_addr = ptr_q;\",\"assign writeMem_addr = wp_q;\").replace(\"assign readMem_addr  = ptr_q;\",\"assign readMem_addr  = rp_q;\")\r\nopen('build/exp/top.sv','w').write(t)\r\nEOF\r\ngrep -n \"ptr_q\" build/exp/top.sv; python3 submission/scripts/lib_dont_use.py tech/NangateOpenCellLibrary_slow.lib build/exp/lib_du2.lib 'OAI33_*' 'NOR3_*' 'NOR4_*' 'OR3_*' 'OR4_*' 'AND4_*' 'NAND4_*' 'AOI211_*' 'AOI221_*' 'AOI222_*' 'OAI211_*' 'OAI221_*' 'OAI222_*'; sed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/4/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head; echo \"$(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; (MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh n800b 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh n800c 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; for d in n800b n800c; do build/exp/path.sh build/exp/$d/sta.rpt | sed -n '3p'; grep -A2 \" $(build/exp/path.