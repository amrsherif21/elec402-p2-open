.720    0.044    0.139    1.000 ^ _3749_/ZN (AND3_X4)\r\n                   0.044    0.000    1.000 ^ _3750_/B (XNOR2_X2)\r\n     1    1.952    0.062    0.113    1.113 ^ _3750_/ZN (XNOR2_X2)\r\n                   0.062    0.000    1.113 ^ _3751_/A1 (NOR2_X1)\r\n     1    1.340    0.046    0.032    1.144 v _3751_/ZN (NOR2_X1)\r\n                   0.046    0.000    1.144 v _4287_/D (DFF_X1)\r\n                                     1.250 ^ _4287_/CK (DFF_X1)\r\n                                     0.001   slack (MET)\r\nRDY_mult                                1    0.096\r\nacc_q                                   6    0.002\r\nrdy_rd_on                               1    0.067\r\nrdy_rd_q                                1    0.020\r\nreadMem_addr                            6    0.001\r\nu_mult.a17                             16    0.119\r\nu_mult.g_pre.neg_q                      8    0.133\r\nu_mult.g_pre.one_q                      8    0.135\r\nu_mult.g_pre.two_q                      8    0.082\r\nu_mult.l2q                             92    0.146\r\nwriteMem_addr                           6   -0.006\r\nwriteMem_val                           32    0.132\r\n"]
[20301.146, "o", "\u001b[1;32m$\u001b[0m cat build/cg/scripts/hold_prop.tcl | head -20; export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; RSZ=build/cg/scripts/resize_cts.tcl STAS=build/cg/scripts/sta_prop.tcl bash build/cg/scripts/eval_cg.sh 400 build/cg/b/rtl build/cg/b 2>&1 | tail -20; grep -i \"error\\|CTS-\\|skew\\|latency\\|RSZ-00\" build/cg/b/rep/resize.log | head -40\r\n# hold_prop.tcl -- propagated-clock view of a netlist: gated-clock insertion delay,\r\n# worst setup/hold, and the hold-violating endpoints. env: LIB NETLIST PERIOD\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nset_propagated_clock [all_clocks]\r\nputs \"== ideal->propagated: setup/hold worst slack\"\r\nreport_worst_slack -max -digits 3\r\nreport_worst_slack -min -digits 3\r\nreport_tns -digits 3\r\n== build/cg/b RUN=400\r\ncheck=PASS sim=PASS wns=0.214 whs=-0.035\r\narea=2783.424 seq=673.778 comb=2109.6 flops=149 vectorless_uW=842.2\r\nactivity_uW: run:=653.21 fill:=1969.10 drain:=159.37 \r\nper register group (flops, worst slack):\r\nEN_writeMem                             1    1.647\r\nRDY_blockRead                           1    1.009\r\nRDY_mult                                1    0.963\r\nVALID_memVal                            1    1.144\r\nacc_q                                   6    0.818\r\nreadMem_addr                            6    0.624\r\nu_mult.a17                             16    0.848\r\nu_mult.g_pre.neg_q                      8    1.038\r\nu_mult.g_pre.one_q                      8    1.193\r\nu_mult.g_pre.two_q                      8    0.956\r\nu_mult.l4q                             59    0.249\r\nv_q                                     2    1.152\r\nwriteMem_val                           32    0.231\r\n[INFO CTS-0050] Root buffer is CLKBUF_X3.\r\n[INFO CTS-0051] Sink buffer is CLKBUF_X3.\r\n[INFO CTS-0052] The following clock buffers will be used for CTS:\r\n[INFO CTS-0049] Characterization buffer is CLKBUF_X3.\r\n[INFO CTS-0007] Net \"clk\" found for clock \"clk\".\r\n[INFO CTS-0011]  Clock net \"clk\" for macros has 1 sinks.\r\n[INFO CTS-0011]  Clock net \"clk_regs\" for registers has 19 sinks.\r\n[INFO CTS-0010]  Clock net \"mclk\" has 131 sinks.\r\n[INFO CTS-0008] TritonCTS found 3 clock nets.\r\n[INFO CTS-0097] Characterization used 3 buffer(s) types.\r\n[INFO CTS-0201] 0 blockages from hard placement blockages and placed macros will be used.\r\n[INFO CTS-0027] Generating H-Tree topology for net clk.\r\n[INFO CTS-0028]  Total number of sinks: 1.\r\n[INFO CTS-0060]  Macro  sinks will be clustered in groups of up to 4 and based on buffer max cap.\r\n[INFO CTS-0030]  Number of static layers: 0.\r\n[INFO CTS-0020]  Wire segment unit: 14000  dbu (7 um).\r\n[INFO CTS-0023]  Original sink region: [(81770, 81914), (81770, 81914)].\r\n[INFO CTS-0024]  Normalized sink region: [(5.84071, 5.851), (5.84071, 5.851)].\r\n[INFO CTS-0025]     Width:  0.0000.\r\n[INFO CTS-0026]     Height: 0.0000.\r\n[INFO CTS-0034]     Segment length (rounded): 1.\r\n[INFO CTS-0038]  Stop criterion found. Sink region hpwl is smaller than max wirelength (1064.396 um) and max number of sinks is 15.\r\n[INFO CTS-0035]  Number of sinks covered: 1.\r\n[INFO CTS-0201] 0 blockages from hard placement blockages and placed macros will be used.\r\n[INFO CTS-0027] Generating H-Tree topology for net clk_regs.\r\n[INFO CTS-0028]  Total number of sinks: 19.\r\n[INFO CTS-0090]  Sinks will be clustered based on buffer max cap.\r\n[INFO CTS-0030]  Number of static layers: 0.\r\n[INFO CTS-0020]  Wire segment unit: 14000  dbu (7 um).\r\n[INFO CTS-0023]  Original sink region: [(63301, 143039), (112881, 158760)].\r\n[INFO CTS-0024]  Normalized sink region: [(4.5215, 10.2171), (8.06293, 11.34)].\r\n[INFO CTS-0025]     Width:  3.5414.\r\n[INFO CTS-0026]     Height: 1.1229.\r\n[INFO CTS-0034]     Segment length (rounded): 1.\r\n[INFO CTS-0038]  Stop criterion found. Sink region hpwl is smaller than max wirelength (1064.396 um) and max number of sinks is 15.\r\n[INFO CTS-0035]  Number of sinks covered: 19.\r\n[INFO CTS-0201] 0 blockages from hard placement blockages and placed macros will be used.\r\n[INFO CTS-0027] Generating H-Tree topology for net mclk.\r\n[INFO CTS-0028]  Total number of sinks: 131.\r\n[INFO CTS-0090]  Sinks will be clustered based on buffer max cap.\r\n"]
[20304.485, "o", "\u001b[1;32m$\u001b[0m W=build/cg/b; grep -A12 \"report_clock_skew\\|Clock clk\" $W/rep/resize.log | grep -v \"^\\[INFO CTS\" | head -60; grep \"RSZ-00\\|worst slack\\|Design area\" $W/rep/resize.log; grep -E \"^cell (CLKBUF|BUF|DLL|AND2)\" $W/rep/sta.rpt\r\nClock clk\r\n   0.55 source latency _3039_/CK ^\r\n  -0.54 target latency _2973_/CK ^\r\n  -0.00 CRPR\r\n--------------\r\n   0.01 setup skew\r\n\r\nIteration |   Area    | Resized | Buffers | Nets repaired | Remaining\r\n---------------------------------------------------------------------\r\n        0 |     +0.0% |       0 |       0 |             0 |      1823\r\n    final |     +0.0% |       0 |       0 |             0 |         0\r\n---------------------------------------------------------------------\r\n[INFO RSZ-0504] Runtime: 1.49s\r\n--\r\nClock clk\r\n   0.55 source latency _3039_/CK ^\r\n  -0.54 target latency _2973_/CK ^\r\n  -0.00 CRPR\r\n--------------\r\n   0.01 setup skew\r\n\r\nClock clk\r\n   0.54 source latency _3004_/CK ^\r\n  -0.55 target latency _3102_/CK ^\r\n  -0.00 CRPR\r\n--------------\r\n  -0.01 hold skew\r\n\r\nDesign area 2783 um^2 45% utilization.\r\n[INFO RSZ-0098] No setup violations found\r\n[INFO RSZ-0046] Found 114 endpoints with hold violations.\r\n[INFO RSZ-0032] Inserted 264 hold buffers.\r\nworst slack max 0.18\r\nworst slack min 0.02\r\nDesign area 2783 um^2 45% utilization.\r\ncell AND2_X1           55     58.520 um^2\r\ncell AND2_X2            1      1.330 um^2\r\ncell BUF_X1            37     29.526 um^2\r\ncell BUF_X2            19     20.216 um^2\r\ncell BUF_X4            42     78.204 um^2\r\ncell BUF_X8            11     38.038 um^2\r\ncell CLKBUF_X1        270    215.460 um^2\r\ncell CLKBUF_X2          7      7.448 um^2\r\ncell CLKBUF_X3         31     41.230 um^2\r\ncell DLL_X1             1      2.660 um^2\r\n"]
[20312.335, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && sed -n 64,105p mkMultBuff.sv\r\n                                     + ((CPA == 1 || (CPA == 0 && (CPA_SPLIT | CPA_CSEL))) ? 1 : 0) + 1;\r\n\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q;\r\n    // copies of the two ready flags that drive only the output ports, so the\r\n    // port load does not slow the internal handshake logic (stored inverted,\r\n    // see below)\r\n    logic rdy_mult_on, rdy_rd_on;\r\n    // likewise port-only copies of the memory addresses and write enable; they\r\n    // are stored inverted (reset value all ones) so that synthesis does not\r\n    // merge them with the internal registers, which have the same next state\r\n    logic [5:0] wp_on, rp_on;\r\n    logic       wr_on;\r\n    logic [5:0] acc_q, wp_q, rp_q;\r\n    logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\r\n    logic signed [31:0] p;\r\n\r\n    wire acc = EN_mult & rdy_mult_q;\r\n    wire rd  = EN_blockRead & rdy_rd_q;\r\n    wire wr  = v_q[LAT-1];\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0;\r\n            rdy_mult_on <= 1'b0; rdy_rd_on <= 1'b1;\r\n            wp_on <= '1; rp_on <= '1; wr_on <= 1'b1;\r\n            acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-2:0], acc};\r\n            if (acc) begin\r\n                acc_q <= acc_q + 6'd1;\r\n                if (acc_q == 6'd63) begin rdy_mult_q <= 1'b0; rdy_mult_on <= 1'b1; end\r\n            end\r\n            if (wr) begin wp_q <= wp_q + 6'd1; wp_on <= ~(wp_q + 6'd1); end\r\n            if (rd) begin rp_q <= rp_q + 6'd1; rp_on <= ~(rp_q + 6'd1); end\r\n            wr_on <= ~v_q[LAT-2];\r\n            if (wr && wp_q == 6'd63) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\n            if (rd && rp_q == 6'd63) begin\r\n                rdy_rd_q <= 1'b0; rdy_mult_q <= 1'b1;\r\n                rdy_rd_on <= 1'b1; rdy_mult_on <= 1'b0;\r\n            end\r\n            vld_q <= rd;\r\n        end\r\n"]
[20314.968, "o", "\u001b[1;32m$\u001b[0m export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"x\"; make timing RUN=400 BUILD=build/cg/b REP=build/cg/b/rep NETLIST=build/cg/b/map.v SDF=build/cg/b/map.sdf 2>&1 | grep -v \"^iverilog\\|^vvp\" | tail -5; docker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cg/b/map.v -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cg/scripts/hold_prop.tcl > build/cg/b/rep/hold_prop.rpt 2>&1; grep -v \"^Warning\" build/cg/b/rep/hold_prop.rpt | sed -n 1,45p\r\nINFO t=2215000 ps: phase 5 complete (384 accepted, 383 returned)\r\n\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 3, 894 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nsubmission/testbench/sdf_checker_400.sv:289: $finish called at 2235000 (1ps)\r\n== ideal->propagated: setup/hold worst slack\r\nworst slack max 0.214\r\nworst slack min -0.035\r\ntns max 0.000\r\n"]
[20317.526, "o", "\u001b[1;32m$\u001b[0m grep -v \"^Warning\" build/cg/b/rep/hold_prop.rpt | sed -n 5,80p\r\n\r\n"]
[20320.025, "o", "\u001b[1;32m$\u001b[0m wc -l build/cg/b/rep/hold_prop.rpt; grep -v \"^Warning\" build/cg/b/rep/hold_prop.rpt | head -80; tail -5 build/cg/scripts/hold_prop.tcl\r\n4 build/cg/b/rep/hold_prop.rpt\r\n== ideal->propagated: setup/hold worst slack\r\nworst slack max 0.214\r\nworst slack min -0.035\r\ntns max 0.000\r\nset_propagated_clock [all_clocks]\r\nputs \"== ideal->propagated: setup/hold worst slack\"\r\nreport_worst_slack -max -digits 3\r\nreport_worst_slack -min -digits 3\r\nreport_tns -digits 3\r\n"]
[20324.117, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"tb_mult.sv\").read()\r\ns = s.replace(\"\"\"    logic signed [15:0] corner [0:9] = '{16'sh0000, 16'sh0001, 16'shFFFF, 16'sh7FFF, 16'sh8000,\r\n                                         16'sh8001, 16'sh5555, 16'shAAAA, 16'sh00FF, 16'shFF00};\r\n\"\"\", \"\"\"    function automatic logic signed [15:0] corner(input int k);\r\n        case (k)\r\n            0: corner = 16'sh0000; 1: corner = 16'sh0001; 2: corner = 16'shFFFF; 3: corner = 16'sh7FFF;\r\n            4: corner = 16'sh8000; 5: corner = 16'sh8001; 6: corner = 16'sh5555; 7: corner = 16'shAAAA;\r\n            8: corner = 16'sh00FF; default: corner = 16'shFF00;\r\n        endcase\r\n    endfunction\r\n\"\"\")\r\ns = s.replace(\"corner[i]\", \"corner(i)\").replace(\"corner[j]\", \"corner(j)\")\r\ns = s.replace(\"if (expq.size() > LAT)\", \"if (expq.size() >= LAT)\")\r\ns = s.replace(\"\"\"        // after reset the pipeline holds zeros: prime the expectation queue\r\n        repeat (LAT) expq.push_back(32'sd0);\r\n        // queue holds LAT entries: entry i is the expected p after the i-th future edge\r\n        expq.delete(); repeat (LAT - 1) expq.push_back(32'sd0);\r\n\"\"\", \"\")\r\nopen(\"tb_mult.sv\",\"w\").write(s)\r\nEOF\r\nfor d in d24 w24; do iverilog -g2012 -Ptb_mult.LAT=6 -o /tmp/claude-0/t_$d.vvp tb_mult.sv $d/rtl/mult_pipe.sv && vvp -n /tmp/claude-0/t_$d.vvp | tail -3; done; iverilog -g2012 -Ptb_mult.LAT=5 -o /tmp/claude-0/t_x.vvp tb_mult.sv d24/rtl/mult_pipe.sv && vvp -n /tmp/claude-0/t_x.vvp | tail -1\r\nPASS: 200902 checks, 0 errors\r\ntb_mult.sv:41: $finish called at 2009096 (1s)\r\n"]
[20327.294, "o", "\u001b[1;32m$\u001b[0m cat >> build/cg/scripts/hold_prop.tcl <<'EOF'\r\nset n 0\r\nforeach inst [get_cells *] {\r\n  if {![string match DFF* [get_property $inst ref_name]]} continue\r\n  set s [get_property [get_pins [get_full_name $inst]/D] slack_min]\r\n  if {$s < 0} {incr n}\r\n}\r\nputs \"== flops with hold violation at D: $n\"\r\nreport_checks -path_delay min -group_path_count 2 -format full_clock_expanded -digits 3\r\nreport_checks -path_delay max -group_path_count 1 -format full_clock_expanded -digits 3\r\nEOF\r\nfor v in a b; do docker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cg/$v/map.v -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cg/scripts/hold_prop.tcl > build/cg/$v/rep/hold_prop.rpt 2>&1; done; grep -v \"^Warning\" build/cg/b/rep/hold_prop.rpt | sed -n 1,75p\r\n== ideal->propagated: setup/hold worst slack\r\nworst slack max 0.214\r\nworst slack min -0.035\r\ntns max 0.000\r\n== flops with hold violation at D: 15\r\nStartpoint: _3121_ (negative level-sensitive latch clocked by clk)\r\nEndpoint: _1559_ (rising clock gating-check end-point clocked by clk)\r\nPath Group: gated clock\r\nPath Type: min\r\n\r\n   Delay     Time   Description\r\n-----------------------------------------------------------\r\n   1.250    1.250   clock clk (fall edge)\r\n   0.000    1.250   clock source latency\r\n   0.000    1.250 v clk (in)\r\n   0.078    1.328 v delaybuf_0_clk/Z (CLKBUF_X3)\r\n   0.088    1.416 v delaybuf_1_clk/Z (CLKBUF_X3)\r\n   0.088    1.504 v delaybuf_2_clk/Z (CLKBUF_X3)\r\n   0.088    1.591 v delaybuf_3_clk/Z (CLKBUF_X3)\r\n   0.088    1.679 v clkbuf_regs_0_clk/Z (CLKBUF_X3)\r\n   0.093    1.772 v clkbuf_0_clk_regs/Z (CLKBUF_X3)\r\n   0.120    1.892 v clkbuf_1_0__f_clk_regs/Z (CLKBUF_X3)\r\n   0.000    1.892 v _3121_/GN (DLL_X1)\r\n   0.168    2.059 ^ _3121_/Q (DLL_X1)\r\n   0.000    2.059 ^ _1559_/A2 (AND2_X1)\r\n            2.059   data arrival time\r\n\r\n   1.250    1.250   clock clk (fall edge)\r\n   0.000    1.250   clock source latency\r\n   0.000    1.250 v clk (in)\r\n   0.078    1.328 v clkbuf_0_clk/Z (CLKBUF_X3)\r\n   0.087    1.415 v clkbuf_1_0__f_clk/Z (CLKBUF_X3)\r\n   0.000    1.415 v _1559_/A1 (AND2_X1)\r\n   0.000    1.415   clock reconvergence pessimism\r\n   0.000    1.415   clock gating hold time\r\n            1.415   data required time\r\n-----------------------------------------------------------\r\n            1.415   data required time\r\n           -2.059   data arrival time\r\n-----------------------------------------------------------\r\n            0.644   slack (MET)\r\n\r\n\r\nStartpoint: RST_N (input port clocked by clk)\r\nEndpoint: _3076_ (rising edge-triggered flip-flop clocked by clk)\r\nPath Group: clk\r\nPath Type: min\r\n\r\n   Delay     Time   Description\r\n-----------------------------------------------------------\r\n   0.000    0.000   clock clk (rise edge)\r\n   0.000    0.000   clock network delay (propagated)\r\n   0.000    0.000 ^ input external delay\r\n   0.007    0.007 ^ RST_N (in)\r\n   0.075    0.082 ^ hold128/Z (CLKBUF_X1)\r\n   0.057    0.138 ^ _1561_/Z (BUF_X1)\r\n   0.126    0.264 ^ hold129/Z (CLKBUF_X1)\r\n   0.059    0.323 v _1615_/ZN (INV_X1)\r\n   0.146    0.470 v _1630_/Z (BUF_X1)\r\n   0.093    0.563 ^ _2912_/ZN (NOR2_X1)\r\n   0.000    0.563 ^ _3076_/D (DFF_X1)\r\n            0.563   data arrival time\r\n\r\n   0.000    0.000   clock clk (rise edge)\r\n   0.000    0.000   clock source latency\r\n   0.000    0.000 ^ clk (in)\r\n   0.056    0.056 ^ clkbuf_0_clk/Z (CLKBUF_X3)\r\n   0.064    0.121 ^ clkbuf_1_0__f_clk/Z (CLKBUF_X3)\r\n   0.084    0.204 ^ _1559_/ZN (AND2_X1)\r\n   0.160    0.365 ^ clkbuf_0_mclk/Z (CLKBUF_X3)\r\n   0.165    0.530 ^ clkbuf_4_5_0_mclk/Z (CLKBUF_X3)\r\n   0.000    0.530 ^ _3076_/CK (DFF_X1)\r\n   0.000    0.530   clock reconvergence pessimism\r\n   0.068    0.598   library hold time\r\n            0.598   data required time\r\n"]
[20345.613, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && python3 - <<'EOF'\r\ns = open('mkMultBuff.sv').read()\r\ns = s.replace(\"    localparam bit [4:0] DUP \", \"    localparam bit       CNT       = 1'b0;   // pointers as 3+3 bits with a registered low-half carry\\n    localparam bit [4:0] DUP \")\r\ns = s.replace(\"    logic [5:0] acc_q, wp_q, rp_q;\\n\", \"    logic [5:0] acc_q, wp_q, rp_q;\\n    logic       wc_q, rc_q;              // CNT: wp_q[2:0] == 7, rp_q[2:0] == 7\\n\")\r\ns = s.replace(\"    wire wr  = v_q[LAT-1];\\n\", \"    wire wr  = v_q[LAT-1];\\n    wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\\n    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\\n\")\r\ns = s.replace(\"acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0;\", \"acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0; wc_q <= 1'b0; rc_q <= 1'b0;\")\r\nold = \"\"\"            if (wr) begin wp_q <= wp_q + 6'd1; wp_on <= ~(wp_q + 6'd1); end\r\n            if (rd) begin rp_q <= rp_q + 6'd1; rp_on <= ~(rp_q + 6'd1); end\"\"\"\r\nnew = \"\"\"            if (wr) begin\r\n                wp_on <= ~(wp_q + 6'd1);\r\n                if (CNT) begin\r\n                    wp_q[2:0] <= wp_q[2:0] + 3'd1;\r\n                    if (wc_q) wp_q[5:3] <= wp_q[5:3] + 3'd1;\r\n                    wc_q <= (wp_q[2:0] == 3'd6);\r\n                end else wp_q <= wp_q + 6'd1;\r\n            end\r\n            if (rd) begin\r\n                rp_on <= ~(rp_q + 6'd1);\r\n                if (CNT) begin\r\n                    rp_q[2:0] <= rp_q[2:0] + 3'd1;\r\n                    if (rc_q) rp_q[5:3] <= rp_q[5:3] + 3'd1;\r\n                    rc_q <= (rp_q[2:0] == 3'd6);\r\n                end else rp_q <= rp_q + 6'd1;\r\n            end\"\"\"\r\nassert old in s; s = s.replace(old, new)\r\ns = s.replace(\"if (wr && wp_q == 6'd63)\", \"if (wr && wp_last)\").replace(\"if (rd && rp_q == 6'd63)\", \"if (rd && rp_last)\")\r\nopen('mkMultBuff.sv','w').write(s)\r\nEOF\r\ngrep -n \"_last\\|wc_q\\|rc_q\" mkMultBuff.sv | head; cd /home/user/elec402-p2-open && build/cand800a/mk.sh e8_cnt CSA_REG=\"4'b1010\" ORD=\"1'b1\" GT=\"1'b1\" GP4=\"1'b0\" CPA=1 CI1=\"1'b1\" DUP=\"5'b00011\" CNT=\"1'b1\" 2>&1 | tail -4\r\n78:    logic       wc_q, rc_q;              // CNT: wp_q[2:0] == 7, rp_q[2:0] == 7\r\n85:    wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\r\n86:    wire rp_last = CNT ? (rc_q && rp_q[5:3] == 3'd7) : (rp_q == 6'd63);\r\n93:            acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0; wc_q <= 1'b0; rc_q <= 1'b0;\r\n104:                    if (wc_q) wp_q[5:3] <= wp_q[5:3] + 3'd1;\r\n105:                    wc_q <= (wp_q[2:0] == 3'd6);\r\n112:                    if (rc_q) rp_q[5:3] <= rp_q[5:3] + 3'd1;\r\n113:                    rc_q <= (rp_q[2:0] == 3'd6);\r\n117:            if (wr && wp_last) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\n118:            if (rd && rp_last) begin\r\ncheck=PASS sim=PASS wns=0.086 whs=0.020\r\narea=4046.658 seq=2000.852 comb=2045.8 flops=442 vectorless_uW=2197.4\r\nactivity_uW: run:=2503.40 fill:=4588.80 drain:=1945.40 \r\nR1op:40(0.226) PP:144(0.150) L2:92(0.152) GP:60(0.151) ADD:43(0.178) PROD:32(0.092) CTRL:31(0.086)\r\n"]
