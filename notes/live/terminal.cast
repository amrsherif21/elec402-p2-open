[20128.51, "o", "\u001b[1;32m$\u001b[0m export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; time bash submission/scripts/eval_candidate.sh 400 build/cg/a/rtl build/cg/a 2>&1 | tail -30\r\nawk: cannot open \"build/cg/a/rep/sta.rpt\" (No such file or directory)\r\nawk: cannot open \"build/cg/a/rep/sta.rpt\" (No such file or directory)\r\ngrep: build/cg/a/rep/sta.rpt: No such file or directory\r\nawk: cannot open \"build/cg/a/rep/sta.rpt\" (No such file or directory)\r\nawk: cannot open \"build/cg/a/rep/sta.rpt\" (No such file or directory)\r\n== build/cg/a RUN=400\r\ncheck=PASS sim=FAIL wns= whs=\r\n(standard_in) 2: syntax error\r\narea= seq= comb=0.0 flops= vectorless_uW=0.0\r\nactivity_uW: \r\nper register group (flops, worst slack):\r\nError: cannot read file build/cg/a/map.v.\r\n\r\nreal\t0m3.476s\r\nuser\t0m0.557s\r\nsys\t0m0.079s\r\n"]
