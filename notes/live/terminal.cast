[2630.455, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && ./path1.sh build/cand_dadda/v3 \"_5993_/D _6003_/D\"; grep -c . /dev/null; ./path1.sh build/cand_dadda/v2 \"_5992_/D\"\r\nStartpoint: _5989_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5993_ (rising edge-triggered flip-flop clocked by clk)\r\n     2    6.148    0.027    0.322    0.322 v _5989_/Q (DFF_X1)\r\n     3    6.693    0.059    0.434    0.756 v _3644_/ZN (OR4_X4)\r\n     2    4.767    0.041    0.237    0.993 v _5234_/ZN (OR3_X4)\r\n     2    5.233    0.042    0.230    1.223 v _5237_/ZN (OR3_X4)\r\n     1    5.838    0.018    0.122    1.345 v _5238_/ZN (AND3_X4)\r\n     2   12.364    0.015    0.078    1.423 v _5239_/Z (BUF_X8)\r\n     1    1.419    0.011    0.025    1.447 ^ _5240_/ZN (INV_X8)\r\n                                    -0.239   slack (VIOLATED)\r\nStartpoint: _5989_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _6003_ (rising edge-triggered flip-flop clocked by clk)\r\n     2    6.148    0.027    0.322    0.322 v _5989_/Q (DFF_X1)\r\n     3    6.693    0.059    0.434    0.756 v _3644_/ZN (OR4_X4)\r\n     2    4.767    0.041    0.237    0.993 v _5234_/ZN (OR3_X4)\r\n     2    5.233    0.042    0.230    1.223 v _5237_/ZN (OR3_X4)\r\n     1    5.838    0.018    0.122    1.345 v _5238_/ZN (AND3_X4)\r\n     2   12.364    0.015    0.078    1.423 v _5239_/Z (BUF_X8)\r\n                                    -0.261   slack (VIOLATED)\r\n0\r\nStartpoint: _6007_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5992_ (rising edge-triggered flip-flop clocked by clk)\r\n     2    8.763    0.078    0.414    0.414 ^ _6007_/Q (DFF_X1)\r\n     6   30.560    0.040    0.102    0.516 ^ _3977_/Z (BUF_X8)\r\n     5   19.832    0.020    0.067    0.582 ^ _3994_/Z (BUF_X16)\r\n     1    1.747    0.034    0.209    0.792 v _5245_/Z (MUX2_X1)\r\n     1    1.922    0.034    0.064    0.856 ^ _5246_/ZN (NAND2_X1)\r\n     1    2.904    0.044    0.056    0.912 v _5247_/ZN (OAI21_X1)\r\n     1    2.014    0.124    0.132    1.044 ^ _5248_/ZN (AOI211_X2)\r\n     1    1.419    0.019    0.089    1.134 ^ _5249_/Z (BUF_X2)\r\n                                     0.072   slack (MET)\r\n"]
[2643.944, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='build/exp/mult_pipe.sv'\r\ns=open(p).read()\r\ns=s.replace(\"    parameter int       CSW       = 8\\n\",\"    parameter int       CSW       = 8,\\n    parameter bit       GP4       = 1'b0\\n\")\r\n# compute l4 as GP form when requested\r\ns=s.replace(\"    assign l4 = csa(l3q[0*32 +: 32], l3q[1*32 +: 32], l3q[2*32 +: 32]);\",\r\n\"\"\"    // level 4 output: the two final rows {c, s}, or (GP4) their bitwise\r\n    // generate / propagate {c & s, c ^ s}, so the adder's first gate level\r\n    // moves in front of the level-4 register\r\n    logic [63:0] l4cs;\r\n    assign l4cs = csa(l3q[0*32 +: 32], l3q[1*32 +: 32], l3q[2*32 +: 32]);\r\n    assign l4 = GP4 ? {l4cs[63:32] & l4cs[31:0], l4cs[63:32] ^ l4cs[31:0]} : l4cs;\"\"\")\r\ns=s.replace(\"\"\"            assign gg  = sx[CSW*i +: CSW] & sy[CSW*i +: CSW];\r\n            assign pp_ = sx[CSW*i +: CSW] ^ sy[CSW*i +: CSW];\"\"\",\"\"\"            if (GP4) begin : g_gp\r\n                assign gg  = sy[CSW*i +: CSW];        // generate (registered)\r\n                assign pp_ = sx[CSW*i +: CSW];        // propagate (registered)\r\n            end else begin : g_cs\r\n                assign gg  = sx[CSW*i +: CSW] & sy[CSW*i +: CSW];\r\n                assign pp_ = sx[CSW*i +: CSW] ^ sy[CSW*i +: CSW];\r\n            end\"\"\")\r\nopen(p,'w').write(s)\r\nt=open('build/exp/top.sv').read()\r\nt=t.replace(\".CSW(`CSWV))\",\".CSW(`CSWV), .GP4(`GP4V))\")\r\nopen('build/exp/top.sv','w').write(t)\r\nr=open('build/exp/run.sh').read()\r\nr=r.replace(\"s/\\\\`CSWV/${CSW:-8}/\\\"\",\"s/\\\\`CSWV/${CSW:-8}/; s/\\\\`GP4V/1'b${GP4:-0}/\\\"\")\r\nopen('build/exp/run.sh','w').write(r)\r\nEOF\r\ngrep -c GP4V build/exp/run.sh; sed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/4/; s/\\`GP4V/1'b1/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head; echo \"$(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; (GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh v800b 1.25 0 1111 0 1000 0 kogge-stone & GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=8 SEL=1 CSL=1 PRE=1 build/exp/run.sh v800d 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning\r\n1\r\nALL PASS\r\nv800b P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5776.456000 rsz_area=5824 wns=0.136 whs=0.025 pwr_est=3.2001e-03\r\nv800d P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5831.784000 rsz_area=5881 wns=0.118 whs=0.028 pwr_est=3.1789e-03\r\n"]
[2654.279, "o", "\u001b[1;32m$\u001b[0m docker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/exp/v800b/rsz.v -e PERIOD=1.25 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/exp/groups.tcl 2>&1 | grep -E \"u_mult|writeMem|wp_q|rp_q|rdy|acc\" ; grep -E \"DFF\" build/exp/v800b/sta.rpt | head -0; grep -cE \"^\\s*DFF\" build/exp/v800b/rsz.v\r\nacc_q                                       0.208\r\nrdy_mult_on                                 0.197\r\nrdy_mult_q                                  0.136\r\nrdy_rd_on                                   0.139\r\nrdy_rd_q                                    0.173\r\nrp_q                                        0.185\r\nu_mult.a17                                  0.252\r\nu_mult.g_csel.bg                            0.350\r\nu_mult.g_csel.co0q                          0.390\r\nu_mult.g_csel.co1q                          0.378\r\nu_mult.g_csel.g_blk[0].P                    0.552\r\nu_mult.g_csel.g_blk[0].pp_                  0.482\r\nu_mult.g_csel.g_blk[1].G                    0.505\r\nu_mult.g_csel.g_blk[1].P                    0.472\r\nu_mult.g_csel.g_blk[1].gg                   0.551\r\nu_mult.g_csel.g_blk[1].pp_                  0.372\r\nu_mult.g_csel.g_blk[2].G                    0.551\r\nu_mult.g_csel.g_blk[2].P                    0.372\r\nu_mult.g_csel.g_blk[2].gg                   0.279\r\nu_mult.g_csel.g_blk[2].pp_                  0.218\r\nu_mult.g_csel.g_blk[3].G                    0.388\r\nu_mult.g_csel.g_blk[3].P                    0.353\r\nu_mult.g_csel.g_blk[3].gg                   0.280\r\nu_mult.g_csel.g_blk[3].pp_                  0.214\r\nu_mult.g_csel.g_blk[4].G                    0.284\r\nu_mult.g_csel.g_blk[4].P                    0.250\r\nu_mult.g_csel.g_blk[4].gg                   0.280\r\nu_mult.g_csel.g_blk[4].pp_                  0.214\r\nu_mult.g_csel.g_blk[5].G                    0.284\r\nu_mult.g_csel.g_blk[5].P                    0.250\r\nu_mult.g_csel.g_blk[5].gg                   0.280\r\nu_mult.g_csel.g_blk[5].pp_                  0.214\r\nu_mult.g_csel.g_blk[6].G                    0.280\r\nu_mult.g_csel.g_blk[6].P                    0.214\r\nu_mult.g_csel.g_blk[6].gg                   0.279\r\nu_mult.g_csel.g_blk[6].pp_                  0.213\r\nu_mult.g_csel.g_blk[7].G                    0.362\r\nu_mult.g_csel.g_blk[7].P                    0.327\r\nu_mult.g_csel.g_blk[7].gg                   0.551\r\nu_mult.g_csel.g_blk[7].pp_                  0.371\r\nu_mult.g_csel.psel                          0.353\r\nu_mult.g_csel.s0q                           0.258\r\nu_mult.g_csel.s1q                           0.188\r\nu_mult.g_pre.neg_q                          0.317\r\nu_mult.g_pre.one_q                          0.351\r\nu_mult.g_pre.two_q                          0.157\r\nu_mult.g_sel.negq                           0.305\r\nu_mult.g_sel.ppq                            0.175\r\nu_mult.l1q                                  0.360\r\nu_mult.l2q                                  0.360\r\nu_mult.l3q                                  0.360\r\nwp_q                                        0.206\r\nwriteMem_val                                0.139\r\n668\r\n"]
[2682.897, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\ns = open('top2.sv.in').read()\r\na = s.index(\"    // next state (computed once\")\r\nb = s.index(\"    logic signed [31:0] p;\")\r\nnew = \"\"\"    // next state (computed once, loaded into both twins). The comparisons with 63\r\n    // are precomputed one cycle ahead into acc_last_q / ptr_last_q.\r\n    logic       acc_last_q, ptr_last_q;   // acc_q == 63, ptr == 63\r\n    wire        wr_last = wr & ptr_last_q;\r\n    wire        rd_last = rd & ptr_last_q;\r\n    wire        rdy_mult_d = rd_last | (~nrdy_mult_q & ~(acc & acc_last_q));\r\n    wire        rdy_rd_d   = wr_last | (~nrdy_rd_q & ~rd_last);\r\n    wire        step       = wr | rd;\r\n    wire [5:0]  ptr_d      = step ? ptr + 6'd1 : ptr;\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0; wr_q <= 1'b0; ptr_q <= '0;\r\n            nrdy_mult_q <= 1'b0; nrdy_rd_q <= 1'b1; nwr_q <= 1'b1; nptr_q <= '1;\r\n            acc_q <= '0; v_q <= '0; acc_last_q <= 1'b0; ptr_last_q <= 1'b0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-3:0], acc};\r\n            wr_q <= v_q[LAT-2];   nwr_q <= ~v_q[LAT-2];\r\n            if (acc) begin\r\n                acc_q <= acc_q + 6'd1;\r\n                acc_last_q <= (acc_q == 6'd62);\r\n            end\r\n            if (step) ptr_last_q <= (ptr == 6'd62);\r\n            rdy_mult_q <= rdy_mult_d; nrdy_mult_q <= ~rdy_mult_d;\r\n            rdy_rd_q   <= rdy_rd_d;   nrdy_rd_q   <= ~rdy_rd_d;\r\n            ptr_q      <= ptr_d;      nptr_q      <= ~ptr_d;\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n\r\n\"\"\"\r\ns = s[:a] + new + s[b:]\r\ns = s.replace(\"// output load (4 x NAND2_X4) is not on the internal paths. Each copy always\\n// holds the complement of its output twin (same next-state value, same reset).\",\r\n \"// output load (4 x NAND2_X4) is not on the internal paths. Each copy always\\n// holds the complement of its output twin (same next-state value, same reset).\\n// The end-of-phase conditions acc_q == 63 and ptr == 63 are registered flags.\")\r\nopen('top3.sv.in','w').write(s)\r\nEOF\r\nsed -i 's/\"top2.sv.in\"/os.environ.get(\"TOP\", \"top3.sv.in\")/' gen2.py && sed -n 35,80p top3.sv.in\r\n    localparam int LAT = @LAT@;          // multiplier latency (register ranks)\r\n\r\n    // output-port registers\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q, wr_q;\r\n    logic [5:0] ptr_q;\r\n    // internal copies (complemented): n*_q == ~(output twin) at all times\r\n    logic       nrdy_mult_q, nrdy_rd_q, nwr_q;\r\n    logic [5:0] nptr_q;\r\n    logic [5:0] acc_q;\r\n    logic [LAT-2:0] v_q;                 // valid bit of pipeline ranks 1..LAT-1\r\n\r\n    wire       acc = EN_mult & ~nrdy_mult_q;\r\n    wire       rd  = EN_blockRead & ~nrdy_rd_q;\r\n    wire       wr  = ~nwr_q;\r\n    wire [5:0] ptr = ~nptr_q;\r\n\r\n    // next state (computed once, loaded into both twins). The comparisons with 63\r\n    // are precomputed one cycle ahead into acc_last_q / ptr_last_q.\r\n    logic       acc_last_q, ptr_last_q;   // acc_q == 63, ptr == 63\r\n    wire        wr_last = wr & ptr_last_q;\r\n    wire        rd_last = rd & ptr_last_q;\r\n    wire        rdy_mult_d = rd_last | (~nrdy_mult_q & ~(acc & acc_last_q));\r\n    wire        rdy_rd_d   = wr_last | (~nrdy_rd_q & ~rd_last);\r\n    wire        step       = wr | rd;\r\n    wire [5:0]  ptr_d      = step ? ptr + 6'd1 : ptr;\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0; wr_q <= 1'b0; ptr_q <= '0;\r\n            nrdy_mult_q <= 1'b0; nrdy_rd_q <= 1'b1; nwr_q <= 1'b1; nptr_q <= '1;\r\n            acc_q <= '0; v_q <= '0; acc_last_q <= 1'b0; ptr_last_q <= 1'b0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-3:0], acc};\r\n            wr_q <= v_q[LAT-2];   nwr_q <= ~v_q[LAT-2];\r\n            if (acc) begin\r\n                acc_q <= acc_q + 6'd1;\r\n                acc_last_q <= (acc_q == 6'd62);\r\n            end\r\n            if (step) ptr_last_q <= (ptr == 6'd62);\r\n            rdy_mult_q <= rdy_mult_d; nrdy_mult_q <= ~rdy_mult_d;\r\n            rdy_rd_q   <= rdy_rd_d;   nrdy_rd_q   <= ~rdy_rd_d;\r\n            ptr_q      <= ptr_d;      nptr_q      <= ~ptr_d;\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n"]
[2694.406, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && for o in \"--b1 0.66 --budget 0.62\" \"--b1 0.62 --budget 0.62\" \"--b1 0.66 --budget 0.66 --xor 0.18 --maj 0.2\" \"--b1 0.66 --budget 0.70 --xor 0.18 --maj 0.2\" \"--b1 0.66 --budget 0.64 --maj 0.2\" \"--b1 0.70 --budget 0.62 --t-and 0.2 --xor 0.2\"; do echo \"== $o: $(python3 gen2.py /tmp/claude-0/x $o --k 4 --cpa3 | grep -o 'LAT=.*\\|[0-9]* flops' | tr '\\n' ' ')\"; done\r\n== --b1 0.66 --budget 0.62: LAT=8 datapath flops=577 173 flops 102 flops 64 flops 50 flops 65 flops 59 flops 32 flops \r\n== --b1 0.62 --budget 0.62: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\n== --b1 0.66 --budget 0.66 --xor 0.18 --maj 0.2: LAT=8 datapath flops=577 173 flops 102 flops 64 flops 50 flops 65 flops 59 flops 32 flops \r\n== --b1 0.66 --budget 0.70 --xor 0.18 --maj 0.2: LAT=8 datapath flops=579 173 flops 102 flops 65 flops 51 flops 65 flops 59 flops 32 flops \r\n== --b1 0.66 --budget 0.64 --maj 0.2: LAT=8 datapath flops=577 173 flops 102 flops 64 flops 50 flops 65 flops 59 flops 32 flops \r\n== --b1 0.70 --budget 0.62 --t-and 0.2 --xor 0.2: LAT=8 datapath flops=577 173 flops 102 flops 64 flops 50 flops 65 flops 59 flops 32 flops\r\n"]
