[642.347, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/testbench/rtl_checker.sv'\r\ns=open(p).read()\r\nold='''            model_reset();\r\n            m_active = 1;\r\n            m_post_reset = 1;\r\n            return;\r\n        end\r\n        if (!m_active) return;\r\n'''\r\nnew='''            model_reset();\r\n            m_active = 1;\r\n            m_post_reset = 1;\r\n        end else if (m_active) begin\r\n            check_active();\r\n        end\r\n    endtask\r\n\r\n    task automatic check_active();\r\n        bit exp_rdy_m, exp_rdy_b, acc, rd_acc, exp_wr;\r\n        logic [31:0] p;\r\n'''\r\nassert old in s\r\ns=s.replace(old,new)\r\n# remove the now-unused decls in check_cycle\r\ns=s.replace('''    task automatic check_cycle();\r\n        bit exp_rdy_m, exp_rdy_b, acc, rd_acc, exp_wr;\r\n        logic [31:0] p;\r\n\r\n''','''    task automatic check_cycle();\r\n''')\r\nold2='''        if (!cfg_pwr) return;\r\n        if (!pwr_fill_done) begin'''\r\nnew2='''        if (cfg_pwr && !pwr_fill_done) begin'''\r\nassert old2 in s\r\ns=s.replace(old2,new2)\r\ns=s.replace('''        if (!pwr_drain_done) begin\r\n            if (was_rd) pwr_drain_cnt++;''','''        if (cfg_pwr && !pwr_drain_done) begin\r\n            if (was_rd) pwr_drain_cnt++;''')\r\nopen(p,'w').write(s)\r\nEOF\r\ngrep -n \"return;\" submission/testbench/rtl_checker.sv; git status --short\r\n M .gitignore\r\n?? Makefile\r\n?? submission/outputs/mkMultBuff_400_map.sdf\r\n?? submission/outputs/mkMultBuff_400_map.v\r\n?? submission/rtl_400/mkMultBuff.sv\r\n?? submission/scripts/abc_speed.script\r\n?? submission/scripts/constraints.tcl\r\n?? submission/scripts/install.sh\r\n?? submission/scripts/sta.tcl\r\n?? submission/scripts/synth.tcl\r\n?? submission/syn_reports/400/\r\n?? submission/syn_reports/tool_versions.txt\r\n?? submission/testbench/rtl_checker.sv\r\n"]
