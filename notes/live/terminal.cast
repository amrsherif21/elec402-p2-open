[768.711, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/submission/testbench && sed -i 's/==== %m summary/==== mkMultBuff_sdf_checker_400 summary/' sdf_checker_400.sv && sed -e 's/_400/_800/g; s/400 MHz/800 MHz/g; s/period fixed at 2.5 ns/period fixed at 1.25 ns/; s/HALF_NS = 1.25;   \\/\\/ 2.5 ns period -> 800 MHz/HALF_NS = 0.625;  \\/\\/ 1.25 ns period -> 800 MHz/' sdf_checker_400.sv > sdf_checker_800.sv && diff sdf_checker_400.sv sdf_checker_800.sv\r\n1,3c1,3\r\n< // sdf_checker_400.sv -- ELEC 402 2026 Project 2. 400 MHz gate-level (SDF) checker.\r\n< // Top module: mkMultBuff_sdf_checker_400. Clock period fixed at 2.5 ns.\r\n< // The flow passes +sdf_file=submission/outputs/mkMultBuff_400_map.sdf at run time.\r\n---\r\n> // sdf_checker_800.sv -- ELEC 402 2026 Project 2. 800 MHz gate-level (SDF) checker.\r\n> // Top module: mkMultBuff_sdf_checker_800. Clock period fixed at 1.25 ns.\r\n> // The flow passes +sdf_file=submission/outputs/mkMultBuff_800_map.sdf at run time.\r\n37c37\r\n< module mkMultBuff_sdf_checker_400;\r\n---\r\n> module mkMultBuff_sdf_checker_800;\r\n39c39\r\n<     localparam real HALF_NS = 1.25;   // 2.5 ns period -> 400 MHz\r\n---\r\n>     localparam real HALF_NS = 0.625;  // 1.25 ns period -> 800 MHz\r\n285c285\r\n<         $display(\"==== mkMultBuff_sdf_checker_400 summary: period %0.3f ns, seed %0d, latency %0d, %0d cycles, %0d accepted, %0d returned, %0d failure(s) ====\",\r\n---\r\n>         $display(\"==== mkMultBuff_sdf_checker_800 summary: period %0.3f ns, seed %0d, latency %0d, %0d cycles, %0d accepted, %0d returned, %0d failure(s) ====\",\r\n292c292\r\n< endmodule : mkMultBuff_sdf_checker_400\r\n---\r\n> endmodule : mkMultBuff_sdf_checker_800\r\n"]
[780.73, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open\r\ncat > slowmodel_wrap.sv <<'EOF'\r\nEOF\r\n# variant of model with a delayed multiplier input path (BUG 9)\r\nsed -e 's/prod = \\$signed(mult_input0) \\* \\$signed(mult_input1);/prod = $signed(a_d) * $signed(b_d);/' -e 's/^  logic \\[31:0\\] prod;/  logic [31:0] prod; logic [15:0] a_d, b_d; assign #(1.4) a_d = mult_input0; assign #(1.4) b_d = mult_input1;/' model.sv > model_slow.sv\r\nsed -i '1i `timescale 1ns/1ps' model_slow.sv; sed -i '1i `timescale 1ns/1ps' model.sv 2>/dev/null; grep -n \"a_d\" model_slow.sv | head -3\r\nfor f in 400 800; do for m in model model_slow; do for L in 2 4; do\r\niverilog -g2012 -gspecify -DLATV=$L -o s.vvp $R/submission/testbench/sdf_checker_$f.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv $m.sv 2>&1 | grep -v -e sdf_annot -e \"constant selects\"\r\nvvp -n s.vvp > slog_${f}_${m}_$L.txt; echo \"$f $m L=$L: $(grep -E 'latency measured' slog_${f}_${m}_$L.txt | sed 's/.*= //') | $(tail -2 slog_${f}_${m}_$L.txt | head -1)\"\r\ndone; done; done\r\nhead -5 slog_800_model_slow_2.txt; grep summary slog_400_model_2.txt\r\n26:  logic [31:0] prod; logic [15:0] a_d, b_d; assign #(1.4) a_d = mult_input0; assign #(1.4) b_d = mult_input1;\r\n28:    prod = $signed(a_d) * $signed(b_d);\r\n400 model L=2: 2 cycles | ALL PASS\r\n400 model L=4: 4 cycles | ALL PASS\r\n400 model_slow L=2: 2 cycles | ALL PASS\r\n400 model_slow L=4: 4 cycles | ALL PASS\r\n800 model L=2: 2 cycles | ALL PASS\r\n800 model L=4: 4 cycles | ALL PASS\r\n800 model_slow L=2: 2 cycles | TIMING FAIL: 378 failure(s)\r\n800 model_slow L=4: 4 cycles | TIMING FAIL: 381 failure(s)\r\nWARNING: /home/user/elec402-p2-open/submission/testbench/sdf_checker_800.sv:82: $sdf_annotate currently only uses the first two argument.\r\nINFO t=10000 ps: latency measured from the first write = 2 cycles\r\nTIMING FAIL t=91250 ps cycle=73: memVal_data=00000000 expected 40000000, product #0 (-32768 * -32768), xor=40000000\r\nTIMING FAIL t=92500 ps cycle=74: memVal_data=00000000 expected ffffffff, product #1 (-1 * 1), xor=ffffffff\r\nTIMING FAIL t=95000 ps cycle=76: memVal_data=00000000 expected 3fff0001, product #3 (32767 * 32767), xor=3fff0001\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 2, 887 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\n"]
[788.355, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/checkers_scratch && R=/home/user/elec402-p2-open\r\nsed -e 's/assign RDY_mult = (BUG == 5)/assign RDY_mult = (BUG == 10) ? 1'\"'\"'b0 : (BUG == 5)/' model.sv > model_dead.sv\r\nfor cfg in \"model 1\" \"model 3\" \"model 4\" \"model 6\" \"model_dead 10\"; do set -- $cfg\r\niverilog -g2012 -gspecify -DLATV=3 -DBUGV=$2 -o s.vvp $R/submission/testbench/sdf_checker_400.sv $R/starter/rtl/memory_wrapper_2port.sv $R/starter/rtl/registerArray.sv $1.sv 2>&1 | grep -v -e sdf_annot -e \"constant selects\"\r\nvvp -n s.vvp > slog_b$2.txt; echo \"BUG $2: $(tail -2 slog_b$2.txt | head -1) | $(grep -m1 'TIMING FAIL t' slog_b$2.txt)\"; done\r\nBUG 1: TIMING FAIL: 97 failure(s) | TIMING FAIL t=187500 ps cycle=75: memVal_data=ffffff7f expected ffffffff, product #1 (-1 * 1), xor=00000080\r\nBUG 3: TIMING FAIL: 383 failure(s) | TIMING FAIL t=185000 ps cycle=74: memVal_data=ffd48057 expected 40000000, product #0 (-32768 * -32768), xor=bfd48057\r\nBUG 4: ALL PASS | \r\nBUG 6: ALL PASS | \r\nBUG 10: TIMING FAIL: 2 failure(s) | TIMING FAIL t=10015000 ps cycle=4006: phase 0: fill not completed (0 accepted)\r\n"]
[798.567, "o", "\u001b[1;32m$\u001b[0m ls /opt 2>/dev/null; find / -xdev \\( -iname \"*nangate*\" -o -iname \"NangateOpenCellLibrary*.v\" -o -iname \"cells.v\" \\) -not -path \"*/proc/*\" 2>/dev/null | grep -v elec402-p2-open/.git | head\r\napache-maven-3.9.11\r\nclaude-code\r\ncontainerd\r\ncu-desktop\r\nenv-runner\r\ngoogle\r\ngoogle-cloud-sdk\r\ngradle\r\ngradle-8.14.3\r\nmaven\r\nnode-tools\r\nnode22\r\nnode24\r\nnvm\r\npw-browsers\r\nrbenv\r\nrclone\r\nrclone-attach\r\nruby-3.1.6\r\nruby-3.2.6\r\nruby-3.3.6\r\n/tmp/claude-0/probe/orfs/flow/platforms/nangate45\r\n/tmp/claude-0/probe/orfs/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/cdl/NangateOpenCellLibrary.cdl\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/lef/NangateOpenCellLibrary.macro.rect.lef\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/lef/NangateOpenCellLibrary.macro.lef\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/lef/NangateOpenCellLibrary.tech.lef\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/gds/NangateOpenCellLibrary.gds\r\n/var/lib/docker/containerd/daemon/io.containerd.snapshotter.v1.overlayfs/snapshots/26/fs/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/Nan