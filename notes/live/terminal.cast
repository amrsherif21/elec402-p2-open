[21029.108, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\ns = s.replace('choices=[\"dadda\", \"wallace\", \"fill\"])', 'choices=[\"dadda\", \"wallace\", \"fill\"])\\nap.add_argument(\"--wlevels\", type=int, default=99, help=\"wallace: levels done Wallace-style; the rest Dadda\")')\r\ns = s.replace('if args.mode in (\"dadda\", \"wallace\"):', 'if args.mode in (\"dadda\", \"wallace\"):', 1)\r\nold = '''        if args.mode == \"dadda\":\r\n            d = max(x for x in DADDA if x < maxh(cols))\r\n            cols, nf, nh = level_dadda(cols, d)\r\n        else:\r\n            cols, nf, nh = level_wallace(cols)\r\n        sf += nf; sh += nh'''\r\nnew = '''        if args.mode == \"dadda\" or lv > args.wlevels:\r\n            d = max(x for x in DADDA if x < maxh(cols))\r\n            cols, nf, nh = level_dadda(cols, d)\r\n        else:\r\n            cols, nf, nh = level_wallace(cols)\r\n        sf += nf; sh += nh'''\r\nassert old in s; s = s.replace(old, new)\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor w in 99 1 2 3; do python3 gen_tree.py /dev/null --mode wallace --wlevels $w --cuts 2,4 --gp cpa --k0 8 --k 5 | grep \"LAT\\|R3\\|R4\"; done\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=55\r\n  R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n  R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\nLAT=6 ranks=[40, 144, 98, 61, 41, 32] datapath flops=416 FA=91 HA=29\r\n  R3 after level 2: 53 FA 21 HA, model arrival 0.72, 98 flops\r\n  R4 after level 4: 38 FA 8 HA, model arrival 0.66, 61 flops\r\nLAT=6 ranks=[40, 144, 86, 61, 41, 32] datapath flops=404 FA=91 HA=38\r\n  R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n  R4 after level 4: 25 FA 14 HA, model arrival 0.66, 61 flops\r\nLAT=6 ranks=[40, 144, 86, 60, 41, 32] datapath flops=403 FA=91 HA=49\r\n  R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n  R4 after level 4: 25 FA 25 HA, model arrival 0.66, 60 flops\r\n"]
[21075.126, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && cat > /tmp/claude-0/path.tcl <<'EOF'\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nforeach g $::env(GROUPS) {\r\n  set pins [get_pins -hierarchical */D]\r\n  set ff {}\r\n  foreach inst [get_cells *] {\r\n    if {![string match DFF* [get_property $inst ref_name]]} continue\r\n    set q [get_full_name [get_nets -of_objects [get_pins [get_full_name $inst]/Q]]]\r\n    if {[string match \"$g\\\\\\[*\" $q]} { lappend ff [get_pins [get_full_name $inst]/D] }\r\n  }\r\n  puts \"=== $g [llength $ff]\"\r\n  report_checks -to $ff -format full -fields {fanout} -digits 3\r\n}\r\nEOF\r\ncp /tmp/claude-0/path.tcl /home/user/elec402-p2-open/build/cand800b/path.tcl; cd /home/user/elec402-p2-open && docker run --rm -v \"$PWD:$PWD\" -w \"$PWD\" -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cand800b/w24cpa5/map.v -e PERIOD=1.25 -e GROUPS=\"u_mult.r3 u_mult.r5\" --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cand800b/path.tcl 2>&1 | grep -v \"^Warning\\|^ *$\\|---\\|clock\\|required\\|library\" | grep -v \"^ *0\\.[0-9]* *0.000\"\r\nError: path.tcl, 4 can't read \"period\": no such variable\r\n"]
