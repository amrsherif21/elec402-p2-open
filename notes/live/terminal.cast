[20181.998, "o", "\u001b[1;32m$\u001b[0m sed -i 's/^set -uo pipefail/set -uo pipefail; set -f/' build/cg/scripts/eval_cg.sh && export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; time bash build/cg/scripts/eval_cg.sh 400 build/cg/a/rtl build/cg/a 2>&1 | tail -30\r\n== build/cg/a RUN=400\r\ncheck=PASS sim=PASS wns=0.231 whs=0.040\r\narea=2532.852 seq=673.778 comb=1859.1 flops=149 vectorless_uW=705.9\r\nactivity_uW: run:=502.72 fill:=1706.20 drain:=108.84 \r\nper register group (flops, worst slack):\r\nEN_writeMem                             1    1.790\r\nRDY_blockRead                           1    0.989\r\nRDY_mult                                1    0.943\r\nVALID_memVal                            1    1.309\r\nacc_q                                   6    0.808\r\nreadMem_addr                            6    0.602\r\nu_mult.a17                             16    1.050\r\nu_mult.g_pre.neg_q                      8    1.243\r\nu_mult.g_pre.one_q                      8    1.254\r\nu_mult.g_pre.two_q                      8    1.154\r\nu_mult.l4q                             59    0.249\r\nv_q                                     2    1.142\r\nwriteMem_val                           32    0.231\r\n\r\nreal\t0m11.738s\r\nuser\t0m2.805s\r\nsys\t0m0.270s\r\n"]
