[20195.457, "o", "\u001b[1;32m$\u001b[0m W=build/cg/a; grep -A8 '(INSTANCE _1559_)' $W/map.sdf; grep -B3 -A10 '(INSTANCE _3121_)' $W/map.sdf | head -20; grep -c \"mclk\" $W/map.v\r\n  (INSTANCE _1559_)\r\n  (DELAY\r\n   (ABSOLUTE\r\n    (IOPATH A1 ZN (2.0092:2.0092:2.0092) (0.6169:0.6169:0.6169))\r\n    (IOPATH A2 ZN (2.0260:2.0260:2.0260) (0.6478:0.6478:0.6478))\r\n   )\r\n  )\r\n )\r\n (CELL\r\n )\r\n (CELL\r\n  (CELLTYPE \"DLL_X1\")\r\n  (INSTANCE _3121_)\r\n  (DELAY\r\n   (ABSOLUTE\r\n    (IOPATH D Q (0.1005:0.1043:0.1043) (0.2146:0.2250:0.2250))\r\n    (IOPATH GN Q (0.3042:0.3042:0.3042) (0.3995:0.3995:0.3995))\r\n   )\r\n  )\r\n  (TIMINGCHECK\r\n    (SETUP (posedge D) (posedge GN) (0.1178:0.1193:0.1193))\r\n    (SETUP (negedge D) (posedge GN) (0.1014:0.1111:0.1111))\r\n    (HOLD (posedge D) (posedge GN) (0.0887:0.0946:0.0946))\r\n133\r\n"]
[20200.909, "o", "\u001b[1;32m$\u001b[0m export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; make timing RUN=400 BUILD=build/cg/a REP=build/cg/a/rep NETLIST=build/cg/a/map.v SDF=build/cg/a/map.sdf 2>&1 | tail -15; grep -i \"max_slew\\|max_cap\\|violat\" -A5 build/cg/a/rep/sta.rpt | head -20; grep -i \"clock\\|mclk\\|RSZ\" build/cg/a/rep/resize.log | head\r\nvvp -n build/cg/a/timing.vvp +sdf_file=build/cg/a/map.sdf +seed=402 > build/cg/a/rep/timing.log 2>&1 ; true\r\nTIMING FAIL t=257500 ps cycle=103: X on memVal_data=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx, product #29 (15916 * -1)\r\nTIMING FAIL ... further messages suppressed\r\nINFO t=340000 ps: phase 0 complete (64 accepted, 63 returned)\r\nINFO t=667500 ps: phase 1 complete (128 accepted, 127 returned)\r\nINFO t=1027500 ps: phase 2 complete (192 accepted, 191 returned)\r\nINFO t=1462500 ps: phase 3 complete (256 accepted, 255 returned)\r\nINFO t=1887500 ps: phase 4 complete (320 accepted, 319 returned)\r\nINFO t=2215000 ps: phase 5 complete (384 accepted, 383 returned)\r\n\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 3, 894 cycles, 384 accepted, 384 returned, 384 failure(s) ====\r\nTIMING FAIL: 384 failure(s)\r\nsubmission/testbench/sdf_checker_400.sv:289: $finish called at 2235000 (1ps)\r\ntiming FAILED\r\nmake: *** [Makefile:99: timing] Error 1\r\n[INFO RSZ-0504] Runtime: 1.73s\r\n[WARNING RSZ-3244] -effort has no effect unless -phases lists PARALLEL_EVAL.\r\n[INFO RSZ-0100] Repair move sequence: UnbufferMove SizeUpMove SwapPinsMove BufferMove CloneMove SplitLoadMove \r\n[INFO RSZ-0098] No setup violations found\r\n[INFO RSZ-0505] Runtime: 0.03s\r\n[INFO RSZ-0046] Found 18 endpoints with hold violations.\r\n[INFO RSZ-0032] Inserted 18 hold buffers.\r\n[INFO RSZ-0506] Runtime: 0.45s\r\n"]
[20205.056, "o", "\u001b[1;32m$\u001b[0m build/cand800a/mk.sh e5_csw8 CSA_REG=\"4'b1010\" ORD=\"1'b1\" GT=\"1'b1\" GP4=\"1'b0\" CPA=1 CI1=\"1'b1\" CSW=8 2>&1 | tail -4\r\ncheck=PASS sim=PASS wns=-0.047 whs=0.020\r\narea=4300.422 seq=2021.334 comb=2279.1 flops=447 vectorless_uW=2260.7\r\nactivity_uW: run:=2579.50 fill:=4852.30 drain:=1987.60 \r\nR1op:40(0.148) PP:144(0.160) L2:92(0.079) GP:60(0.149) ADD:37(-0.028) PROD:32(-0.047) CTRL:42(0.096)\r\n"]
[20214.271, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && python3 - <<'EOF'\r\ns = open('mkMultBuff.sv').read()\r\ns = s.replace(\"    localparam bit       ORD       = 1'b0;\\n\", \"    localparam bit       ORD       = 1'b0;\\n    localparam bit       DUP       = 1'b1;   // port-only copies of the ready flags, addresses, write enable\\n\")\r\nold = s[s.index(\"    assign RDY_mult      = ~rdy_mult_on;\"):s.index(\"    assign writeMem_val  = p;\")]\r\nnew = \"\"\"    generate if (DUP) begin : g_dup\r\n        assign RDY_mult      = ~rdy_mult_on;\r\n        assign RDY_blockRead = ~rdy_rd_on;\r\n        assign EN_writeMem   = ~wr_on;\r\n        assign writeMem_addr = ~wp_on;\r\n        assign readMem_addr  = ~rp_on;\r\n    end else begin : g_nodup\r\n        assign RDY_mult      = rdy_mult_q;\r\n        assign RDY_blockRead = rdy_rd_q;\r\n        assign EN_writeMem   = wr;\r\n        assign writeMem_addr = wp_q;\r\n        assign readMem_addr  = rp_q;\r\n    end endgenerate\r\n\"\"\"\r\ns = s.replace(old, new)\r\ns = s.replace(\"    assign readMem_addr  = ~rp_on;\\n    assign VALID_memVal\", \"    assign VALID_memVal\")\r\nopen('mkMultBuff.sv','w').write(s)\r\nEOF\r\ngrep -n \"assign\" mkMultBuff.sv\r\n112:        assign RDY_mult      = ~rdy_mult_on;\r\n113:        assign RDY_blockRead = ~rdy_rd_on;\r\n114:        assign EN_writeMem   = ~wr_on;\r\n115:        assign writeMem_addr = ~wp_on;\r\n116:        assign readMem_addr  = ~rp_on;\r\n118:        assign RDY_mult      = rdy_mult_q;\r\n119:        assign RDY_blockRead = rdy_rd_q;\r\n120:        assign EN_writeMem   = wr;\r\n121:        assign writeMem_addr = wp_q;\r\n122:        assign readMem_addr  = rp_q;\r\n124:    assign writeMem_val  = p;\r\n125:    assign EN_readMem    = rd;\r\n126:    assign VALID_memVal  = vld_q;\r\n127:    assign memVal_data   = readMem_val;\r\n"]
