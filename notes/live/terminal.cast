[2589.292, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime && (./src/run.sh b1_r6 6 1 fix build/cand_retime/src/retime.script > b1_r6.out 2>&1 &); (./src/run.sh b1_r7 7 1 fix build/cand_retime/src/retime.script > b1_r7.out 2>&1 &); cd /home/user/elec402-p2-open && build/cand_retime/src/f14.sh build/cand_retime/b1_r5_fixR/map.v\r\nF14CHECK: flops 459, reset-gated 459 (of which reset-to-1 1), NOT reset-gated 0:\r\n"]
[2595.419, "o", "\u001b[1;32m$\u001b[0m cat > build/exp/groups.tcl <<'EOF'\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\narray set w {}\r\nforeach inst [get_cells *] {\r\n  set ref [get_property $inst ref_name]\r\n  if {![string match DFF* $ref]} continue\r\n  set q [get_nets -of_objects [get_pins $inst/Q]]\r\n  set name [regsub {\\s*\\[[0-9]+\\]$} [get_full_name $q] \"\"]\r\n  set name [regsub {\\[[0-9]+\\]\\s*$} $name \"\"]\r\n  set s [get_property [get_pins $inst/D] slack_max]\r\n  if {![info exists w($name)] || $s < $w($name)} { set w($name) $s }\r\n}\r\nforeach n [lsort [array names w]] { puts [format \"%-40s %8.3f\" $n $w($n)] }\r\nEOF\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/exp/u800b/rsz.v -e PERIOD=1.25 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/exp/groups.tcl 2>&1 | tail -40\r\nWarning 363: groups.tcl line 1, pin '_4043626899550000_p_Instance/Q' not found.\r\nError 2204: groups.tcl line 1, get_property  is not an object.\r\n"]
