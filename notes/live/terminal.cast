[1321.598, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/scripts/synth.tcl'\r\ns=open(p).read()\r\ns=s.replace('abc -D $abc_d -liberty $lib -script submission/scripts/abc_speed.script -constr [file rootname $out].abc.constr',\r\n'''set abc_script [expr {[info exists ::env(ABC_SCRIPT)] ? $::env(ABC_SCRIPT) : \"submission/scripts/abc_speed.script\"}]\r\nif {$abc_script eq \"default\"} {\r\n    abc -D $abc_d -liberty $lib -constr [file rootname $out].abc.constr\r\n} else {\r\n    abc -D $abc_d -liberty $lib -script $abc_script -constr [file rootname $out].abc.constr\r\n}''')\r\nopen(p,'w').write(s)\r\nEOF\r\nsed -i 's/-e BOOTH=${7:-0} -e ADDER=${8:-sklansky}/-e BOOTH=${7:-0} -e ADDER=${8:-sklansky} -e ABC_SCRIPT=${ABC_SCRIPT:-submission\\/scripts\\/abc_speed.script}/' build/exp/run.sh\r\n(ABC_SCRIPT=default PRE=1 build/exp/run.sh q400a 2.5 0 1000 0 2000 & PRE=1 build/exp/run.sh q400b 2.5 0 1000 0 2000 0 kogge-stone & PRE=1 build/exp/run.sh q400c 2.5 0 1000 0 2000 0 han-carlson & wait) 2>&1 | grep -v Warning\r\nABC_SCRIPT=default PRE=1 build/exp/run.sh q400d 2.5 0 1000 0 2000 0 kogge-stone 2>&1 | grep -v Warning\r\nq400b P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2242.646000 rsz_area=2281 wns=0.000 whs=0.055 pwr_est=6.2121e-04\r\nq400c P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2222.696000 rsz_area=2301 wns=-0.273 whs=0.053 pwr_est=6.2153e-04\r\nq400a P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2107.518000 rsz_area=2322 wns=-1.404 whs=0.024 pwr_est=6.2656e-04\r\nq400d P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2135.980000 rsz_area=2297 wns=-0.459 whs=0.024 pwr_est=6.1979e-04\r\n"]
[1333.266, "o", "\u001b[1;32m$\u001b[0m (for d in 1500 1800 2300; do PRE=1 build/exp/run.sh r400_$d 2.5 0 1000 0 $d 0 kogge-stone & done; wait) 2>&1 | grep -v Warning\r\nr400_1500 P=2.5 enc=0 csa=1000 spl=0 abcD=1500 | yosys_area=2242.646000 rsz_area=2281 wns=0.000 whs=0.055 pwr_est=6.2121e-04\r\nr400_2300 P=2.5 enc=0 csa=1000 spl=0 abcD=2300 | yosys_area=2242.646000 rsz_area=2281 wns=0.000 whs=0.055 pwr_est=6.2121e-04\r\nr400_1800 P=2.5 enc=0 csa=1000 spl=0 abcD=1800 | yosys_area=2242.646000 rsz_area=2281 wns=0.000 whs=0.055 pwr_est=6.2121e-04\r\n"]
[1350.464, "o", "\u001b[1;32m$\u001b[0m sed -i 's/repair_timing -setup -repair_tns 100 -setup_margin 0.0/repair_timing -setup -repair_tns 100 -setup_margin [expr {[info exists ::env(SETUP_MARGIN)] ? $::env(SETUP_MARGIN) : 0.15}]/' submission/scripts/resize.tcl && (PRE=1 build/exp/run.sh s400a 2.5 0 1000 0 2000 0 kogge-stone & PRE=1 build/exp/run.sh s400b 2.5 0 0100 0 2000 0 kogge-stone & PRE=1 build/exp/run.sh s400c 2.5 0 1000 0 2000 0 sklansky & wait) 2>&1 | grep -v Warning\r\ns400b P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2381.764000 rsz_area=2387 wns=0.152 whs=0.053 pwr_est=6.5253e-04\r\ns400a P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2242.646000 rsz_area=2347 wns=0.045 whs=0.055 pwr_est=6.2967e-04\r\ns400c P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2246.104000 rsz_area=2403 wns=-0.354 whs=0.055 pwr_est=6.3654e-04\r\n"]
[1363.601, "o", "\u001b[1;32m$\u001b[0m (SETUP_MARGIN=0.3 PRE=1 build/exp/run.sh u400a 2.5 0 1000 0 2000 0 kogge-stone & SETUP_MARGIN=0.3 PRE=1 build/exp/run.sh u400b 2.5 0 0100 0 2000 0 kogge-stone & wait) 2>&1 | grep -v Warning\r\nu400b P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2381.764000 rsz_area=2387 wns=0.152 whs=0.053 pwr_est=6.5253e-04\r\nu400a P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2242.646000 rsz_area=2347 wns=0.045 whs=0.055 pwr_est=6.2967e-04\r\n"]
[1372.028, "o", "\u001b[1;32m$\u001b[0m sed -n 1,20p build/exp/mult_pipe.sv; grep -n \"CPA\\|g_split\\|g_full\" build/exp/mult_pipe.sv | head\r\n// mult_pipe.sv -- pipelined signed 16x16 multiplier: radix-4 (modified) Booth\r\n// partial products, carry-save (3:2) reduction 9->6->4->3->2 rows and a final\r\n// carry-propagate adder. Every pipeline cut is optional (parameters), so the\r\n// same source serves the 400 MHz and 800 MHz implementations.\r\n//   ENC_REG : register the Booth-encoded multiplier digits + multiplicand\r\n//   CSA_REG : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   CPA_SPLIT: add the low 16 bits in one stage and the high 16 bits in the next\r\n// LAT = number of register ranks inside this module (product register included).\r\nmodule mult_pipe #(\r\n    parameter bit       PRE_ENC   = 1'b1,\r\n    parameter bit       ENC_REG   = 1'b0,\r\n    parameter bit [3:0] CSA_REG   = 4'b1000,\r\n    parameter bit       CPA_SPLIT = 1'b0\r\n) (\r\n    input  logic               clk,\r\n    input  logic               RST_N,\r\n    input  logic               en,     // accept: load operands, else load zeros\r\n    input  logic signed [15:0] a,      // multiplicand (unregistered input)\r\n    input  logic signed [15:0] b,      // multiplier   (unregistered input)\r\n    output logic signed [31:0] p       // product, registered\r\n7://   CPA_SPLIT: add the low 16 bits in one stage and the high 16 bits in the next\r\n13:    parameter bit       CPA_SPLIT = 1'b0\r\n137:    generate if (CPA_SPLIT) begin : g_split\r\n151:    end else begin : g_full\r\n"]
[1387.637, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nmp=open('build/exp/mult_pipe.sv').read()\r\nmp=mp.replace('''//   ENC_REG : register the Booth-encoded multiplier digits + multiplicand\r\n//   CSA_REG : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   CPA_SPLIT: add the low 16 bits in one stage and the high 16 bits in the next\r\n// LAT = number of register ranks inside this module (product register included).''','''//   PRE_ENC  : Booth-recode the multiplier before the operand register\r\n//   ENC_REG  : (PRE_ENC = 0 only) extra rank after the Booth recoding\r\n//   CSA_REG  : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   CPA_SPLIT: add the low 16 bits in one stage and the high 16 bits in the next\r\n// Register ranks (= latency from 'en' to 'p'):\r\n//   1 (operand) + (PRE_ENC ? 0 : ENC_REG) + popcount(CSA_REG) + CPA_SPLIT + 1 (product)\r\n// Every register has a synchronous active-low reset. When 'en' is 0 the operand\r\n// register loads zeros (operand isolation), so an idle multiplier does not toggle.\r\n// Written for this project; the Booth recoding and sign-extension constant follow\r\n// the textbook modified-Booth scheme (see the report's references).''')\r\nopen('submission/rtl_400/mult_pipe.sv','w').write(mp)\r\nopen('submission/rtl_800/mult_pipe.sv','w').write(mp)\r\nt=open('build/exp/top.sv').read()\r\nhdr='''// mkMultBuff.sv -- @FREQ@ MHz implementation (@PER@ ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n// @DESC@\r\n// Latency (accept -> EN_writeMem) = LAT cycles; a LAT-bit valid shift register\r\n// runs alongside the datapath and drives EN_writeMem (F4).\r\n//\r\n// Control: the two registered ready flags RDY_mult / RDY_blockRead are the\r\n// fill / drain state machine (states FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1});\r\n// acc_q counts operand pairs accepted in the fill phase, so pairs still in the\r\n// pipeline count against the capacity (F5); ptr_q is the memory address, shared\r\n// by the write pointer (fill) and the read pointer (drain), which never run in\r\n// the same cycle (F13). All outputs come from registers except EN_readMem\r\n// (= EN_blockRead & RDY_blockRead, F7) and memVal_data (= readMem_val, F8).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\n'''\r\nt=t.replace(\"// mkMultBuff.sv -- fill/drain buffer around the pipelined Booth multiplier.\\n\", hdr)\r\nt=t.replace(\"    // multiplier pipeline configuration (see mult_pipe.sv)\",\"    // multiplier pipeline configuration (see mult_pipe.sv)\")\r\nt=t.replace(\"logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\",\"logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\")\r\ndef mk(freq,per,desc,pre,enc,csa,spl):\r\n    s=t.replace('@FREQ@',freq).replace('@PER@',per).replace('@DESC@',desc)\r\n    s=s.replace(\"`PRE\",\"1'b\"+pre).replace(\"`ENC\",\"1'b\"+enc).replace(\"`CSA\",\"4'b\"+csa).replace(\"`SPL\",\"1'b\"+spl)\r\n    return s\r\nopen('submission/rtl_400/mkMultBuff.sv','w').write(mk('400','2.5','''// three register ranks (LAT = 3):\r\n//   rank 1: operand register; the multiplier mult_input1 is Booth-recoded\r\n//           before it (one/two/neg digits), the multiplicand is stored as is\r\n//   rank 2: four carry-save rows after partial-product selection and two\r\n//           3:2 levels (9 -> 6 -> 4 rows)\r\n//   rank 3: product, after two more 3:2 levels (4 -> 3 -> 2) and a 32-bit\r\n//           Kogge-Stone adder; drives writeMem_val directly''','1','0','0100','0'))\r\nEOF\r\ngrep -n \"localparam\" submission/rtl_400/mkMultBuff.sv; rm -f submission/rtl_800/mult_pipe.sv; ls submission/rtl_400\r\n42:    localparam bit       PRE_ENC   = 1'b1;\r\n43:    localparam bit       ENC_REG   = 1'b0;\r\n44:    localparam bit [3:0] CSA_REG   = 4'b0100;\r\n45:    localparam bit       CPA_SPLIT = 1'b0;\r\n46:    localparam int       LAT_M     = 1 + (PRE_ENC ? 0 : ENC_REG) + CSA_REG[0] + CSA_REG[1] + CSA_REG[2] + CSA_REG[3] + 1 + CPA_SPLIT;\r\n47:    localparam int       LAT       = LAT_M;       // operand register included\r\nmkMultBuff.sv\r\nmult_pipe.sv\r\n"]
[1409.067, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/rtl_400/mkMultBuff.sv'\r\ns=open(p).read()\r\ns=s.replace('''    localparam int       LAT_M     = 1 + (PRE_ENC ? 0 : ENC_REG) + CSA_REG[0] + CSA_REG[1] + CSA_REG[2] + CSA_REG[3] + 1 + CPA_SPLIT;\r\n    localparam int       LAT       = LAT_M;       // operand register included''','''    localparam int       LAT       = 1 + (PRE_ENC ? 0 : ENC_REG) + CSA_REG[0] + CSA_REG[1]\r\n                                     + CSA_REG[2] + CSA_REG[3] + CPA_SPLIT + 1;''')\r\nopen(p,'w').write(s)\r\nm=open('Makefile').read()\r\nm=m.replace(\"  ADDER   ?= sklansky\\nelse ifeq ($(RUN),800)\",\"  ADDER   ?= kogge-stone\\nelse ifeq ($(RUN),800)\")\r\nm=m.replace(\"  ADDER   ?= sklansky\\nelse\\n\",\"  ADDER   ?= kogge-stone\\nelse\\n\")\r\nm=m.replace('''YOSYS       := $(DOCKER) -e RUN=$(RUN) -e LIB=$(LIB) -e ABC_D=$(ABC_D) -e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT=$(NETLIST) \\\\''','''YOSYS       := $(DOCKER) -e RUN=$(RUN) -e LIB=$(LIB) -e ABC_D=$(ABC_D) -e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT=$(BUILD)/syn.v \\\\''')\r\nm=m.replace('''STA         := $(DOCKER)''','''OPENROAD    := $(DOCKER) -e LIB=$(LIB) -e NETLIST_IN=$(BUILD)/syn.v -e NETLIST=$(NETLIST) -e PERIOD=$(PERIOD) \\\\\r\n               -e SETUP_MARGIN=$(SETUP_MARGIN) -e PDK_LEF_DIR=/OpenROAD-flow-scripts/flow/platforms/nangate45/lef \\\\\r\n               $(YOSYS_IMAGE) /OpenROAD-flow-scripts/tools/install/OpenROAD/bin/openroad -no_init -exit\r\nSTA         := $(DOCKER)''')\r\nm=m.replace('''synth: | $(REP) $(OUT)\r\n\t$(YOSYS) -q -l $(REP)/synth.log -c submission/scripts/synth.tcl\r\n\tmv -f $(basename $(NETLIST)).stat.rpt $(REP)/area.rpt\r\n\t$(STA) submission/scripts/sta.tcl > $(REP)/sta.rpt 2>&1\r\n\t@grep -A3 \"Chip area\" $(REP)/area.rpt | head -2; grep -E \"^worst slack|^tns\" $(REP)/sta.rpt''','''synth: | $(REP) $(OUT) $(BUILD)\r\n\t$(YOSYS) -q -l $(REP)/synth.log -c submission/scripts/synth.tcl\r\n\tmv -f $(BUILD)/syn.stat.rpt $(REP)/yosys_area.rpt\r\n\t$(OPENROAD) submission/scripts/resize.tcl > $(REP)/resize.log 2>&1\r\n\t$(STA) submission/scripts/sta.tcl > $(REP)/sta.rpt 2>&1\r\n\t@grep -E \"^(worst slack|tns|Total|cell area)\" $(REP)/sta.rpt''')\r\nm=m.replace(\"SEED     ?= 1\\n\",\"SEED     ?= 402\\nSETUP_MARGIN ?= 0.15\\n\")\r\nopen('Makefile','w').write(m)\r\ns=open('submission/scripts/sta.tcl').read()\r\ns=s.replace('''report_power -digits 4''','''report_power -digits 4\r\n# cell area of the final netlist, from the Liberty areas\r\nset area 0.0\r\narray set hist {}\r\nforeach inst [get_cells *] {\r\n    set lc [get_property $inst ref_name]\r\n    set a [get_property [get_lib_cells */$lc] area]\r\n    set area [expr {$area + $a}]\r\n    if {[info exists hist($lc)]} { incr hist($lc) } else { set hist($lc) 1 }\r\n}\r\nset seq 0.0\r\nforeach lc [lsort [array names hist]] {\r\n    set a [get_property [get_lib_cells */$lc] area]\r\n    if {[string match DFF* $lc]} { set seq [expr {$seq + $a * $hist($lc)}] }\r\n    puts [format \"cell %-14s %5d  %9.3f um^2\" $lc $hist($lc) [expr {$a * $hist($lc)}]]\r\n}\r\nputs [format \"cell area %.3f um^2 (sequential %.3f um^2, %d instances)\" $area $seq [llength [get_cells *]]]''')\r\nopen('submission/scripts/sta.tcl','w').write(s)\r\nEOF\r\nmake synth RUN=400 2>&1 | tail -6\r\ndocker run --rm -v /home/user/elec402-p2-open:/home/user/elec402-p2-open -w /home/user/elec402-p2-open -e RUN=400 -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=submission/outputs/mkMultBuff_400_map.v -e SDF=submission/outputs/mkMultBuff_400_map.sdf -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit submission/scripts/sta.tcl > submission/syn_reports/400/sta.rpt 2>&1\r\nworst slack max 0.152\r\nworst slack min 0.053\r\ntns max 0.000\r\nTotal                4.5965e-04 1.6037e-04 3.2514e-05 6.5253e-04 100.0%\r\ncell area 2386.552 um^2 (sequential 753.844 um^2, 1501 instances)\r\n"]
[1435.983, "o", "\u001b[1;32m$\u001b[0m sed -i \"s|sed -e '0,/^module mkMultBuff(/s//module mkMultBuff #(parameter N = 32) (/' \\$< > \\$@|sed -e '0,/^module mkMultBuff (/s//module mkMultBuff #(parameter N = 32) (/' \\$< > \\$@|\" Makefile && rm -f build/400/netlist_sim.v && make sim RUN=400 2>&1 | tail -3; grep PWR_WIN submission/syn_reports/400/sim.log; ls -la build/400/gate.vcd\r\n  STIMULUS checks=       0  failures=0\r\nALL PASS\r\nsubmission/testbench/rtl_checker.sv:420: $finish called at 14640000 (1ps)\r\nPWR_WIN fill 521250 681250\r\nPWR_WIN drain 688750 848750\r\n-rw-r--r-- 1 root root 15778666 Nov  8 02:57 build/400/gate.vcd\r\n"]
[1441.945, "o", "\u001b[1;32m$\u001b[0m make timing RUN=400 2>&1 | tail -14; grep -i -c warn submission/syn_reports/400/timing.log; grep -i warn submission/syn_reports/400/timing.log | sort | uniq -c | head -5\r\n    submission/testbench/sdf_checker_400.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/400/netlist_sim.v tech/NangateOpenCellLibrary.v\r\nvvp -n build/400/timing.vvp +sdf_file=submission/outputs/mkMultBuff_400_map.sdf +seed=402 > submission/syn_reports/400/timing.log 2>&1 ; true\r\nWARNING: submission/testbench/sdf_checker_400.sv:82: $sdf_annotate currently only uses the first two argument.\r\nINFO t=22500 ps: latency measured from the first write = 3 cycles\r\nINFO t=340000 ps: phase 0 complete (64 accepted, 63 returned)\r\nINFO t=667500 ps: phase 1 complete (128 accepted, 127 returned)\r\nINFO t=1027500 ps: phase 2 complete (192 accepted, 191 returned)\r\nINFO t=1462500 ps: phase 3 complete (256 accepted, 255 returned)\r\nINFO t=1887500 ps: phase 4 complete (320 accepted, 319 returned)\r\nINFO t=2215000 ps: phase 5 complete (384 accepted, 383 returned)\r\n\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 3, 894 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nsubmission/testbench/sdf_checker_400.sv:289: $finish called at 2235000 (1ps)\r\n1\r\n      1 WARNING: submission/testbench/sdf_checker_400.sv:82: $sdf_annotate currently only uses the first two argument.\r\n"]
[1449.226, "o", "\u001b[1;32m$\u001b[0m head -20 submission/outputs/mkMultBuff_400_map.sdf; grep -m3 IOPATH submission/outputs/mkMultBuff_400_map.sdf; grep -c INTERCONNECT submission/outputs/mkMultBuff_400_map.sdf; grep -m2 -A3 TIMINGCHECK submission/outputs/mkMultBuff_400_map.sdf\r\n(DELAYFILE\r\n (SDFVERSION \"3.0\")\r\n (DESIGN \"mkMultBuff\")\r\n (VENDOR \"Parallax\")\r\n (PROGRAM \"STA\")\r\n (VERSION \"3.1.0\")\r\n (DIVIDER /)\r\n (VOLTAGE 0.950::0.950)\r\n (PROCESS \"1.000::1.000\")\r\n (TEMPERATURE 125.000::125.000)\r\n (TIMESCALE 1ns)\r\n (CELL\r\n  (CELLTYPE \"mkMultBuff\")\r\n  (INSTANCE)\r\n  (DELAY\r\n   (ABSOLUTE\r\n    (INTERCONNECT EN_blockRead _1498_/A2 (0.0129:0.0129:0.0129) (0.0100:0.0100:0.0100))\r\n    (INTERCONNECT EN_mult _1623_/A2 (0.0084:0.0084:0.0084) (0.0066:0.0066:0.0066))\r\n    (INTERCONNECT RST_N _1500_/A (0.5608:0.5608:0.5608) (0.1766:0.1766:0.1766))\r\n    (INTERCONNECT RST_N _1602_/A1 (0.5608:0.5608:0.5608) (0.1765:0.1765:0.1765))\r\n    (IOPATH A1 ZN (0.1092:0.1092:0.1092) (0.1173:0.1173:0.1173))\r\n    (IOPATH A2 ZN (0.0893:0.0893:0.0893) (0.0577:0.0577:0.0577))\r\n    (IOPATH A ZN (0.2860:0.2983:0.3105) (0.1115:0.1123:0.1131))\r\n3571\r\n  (TIMINGCHECK\r\n    (SETUP (posedge D) (posedge CK) (0.0497:0.0497:0.0498))\r\n    (SETUP (negedge D) (posedge CK) (0.0617:0.0617:0.0617))\r\n    (HOLD (posedge D) (posedge CK) (0.0993:0.0993:0.0993))\r\n--\r\n  (TIMINGCHECK\r\n    (SETUP (posedge D) (posedge CK) (0.0625:0.0628:0.0631))\r\n    (SETUP (negedge D) (posedge CK) (0.0627:0.0703:0.0778))\r\n    (HOLD (posedge D) (posedge CK) (0.1191:0.1196:0.1202))\r\n"]
[1466.186, "o", "\u001b[1;32m$\u001b[0m cd /tmp/claude-0/probe/tc && cat > s.v <<'EOF'\r\n`timescale 1ns/1ps\r\nmodule top(input A, output Z); BUF_X1 u(.A(A),.Z(Z)); endmodule\r\nmodule t; reg A=0; wire Z; top dut(.A(A),.Z(Z));\r\n initial begin $sdf_annotate(\"s.sdf\", dut); #5 A=1; end\r\n always @(Z) $display(\"Z=%b at %0t\", Z, $realtime);\r\nendmodule\r\nEOF\r\ncat > s.sdf <<'EOF'\r\n(DELAYFILE (SDFVERSION \"3.0\") (DESIGN \"top\") (DIVIDER /) (TIMESCALE 1ns)\r\n (CELL (CELLTYPE \"BUF_X1\") (INSTANCE u) (DELAY (ABSOLUTE (IOPATH A Z (0.1:0.5:0.9) (0.1:0.5:0.9))))))\r\nEOF\r\niverilog -gspecify -o s.vvp s.v ../mf/stdcells.v && vvp -n s.vvp | grep -v \"^$\" | tail -3\r\nZ=0 at 500\r\nZ=1 at 5500\r\nShell cwd was reset to /home/user/elec402-p2-open\r\n"]
[1481.648, "o", "\u001b[1;32m$\u001b[0m cat > submission/scripts/sdf_typmax.py <<'EOF'\r\n#!/usr/bin/env python3\r\n\"\"\"sdf_typmax.py IN OUT -- copy an SDF file, replacing the 'typ' entry of every\r\n(min:typ:max) triple by 'max'. Icarus Verilog annotates the typ value, so this\r\nmakes the gate-level simulation use the (setup-pessimistic) maximum delays\r\ncomputed by OpenSTA, while 'min' is kept unchanged.\"\"\"\r\nimport re, sys\r\nsrc = open(sys.argv[1]).read()\r\npat = re.compile(r'\\(\\s*(-?[0-9.eE+-]+)\\s*:\\s*(-?[0-9.eE+-]*)\\s*:\\s*(-?[0-9.eE+-]+)\\s*\\)')\r\nout, n = pat.subn(lambda m: f'({m.group(1)}:{m.group(3)}:{m.group(3)})', src)\r\nopen(sys.argv[2], 'w').write(out)\r\nprint(f'sdf_typmax: {n} delay triples set to typ = max -> {sys.argv[2]}')\r\nEOF\r\nsed -i 's|write_sdf -include_typ -digits 4 -no_timestamp $::env(SDF)|write_sdf -include_typ -digits 4 -no_timestamp $::env(SDF).sta|' submission/scripts/sta.tcl && python3 - <<'EOF'\r\nm=open('Makefile').read()\r\nm=m.replace('''\t$(STA) submission/scripts/sta.tcl > $(REP)/sta.rpt 2>&1\r\n\t@grep''','''\t$(STA) submission/scripts/sta.tcl > $(REP)/sta.rpt 2>&1\r\n\tpython3 submission/scripts/sdf_typmax.py $(SDF).sta $(SDF) && rm -f $(SDF).sta\r\n\t@grep''')\r\nopen('Makefile','w').write(m)\r\nEOF\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e RUN=400 -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=submission/outputs/mkMultBuff_400_map.v -e SDF=submission/outputs/mkMultBuff_400_map.sdf -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit submission/scripts/sta.tcl > submission/syn_reports/400/sta.rpt 2>&1; python3 submission/scripts/sdf_typmax.py submission/outputs/mkMultBuff_400_map.sdf.sta submission/outputs/mkMultBuff_400_map.sdf && rm submission/outputs/mkMultBuff_400_map.sdf.sta; make timing RUN=400 2>&1 | tail -3\r\nsdf_typmax: 19813 delay triples set to typ = max -> submission/outputs/mkMultBuff_400_map.sdf\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 3, 894 cycles, 384 accepted, 384 returned, 0 failure(s) ====\r\nALL PASS\r\nsubmission/testbench/sdf_checker_400.sv:289: $finish called at 2235000 (1ps)\r\n"]
[1532.336, "o", "\u001b[1;32m$\u001b[0m mkdir -p submission/testbench/timing_fail/rtl_onestage && sed 's/localparam bit \\[3:0\\] CSA_REG   = 4'\"'\"'b0100;/localparam bit [3:0] CSA_REG   = 4'\"'\"'b0000;   \\/\\/ TIMING-FAIL VARIANT: no carry-save register/' submission/rtl_400/mkMultBuff.sv | sed '1s|.*|// mkMultBuff.sv -- DELIBERATELY TOO SLOW variant of the 400 MHz design, used only to show that the\\n// gate-level checkers fail a netlist that violates timing (SPEC 8.2). The whole multiplier sits in one\\n// pipeline stage (about 4.4 ns at the slow corner), so it cannot meet the 2.5 ns clock. Not a deliverable.\\n//|' > submission/testbench/timing_fail/rtl_onestage/mkMultBuff.sv && cp submission/rtl_400/mult_pipe.sv submission/testbench/timing_fail/rtl_onestage/ && grep -n \"CSA_REG   =\" submission/testbench/timing_fail/rtl_onestage/mkMultBuff.sv && python3 - <<'EOF'\r\nm=open('Makefile').read()\r\nm=m.replace(\"RTL      := $(wildcard submission/rtl_$(RUN)/*.sv)\",\"RTL_DIR  ?= submission/rtl_$(RUN)\\nRTL      := $(wildcard $(RTL_DIR)/*.sv)\")\r\nm=m.replace(\"REP      := submission/syn_reports/$(RUN)\",\"REP      ?= submission/syn_reports/$(RUN)\")\r\nm=m.replace(\"BUILD    := build/$(RUN)\",\"BUILD    ?= build/$(RUN)\")\r\nm=m.replace(\"YOSYS       := $(DOCKER) -e RUN=$(RUN) -e LIB\",\"YOSYS       := $(DOCKER) -e RUN=$(RUN) -e RTL_DIR=$(RTL_DIR) -e LIB\")\r\nm=m.replace(\"PERIOD  := 2.5\",\"PERIOD  ?= 2.5\").replace(\"PERIOD  := 1.25\",\"PERIOD  ?= 1.25\")\r\nm=m.replace(\".PHONY: synth check sim timing power all clean timing_fail\",\".PHONY: synth check sim timing power all clean timing_fail\")\r\nm=m.replace('''all: synth check sim timing power''','''# ---- demonstration that the gate-level checker fails a netlist that violates timing\r\n#  RUN=400: the one-stage-multiplier variant in submission/testbench/timing_fail/rtl_onestage,\r\n#           synthesized with the same flow at 2.5 ns (STA reports negative slack)\r\n#  RUN=800: the 400 MHz netlist, timed by STA and back-annotated at 1.25 ns\r\nFAIL_BUILD := build/fail_$(RUN)\r\nFAIL_REP   := submission/syn_reports/$(RUN)/timing_fail\r\ntiming_fail:\r\n\tmkdir -p $(FAIL_BUILD) $(FAIL_REP)\r\nifeq ($(RUN),400)\r\n\t$(MAKE) synth RUN=400 RTL_DIR=submission/testbench/timing_fail/rtl_onestage BUILD=$(FAIL_BUILD) REP=$(FAIL_REP) \\\\\r\n\t    NETLIST=$(FAIL_BUILD)/fail_map.v SDF=$(FAIL_BUILD)/fail_map.sdf\r\nelse\r\n\t$(MAKE) sta_only RUN=800 BUILD=$(FAIL_BUILD) REP=$(FAIL_REP) \\\\\r\n\t    NETLIST=$(OUT)/mkMultBuff_400_map.v SDF=$(FAIL_BUILD)/fail_map.sdf\r\nendif\r\n\t-$(MAKE) timing RUN=$(RUN) BUILD=$(FAIL_BUILD) REP=$(FAIL_REP) NETLIST=$(if $(filter 400,$(RUN)),$(FAIL_BUILD)/fail_map.v,$(OUT)/mkMultBuff_400_map.v) SDF=$(FAIL_BUILD)/fail_map.sdf\r\n\t@grep -q \"TIMING FAIL\" $(FAIL_REP)/timing.log && echo \"timing_fail: checker reported TIMING FAIL as expected\" \\\\\r\n\t    || { echo \"timing_fail: checker did NOT fail\"; exit 1; }\r\n\r\nsta_only: | $(REP)\r\n\t$(STA) submission/scripts/sta.tcl > $(REP)/sta.rpt 2>&1\r\n\tpython3 submission/scripts/sdf_typmax.py $(SDF).sta $(SDF) && rm -f $(SDF).sta\r\n\t@grep -E \"^(worst slack|tns)\" $(REP)/sta.rpt\r\n\r\nall: synth check sim timing power''')\r\nm=m.replace(\".PHONY: synth check sim timing power all clean timing_fail\",\".PHONY: synth check sim timing power all clean timing_fail sta_only\")\r\nopen('Makefile','w').write(m)\r\nEOF\r\nmake timing_fail RUN=400 2>&1 | grep -E \"^worst|^tns|TIMING FAIL|timing_fail:|ALL PASS|summary\" | head; make timing_fail RUN=800 2>&1 | grep -E \"^worst|^tns|TIMING FAIL|timing_fail:|ALL PASS|summary\" | head\r\n47:    localparam bit [3:0] CSA_REG   = 4'b0000;   // TIMING-FAIL VARIANT: no carry-save register\r\nworst slack max -1.469\r\nworst slack min 0.055\r\ntns max -23.169\r\nTIMING FAIL t=507500 ps cycle=203: memVal_data=87fc0013 expected 00000013, product #64 (-1 * -19), xor=87fc0000\r\nTIMING FAIL ... further messages suppressed\r\n==== mkMultBuff_sdf_checker_400 summary: period 2.500 ns, seed 402, latency 2, 887 cycles, 384 accepted, 384 returned, 172 failure(s) ====\r\nTIMING FAIL: 172 failure(s)\r\ntiming_fail: checker reported TIMING FAIL as expected\r\nworst slack max -1.091\r\nworst slack min 0.073\r\ntns max -67.793\r\nTIMING FAIL t=5087500 ps cycle=4070: phase 0: drain not completed (0 of 64 reads accepted)\r\nTIMING FAIL t=5087500 ps cycle=4070: 64 operand pairs accepted, expected 384\r\nTIMING FAIL t=5087500 ps cycle=4070: 0 products returned, 64 accepted\r\n==== mkMultBuff_sdf_checker_800 summary: period 1.250 ns, seed 402, latency 3, 4070 cycles, 64 accepted, 0 returned, 3 failure(s) ====\r\nTIMING FAIL: 3 failure(s)\r\ntiming_fail: checker reported TIMING FAIL as expected\r\n"]
[1539.061, "o", "\u001b[1;32m$\u001b[0m printf \"help read_vcd\\nhelp report_power\\nhelp read_saif\\nhelp set_power_activity\\n\" > build/h.tcl && docker run --rm -v $PWD:$PWD -w $PWD --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/h.tcl; head -40 build/400/gate.vcd | grep -E \"scope|timescale\" \r\nread_vcd [-scope scope] [-mode mode_name] [-begin_time begin_time]\r\n   [-end_time end_time] filename \r\n  The read_vcd command reads a VCD (Value Change Dump) file from a Verilog\r\n  simulation and extracts activities and duty cycles for use in power\r\n  estimation. A VCD name that matches a net annotates the pins connected to the\r\n  net. A pin named by its own VCD variable keeps that variable's activity.\r\n  Files compressed with gzip are supported. Annotated activities are propagated\r\n  to the fanout of the annotated pins.\r\n  -scope  The VCD scope of the current design to extract simulation data.\r\n    Typically the test bench name and design under test instance name. Scope\r\n    levels are separated with '/'.\r\n  -mode  Mode to annotate activities.\r\n  -begin_time  Ignore VCD activity before this time.\r\n  -end_time  Ignore VCD activity after this time.\r\nreport_power [-instances instances] [-highest_power_instances count]\r\n   [-scene scene] [-digits digits] [-format format] [> filename] [>> filename]  \r\n  The report_power command uses static power analysis based on propagated or\r\n  annotated pin activities in the circuit using Liberty power models. The\r\n  internal, switching, leakage and total power are reported. Design power is\r\n  reported separately for combinational, sequential, macro and pad groups.\r\n  Power values are reported in watts.\r\n\r\n  The read_vcd or read_saif commands can be used to read activities from a file\r\n  based on simulation. If no simulation activities are available, the\r\n  set_power_activity command should be used to set the activity of input ports\r\n  or pins in the design. The default input activity and duty for inputs are 0.1\r\n  and 0.5 respectively. The activities are propagated from annotated input\r\n  ports or pins through gates and used in the power calculations.\r\n\r\n  Group Internal Switching Leakage Total\r\n  Power Power Power Power\r\n  ----------------------------------------------------------------\r\n  Sequential 3.29e-06 3.41e-08 2.37e-07 3.56e-06 92.4%\r\n  Combinational 1.86e-07 3.31e-08 7.51e-08 2.94e-07 7.6%\r\n  Macro 0.00e+00 0.00e+00 0.00e+00 0.00e+00 0.0%\r\n  Pad 0.00e+00 0.00e+00 0.00e+00 0.00e+00 0.0%\r\n  ---------------------------------------------------------------\r\n  Total 3.48e-06 6.72e-08 3.12e-07 3.86e-06 100.0%\r\n  90.2% 1.7% 8.1%\r\n  -instances  instances: Report the power for each instance of instances. If\r\n    the instance is hierarchical the total power for the instances inside the\r\n    hierarchical instance is reported.\r\n  -highest_power_instances  count: Report the power for the count highest power\r\n    instances.\r\n  -scene  Restrict the command to one scene.\r\n  -digits  Number of digits to print after the decimal point. The default value\r\n    is the variable sta_report_default_digits.\r\n  -format  text: Print a text table (the default). json: Print JSON.\r\nread_saif [-scope scope] filename  \r\n  The read_saif command reads a SAIF (Switching Activity Interchange Format)\r\n  file from a Verilog simulation and extracts activities and duty cycles for\r\n  use in power estimation. A SAIF name that matches a net annotates the pins\r\n  connected to the net. A name that matches a pin but not a net annotates that\r\n  pin. Files compressed with gzip are supported. Annotated activities are\r\n  propagated to the fanout of the annotated pins.\r\n  -scope  The SAIF scope of the current design to extract simulation data.\r\n    Typically the test bench name and design under test instance name. Scope\r\n    levels are separated with '/'.\r\nset_power_activity [-global] [-input] [-input_ports ports] [-pins pins]\r\n   [-activity activity | -density density] [-duty duty] [-clock clock] \r\n  The set_power_activity command is used to set the activity and duty used for\r\n  power analysis globally or for input ports or pins in the design.\r\n\r\n  The default input activity for inputs is 0.1 transitions per minimum clock\r\n  period if a clock is defined or 0.0 if there are no clocks defined. The\r\n  default input duty is 0.5. This is equivalent to the following command:\r\n\r\n  set_power_activity -input -activity 0.1 -duty 0.5\r\n  -global  Set the activity/duty for all non-clock pins.\r\n  -input  Set the default input port activity/duty.\r\n  -input_ports  input_ports: Set the input port activity/duty.\r\n  -pins  pins: Set the pin activity/duty.\r\n  -activity  activity: The activity, or number of transitions per clock cycle.\r\n    If clock is not specified the clock with the minimum period is used. If no\r\n    clocks are defined an error is reported.\r\n  -density  density: Transitions per library time unit.\r\n  -duty  duty: The duty, or probability the signal is high (0 <= duty <= 1.0).\r\n    Defaults to 0.5.\r\n  -clock  clock: The clock to use for the period with -activity. This option is\r\n    ignored if -density is used.\r\n$timescale\r\n$scope module mkMultBuff_tb $end\r\n$scope module DUT $end\r\n"]
