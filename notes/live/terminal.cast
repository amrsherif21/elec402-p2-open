[20500.554, "o", "\u001b[1;32m$\u001b[0m W=build/cg/d3; make -s f14 RUN=400 BUILD=$W REP=$W/rep NETLIST=$W/map.v 2>&1 | tail -2; G=$(grep -B2 'ZN(mclk)' $W/map.v | grep -o '_[0-9]*_' | head -1); L=$(grep -B1 -A3 \"DLL_X1\" $W/map.v | head -5); echo \"$L\"; grep -A6 \"(INSTANCE $G)\" $W/map.sdf | grep IOPATH; for b in clkbuf_0_mclk clkbuf_3_0__f_mclk; do grep -A5 \"(INSTANCE $b)\" $W/map.sdf | grep IOPATH; done; grep -B3 -A22 \"clock gating-check\" $W/rep/sta.rpt | grep \"slack\\|Path Type\\|gating\"; docker run --rm -v $PWD:$PWD -w $PWD -e RUN=400 -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$W/map.v -e SDF=$W/ideal.sdf -e PERIOD=2.5 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit submission/scripts/sta.tcl > $W/rep/sta_ideal.rpt 2>&1; rm -f $W/ideal.sdf.sta; grep \"^worst slack\\|^Total\" $W/rep/sta_ideal.rpt\r\nF14CHECK: flops 149, reset-gated 149 (of which reset-to-1 1), NOT reset-gated 0: \r\n    .QN(_1474_));\r\n DLL_X1 _3189_ (.D(\\u_cg.en ),\r\n    .GN(clk),\r\n    .Q(\\u_cg.en_l ));\r\n CLKBUF_X3 clkbuf_0_mclk (.A(mclk),\r\n    (IOPATH A1 ZN (0.0755:0.0755:0.0755) (0.0825:0.0825:0.0825))\r\n    (IOPATH A2 ZN (0.0918:0.0918:0.0918) (0.1096:0.1096:0.1096))\r\n    (IOPATH A Z (0.1140:0.1140:0.1140) (0.1184:0.1188:0.1188))\r\n    (IOPATH A Z (0.1580:0.1580:0.1580) (0.1491:0.1491:0.1491))\r\nEndpoint: _1593_ (rising clock gating-check end-point clocked by clk)\r\nPath Type: max\r\n                            0.000    2.500   clock gating setup time\r\nEndpoint: _1593_ (rising clock gating-check end-point clocked by clk)\r\nPath Type: min\r\n                     0.000    1.250   clock gating hold time\r\nworst slack max 0.138\r\nworst slack min -0.008\r\nTotal                4.3948e-04 2.1543e-04 3.6391e-05 6.9130e-04 100.0%\r\n"]
[20504.094, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && time ./run.sh 800 w24 --mode wallace --cuts 2,4 2>&1 | tail -40\r\nLAT=6 ranks=[40, 144, 86, 58, 37, 32] datapath flops=397 FA=92 HA=55\r\n  R1 operands + Booth digits: 40 flops\r\n  R2 selected partial products + neg bits: 144 flops\r\n  R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n  R4 tree end, p/g per column (model arrival 0.84): 58 flops\r\n  R5 adder stage A (cinc, blocks [(4, 12), (12, 20), (20, 28), (28, 32)]): 37 flops\r\n  R6 product: 32 flops\r\nPASS: 200902 checks, 0 errors\r\n== build/cand800b/w24 RUN=800\r\ncheck=PASS sim=PASS wns=0.014 whs=0.041\r\narea=4137.098 seq=1985.158 comb=2151.9 flops=439 vectorless_uW=2224.3\r\nactivity_uW: run:=2504.70 fill:=4666.30 drain:=1951.60 \r\nper register group (flops, worst slack):\r\nVALID_memVal                            1    0.444\r\nu_mult.a17                             16    0.212\r\nu_mult.neg_q                            8    0.258\r\nu_mult.one_q                            8    0.258\r\nu_mult.prod                            12    0.177\r\nu_mult.two_q                            8    0.207\r\nwriteMem_val                           32    0.028\r\nu_mult.a17                             16    0.212\r\nu_mult.neg_q                            8    0.258\r\nu_mult.one_q                            8    0.258\r\nu_mult.prod                            12    0.177\r\nu_mult.r2                             144    0.162\r\nu_mult.r3                              86    0.090\r\nu_mult.r4                              58    0.014\r\nu_mult.r5                              25    0.111\r\nu_mult.two_q                            8    0.207\r\n\r\nreal\t2m8.626s\r\nuser\t1m50.607s\r\nsys\t0m0.329s\r\n"]
[20509.217, "o", "\u001b[1;32m$\u001b[0m for f in build/cg/d3/rep/sta.rpt build/cg/a/rep/sta.rpt; do echo $f; awk '/clock gating-check/{p=1} p&&/slack \\(/{print; p=0}' $f; done; W=build/cg/d3; python3 - <<'PY'\r\n# latch D (= u_cg.en) must be 1 whenever RST_N = 0: prove with yosys sat\r\nPY\r\ncat > build/cg/scripts/latch_rst.tcl <<'EOF'\r\nyosys -import\r\nread_liberty -ignore_miss_func $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nhierarchy -top mkMultBuff\r\nflatten\r\nsat -set RST_N 0 -prove u_cg.en 1'1 -ignore_unknown_cells\r\nEOF\r\nsed -e 's/\\\\u_cg\\.en /u_cg_en /g' $W/map.v > $W/latchchk.v; sed -i 's/u_cg\\.en/u_cg_en/' build/cg/scripts/latch_rst.tcl; docker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$W/latchchk.v openroad/orfs@sha256:d3505fd5f930fcd20d3d25a41f3047230b7db7b7797e3448561c9e556cca3774 /OpenROAD-flow-scripts/tools/install/yosys/bin/yosys -c build/cg/scripts/latch_rst.tcl 2>&1 | grep -i \"SUCCESS\\|FAIL\\|error\" | head\r\nbuild/cg/d3/rep/sta.rpt\r\n                                     0.999   slack (MET)\r\n                              0.149   slack (MET)\r\nbuild/cg/a/rep/sta.rpt\r\n                                     0.851   slack (MET)\r\n                              0.304   slack (MET)\r\nSuccessfully finished Verilog frontend.\r\nSAT proof finished - no model found: SUCCESS!\r\n"]
[20527.407, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800a/src && python3 - <<'EOF'\r\ns = open('mkMultBuff.sv').read()\r\ns = s.replace(\"    localparam bit [4:0] DUP \", \"    localparam bit       RDS       = 1'b0;   // drain starts at the write made when fill is closed and nothing else is in flight\\n    localparam bit [4:0] DUP \")\r\ns = s.replace(\"    wire wp_last = CNT ?\", \"    wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\\n    wire wp_last = CNT ?\")\r\ns = s.replace(\"if (wr && wp_last) begin\", \"if (wr_last) begin\")\r\nopen('mkMultBuff.sv','w').write(s)\r\nEOF\r\ngrep -n \"wr_last\\|wp_last\" mkMultBuff.sv; cd /home/user/elec402-p2-open && build/cand800a/mk.sh e11_rds CSA_REG=\"4'b1010\" ORD=\"1'b1\" GT=\"1'b1\" GP4=\"1'b0\" CPA=1 CI1=\"1'b1\" DUP=\"5'b00011\" CNT=\"1'b1\" RDS=\"1'b1\" 2>&1 | tail -4\r\n86:    wire wr_last = RDS ? (wr && !rdy_mult_q && v_q[LAT-2:0] == '0) : (wr && wp_last);\r\n87:    wire wp_last = CNT ? (wc_q && wp_q[5:3] == 3'd7) : (wp_q == 6'd63);\r\n119:            if (wr_last) begin rdy_rd_q <= 1'b1; rdy_rd_on <= 1'b0; end\r\ncheck=PASS sim=PASS wns=0.130 whs=0.020\r\narea=4060.490 seq=2000.852 comb=2059.6 flops=442 vectorless_uW=2199.9\r\nactivity_uW: run:=2507.60 fill:=4598.20 drain:=1946.10 \r\nR1op:40(0.215) PP:144(0.151) L2:92(0.152) GP:60(0.151) ADD:43(0.178) PROD:32(0.130) CTRL:31(0.146)\r\n"]
