[3062.688, "o", "\u001b[1;32m$\u001b[0m bash build/exp/path.sh build/cand_dadda/v6_abc1050/rep/sta.rpt | head -14; grep -A3 \"DFF_X. _5585_ \\|DFF_X. _5524_ \" build/cand_dadda/v6_abc1050/map.v | grep Q\r\nby clk) fo=Startpoint: d=edge-triggered t=flip-flop\r\nby clk) fo=Endpoint: d=edge-triggered t=flip-flop\r\n_5583_/Q (DFF_X1) fo=2 d=0.391 t=0.391\r\n_4042_/Z (BUF_X4) fo=5 d=0.083 t=0.474\r\n_4092_/Z (BUF_X2) fo=10 d=0.141 t=0.615\r\n_4179_/ZN (NAND2_X1) fo=1 d=0.065 t=0.680\r\n_4180_/ZN (XNOR2_X1) fo=1 d=0.125 t=0.805\r\n_4181_/ZN (XNOR2_X1) fo=1 d=0.132 t=0.937\r\n_4182_/ZN (NOR2_X1) fo=1 d=0.105 t=1.041\r\n                                     1.041   data arrival time\r\n                           -0.059    1.191   library setup time\r\n                                    -1.041   data arrival time\r\nslack (MET) fo=0.150 d= t=\r\n    .Q(\\u_mult.r1 [126]),\r\n    .QN(_2796_));\r\n    .Q(\\u_mult.a_q [6]),\r\n    .QN(_2243_));\r\n"]
[3085.621, "o", "\u001b[1;32m$\u001b[0m cat > submission/scripts/waves/vcd_events.py <<'EOF'\r\n#!/usr/bin/env python3\r\n\"\"\"vcd_events.py VCD SIGNAL -- print the times (ps) at which a 1-bit signal rises/falls.\"\"\"\r\nimport sys\r\nvcd, sig = sys.argv[1], sys.argv[2]\r\ncode, t, last = None, 0, None\r\nwith open(vcd) as f:\r\n    for line in f:\r\n        if line.startswith('$var') and line.split()[4] == sig and code is None:\r\n            code = line.split()[3]\r\n        elif line.startswith('#'):\r\n            t = int(line[1:])\r\n        elif code and len(line) > 1 and line[0] in '01xz' and line[1:].strip() == code:\r\n            v = line[0]\r\n            if v != last:\r\n                print(t, v)\r\n            last = v\r\nEOF\r\npython3 submission/scripts/waves/vcd_events.py build/400/w_rtl.vcd RDY_blockRead | head -4; python3 submission/scripts/waves/vcd_events.py build/400/w_rtl.vcd RDY_mult | head -4; dpkg-query -W -f='${Version}\\n' gtkwave\r\n0 x\r\n1250 0\r\n181250 1\r\n341250 0\r\nTraceback (most recent call last):\r\n  File \"/home/user/elec402-p2-open/submission/scripts/waves/vcd_events.py\", line 15, in <module>\r\n    print(t, v)\r\n    ~~~~~^^^^^^\r\nBrokenPipeError: [Errno 32] Broken pipe\r\n0 x\r\n1250 1\r\n173750 0\r\n341250 1\r\nTraceback (most recent call last):\r\n  File \"/home/user/elec402-p2-open/submission/scripts/waves/vcd_events.py\", line 15, in <module>\r\n    print(t, v)\r\n    ~~~~~^^^^^^\r\nBrokenPipeError: [Errno 32] Broken pipe\r\n3.3.116-1build2\r\n"]
[3100.53, "o", "\u001b[1;32m$\u001b[0m cat > build/400/g.tcl <<'EOF'\r\nset sigs [list mkMultBuff_sdf_checker_400.DUT.clk mkMultBuff_sdf_checker_400.DUT.RDY_mult mkMultBuff_sdf_checker_400.DUT.EN_writeMem mkMultBuff_sdf_checker_400.DUT.writeMem_addr]\r\ngtkwave::addSignalsFromList $sigs\r\ngtkwave::setZoomRangeTimes 170000 190000\r\ngtkwave::/File/Grab_To_File build/400/test.png\r\ngtkwave::/File/Quit\r\nEOF\r\ntimeout 60 xvfb-run -a -s \"-screen 0 1600x900x24\" gtkwave -S build/400/g.tcl build/400/w_rtl.vcd > build/400/gtk.log 2>&1; tail -5 build/400/gtk.log; ls -la build/400/test.png\r\n[0] start time.\r\n[2235000] end time.\r\nGTKWAVE | Executing Tcl script 'build/400/g.tcl'\r\nGTKWAVE | Filename 'build/400/test.png'\r\nExiting.\r\n-rw-r--r-- 1 root root 36467 Nov  8 03:25 build/400/test.png\r\n"]
