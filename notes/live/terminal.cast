[2217.332, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && cat > ep.tcl <<'EOF'\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nreport_checks -path_delay max -group_path_count 40 -endpoint_path_count 1 -format end\r\nEOF\r\ncat > ep.sh <<'EOF'\r\n#!/bin/bash\r\n# ep.sh DIR -- worst 40 endpoints, with the register name (Q net) of each endpoint\r\ncd /home/user/elec402-p2-open\r\nD=$1\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$D/map.v -e PERIOD=${P:-1.25} \\\r\n  --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cand_dadda/ep.tcl > $D/rep/ep.rpt 2>&1\r\ngrep -E \"^_[0-9]+_/D|^[a-zA-Z].*/D \" $D/rep/ep.rpt | while read pin req arr slack rest; do\r\n  inst=${pin%/D}; q=$(grep -A4 \" $inst (\" $D/map.v | grep -o \"\\.Q([^)]*)\" | head -1)\r\n  echo \"$pin $slack $q\"\r\ndone\r\nEOF\r\nchmod +x ep.sh; ./ep.sh build/cand_dadda/v1 | head -40\r\n_5951_/D 1.40 .Q(RDY_blockRead)\r\n_5920_/D 1.36 .Q(\\u_mult.q_s1_4 [3])\r\n_5930_/D 1.36 .Q(\\u_mult.q_s1_5 [3])\r\n_5875_/D 1.35 .Q(writeMem_val[29])\r\n_5876_/D 1.35 .Q(writeMem_val[30])\r\n_5877_/D 1.35 .Q(writeMem_val[31])\r\n_5942_/D 1.33 .Q(readMem_addr[4])\r\n_5910_/D 1.33 .Q(\\u_mult.q_s1_3 [3])\r\n_5941_/D 1.31 .Q(readMem_addr[3])\r\n_5867_/D 1.32 .Q(writeMem_val[21])\r\n_5868_/D 1.32 .Q(writeMem_val[22])\r\n_5869_/D 1.32 .Q(writeMem_val[23])\r\n_5870_/D 1.31 .Q(writeMem_val[24])\r\n_5871_/D 1.31 .Q(writeMem_val[25])\r\n_5872_/D 1.31 .Q(writeMem_val[26])\r\n_5873_/D 1.31 .Q(writeMem_val[27])\r\n_5874_/D 1.31 .Q(writeMem_val[28])\r\n_5943_/D 1.29 .Q(readMem_addr[5])\r\n_5952_/D 1.20 .Q(RDY_mult)\r\n_5949_/D 1.21 .Q(acc_q[5])\r\n_5863_/D 1.17 .Q(writeMem_val[17])\r\n_5864_/D 1.17 .Q(writeMem_val[18])\r\n_5865_/D 1.17 .Q(writeMem_