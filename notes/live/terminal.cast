[2755.824, "o", "\u001b[1;32m$\u001b[0m grep -n \"set_load 23.5\" submission/scripts/synth.tcl && sed -i 's/puts $cf \"set_driving_cell BUF_X1\\\\nset_load 23.5\"/puts $cf \"set_driving_cell BUF_X1\\\\nset_load [expr {[info exists ::env(ABC_LOAD)] ? $::env(ABC_LOAD) : 1.0}]\"/' submission/scripts/synth.tcl && sed -n 36,40p submission/scripts/synth.tcl && (GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh x800_1010 1.25 0 1010 0 1000 0 kogge-stone & GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh x800_1111 1.25 0 1111 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; (MAPLIB=build/exp/lib_du3.lib PRE=1 build/exp/run.sh x400 2.5 0 0100 0 2000 0 kogge-stone & PRE=1 build/exp/run.sh x400n 2.5 0 0100 0 2000 0 kogge-stone & wait) 2>&1 | grep -v Warning\r\n38:puts $cf \"set_driving_cell BUF_X1\\nset_load 23.5\"\r\n# constraint file gives ABC the input drive and the output load of SPEC Section 6\r\nset cf [open [file rootname $out].abc.constr w]\r\nputs $cf \"set_driving_cell BUF_X1\\nset_load [expr {[info exists ::env(ABC_LOAD)] ? $::env(ABC_LOAD) : 1.0}]\"\r\nclose $cf\r\nset abc_script [expr {[info exists ::env(ABC_SCRIPT)] ? $::env(ABC_SCRIPT) : \"submission/scripts/abc_speed.script\"}]\r\nx800_1111 P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5183.276000 rsz_area=5211 wns=0.150 whs=0.028 pwr_est=3.0715e-03\r\nx800_1010 P=1.25 enc=0 csa=1010 spl=0 abcD=1000 | yosys_area=4167.954000 rsz_area=4431 wns=-0.004 whs=0.020 pwr_est=2.4232e-03\r\nx400 P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2696.442000 rsz_area=2712 wns=0.270 whs=0.061 pwr_est=7.2381e-04\r\nx400n P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2579.934000 rsz_area=2623 wns=0.021 whs=0.058 pwr_est=6.9929e-04\r\n"]
[2771.018, "o", "\u001b[1;32m$\u001b[0m build/cand_retime/src/f14.sh build/cand_retime/b1_r7/map.v; cd build/cand_retime && until grep -q \"cell area\\|rror\" b1_r8.out; do sleep 5; done; cat b1_r8.out; awk '/^Startpoint/{s=$2} /^Endpoint/{e=$2} /slack \\(/{print s, e, $1}' b1_r8/rep/sta.rpt | head -3; grep -c \"DFF_X\" b1_r7/map.v b1_r8/map.v\r\nF14CHECK: flops 600, reset-gated 600 (of which reset-to-1 1), NOT reset-gated 0: \r\nRT: re-added reset to 577 rmult flops\r\nyosys 3s\r\nsdf_typmax: 40859 delay triples set to typ = max -> build/cand_retime/b1_r8/map.sdf\r\nworst slack max -0.202\r\nworst slack min 0.076\r\ntns max -14.115\r\nTotal                2.8888e-03 5.9625e-04 9.2821e-05 3.5779e-03 100.0%\r\ncell area 6126.246 um^2 (sequential 2875.194 um^2, 3137 instances)\r\n_6101_ _6105_ -0.202\r\nRST_N _6247_ -0.199\r\nRST_N _6230_ -0.199\r\nb1_r7/map.v:600\r\nb1_r8/map.v:633\r\n"]
[2780.133, "o", "\u001b[1;32m$\u001b[0m for a in 800 900; do D=build/cand_dadda/v5_abc$a; mkdir -p $D; (make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v5/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1) & done; wait; for a in 800 900; do echo \"== abc $a\"; grep -E \"^(worst slack|cell area|Total)\" build/cand_dadda/v5_abc$a/rep/sta.rpt; done\r\n[1]-  Done                    ( make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v5/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n[2]+  Done                    ( make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v5/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n== abc 800\r\nworst slack max 0.030\r\nworst slack min 0.070\r\nTotal                2.5775e-03 1.6227e-04 6.6637e-05 2.8065e-03 100.0%\r\ncell area 5268.130 um^2 (sequential 2776.508 um^2, 2852 instances)\r\n== abc 900\r\nworst slack max 0.030\r\nworst slack min 0.070\r\nTotal                2.5775e-03 1.6227e-04 6.6637e-05 2.8065e-03 100.0%\r\ncell area 5268.130 um^2 (sequential 2776.508 um^2, 2852 instances)\r\n"]
[2784.194, "o", "\u001b[1;32m$\u001b[0m cat > build/cand_retime/src/ends.tcl <<'EOF'\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nreport_checks -path_delay max -group_path_count 400 -endpoint_path_count 1 -format end\r\nEOF\r\nfor d in b1_r7 b1_r8; do echo \"== $d\"; docker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cand_retime/$d/map.v -e PERIOD=1.25 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cand_retime/src/ends.tcl > build/cand_retime/$d/rep/ends.rpt 2>&1; python3 - build/cand_retime/$d <<'PY'\r\nimport re,sys\r\nd=sys.argv[1]\r\nnet=open(d+'/map.v').read()\r\n# map flop instance -> Q net\r\nq={m.group(1):m.group(2) for m in re.finditer(r'DFF_X\\d (\\S+) \\(.*?\\.Q\\(([^)]*)\\)',net,re.S)}\r\nrows=[l.split() for l in open(d+'/rep/ends.rpt') if re.match(r'^\\S+ \\(\\S+\\)|^_\\d+_/D',l)]\r\ncnt={}\r\nfor l in open(d+'/rep/ends.rpt'):\r\n    m=re.match(r'^(\\S+)\\s+([-\\d.]+)\\s+([-\\d.]+)\\s+([-\\d.]+)',l)\r\n    if not m: continue\r\n    ep=m.group(1); sl=float(m.group(4))\r\n    inst=ep.split('/')[0]\r\n    qn=q.get(inst,ep)\r\n    kind='mult' if qn.startswith('_') or qn.startswith('net') else 'named:'+re.sub(r'\\[\\d+\\]','',qn)\r\n    cnt.setdefault(kind,[]).append(sl)\r\nfor k,v in sorted(cnt.items(),key=lambda x:min(x[1])):\r\n    neg=sum(1 for s in v if s<0)\r\n    print(f'{k:30s} worst {min(v):7.3f}  endpoints<0: {neg}')\r\nPY\r\ndone\r\n== b1_r7\r\n== b1_r8\r\n"]
[2786.417, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && v=v5_abc800; NPATH=300 ./ep.sh build/cand_dadda/$v > $v/rep/ep_all.txt; head -8 $v/rep/ep_all.txt; for r in a_q r1 r2 r3 r4 r5 r6 writeMem_val ptr acc_q rdy RDY; do echo \"$r: $(grep \"$r\" $v/rep/ep_all.txt | head -1 | awk '{print $2}')\"; done | tr '\\n' ' '; echo\r\n_5599_/D 1.16 .Q(ptr_last_q)\r\n_5626_/D 1.17 .Q(readMem_addr[3])\r\n_5617_/D 1.11 .Q(nptr_q[3])\r\n_5625_/D 1.09 .Q(readMem_addr[2])\r\n_5627_/D 1.13 .Q(readMem_addr[4])\r\n_5619_/D 1.08 .Q(nptr_q[5])\r\n_5618_/D 1.07 .Q(nptr_q[4])\r\n_5628_/D 1.12 .Q(readMem_addr[5])\r\na_q: 0.95 r1: 1.06 r2: 0.99 r3: 0.99 r4: 0.97 r5: 1.03 r6: 0.97 writeMem_val:  ptr: 1.16 acc_q: 1.04 rdy: 0.94 RDY: 0.88\r\n"]
[2787.088, "o", "\u001b[1;32m$\u001b[0m head -30 build/cand_retime/b1_r8/rep/ends.rpt\r\nmax_delay/setup group clk\r\n\r\n                                     Required  Actual\r\nEndpoint                               Delay   Delay   Slack\r\n------------------------------------------------------------\r\n_6105_/D (DFF_X2)                       1.20    1.40   -0.20 (VIOLATED)\r\n_6247_/D (DFF_X1)                       1.20    1.40   -0.20 (VIOLATED)\r\n_6230_/D (DFF_X1)                       1.20    1.40   -0.20 (VIOLATED)\r\n_6066_/D (DFF_X2)                       1.21    1.39   -0.18 (VIOLATED)\r\n_6500_/D (DFF_X1)                       1.20    1.38   -0.18 (VIOLATED)\r\n_6628_/D (DFF_X1)                       1.21    1.38   -0.17 (VIOLATED)\r\n_6624_/D (DFF_X1)                       1.21    1.38   -0.17 (VIOLATED)\r\n_6618_/D (DFF_X1)                       1.21    1.37   -0.16 (VIOLATED)\r\n_6104_/D (DFF_X2)                       1.20    1.35   -0.16 (VIOLATED)\r\n_6611_/D (DFF_X1)                       1.16    1.31   -0.15 (VIOLATED)\r\n_6251_/D (DFF_X1)                       1.20    1.35   -0.15 (VIOLATED)\r\n_6471_/D (DFF_X1)                       1.16    1.31   -0.14 (VIOLATED)\r\n_6444_/D (DFF_X1)                       1.16    1.31   -0.14 (VIOLATED)\r\n_6446_/D (DFF_X1)                       1.16    1.31   -0.14 (VIOLATED)\r\n_6448_/D (DFF_X1)                       1.16    1.31   -0.14 (VIOLATED)\r\n_6442_/D (DFF_X1)                       1.21    1.34   -0.14 (VIOLATED)\r\n_6440_/D (DFF_X1)                       1.21    1.34   -0.14 (VIOLATED)\r\n_6451_/D (DFF_X1)                       1.21    1.34   -0.14 (VIOLATED)\r\n_6266_/D (DFF_X1)                       1.16    1.29   -0.13 (VIOLATED)\r\n_6620_/D (DFF_X1)                       1.16    1.29   -0.13 (VIOLATED)\r\n_6067_/D (DFF_X2)                       1.14    1.27   -0.13 (VIOLATED)\r\n_6533_/D (DFF_X1)                       1.21    1.33   -0.13 (VIOLATED)\r\n_6535_/D (DFF_X1)                       1.21    1.33   -0.13 (VIOLATED)\r\n_6570_/D (DFF_X1)                       1.21    1.33   -0.13 (VIOLATED)\r\n_6303_/D (DFF_X1)                       1.20    1.33   -0.13 (VIOLATED)\r\n"]
[2794.202, "o", "\u001b[1;32m$\u001b[0m for d in b1_r7 b1_r8; do echo \"== $d\"; python3 - build/cand_retime/$d <<'PY'\r\nimport re,sys\r\nd=sys.argv[1]\r\nnet=open(d+'/map.v').read()\r\nq={m.group(1):m.group(2) for m in re.finditer(r'DFF_X\\d (\\S+) \\((.*?)\\);',net,re.S)}\r\nq={k:re.search(r'\\.Q\\(([^)]*)\\)',v).group(1) if '.Q(' in v else 'noQ' for k,v in q.items()}\r\ncnt={}\r\nfor l in open(d+'/rep/ends.rpt'):\r\n    m=re.match(r'^(\\S+)\\s+\\(\\S+\\)\\s+([-\\d.]+)\\s+([-\\d.]+)\\s+([-\\d.]+)',l)\r\n    if not m: continue\r\n    ep=m.group(1); sl=float(m.group(4))\r\n    inst=ep.split('/')[0]\r\n    qn=q.get(inst,ep)\r\n    kind='retimed mult flop' if re.match(r'^(_\\d+_|net\\d+|noQ)$',qn) else 'named:'+re.sub(r'\\[\\d+\\]','',qn)\r\n    cnt.setdefault(kind,[]).append(sl)\r\nfor k,v in sorted(cnt.items(),key=lambda x:min(x[1])):\r\n    print(f'{k:30s} worst {min(v):7.3f}  endpoints<0: {sum(1 for s in v if s<0)} of {len(v)}')\r\nPY\r\ndone\r\n== b1_r7\r\nnamed:RDY_blockRead            worst  -0.230  endpoints<0: 1 of 1\r\nnamed:readMem_addr             worst  -0.230  endpoints<0: 5 of 6\r\nretimed mult flop              worst  -0.190  endpoints<0: 169 of 342\r\nnamed:writeMem_val             worst  -0.090  endpoints<0: 5 of 11\r\nnamed:b_q                      worst  -0.050  endpoints<0: 16 of 16\r\nnamed:a_q                      worst  -0.050  endpoints<0: 13 of 16\r\nnamed:RDY_mult                 worst  -0.030  endpoints<0: 1 of 1\r\nnamed:VALID_memVal             worst  -0.030  endpoints<0: 1 of 1\r\nnamed:acc_q                    worst  -0.030  endpoints<0: 5 of 6\r\n== b1_r8\r\nnamed:readMem_addr             worst  -0.200  endpoints<0: 3 of 6\r\nretimed mult flop              worst  -0.200  endpoints<0: 142 of 341\r\nnamed:RDY_blockRead            worst  -0.180  endpoints<0: 1 of 1\r\nnamed:RDY_mult                 worst  -0.130  endpoints<0: 1 of 1\r\nnamed:acc_q                    worst  -0.110  endpoints<0: 2 of 5\r\nnamed:b_q                      worst  -0.090  endpoints<0: 10 of 16\r\nnamed:a_q                      worst  -0.090  endpoints<0: 12 of 13\r\nnamed:writeMem_val             worst  -0.090  endpoints<0: 1 of 16\r\nnamed:VALID_memVal             worst   0.050  endpoints<0: 0 of 1\r\n"]
[2801.002, "o", "\u001b[1;32m$\u001b[0m (GP4=0 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh y800_a 1.25 0 1010 0 1000 0 kogge-stone & GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=8 SEL=1 CSL=1 PRE=1 build/exp/run.sh y800_b 1.25 0 1010 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; GP4=1 MAPLIB=build/exp/lib_du2.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh y800_c 1.25 0 1010 0 1000 0 kogge-stone 2>&1 | grep -v Warning\r\ny800_a P=1.25 enc=0 csa=1010 spl=0 abcD=1000 | yosys_area=4249.616000 rsz_area=4465 wns=0.023 whs=0.028 pwr_est=2.4188e-03\r\ny800_b P=1.25 enc=0 csa=1010 spl=0 abcD=1000 | yosys_area=4187.106000 rsz_area=4508 wns=-0.004 whs=0.020 pwr_est=2.4171e-03\r\ny800_c P=1.25 enc=0 csa=1010 spl=0 abcD=1000 | yosys_area=4165.560000 rsz_area=4382 wns=-0.078 whs=0.020 pwr_est=2.4115e-03\r\n"]
[2836.907, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\ns = open('top3.sv.in').read()\r\na = s.index(\"    // output-port registers\")\r\nb = s.index(\"    logic signed [31:0] p;\")\r\nnew = \"\"\"    // output-port registers\r\n    logic       rdy_mult_q, rdy_rd_q, vld_q, wr_q;\r\n    logic [5:0] ptr_q;\r\n    // internal copies (complemented): n*_q == ~(output twin) at all times\r\n    logic       nrdy_mult_q, nrdy_rd_q, nwr_q;\r\n    logic [5:0] nptr_q;\r\n    logic [5:0] acc_q;\r\n    logic [LAT-2:0] v_q;                 // valid bit of pipeline ranks 1..LAT-1\r\n    // counter flags, registered: each 6-bit counter is two 3-bit halves, and\r\n    // xx7_q == (half == 7), so 'counter == 63' is the AND of two flags\r\n    logic       pl7_q, ph7_q, al7_q, ah7_q;\r\n\r\n    wire       acc = EN_mult & ~nrdy_mult_q;\r\n    wire       rd  = EN_blockRead & ~nrdy_rd_q;\r\n    wire       wr  = ~nwr_q;\r\n    wire [5:0] ptr = ~nptr_q;\r\n    wire       step     = wr | rd;               // address pointer advances\r\n    wire       ptr_last = pl7_q & ph7_q;         // ptr == 63\r\n    wire       acc_last = al7_q & ah7_q;         // acc_q == 63\r\n    wire       wr_last  = wr & ptr_last;\r\n    wire       rd_last  = rd & ptr_last;\r\n    wire       rdy_mult_d = rd_last | (~nrdy_mult_q & ~(acc & acc_last));\r\n    wire       rdy_rd_d   = wr_last | (~nrdy_rd_q & ~rd_last);\r\n    wire       step_h   = step & pl7_q;          // carry into the upper half\r\n    wire       acc_h    = acc & al7_q;\r\n    wire [5:0] ptr_d    = {step_h ? ptr[5:3] + 3'd1 : ptr[5:3], step ? ptr[2:0] + 3'd1 : ptr[2:0]};\r\n\r\n    always_ff @(posedge clk) begin\r\n        if (!RST_N) begin\r\n            rdy_mult_q <= 1'b1; rdy_rd_q <= 1'b0; vld_q <= 1'b0; wr_q <= 1'b0; ptr_q <= '0;\r\n            nrdy_mult_q <= 1'b0; nrdy_rd_q <= 1'b1; nwr_q <= 1'b1; nptr_q <= '1;\r\n            acc_q <= '0; v_q <= '0;\r\n            pl7_q <= 1'b0; ph7_q <= 1'b0; al7_q <= 1'b0; ah7_q <= 1'b0;\r\n        end else begin\r\n            v_q <= {v_q[LAT-3:0], acc};\r\n            wr_q <= v_q[LAT-2];   nwr_q <= ~v_q[LAT-2];\r\n            if (acc)    begin acc_q[2:0] <= acc_q[2:0] + 3'd1; al7_q <= (acc_q[2:0] == 3'd6); end\r\n            if (acc_h)  begin acc_q[5:3] <= acc_q[5:3] + 3'd1; ah7_q <= (acc_q[5:3] == 3'd6); end\r\n            if (step)   pl7_q <= (ptr[2:0] == 3'd6);\r\n            if (step_h) ph7_q <= (ptr[5:3] == 3'd6);\r\n            rdy_mult_q <= rdy_mult_d; nrdy_mult_q <= ~rdy_mult_d;\r\n            rdy_rd_q   <= rdy_rd_d;   nrdy_rd_q   <= ~rdy_rd_d;\r\n            ptr_q      <= ptr_d;      nptr_q      <= ~ptr_d;\r\n            vld_q <= rd;\r\n        end\r\n    end\r\n\r\n\"\"\"\r\ns = s[:a] + new + s[b:]\r\ns = s.replace(\"// The end-of-phase conditions acc_q == 63 and ptr == 63 are registered flags.\",\r\n \"// The counters are split into 3-bit halves with registered 'half == 7' flags, so\\n// that the end-of-phase tests acc_q == 63 and ptr == 63 are 2-input ANDs.\")\r\nopen('top4.sv.in','w').write(s)\r\nEOF\r\ngrep -n \"acc_last_q\\|ptr_last_q\" top4.sv.in; TOP=top4.sv.in python3 gen2.py v6 --b1 0.62 --budget 0.62 --k 4 --cpa3 | head -2; cd ../..; D=build/cand_dadda/v6; make check RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 2>&1 | grep -E \"^ALL PASS|FAIL|rror\" | head\r\nplan: None\r\nLAT=8 datapath flops=594\r\nALL PASS\r\n"]
[2840.385, "o", "\u001b[1;32m$\u001b[0m (GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh z800_1101 1.25 0 1101 0 1000 0 kogge-stone & GP4=1 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh z800_1011 1.25 0 1011 0 1000 0 kogge-stone & wait) 2>&1 | grep -v Warning; GP4=0 MAPLIB=build/exp/lib_du3.lib CSW=4 SEL=1 CSL=1 PRE=1 build/exp/run.sh z800_0111 1.25 0 1110 0 1000 0 kogge-stone 2>&1 | grep -v Warning\r\nz800_1101 P=1.25 enc=0 csa=1101 spl=0 abcD=1000 | yosys_area=4667.236000 rsz_area=4755 wns=0.075 whs=0.041 pwr_est=2.7276e-03\r\nz800_1011 P=1.25 enc=0 csa=1011 spl=0 abcD=1000 | yosys_area=4757.144000 rsz_area=4973 wns=-0.004 whs=0.020 pwr_est=2.8014e-03\r\nz800_0111 P=1.25 enc=0 csa=1110 spl=0 abcD=1000 | yosys_area=4587.702000 rsz_area=4744 wns=0.023 whs=0.028 pwr_est=2.6428e-03\r\n"]
[2860.339, "o", "\u001b[1;32m$\u001b[0m for a in 1050 800; do D=build/cand_dadda/v6_abc$a; mkdir -p $D; (make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v6/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1) & done; wait; cd build/cand_dadda; for a in 1050 800; do v=v6_abc$a; echo \"== $v\"; grep -E \"^(worst slack|cell area|Total)\" $v/rep/sta.rpt; NPATH=300 ./ep.sh build/cand_dadda/$v > $v/rep/ep_all.txt; head -4 $v/rep/ep_all.txt; for r in a_q r1 r2 r3 r4 r5 r6 writeMem_val ptr acc_q 7_q rdy RDY; do echo \"$r: $(grep \"$r\" $v/rep/ep_all.txt | head -1 | awk '{print $2}')\"; done | tr '\\n' ' '; echo; done\r\n[1]-  Done                    ( make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v6/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n[2]+  Done                    ( make synth RUN=800 ABC_D=$a RTL_DIR=build/cand_dadda/v6/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n== v6_abc1050\r\nworst slack max 0.150\r\nworst slack min 0.076\r\nTotal                2.5876e-03 1.6311e-04 6.7374e-05 2.8181e-03 100.0%\r\ncell area 5277.972 um^2 (sequential 2785.552 um^2, 2861 instances)\r\n_5507_/D 1.04 .Q(\\u_mult.r1 [109])\r\n_5457_/D 1.04 .Q(\\u_mult.r1 [59])\r\n_5564_/D 1.05 .Q(\\u_mult.r1 [166])\r\n_5555_/D 1.04 .Q(\\u_mult.r1 [157])\r\na_q: 0.96 r1: 1.04 r2: 0.99 r3: 0.99 r4: 0.97 r5: 1.05 r6: 0.97 writeMem_val:  ptr: 0.99 acc_q: 1.02 7_q: 1.02 rdy:  RDY:  \r\n== v6_abc800\r\nworst slack max 0.150\r\nworst slack min 0.076\r\nTotal                2.5876e-03 1.6311e-04 6.7374e-05 2.8181e-03 100.0%\r\ncell area 5277.972 um^2 (sequential 2785.552 um^2, 2861 instances)\r\n_5507_/D 1.04 .Q(\\u_mult.r1 [109])\r\n_5457_/D 1.04 .Q(\\u_mult.r1 [59])\r\n_5564_/D 1.05 .Q(\\u_mult.r1 [166])\r\n_5555_/D 1.04 .Q(\\u_mult.r1 [157])\r\na_q: 0.96 r1: 1.04 r2: 0.99 r3: 0.99 r4: 0.97 r5: 1.05 r6: 0.97 writeMem_val:  ptr: 0.99 acc_q: 1.02 7_q: 1.02 rdy:  RDY:\r\n"]
[2866.922, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/scripts/synth.tcl'\r\ns=open(p).read()\r\ns=s.replace('puts $cf \"set_driving_cell BUF_X1\\\\nset_load [expr {[info exists ::env(ABC_LOAD)] ? $::env(ABC_LOAD) : 1.0}]\"',\r\n'''set drv  [expr {[info exists ::env(ABC_DRIVER)] ? $::env(ABC_DRIVER) : \"BUF_X1\"}]\r\nset load [expr {[info exists ::env(ABC_LOAD)] ? $::env(ABC_LOAD) : 1.0}]\r\nif {$drv ne \"\" && $drv ne \"none\"} { puts $cf \"set_driving_cell $drv\" }\r\nputs $cf \"set_load $load\"''')\r\nopen(p,'w').write(s)\r\nm=open('Makefile').read()\r\nm=m.replace('''  ABC_D   ?= 2200\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone''','''  ABC_D   ?= 2200\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone\r\n  # ABC mapping knobs (see notes/WORKLOG.md): no input-driver model, the SPEC\r\n  # output load on every ABC output, full cell library\r\n  ABC_DRIVER ?= none\r\n  ABC_LOAD   ?= 23.5\r\n  DONT_USE   ?=''')\r\nm=m.replace('''  ABC_D   ?= 1050\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone''','''  ABC_D   ?= 1050\r\n  BOOTH   ?= 1\r\n  ADDER   ?= kogge-stone\r\n  # ABC mapping knobs: BUF_X1 input driver, 1 fF load (ABC outputs are mostly\r\n  # flip-flop D pins), and no cells with 3- or 4-high stacks or MUX2 (slow at\r\n  # the slow corner) during mapping\r\n  ABC_DRIVER ?= BUF_X1\r\n  ABC_LOAD   ?= 1.0\r\n  DONT_USE   ?= OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*''')\r\nm=m.replace(\"-e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT=$(BUILD)/syn.v\",\"-e BOOTH=$(BOOTH) -e ADDER=$(ADDER) -e OUT=$(BUILD)/syn.v \\\\\\n               -e ABC_DRIVER=$(ABC_DRIVER) -e ABC_LOAD=$(ABC_LOAD) -e MAPLIB=$(if $(strip $(DONT_USE)),$(BUILD)/maplib.lib,)\")\r\nm=m.replace('''\t$(YOSYS) -q -l $(REP)/synth.log -c submission/scripts/synth.tcl''','''\t$(if $(strip $(DONT_USE)),python3 submission/scripts/lib_dont_use.py $(LIB) $(BUILD)/maplib.lib $(DONT_USE),)\r\n\t$(YOSYS) -q -l $(REP)/synth.log -c submission/scripts/synth.tcl''')\r\nopen('Makefile','w').write(m)\r\nEOF\r\ngrep -n \"MAPLIB\\|DONT_USE\\|ABC_DRIVER\" Makefile | head; cp -r submission/outputs build/outputs_cp2_backup; make synth RUN=400 2>&1 | tail -5\r\n14:  ABC_DRIVER ?= none\r\n16:  DONT_USE   ?=\r\n26:  ABC_DRIVER ?= BUF_X1\r\n28:  DONT_USE   ?= OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\r\n52:               -e ABC_DRIVER=$(ABC_DRIVER) -e ABC_LOAD=$(ABC_LOAD) -e MAPLIB=$(if $(strip $(DONT_USE)),$(BUILD)/maplib.lib,) \\\r\n67:\t$(if $(strip $(DONT_USE)),python3 submission/scripts/lib_dont_use.py $(LIB) $(BUILD)/maplib.lib $(DONT_USE),)\r\nworst slack max 0.152\r\nworst slack min 0.053\r\ntns max 0.000\r\nTotal                4.5965e-04 1.6037e-04 3.2514e-05 6.5253e-04 100.0%\r\ncell area 2386.552 um^2 (sequential 753.844 um^2, 1501 instances)\r\n"]
[2870.402, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && for b in 0.62 0.64 0.66 0.68 0.70 0.72 0.74 0.76 0.78 0.80 0.84; do echo \"B=$b: $(TOP=top4.sv.in python3 gen2.py /tmp/claude-0/x --b1 0.62 --budget $b --k 4 --cpa3 | grep -o 'LAT=.*\\|[0-9]* flops' | tr '\\n' ' ')\"; done\r\nB=0.62: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\nB=0.64: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\nB=0.66: LAT=8 datapath flops=596 181 flops 106 flops 68 flops 53 flops 65 flops 59 flops 32 flops \r\nB=0.68: LAT=8 datapath flops=596 181 flops 106 flops 68 flops 53 flops 65 flops 59 flops 32 flops \r\nB=0.70: LAT=8 datapath flops=596 181 flops 106 flops 68 flops 53 flops 65 flops 59 flops 32 flops \r\nB=0.72: LAT=8 datapath flops=596 181 flops 106 flops 68 flops 53 flops 65 flops 59 flops 32 flops \r\nB=0.74: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\nB=0.76: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\nB=0.78: LAT=8 datapath flops=594 181 flops 106 flops 67 flops 52 flops 65 flops 59 flops 32 flops \r\nB=0.80: LAT=8 datapath flops=565 181 flops 91 flops 58 flops 47 flops 65 flops 59 flops 32 flops \r\nB=0.84: LAT=7 datapath flops=504 181 flops 84 flops 51 flops 65 flops 59 flops 32 flops\r\n"]
[2872.437, "o", "\u001b[1;32m$\u001b[0m sed -i \"s|python3 submission/scripts/lib_dont_use.py \\$(LIB) \\$(BUILD)/maplib.lib \\$(DONT_USE)|python3 submission/scripts/lib_dont_use.py \\$(LIB) \\$(BUILD)/maplib.lib \\$(foreach c,\\$(DONT_USE),'\\$(c)')|\" Makefile && grep -n \"lib_dont_use\" Makefile; git status --short | head\r\n67:\t$(if $(strip $(DONT_USE)),python3 submission/scripts/lib_dont_use.py $(LIB) $(BUILD)/maplib.lib $(foreach c,$(DONT_USE),'$(c)'),)\r\n M Makefile\r\n M submission/scripts/resize.tcl\r\n M submission/scripts/synth.tcl\r\n M submission/syn_reports/400/resize.log\r\n M submission/syn_reports/400/synth.log\r\n?? submission/scripts/lib_dont_use.py\r\n"]
[2875.779, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && v=v6_abc1050; p=$(grep \"r2 \\[\" $v/rep/ep_all.txt | head -1 | awk '{print $1}'); p3=$(grep \"r3 \\[\" $v/rep/ep_all.txt | head -1 | awk '{print $1}'); ./path1.sh build/cand_dadda/$v \"$p $p3\"\r\nStartpoint: _5568_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5388_ (rising edge-triggered flip-flop clocked by clk)\r\n     3    6.489    0.063    0.397    0.397 ^ _5568_/Q (DFF_X1)\r\n     1    2.533    0.097    0.190    0.587 ^ _4692_/Z (XOR2_X1)\r\n     2    4.580    0.122    0.168    0.755 ^ _4696_/ZN (XNOR2_X1)\r\n     1    1.901    0.085    0.196    0.950 ^ _4759_/Z (XOR2_X1)\r\n     1    1.340    0.038    0.042    0.992 v _4760_/ZN (NOR2_X1)\r\n                                     0.157   slack (MET)\r\nStartpoint: _5316_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5241_ (rising edge-triggered flip-flop clocked by clk)\r\n     3    6.489    0.063    0.397    0.397 ^ _5316_/Q (DFF_X1)\r\n     1    2.533    0.097    0.190    0.587 ^ _3232_/Z (XOR2_X1)\r\n     2    4.580    0.122    0.168    0.755 ^ _3236_/ZN (XNOR2_X1)\r\n     1    1.901    0.085    0.196    0.950 ^ _3244_/Z (XOR2_X1)\r\n     1    1.340    0.023    0.042    0.992 v _3245_/ZN (NOR2_X1)\r\n                                     0.165   slack (MET)\r\n"]
[2889.658, "o", "\u001b[1;32m$\u001b[0m mkdir -p build/r400new/rtl && cp submission/rtl_400/mkMultBuff.sv build/r400new/rtl/ && cp build/exp/mult_pipe.sv build/r400new/rtl/ && make synth RUN=400 RTL_DIR=build/r400new/rtl BUILD=build/r400new REP=build/r400new/rep NETLIST=build/r400new/map.v SDF=build/r400new/map.sdf 2>&1 | tail -5\r\nworst slack max -0.037\r\nworst slack min 0.053\r\ntns max -0.037\r\nTotal                4.6065e-04 1.6726e-04 3.3696e-05 6.6161e-04 100.0%\r\ncell area 2467.150 um^2 (sequential 751.716 um^2, 1562 instances)\r\n"]
[2911.092, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\nmp=open('build/exp/mult_pipe.sv').read()\r\nhdr_old=mp[:mp.index('module mult_pipe')]\r\nhdr='''// mult_pipe.sv -- pipelined signed 16x16 multiplier: radix-4 (modified) Booth\r\n// partial products, carry-save (3:2) reduction 9->6->4->3->2 rows and a final\r\n// carry-propagate adder. Every pipeline cut is optional (parameters).\r\n//   PRE_ENC  : Booth-recode the multiplier before the operand register\r\n//   ENC_REG  : (PRE_ENC = 0 only) extra rank after the Booth recoding\r\n//   SEL_REG  : register the selected partial products (8 x 17 bits + 8 \"+1\" bits)\r\n//   CSA_REG  : bit k set -> register after carry-save level k+1 (k = 0..3)\r\n//   GP4      : the level-4 register holds generate/propagate (c&s, c^s) of the\r\n//              two final rows instead of the rows themselves (same width)\r\n//   CPA_CSEL : two-stage carry-select final adder with CSW-bit blocks and\r\n//              Kogge-Stone prefixes inside the blocks and across the blocks\r\n//   CPA_SPLIT: (alternative) low 16 bits in one stage, high 16 bits in the next\r\n// Register ranks (= latency from 'en' to 'p'): 1 (operand) + (PRE_ENC ? 0 : ENC_REG)\r\n//   + SEL_REG + popcount(CSA_REG) + (CPA_CSEL | CPA_SPLIT) + 1 (product)\r\n// Every register has a synchronous active-low reset. When 'en' is 0 the operand\r\n// register loads zeros (operand isolation), so an idle multiplier does not toggle.\r\n// Written for this project; the Booth recoding, the sign-extension constant and\r\n// the prefix adders follow textbook schemes (see the report's references).\r\n'''\r\nmp=hdr+mp[mp.index('module mult_pipe'):]\r\nopen('submission/rtl_800/mult_pipe.sv','w').write(mp)\r\nt=open('build/exp/top.sv').read()\r\ndesc='''// eight register ranks (LAT = 8):\r\n//   rank 1: operand register; mult_input1 is Booth-recoded before it\r\n//   rank 2: selected partial products (8 rows of 17 bits + 8 \"+1\" bits)\r\n//   rank 3: carry-save level 1 (9 -> 6 rows)\r\n//   rank 4: carry-save levels 2 and 3 (6 -> 4 -> 3 rows)\r\n//   rank 5: carry-save level 4 (3 -> 2 rows), stored as generate/propagate\r\n//   rank 6: carry-select adder stage A (4-bit blocks: sums for carry-in 0/1,\r\n//           block carry-outs)\r\n//   rank 7: product, after the block-carry prefix and the sum selection;\r\n//           drives writeMem_val directly\r\n// (rank numbering: LAT counts ranks 1..7 plus the separate output copy of the\r\n//  last valid bit, so EN_writeMem is high in the cycle the product is in rank 7)'''\r\nhdr2='''// mkMultBuff.sv -- 800 MHz implementation (1.25 ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, carry-select adder),\r\n// with\r\n'''+desc+'''\r\n// A LAT-bit valid shift register runs alongside the datapath and drives\r\n// EN_writeMem (F4).\r\n//\r\n// Control: the registered ready flags rdy_mult_q / rdy_rd_q are the fill /\r\n// drain state machine (FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1}); acc_q counts\r\n// pairs accepted in the fill phase, so pairs in flight count against the\r\n// capacity (F5); wp_q / rp_q are the write and read pointers. Changes from the\r\n// 400 MHz control for timing at 1.25 ns: separate write and read pointers, and\r\n// port-only copies of RDY_mult, RDY_blockRead, writeMem_addr, readMem_addr and\r\n// EN_writeMem, so the output load does not slow the internal handshake logic.\r\n// All outputs come from registers except EN_readMem (= EN_blockRead &\r\n// RDY_blockRead, F7) and memVal_data (= readMem_val, F8).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\n'''\r\nt=t[t.index('module mkMultBuff'):]\r\nt=hdr2+t\r\nfor a,b in [(\"`PRE\",\"1'b1\"),(\"`ENC\",\"1'b0\"),(\"`CSA\",\"4'b1101\"),(\"`SPL\",\"1'b0\"),(\"`SEL\",\"1'b1\"),(\"`CSL\",\"1'b1\"),(\"`CSWV\",\"4\"),(\"`GP4V\",\"1'b1\")]:\r\n    t=t.replace(a,b)\r\nt=t.replace(\"\"\"    localparam int       LAT_M     = 1 + (PRE_ENC ? 0 : ENC_REG) + CSA_REG[0] + CSA_REG[1] + CSA_REG[2] + CSA_REG[3] + 1 + (CPA_SPLIT | CPA_CSEL) + SEL_REG;\r\n    localparam int       LAT       = LAT_M;       // operand register included\"\"\",\"\"\"    localparam int       LAT       = 1 + (PRE_ENC ? 0 : ENC_REG) + SEL_REG + CSA_REG[0] + CSA_REG[1]\r\n                                     + CSA_REG[2] + CSA_REG[3] + (CPA_SPLIT | CPA_CSEL) + 1;\"\"\")\r\nopen('submission/rtl_800/mkMultBuff.sv','w').write(t)\r\nEOF\r\ngrep -n \"localparam\\|LAT \" submission/rtl_800/mkMultBuff.sv | head -12\r\n6:// eight register ranks (LAT = 8):\r\n16:// (rank numbering: LAT counts ranks 1..7 plus the separate output copy of the\r\n50:    localparam bit       PRE_ENC   = 1'b1;\r\n51:    localparam bit       ENC_REG   = 1'b0;\r\n52:    localparam bit [3:0] CSA_REG   = 4'b1101;\r\n53:    localparam bit       SEL_REG   = 1'b1;\r\n54:    localparam bit       CPA_SPLIT = 1'b0;\r\n55:    localparam bit       CPA_CSEL  = 1'b1;\r\n56:    localparam int       LAT       = 1 + (PRE_ENC ? 0 : ENC_REG) + SEL_REG + CSA_REG[0] + CSA_REG[1]\r\n"]
[2931.991, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/rtl_800/mkMultBuff.sv'\r\nt=open(p).read()\r\nt=t.replace(\"// eight register ranks (LAT = 8):\",\"// seven register ranks (LAT = 7):\")\r\nt=t.replace('''// (rank numbering: LAT counts ranks 1..7 plus the separate output copy of the\r\n//  last valid bit, so EN_writeMem is high in the cycle the product is in rank 7)\r\n''','')\r\nopen(p,'w').write(t)\r\nEOF\r\nmake check RUN=800 2>&1 | grep -E \"latency|^ALL PASS|^FAIL\"; make synth RUN=800 2>&1 | tail -5\r\n==== mkMultBuff_tb summary (seed=402, period=1.250 ns, latency=7, cycles=5897) ====\r\nALL PASS\r\nworst slack max 0.075\r\nworst slack min 0.041\r\ntns max 0.000\r\nTotal                2.4504e-03 2.1421e-04 6.3031e-05 2.7276e-03 100.0%\r\ncell area 4755.016 um^2 (sequential 2609.194 um^2, 2429 instances)\r\n"]
[2940.894, "o", "\u001b[1;32m$\u001b[0m D=build/cand_dadda/v6_abc1050; time make sim power RUN=800 RTL_DIR=build/cand_dadda/v6/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 2>&1 | grep -E \"ALL PASS|FAIL|rror|W|power|fill|drain|run\" | head -20\r\nINFO t=7287500 ps: fill/drain phase 14 complete\r\n  fill/drain phases completed: 14, products accepted: 1064, returned: 915\r\n  WATCHDOG checks=       0  failures=0\r\nALL PASS\r\nbash submission/scripts/power.sh build/cand_dadda/v6_abc1050/rep build/cand_dadda/v6_abc1050 build/cand_dadda/v6_abc1050/map.v 1.25 tech/NangateOpenCellLibrary_slow.lib openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a\r\ncase                                                internal switching   leakage  total uW\r\nrun: window whole run                                2837.40    372.11     69.44   3279.00\r\nfill: window 268125..348125 ps                       4082.40   1568.50     73.92   5724.80\r\ndrain: window 358125..438125 ps                      2577.80     56.27     68.26   2702.40\r\n\r\nreal\t0m36.478s\r\nuser\t0m33.027s\r\nsys\t0m0.136s\r\n"]
