[2297.136, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime/src && python3 - <<'EOF'\r\np='f14check.tcl'\r\nt=open(p).read()\r\nstart=t.index('set ff ')\r\nend=t.index('set ok 0')\r\nt=t[:start]+'''set fh [open $::env(DNETS) r]; set nets [split [string trim [read $fh]] \"\\\\n\"]; close $fh\r\nset ff [llength $nets]\r\n'''+t[end:]\r\nt=t.replace('set w [lindex [split $n /] end]','set w $n')\r\nt=t.replace('distinct D nets [llength $nets], ','')\r\nopen(p,'w').write(t)\r\np='f14.sh'\r\nt=open(p).read()\r\nt=t.replace(\"open(sys.argv[2], 'w').write(t)\",\"\"\"open(sys.argv[2], 'w').write(t)\r\nds = re.findall(r'\\\\bDFF\\\\w*\\\\s+\\\\S+\\\\s*\\\\(([^;]*)\\\\);', t, re.S)\r\nnets = [re.search(r'\\\\.D\\\\(\\\\s*([^)\\\\s]+)\\\\s*\\\\)', d).group(1) for d in ds]\r\nopen(sys.argv[2][:-2] + '.dnets', 'w').write('\\\\n'.join(nets) + '\\\\n')\"\"\")\r\nt=t.replace('-e NETLIST=$S','-e NETLIST=$S -e DNETS=${S%.v}.dnets')\r\nopen(p,'w').write(t)\r\nEOF\r\ncat f14check.tcl | sed -n 9,20p; cd /home/user/elec402-p2-open && build/cand_retime/src/f14.sh build/cand_retime/ref400.v; head -3 build/cand_retime/ref400.f14in.dnets\r\nopt_clean\r\nset fh [open $::env(DNETS) r]; set nets [split [string trim [read $fh]] \"\\n\"]; close $fh\r\nset ff [llength $nets]\r\nset ok 0; set bad {}\r\nyosys log \"F14DBG [llength $nets] [lrange $nets 0 3]\"\r\nforeach n $nets {\r\n    set w $n\r\n    if {[catch {sat -set RST_N 0 -prove $w 0 -verify -ignore_unknown_cells} msg]} { lappend bad $w } else { incr ok }\r\n}\r\nyosys log \"F14CHECK: flops $ff, reset-gated $ok, NOT reset-gated [llength $bad]\"\r\nF14CHECK: flops 166, reset-gated 1, NOT reset-gated 165\r\n_0008_\r\n_0007_\r\n_0006_\r\n"]
