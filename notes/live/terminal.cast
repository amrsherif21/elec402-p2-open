[2945.804, "o", "\u001b[1;32m$\u001b[0m cat submission/syn_reports/400/power_summary.txt 2>/dev/null | head; grep -E \"^(worst|cell area)\" submission/syn_reports/400/sta.rpt\r\ncase                                                internal switching   leakage  total uW\r\nsynthesis estimate (vectorless, activity 0.1)         459.65    160.37     32.51    652.53\r\nrun: window whole run                                 455.01    155.25     32.55    642.80\r\nfill: window 521250..681250 ps                        815.82    629.82     34.50   1480.10\r\ndrain: window 688750..848750 ps                       372.57     25.83     31.96    430.37\r\nworst slack max 0.152\r\nworst slack min 0.053\r\ncell area 2386.552 um^2 (sequential 753.844 um^2, 1501 instances)\r\n"]
[2950.421, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime/src && cat f14.sh; cat f14check.tcl | head -60\r\n#!/usr/bin/env bash\r\n# f14.sh NETLIST -- SAT check that every flop's D is forced to 0 by RST_N = 0\r\ncd /home/user/elec402-p2-open\r\nN=$1; S=${N%.v}.f14in.v\r\npython3 - \"$N\" \"$S\" <<'PY'\r\nimport re, sys\r\nt = open(sys.argv[1]).read()\r\nt = re.sub(r'\\\\(\\S+)(\\s)', lambda m: 'e_' + re.sub(r'\\W', '_', m.group(1)) + m.group(2), t)\r\nopen(sys.argv[2], 'w').write(t)\r\nds = re.findall(r'\\bDFF\\w*\\s+\\S+\\s*\\(([^;]*)\\);', t, re.S)\r\nnets = [re.search(r'\\.D\\(\\s*([^)\\s]+)\\s*\\)', d).group(1) for d in ds]\r\nopen(sys.argv[2][:-2] + '.dnets', 'w').write('\\n'.join(nets) + '\\n')\r\nPY\r\nIMG=openroad/orfs@sha256:d3505fd5f930fcd20d3d25a41f3047230b7db7b7797e3448561c9e556cca3774\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$S -e DNETS=${S%.v}.dnets $IMG \\\r\n  /OpenROAD-flow-scripts/tools/install/yosys/bin/yosys -q -l ${N%.v}.f14.log -c build/cand_retime/src/f14check.tcl >/dev/null 2>&1\r\ngrep F14CHECK ${N%.v}.f14.log || tail -3 ${N%.v}.f14.log\r\n# f14check.tcl -- for every flip-flop of the netlist, prove (SAT, all other\r\n# signals and flop outputs free) that its D input is 0 whenever RST_N = 0.\r\n# env: LIB, NETLIST\r\nyosys -import\r\nread_liberty -ignore_miss_func $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nhierarchy -top mkMultBuff\r\nflatten\r\ndelete t:\\$_DFF_P_ t:\\$scopeinfo\r\nset fh [open $::env(DNETS) r]; set nets [split [string trim [read $fh]] \"\\n\"]; close $fh\r\nset ff [llength $nets]\r\nset ok 0; set bad {}\r\nyosys log \"F14DBG [llength $nets] [lrange $nets 0 3]\"\r\nset tf $::env(DNETS).sat\r\nproc proved {w v} {\r\n    global tf\r\n    yosys tee -q -o $tf sat -set RST_N 0 -prove $w $v -ignore_unknown_cells\r\n    set fh [open $tf r]; set s [read $fh]; close $fh\r\n    return [string match \"*no model found: SUCCESS*\" $s]\r\n}\r\nset one 0\r\nforeach w $nets {\r\n    if {[proved $w 1'0]} { incr ok } elseif {[proved $w 1'1]} { incr ok; incr one } else { lappend bad $w }\r\n}\r\nyosys log \"F14CHECK: flops $ff, reset-gated $ok (of which reset-to-1 $one), NOT reset-gated [llength $bad]: [lrange $bad 0 9]\"\r\n"]
[2963.318, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && grep -n \"a_q\\|b_q\\|LAT = 1 + st\\|if (!RST_N) p <= \\|else        p <= prod\\|stage {st} register: product\\|budget = B1\\|B1 if st == 1\\|isolation\\|ffs.append\" gen2.py\r\n6:  stage 1      operand register a_q/b_q (loads zeros when no pair is accepted)\r\n209:    budget = B1 if st == 1 else B\r\n247:    ffs.append((st, comment, [(f\"{name}[{i}]\", e) for i, (k, e) in enumerate(srcs)], name, len(srcs)))\r\n268:            L.append(f\"    wire {n} = ~(a_q[{j}] & b_q[{i}]);\")\r\n270:            L.append(f\"    wire {n} = a_q[{j}] & b_q[{i}];\")\r\n278:budget = B1\r\n474:LAT = 1 + st\r\n488:o.append(\"//   operand register a_q, b_q: 32 flops (zeros when en = 0: operand isolation)\")\r\n500:o.append(\"    logic [15:0] a_q, b_q;\")\r\n506:o.append(\"        if (!RST_N || !en) begin a_q <= '0; b_q <= '0; end\")\r\n507:o.append(\"        else               begin a_q <= a;  b_q <= b;  end\")\r\n524:o.append(f\"    // stage {st} register: product\")\r\n526:o.append(\"        if (!RST_N) p <= '0;\")\r\n527:o.append(\"        else        p <= prod;\")\r\n"]
[2968.435, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && sed -n 470,535p gen2.py\r\n    body.append(f\"    //      and block selection s = s0 ^ (cin & pp)\")\r\n    pbits = select(cin, res1)\r\nbody.append(\"    assign prod = {\" + \", \".join(reversed(pbits)) + \"};\")\r\nsummary.append(f\"stage {st}: selection, product register 32 flops\")\r\nLAT = 1 + st\r\n\r\n# ---------------------------------------------------------------------------\r\nout_dir = os.path.join(args.outdir, \"rtl\")\r\nos.makedirs(out_dir, exist_ok=True)\r\nnff = 32 + sum(f[4] for f in ffs) + 32\r\no = []\r\no.append(\"// mult_tree.sv -- GENERATED by build/cand_dadda/gen2.py; edit the generator, not this file.\")\r\no.append(f\"// generator arguments: {' '.join(sys.argv[2:])}\")\r\no.append(\"//\")\r\no.append(\"// Pipelined signed 16x16 multiplier: Baugh-Wooley partial products, timing-driven\")\r\no.append(\"// column-wise carry-save (full / half adder) reduction with hand-placed pipeline\")\r\no.append(\"// registers, and a pipelined carry-select final adder. Register ranks (latency\")\r\no.append(f\"// from 'en' to 'p'): {LAT}; datapath flip-flops: {nff}.\")\r\no.append(\"//   operand register a_q, b_q: 32 flops (zeros when en = 0: operand isolation)\")\r\nfor s in summary:\r\n    o.append(\"//   \" + s)\r\no.append(\"// Every register has a synchronous active-low reset (SPEC F14).\")\r\no.append(\"module mult_tree (\")\r\no.append(\"    input  logic               clk,\")\r\no.append(\"    input  logic               RST_N,\")\r\no.append(\"    input  logic               en,     // accept: load operands, else load zeros\")\r\no.append(\"    input  logic signed [15:0] a,      // multiplicand\")\r\no.append(\"    input  logic signed [15:0] b,      // multiplier\")\r\no.append(\"    output logic signed [31:0] p       // product, registered\")\r\no.append(\");\")\r\no.append(\"    logic [15:0] a_q, b_q;\")\r\no.extend(decl)\r\no.append(\"    logic [31:0] prod;\")\r\no.append(\"\")\r\no.append(\"    // ---- operand register\")\r\no.append(\"    always_ff @(posedge clk) begin\")\r\no.append(\"        if (!RST_N || !en) begin a_q <= '0; b_q <= '0; end\")\r\no.append(\"        else               begin a_q <= a;  b_q <= b;  end\")\r\no.append(\"    end\")\r\no.append(\"\")\r\n# interleave: body lines are in stage order; append register blocks at the end per stage\r\no.extend(body)\r\no.append(\"\")\r\nfor (s, comment, pairs, name, n) in ffs:\r\n    if not n:\r\n        continue\r\n    o.append(f\"    // stage {s} register: {comment} ({n} bits)\")\r\n    o.append(\"    always_ff @(posedge clk) begin\")\r\n    o.append(f\"        if (!RST_N) {name} <= '0;\")\r\n    o.append(\"        else begin\")\r\n    for (dst, src) in pairs:\r\n        o.append(f\"            {dst} <= {src};\")\r\n    o.append(\"        end\")\r\n    o.append(\"    end\")\r\no.append(f\"    // stage {st} register: product\")\r\no.append(\"    always_ff @(posedge clk) begin\")\r\no.append(\"        if (!RST_N) p <= '0;\")\r\no.append(\"        else        p <= prod;\")\r\no.append(\"    end\")\r\no.append(\"endmodule : mult_tree\")\r\nopen(os.path.join(out_dir, \"mult_tree.sv\"), \"w\").write(\"\\n\".join(o) + \"\\n\")\r\ntop = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), os.environ.get(\"TOP\", \"top3.sv.in\"))).read()\r\nopen(os.path.join(out_dir, \"mkMultBuff.sv\"), \"w\").write(top.replace(\"@LAT@\", str(LAT)))\r\nprint(f\"LAT={LAT} datapath flops={nff}\")\r\nfor s in summary:\r\n    print(\"  \" + s)\r\n"]
[2983.654, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\ns = open('gen2.py').read()\r\ns = s.replace('ap.add_argument(\"--xor\"', 'ap.add_argument(\"--outcomb\", action=\"store_true\", help=\"no product register: selection drives p\")\\nap.add_argument(\"--inlogic\", action=\"store_true\", help=\"no operand register: PP and stage-1 reduction from the inputs\")\\nap.add_argument(\"--xor\"', 1)\r\ns = s.replace('''            L.append(f\"    wire {n} = ~(a_q[{j}] & b_q[{i}]);\")''', '''            L.append(f\"    wire {n} = ~({A}[{j}] & {Bv}[{i}]);\")''')\r\ns = s.replace('''            L.append(f\"    wire {n} = a_q[{j}] & b_q[{i}];\")''', '''            L.append(f\"    wire {n} = {A}[{j}] & {Bv}[{i}];\")''')\r\ns = s.replace(\"# stage 1: partial products\\n\", \"# stage 1: partial products\\nA, Bv = ('a', 'b') if args.inlogic else ('a_q', 'b_q')\\n\")\r\ns = s.replace('summary.append(f\"stage {st}: selection, product register 32 flops\")\\nLAT = 1 + st',\r\n 'summary.append(f\"stage {st}: selection\" + (\"\" if args.outcomb else \", product register 32 flops\"))\\nLAT = (0 if args.inlogic else 1) + st - (1 if args.outcomb else 0)')\r\ns = s.replace('nff = 32 + sum(f[4] for f in ffs) + 32', 'nff = (0 if args.inlogic else 32) + sum(f[4] for f in ffs) + (0 if args.outcomb else 32)')\r\ns = s.replace('''o.append(\"//   operand register a_q, b_q: 32 flops (zeros when en = 0: operand isolation)\")''',\r\n'''if args.inlogic:\r\n    o.append(\"//   no operand register: stage 1 starts at the inputs; the stage-1 register loads\")\r\n    o.append(\"//   zeros when en = 0 (operand isolation)\")\r\nelse:\r\n    o.append(\"//   operand register a_q, b_q: 32 flops (zeros when en = 0: operand isolation)\")''')\r\ns = s.replace('''o.append(\"    logic [15:0] a_q, b_q;\")\r\no.extend(decl)''', '''if not args.inlogic:\r\n    o.append(\"    logic [15:0] a_q, b_q;\")\r\no.extend(decl)''')\r\ns = s.replace('''o.append(\"    // ---- operand register\")\r\no.append(\"    always_ff @(posedge clk) begin\")\r\no.append(\"        if (!RST_N || !en) begin a_q <= '0; b_q <= '0; end\")\r\no.append(\"        else               begin a_q <= a;  b_q <= b;  end\")\r\no.append(\"    end\")''', '''if not args.inlogic:\r\n    o.append(\"    // ---- operand register\")\r\n    o.append(\"    always_ff @(posedge clk) begin\")\r\n    o.append(\"        if (!RST_N || !en) begin a_q <= '0; b_q <= '0; end\")\r\n    o.append(\"        else               begin a_q <= a;  b_q <= b;  end\")\r\n    o.append(\"    end\")''')\r\ns = s.replace('''    o.append(f\"        if (!RST_N) {name} <= '0;\")''', '''    rst = \"!RST_N || !en\" if (args.inlogic and s == 1) else \"!RST_N\"\r\n    o.append(f\"        if ({rst}) {name} <= '0;\")''')\r\ns = s.replace('''o.append(f\"    // stage {st} register: product\")\r\no.append(\"    always_ff @(posedge clk) begin\")\r\no.append(\"        if (!RST_N) p <= '0;\")\r\no.append(\"        else        p <= prod;\")\r\no.append(\"    end\")''', '''if args.outcomb:\r\n    o.append(\"    // no product register: the selection drives p (writeMem_val) directly\")\r\n    o.append(\"    assign p = prod;\")\r\nelse:\r\n    o.append(f\"    // stage {st} register: product\")\r\n    o.append(\"    always_ff @(posedge clk) begin\")\r\n    o.append(\"        if (!RST_N) p <= '0;\")\r\n    o.append(\"        else        p <= prod;\")\r\n    o.append(\"    end\")''')\r\nopen('gen2.py','w').write(s)\r\nEOF\r\nfor o in \"--b1 0.62 --budget 0.62 --k 4 --cpa3 --outcomb\" \"--inlogic --b1 0.95 --t-and 0.25 --budget 0.62 --k 4 --cpa3\" \"--inlogic --b1 1.0 --t-and 0.25 --budget 0.62 --k 4 --cpa3\"; do echo \"== $o\"; TOP=top4.sv.in python3 gen2.py /tmp/claude-0/x $o; done\r\n== --b1 0.62 --budget 0.62 --k 4 --cpa3 --outcomb\r\nplan: None\r\nLAT=7 datapath flops=562\r\n  stage 1: 76 FA 1 HA, max height 11, 181 flops\r\n  stage 2: 75 FA 5 HA, max height 6, 106 flops\r\n  stage 3: 39 FA 7 HA, max height 4, 67 flops\r\n  stage 4: 15 FA 5 HA, max height 2, 52 flops\r\n  stage 5: CPA part 1, blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)], 65 flops\r\n  stage 6: CPA part 2 (block prefix), 59 flops\r\n  stage 7: selection\r\n== --inlogic --b1 0.95 --t-and 0.25 --budget 0.62 --k 4 --cpa3\r\nplan: None\r\nLAT=7 datapath flops=500\r\n  stage 1: 109 FA 4 HA, max height 9, 148 flops\r\n  stage 2: 60 FA 4 HA, max height 5, 88 flops\r\n  stage 3: 29 FA 8 HA, max height 4, 59 flops\r\n  stage 4: 10 FA 4 HA, max height 2, 49 flops\r\n  stage 5: CPA part 1, blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)], 65 flops\r\n  stage 6: CPA part 2 (block prefix), 59 flops\r\n  stage 7: selection, product register 32 flops\r\n== --inlogic --b1 1.0 --t-and 0.25 --budget 0.62 --k 4 --cpa3\r\nplan: None\r\nLAT=7 datapath flops=500\r\n  stage 1: 109 FA 4 HA, max height 9, 148 flops\r\n  stage 2: 60 FA 4 HA, max height 5, 88 flops\r\n  stage 3: 29 FA 8 HA, max height 4, 59 flops\r\n  stage 4: 10 FA 4 HA, max height 2, 49 flops\r\n  stage 5: CPA part 1, blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)], 65 flops\r\n  stage 6: CPA part 2 (block prefix), 59 flops\r\n  stage 7: selection, product register 32 flops\r\n"]
[3003.294, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open && cp build/cand_retime/src/f14check.tcl submission/scripts/f14_check.tcl && python3 - <<'EOF'\r\ns=open('build/cand_retime/src/f14.sh').read()\r\ns=s.replace(\"# f14.sh NETLIST -- SAT check that every flop's D is forced to 0 by RST_N = 0\\ncd /home/user/elec402-p2-open\\nN=$1; S=${N%.v}.f14in.v\",\r\n\"\"\"# f14_check.sh NETLIST WORKDIR -- SPEC F14 check on a gate-level netlist: for every\r\n# flip-flop, Yosys' SAT solver proves that its D input is constant whenever RST_N = 0\r\n# (all other inputs and all flip-flop outputs are left free), i.e. that every\r\n# register has a synchronous reset driven by RST_N.\r\nset -euo pipefail\r\nN=$1; W=$2; mkdir -p \"$W\"; S=$W/$(basename ${N%.v}).f14in.v\"\"\")\r\ns=s.replace(\"build/cand_retime/src/f14check.tcl\",\"submission/scripts/f14_check.tcl\")\r\ns=s.replace(\"-l ${N%.v}.f14.log\",\"-l ${S%.f14in.v}.f14.log\")\r\ns=s.replace(\"grep F14CHECK ${N%.v}.f14.log || tail -3 ${N%.v}.f14.log\",\"grep F14CHECK ${S%.f14in.v}.f14.log || tail -3 ${S%.f14in.v}.f14.log\")\r\nopen('submission/scripts/f14_check.sh','w').write(s)\r\nm=open('Makefile').read()\r\nm=m.replace(\"all: synth check sim timing power\",\"\"\"# ---- SPEC F14: formal (SAT) proof that every flip-flop of the netlist is reset by RST_N\r\nf14: | $(REP) $(BUILD)\r\n\tbash submission/scripts/f14_check.sh $(NETLIST) $(BUILD)/f14 | tee $(REP)/f14.log\r\n\r\nall: synth check sim timing power f14\"\"\")\r\nm=m.replace(\".PHONY: synth check sim timing power all clean timing_fail sta_only\",\".PHONY: synth check sim timing power all clean timing_fail sta_only f14\")\r\nopen('Makefile','w').write(m)\r\nEOF\r\nhead -12 submission/scripts/f14_check.sh; make f14 RUN=400 2>&1 | tail -1; make f14 RUN=800 2>&1 | tail -1\r\n#!/usr/bin/env bash\r\n# f14_check.sh NETLIST WORKDIR -- SPEC F14 check on a gate-level netlist: for every\r\n# flip-flop, Yosys' SAT solver proves that its D input is constant whenever RST_N = 0\r\n# (all other inputs and all flip-flop outputs are left free), i.e. that every\r\n# register has a synchronous reset driven by RST_N.\r\nset -euo pipefail\r\nN=$1; W=$2; mkdir -p \"$W\"; S=$W/$(basename ${N%.v}).f14in.v\r\npython3 - \"$N\" \"$S\" <<'PY'\r\nimport re, sys\r\nt = open(sys.argv[1]).read()\r\nt = re.sub(r'\\\\(\\S+)(\\s)', lambda m: 'e_' + re.sub(r'\\W', '_', m.group(1)) + m.group(2), t)\r\nopen(sys.argv[2], 'w').write(t)\r\nF14CHECK: flops 166, reset-gated 166 (of which reset-to-1 1), NOT reset-gated 0: \r\nF14CHECK: flops 577, reset-gated 577 (of which reset-to-1 15), NOT reset-gated 0:\r\n"]
[3008.293, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && TOP=top4.sv.in python3 gen2.py v7 --b1 0.62 --budget 0.62 --k 4 --cpa3 --outcomb >/dev/null && TOP=top4.sv.in python3 gen2.py v8 --inlogic --b1 0.95 --t-and 0.25 --budget 0.62 --k 4 --cpa3 > /dev/null && cd ../.. && for v in v7 v8; do D=build/cand_dadda/$v; make check RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 2>&1 | grep -E \"^ALL PASS|FAIL|rror\" | head -3; done; for v in v7 v8; do D=build/cand_dadda/$v; (make synth RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1) & done; wait; cd build/cand_dadda; for v in v7 v8; do echo \"== $v\"; grep -E \"^(worst slack|cell area|Total)\" $v/rep/sta.rpt; NPATH=300 ./ep.sh build/cand_dadda/$v > $v/rep/ep_all.txt; head -3 $v/rep/ep_all.txt; done\r\nALL PASS\r\nALL PASS\r\n[1]-  Done                    ( make synth RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n[2]+  Done                    ( make synth RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 > $D/synth.out 2>&1 )\r\n== v7\r\nworst slack max 0.149\r\nworst slack min 0.076\r\nTotal                2.4565e-03 1.5874e-04 6.6530e-05 2.6817e-03 100.0%\r\ncell area 5089.910 um^2 (sequential 2636.326 um^2, 2784 instances)\r\n_4975_/D 1.01 .Q(\\u_mult.r5 [29])\r\n_5389_/D 1.00 .Q(\\u_mult.r1 [161])\r\n_5348_/D 1.04 .Q(\\u_mult.r1 [120])\r\n== v8\r\nworst slack max 0.161\r\nworst slack min 0.076\r\nTotal                2.4145e-03 3.2721e-04 6.4360e-05 2.8060e-03 100.0%\r\ncell area 4761.932 um^2 (sequential 2355.962 um^2, 2656 instances)\r\n_5005_/D 0.99 .Q(\\u_mult.r3 [24])\r\n_5007_/D 0.99 .Q(\\u_mult.r3 [26])\r\n_5023_/D 0.99 .Q(\\u_mult.r3 [42])\r\n"]
[3018.146, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && cat > io.tcl <<'EOF'\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nreport_checks -path_delay max -from [get_ports {mult_input0* mult_input1* EN_mult EN_blockRead}] -digits 3\r\nreport_checks -path_delay max -to [get_ports {writeMem_val*}] -digits 3\r\nEOF\r\nfor v in v7 v8 v6_abc1050; do echo \"== $v\"; docker run --rm -v $PWD/../..:/w -w /w -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=build/cand_dadda/$v/map.v -e PERIOD=1.25 --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cand_dadda/io.tcl 2>&1 | grep -E \"^Startpoint|^Endpoint|data arrival|slack\" | sed -n '1,4p;6,9p' | grep -v \"^ *-\"; done\r\n== v7\r\nStartpoint: EN_blockRead (input port clocked by clk)\r\nEndpoint: _5470_ (rising edge-triggered flip-flop clocked by clk)\r\n            0.676   data arrival time\r\nStartpoint: _4918_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: writeMem_val[11] (output port clocked by clk)\r\n            1.101   data arrival time\r\n== v8\r\nStartpoint: mult_input1[9] (input port clocked by clk)\r\nEndpoint: _5246_ (rising edge-triggered flip-flop clocked by clk)\r\n            0.967   data arrival time\r\nStartpoint: _4797_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: writeMem_val[0] (output port clocked by clk)\r\n            0.536   data arrival time\r\n== v6_abc1050\r\nStartpoint: EN_blockRead (input port clocked by clk)\r\nEndpoint: _5614_ (rising edge-triggered flip-flop clocked by clk)\r\n            0.734   data arrival time\r\nStartpoint: _5038_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: writeMem_val[0] (output port clocked by clk)\r\n            0.536   data arrival time\r\n"]
[3027.85, "o", "\u001b[1;32m$\u001b[0m cat >> notes/WORKLOG.md <<'EOF'\r\n\r\n**03:30 check/400 pushed** (`git push origin HEAD:refs/heads/check/400`, commit 60ed005). Work continued without waiting. Note: `rtl_800/` was still empty at that point, so the 800 part of that scorecard is expected to fail.\r\n\r\n## Checkpoint 3: 800 MHz\r\n\r\n**03:32 First 800 MHz probes** (`build/exp/run.sh`, mult_pipe configurations at 1.25 ns): WNS between \u22121.1 and \u22122.8 ns. The critical path was the `RST_N` input: one DFF_X1-modelled driver into 90 to 174 synchronous-reset gates, 1.4 to 2.6 ns. The Resizer cannot buffer it without placement (RSZ-0075 makeBufferedNet failed), and ABC's `buffer -p` changed nothing (the results were bit-identical).\r\n- **Fix in resize.tcl:** a throw-away floorplan plus global placement, made only so the Resizer can insert buffers. Timing inside the Resizer stays on the wire-load model (no `estimate_parasitics`), so it is the same view as sign-off STA. Result at 800 MHz: \u22121.24 \u2192 \u22120.73 ns. At 400 MHz the result is identical (+0.152 ns, 2387 \u00b5m\u00b2).\r\n\r\n**03:40 Parallel candidate evaluations (two subagents) while I iterated on the Booth/CSA candidate:**\r\n- *(B) Behavioural `*` + R extra ranks + ABC retiming (`build/cand_retime/`):*\r\n  - Best result: WNS \u22120.20 ns at R=8, about 6.1k \u00b5m\u00b2. Retiming in ABC uses unit delays, so the result saturates near \u22120.2 ns.\r\n  - Plain retiming breaks F14: 319 of 432 flops had no reset after retiming, and ABC even moved registers onto RST_N. Keeping F14 needs a non-standard strip/re-add-reset step.\r\n  - Sign-off risk: the RTL alone is a one-stage multiplier followed by delay ranks, which GPDK045 sign-off would not retime. **Rejected.**\r\n  - Its SAT-based F14 netlist check was adopted as `make f14`.\r\n- *(C) Baugh-Wooley + Dadda, hand cut:* result pending at the time of writing; see below.\r\n- *(A) Booth/CSA mult_pipe, my own:* iterations below.\r\n\r\n**Booth/CSA iterations at 1.25 ns** (each fix found from the STA critical path; area is post-Resizer):\r\n\r\n| step | change | WNS ns | area \u00b5m\u00b2 |\r\n|---|---|---|---|\r\n| e800b | PRE_ENC, CS after L2 & L4, CPA split 16/16 | \u22121.136 | 3655 |\r\n| g800b | + placement-backed buffering | \u22120.729 | 4182 |\r\n| i800a | + SEL_REG (register after PP select), all 4 CSA levels registered, 2-stage carry-select adder | \u22120.610 | 5413 |\r\n| k800a | + ABC maps with a Liberty copy in which slow stacked cells are `dont_use` (`lib_dont_use.py`; `abc -dont_use` did not reach ABC's SCL) | \u22120.440 | 5573 |\r\n| m800b | carry-select adder rewritten with explicit in-block Kogge-Stone prefix computing both carry-in sums at once (Yosys had built `x+y+1` as two chained adders); 4-bit blocks | \u22120.159 | 5853 |\r\n| n800b | separate write and read pointers (the shared pointer drove 2 ports, 47 fF) | \u22120.090 | 5965 |\r\n| r800b | port-only copies of RDY_*, addresses and EN_writeMem, stored inverted so Yosys does not merge them with the internal copies (`(* keep *)` did not prevent merging) | \u22120.014 | 5786 |\r\n| t800b | block-carry prefix in stage B instead of a ripple | \u22120.034 | 5933 |\r\n| u800b | MUX2 also dont_use (MUX2_X1 0.24 ns) | +0.051 | 5893 |\r\n| v800b | GP4: L4 register holds generate/propagate of the final rows, moving the adder's first gate level into the L4 stage (0.36 ns slack there) | +0.136 | 5824 |\r\n| x800 | ABC output load 23.5 \u2192 1 fF: ABC sees every flop D pin as a primary output and had buffered each as if it drove the 23.5 fF port load | +0.150 | 5211 |\r\n| x800_1010 | CS registers only after L2 and L4 (473 flops instead of 577+) | \u22120.004 | 4431 |\r\n| y800_a | same, GP4 = 0 | +0.023 | 4465 |\r\n| z800_1011 | CS after L1, L2, L4 | \u22120.004 | 4973 |\r\n| **z800_1101** | **CS after L1, L3, L4 (L2+L3 share a stage: L3 is a single 3:2 on 3 of 4 rows)** | **+0.075** | **4755** |\r\n\r\nABC results vary by about \u00b10.1\u20130.2 ns with small netlist-structure changes. For example, the 400 MHz RTL with the newer mult_pipe.sv (logically identical for its parameters) maps to \u22120.037 ns instead of +0.152 ns, so rtl_400 keeps its verified mult_pipe.sv. Each final configuration is deterministic, and the knobs are fixed per RUN in the Makefile (ABC_DRIVER, ABC_LOAD, DONT_USE).\r\n\r\n**04:20 rtl_800 = z800_1101** (latency 7, 577 flops; config in `submission/rtl_800/mkMultBuff.sv`). It meets the 62 ps target at the lowest area of the passing variants. The 1111 variant has more slack (+0.150 ns) but costs +456 \u00b5m\u00b2 and about +0.34 mW of vectorless power.\r\n\r\n| step | result |\r\n|---|---|\r\n| `make check RUN=800` | ALL PASS, latency 7 |\r\n| `make synth RUN=800` | WNS +0.075 ns, hold +0.041 ns, 4755.0 \u00b5m\u00b2, vectorless 2727.6 \u00b5W |\r\n| `make sim RUN=800` | ALL PASS |\r\n| `make timing RUN=800` | ALL PASS, 384 products |\r\n| `make power RUN=800` | run 3073 \u00b5W, fill window 5210 \u00b5W, drain window 2536 \u00b5W |\r\n| `make f14 RUN=400` | 166/166 flops reset-gated (SAT) |\r\n| `make f14 RUN=800` | 577/577 flops reset-gated (SAT) |\r\n\r\n`make synth RUN=400` with the final scripts and the 400 knobs reproduces the committed netlist exactly: +0.152 ns, 2386.552 \u00b5m\u00b2, and `git status` shows the netlist and SDF unchanged.\r\nEOF\r\necho ok\r\nok\r\n"]
[3049.887, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='submission/scripts/mutate.sh'\r\ns=open(p).read()\r\na=s.index('mutants=(')\r\nb=s.index(')\\nok=0')\r\nm400=s[a:b+1]\r\nm800='''mutants=(\r\n  \"if (acc_q == 6'd63) begin|if (acc_q == 6'd62) begin|RDY_mult drops one pair early\"\r\n  \"if (wr \\\\&\\\\& wp_q == 6'd63) begin|if (wr \\\\&\\\\& wp_q == 6'd62) begin|drain starts before the last write\"\r\n  \"if (rd \\\\&\\\\& rp_q == 6'd63) begin|if (rd \\\\&\\\\& rp_q == 6'd62) begin|drain ends one read early\"\r\n  \"vld_q <= rd;|vld_q <= EN_blockRead;|VALID_memVal ignores RDY_blockRead\"\r\n  \"wire acc = EN_mult \\\\& rdy_mult_q;|wire acc = EN_mult;|EN_mult accepted while not ready\"\r\n  \"wire rd  = EN_blockRead \\\\& rdy_rd_q;|wire rd  = rdy_rd_q;|reads without EN_blockRead\"\r\n  \"wp_on <= '1; rp_on <= '1; wr_on <= 1'b1;|wp_on <= '1; rp_on <= '1;|EN_writeMem copy not reset\"\r\n  \"acc_q <= '0; wp_q <= '0; rp_q <= '0; v_q <= '0;|acc_q <= '0; wp_q <= '0; rp_q <= '0;|valid pipeline not reset\"\r\n  \"v_q <= {v_q\\\\[LAT-2:0\\\\], acc};|v_q <= {v_q[LAT-2:0], EN_mult};|valid bit set by unaccepted pairs\"\r\n  \"assign memVal_data   = readMem_val;|assign memVal_data   = writeMem_val;|wrong data source\"\r\n  \"assign EN_readMem    = rd;|assign EN_readMem    = rdy_rd_q;|EN_readMem held during drain\"\r\n  \"wr_on <= ~v_q\\\\[LAT-2\\\\];|wr_on <= ~v_q[LAT-3];|EN_writeMem one cycle early\"\r\n  \"assign cin = {bg\\\\[NB-2:0\\\\], 1'b0};|assign cin = {bg[NB-2:0], 1'b1};|adder carry-in error (mult_pipe)\"\r\n)'''\r\ns=s[:a]+'if [ \"$RUN\" = 400 ]; then\\n'+m400+'\\nelse\\n'+m800+'\\nfi'+s[b+1:]\r\n# mutant may target mult_pipe.sv: apply sed to all .sv files and compare the set\r\ns=s.replace('''  sed -i \"s/$from/$to/\" \"$d/mkMultBuff.sv\"\r\n  if cmp -s \"$SRC/mkMultBuff.sv\" \"$d/mkMultBuff.sv\"; then''','''  sed -i \"s/$from/$to/\" \"$d\"/*.sv\r\n  if cat \"$SRC\"/*.sv | cmp -s - <(cat \"$d\"/*.sv); then''')\r\nopen(p,'w').write(s)\r\nEOF\r\nbash submission/scripts/mutate.sh 800 2>&1 | grep -E \"^mutant|killed\"\r\nmutant 1 (RDY_mult drops one pair early): FAIL 10618 check(s) failed\r\nmutant 2 (drain starts before the last write): FAIL 5152 check(s) failed\r\nmutant 3 (drain ends one read early): FAIL 4085 check(s) failed\r\nmutant 4 (VALID_memVal ignores RDY_blockRead): FAIL 1464 check(s) failed\r\nmutant 5 (EN_mult accepted while not ready): FAIL 9269 check(s) failed\r\nmutant 6 (reads without EN_blockRead): FAIL 12580 check(s) failed\r\nmutant 7 (EN_writeMem copy not reset): FAIL 7 check(s) failed\r\nmutant 8 (valid pipeline not reset): FAIL 5865 check(s) failed\r\nmutant 9 (valid bit set by unaccepted pairs): FAIL 9793 check(s) failed\r\nmutant 10 (wrong data source): FAIL 1818 check(s) failed\r\nmutant 11 (EN_readMem held during drain): FAIL 2236 check(s) failed\r\nmutant 12 (EN_writeMem one cycle early): FAIL 3339 check(s) failed\r\nmutant 13 (adder carry-in error (mult_pipe)): FAIL 1979 check(s) failed\r\nkilled 13 of 13 mutants\r\n"]
[3054.831, "o", "\u001b[1;32m$\u001b[0m D=build/cand_dadda/v8; make sim power RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep NETLIST=$D/map.v SDF=$D/map.sdf BOOTH=0 2>&1 | grep -E \"^ALL PASS|FAIL|window\" ; for v in v1 v2 v3 v4 v5 v5_abc800 v6_abc1050 v7 v8; do echo \"$v $(grep -E '^cell DFF' build/cand_dadda/$v/rep/sta.rpt | awk '{s+=$3} END {print s}') $(grep -E '^(worst slack max|worst slack min)' build/cand_dadda/$v/rep/sta.rpt | awk '{print $NF}' | tr '\\n' ' ') $(grep '^cell area' build/cand_dadda/$v/rep/sta.rpt | awk '{print $3}') $(grep '^Total' build/cand_dadda/$v/rep/sta.rpt | awk '{print $5}')\"; done\r\nALL PASS\r\nrun: window whole run                                2874.30    886.67     64.68   3825.70\r\nfill: window 270625..350625 ps                       3599.70   1508.40     67.58   5175.70\r\ndrain: window 359375..439375 ps                      2185.20     55.36     64.51   2305.00\r\nv1 564 -0.195 0.076  5768.210 2.7160e-03\r\nv2 595 0.062 0.076  6124.118 2.8948e-03\r\nv3 589 -0.261 0.076  5906.264 2.8070e-03\r\nv4 597 0.009 0.076  5778.052 2.8381e-03\r\nv5 614 0.011 0.076  5778.052 2.8871e-03\r\nv5_abc800 614 0.030 0.070  5268.130 2.8065e-03\r\nv6_abc1050 616 0.150 0.076  5277.972 2.8181e-03\r\nv7 583 0.149 0.076  5089.910 2.6817e-03\r\nv8 521 0.161 0.076  4761.932 2.8060e-03\r\n"]
