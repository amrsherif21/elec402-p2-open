[20366.23, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"../../submission/rtl_800/mkMultBuff.sv\").read()\r\nimport re\r\nstart = s.index(\"    // multiplier pipeline configuration\")\r\nend = s.index(\"\\n\\n\", s.index(\"localparam int       LAT\"))\r\ns = s[:start] + \"    // multiplier pipeline latency (register ranks of the generated mult_pipe.sv)\\n    localparam int LAT = @LAT@;\" + s[end:]\r\ns = re.sub(r\"    mult_pipe #\\(.*?\\)\\n        u_mult\", \"    mult_pipe u_mult\", s, flags=re.S)\r\ns = s.replace(\"u_mult (.clk\", \"(.clk\") if \"mult_pipe u_mult (.clk\" not in s else s\r\nopen(\"top800.sv.in\",\"w\").write(s)\r\ns4 = open(\"../../submission/rtl_400/mkMultBuff.sv\").read()\r\nstart = s4.index(\"    // multiplier pipeline configuration\")\r\nend = s4.index(\"\\n\\n\", s4.index(\"localparam int       LAT\"))\r\ns4 = s4[:start] + \"    // multiplier pipeline latency (register ranks of the generated mult_pipe.sv)\\n    localparam int LAT = @LAT@;\" + s4[end:]\r\ns4 = re.sub(r\"    mult_pipe #\\(.*?\\)\\n        u_mult\", \"    mult_pipe u_mult\", s4, flags=re.S)\r\nopen(\"top400.sv.in\",\"w\").write(s4)\r\nEOF\r\ngrep -n \"LAT\\|u_mult\" top800.sv.in top400.sv.in | head; cat > run.sh <<'EOF'\r\n#!/usr/bin/env bash\r\n# run.sh RUN NAME [gen_tree.py options] -- generate, unit-test, then run the flow\r\nset -euo pipefail\r\ncd \"$(dirname \"$0\")\"\r\nRUN=$1; NAME=$2; shift 2\r\nmkdir -p $NAME/rtl\r\npython3 gen_tree.py $NAME/rtl/mult_pipe.sv \"$@\" | tee $NAME/gen.txt\r\nLAT=$(head -1 $NAME/gen.txt | sed 's/LAT=\\([0-9]*\\).*/\\1/')\r\nsed \"s/@LAT@/$LAT/\" top$RUN.sv.in > $NAME/rtl/mkMultBuff.sv\r\niverilog -g2012 -Ptb_mult.LAT=$LAT -o $NAME/unit.vvp tb_mult.sv $NAME/rtl/mult_pipe.sv\r\nvvp -n $NAME/unit.vvp | tee $NAME/unit.log | grep -q \"^PASS\" || { echo UNIT FAIL; exit 1; }\r\ntail -2 $NAME/unit.log | head -1\r\ncd ../..\r\nbash submission/scripts/eval_candidate.sh $RUN build/cand800b/$NAME/rtl build/cand800b/$NAME | tee build/cand800b/$NAME/eval.txt | grep -v \"^u_mult.r\\|^[a-z_]*  \" \r\ngrep \"^u_mult\" build/cand800b/$NAME/eval.txt | awk '{g=$1; sub(/\\[.*$/,\"\",g); print}' \r\nEOF\r\nchmod +x run.sh\r\ntop800.sv.in:6:// seven register ranks (LAT = 7):\r\ntop800.sv.in:16:// A LAT-bit valid shift register runs alongside the datapath and drives\r\ntop800.sv.in:48:    localparam int LAT = @LAT@;\r\ntop800.sv.in:61:    logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\r\ntop800.sv.in:66:    wire wr  = v_q[LAT-1];\r\ntop800.sv.in:75:            v_q <= {v_q[LAT-2:0], acc};\r\ntop800.sv.in:82:            wr_on <= ~v_q[LAT-2];\r\ntop800.sv.in:92:    mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\ntop400.sv.in:5:// // three register ranks (LAT = 3):\r\ntop400.sv.in:12:// Latency (accept -> EN_writeMem) = LAT cycles; a LAT-bit valid shift register\r\n"]
[20371.042, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\nfor f in (\"top800.sv.in\",\"top400.sv.in\"):\r\n    L = open(f).read().split(\"\\n\")\r\n    out=[]; skip=False\r\n    for i,l in enumerate(L):\r\n        if \"register ranks (LAT =\" in l:\r\n            out.append(\"// @LAT@ register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\")\r\n            skip=True; continue\r\n        if skip:\r\n            if l.startswith(\"//   \") or l.startswith(\"//           \"):\r\n                continue\r\n            skip=False\r\n        out.append(l)\r\n    open(f,\"w\").write(\"\\n\".join(out))\r\nEOF\r\nsed -n 1,20p top800.sv.in; sed -n 1,12p top400.sv.in; grep -n \"mult_pipe\" top400.sv.in\r\n// mkMultBuff.sv -- 800 MHz implementation (1.25 ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, carry-select adder),\r\n// with\r\n// @LAT@ register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\r\n// A LAT-bit valid shift register runs alongside the datapath and drives\r\n// EN_writeMem (F4).\r\n//\r\n// Control: the registered ready flags rdy_mult_q / rdy_rd_q are the fill /\r\n// drain state machine (FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1}); acc_q counts\r\n// pairs accepted in the fill phase, so pairs in flight count against the\r\n// capacity (F5); wp_q / rp_q are the write and read pointers. Changes from the\r\n// 400 MHz control for timing at 1.25 ns: separate write and read pointers, and\r\n// port-only copies of RDY_mult, RDY_blockRead, writeMem_addr, readMem_addr and\r\n// EN_writeMem, so the output load does not slow the internal handshake logic.\r\n// All outputs come from registers except EN_readMem (= EN_blockRead &\r\n// RDY_blockRead, F7) and memVal_data (= readMem_val, F8).\r\n// Every register has a synchronous active-low reset (F14, F15).\r\nmodule mkMultBuff #(parameter N = 32) (\r\n// mkMultBuff.sv -- 400 MHz implementation (2.5 ns clock), Nangate45 slow corner.\r\n//\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n// @LAT@ register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\r\n// Latency (accept -> EN_writeMem) = LAT cycles; a LAT-bit valid shift register\r\n// runs alongside the datapath and drives EN_writeMem (F4).\r\n//\r\n// Control: the two registered ready flags RDY_mult / RDY_blockRead are the\r\n// fill / drain state machine (states FILL = {1,0}, WAIT = {0,0}, DRAIN = {0,1});\r\n// acc_q counts operand pairs accepted in the fill phase, so pairs still in the\r\n// pipeline count against the capacity (F5); ptr_q is the memory address, shared\r\n4:// Datapath: mult_pipe (radix-4 Booth, carry-save reduction, final adder), with\r\n5:// @LAT@ register ranks (LAT = @LAT@), listed in the header of the generated mult_pipe.sv.\r\n35:    // multiplier pipeline latency (register ranks of the generated mult_pipe.sv)\r\n66:    mult_pipe u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n"]
[20385.55, "o", "\u001b[1;32m$\u001b[0m sed 's/clock_tree_synthesis -buf_list {CLKBUF_X1 CLKBUF_X2 CLKBUF_X3} -root_buf CLKBUF_X3 -sink_clustering_enable/clock_tree_synthesis -clk_nets mclk -buf_list {CLKBUF_X1 CLKBUF_X2 CLKBUF_X3} -root_buf CLKBUF_X3 -sink_clustering_enable/' build/cg/scripts/resize_cts.tcl > build/cg/scripts/resize_cts_gated.tcl; grep -n clock_tree build/cg/scripts/resize_cts_gated.tcl; mkdir -p build/cg/c && cp -r build/cg/a/rtl build/cg/c/; export ABC_DRIVER=BUF_X1 ABC_LOAD=1.0 DONT_USE=\"OAI33_* NOR3_* NOR4_* OR3_* OR4_* AND4_* NAND4_* AOI211_* AOI221_* AOI222_* OAI211_* OAI221_* OAI222_* MUX2_*\"; RSZ=build/cg/scripts/resize_cts_gated.tcl STAS=build/cg/scripts/sta_prop.tcl bash build/cg/scripts/eval_cg.sh 400 build/cg/c/rtl build/cg/c 2>&1 | sed -n 1,4p; W=build/cg/c; grep \"CTS-0010\\|CTS-0011\\|CTS-0007\\|Error\\|ERROR\" $W/rep/resize.log; grep -A6 \"^Clock clk\" $W/rep/resize.log | head -24; grep \"RSZ-00\\|worst slack\" $W/rep/resize.log; grep -E \"^cell (CLKBUF|BUF|DLL|AND2)\" $W/rep/sta.rpt\r\n31:clock_tree_synthesis -clk_nets mclk -buf_list {CLKBUF_X1 CLKBUF_X2 CLKBUF_X3} -root_buf CLKBUF_X3 -sink_clustering_enable\r\n== build/cg/c RUN=400\r\ncheck=PASS sim=PASS wns=0.214 whs=0.008\r\narea=2699.102 seq=673.778 comb=2025.3 flops=149 vectorless_uW=790.8\r\nactivity_uW: run:=582.29 fill:=1892.50 drain:=111.19 \r\n[INFO CTS-0010]  Clock net \"mclk\" has 131 sinks.\r\nClock clk\r\n   0.00 source latency _3120_/CK ^\r\n  -0.42 target latency _3039_/CK ^\r\n   0.00 CRPR\r\n--------------\r\n  -0.42 setup skew\r\n\r\n--\r\nClock clk\r\n   0.00 source latency _3120_/CK ^\r\n  -0.42 target latency _3039_/CK ^\r\n   0.00 CRPR\r\n--------------\r\n  -0.42 setup skew\r\n\r\nClock clk\r\n   0.00 source latency _3120_/CK ^\r\n  -0.42 target latency _3039_/CK ^\r\n   0.00 CRPR\r\n--------------\r\n  -0.42 hold skew\r\n\r\n[INFO RSZ-0098] No setup violations found\r\n[INFO RSZ-0046] Found 55 endpoints with hold violations.\r\n[INFO RSZ-0032] Inserted 176 hold buffers.\r\nworst slack max 0.18\r\nworst slack min 0.02\r\ncell AND2_X1           55     58.520 um^2\r\ncell AND2_X2            1      1.330 um^2\r\ncell BUF_X1            37     29.526 um^2\r\ncell BUF_X2            19     20.216 um^2\r\ncell BUF_X4            42     78.204 um^2\r\ncell BUF_X8            11     38.038 um^2\r\ncell CLKBUF_X1        182    145.236 um^2\r\ncell CLKBUF_X2          7      7.448 um^2\r\ncell CLKBUF_X3         21     27.930 um^2\r\ncell DLL_X1             1      2.660 um^2\r\n"]
[20402.142, "o", "\u001b[1;32m$\u001b[0m mkdir -p build/cg/d && cp -r build/cg/a/rtl build/cg/d/ && cd build/cg/d/rtl && python3 - <<'PY'\r\nimport re\r\np='mult_pipe.sv'; t=open(p).read()\r\nt=t.replace(\"    input  logic               clk,\\n\",\"    input  logic               clk,\\n    input  logic               gclk,   // gated clock for the ranks after the operand register\\n\",1)\r\ni=t.index(\"// level 1: 9 -> 6\")  # everything after the operand stage uses gclk (SEL_REG excluded below)\r\nhead,tail=t[:i],t[i:]\r\ntail=tail.replace(\"always_ff @(posedge clk)\",\"always_ff @(posedge gclk)\")\r\nopen(p,'w').write(head+tail)\r\np='mkMultBuff.sv'; t=open(p).read()\r\nt=t.replace(\"\"\"    // clock gate for the multiplier datapath: an edge is needed when an operand\r\n    // pair is accepted, while a product is in ranks 1..LAT-1, and whenever\r\n    // RST_N = 0 (so the synchronous reset of the gated registers still acts, F14)\r\n    wire mclk;\r\n    clk_gate u_cg (.clk(clk), .en(!RST_N | acc | (|v_q[LAT-2:0])), .gclk(mclk));\r\n\"\"\",\"\"\"    // clock gate for the multiplier ranks after the operand register: an edge is\r\n    // needed while a product is in ranks 1..LAT-1, and whenever RST_N = 0 (so the\r\n    // synchronous reset of the gated registers still acts, F14)\r\n    wire mclk;\r\n    clk_gate u_cg (.clk(clk), .en(!RST_N | (|v_q[LAT-2:0])), .gclk(mclk));\r\n\"\"\")\r\nt=t.replace(\"u_mult (.clk(mclk),\",\"u_mult (.clk(clk), .gclk(mclk),\")\r\nopen(p,'w').write(t)\r\nPY\r\ngrep -n \"posedge\" mult_pipe.sv; grep -n \"mclk\" mkMultBuff.sv\r\n57:        always_ff @(posedge clk) begin\r\n68:        always_ff @(posedge clk) begin\r\n76:            always_ff @(posedge clk) begin\r\n155:            always_ff @(posedge gclk) ppq[i] <= RST_N ? pp[i] : 17'd0;\r\n157:        always_ff @(posedge gclk) negq <= RST_N ? neg_e : 8'd0;\r\n183:            always_ff @(posedge gclk) l1q <= RST_N ? l1 : '0;\r\n188:            always_ff @(posedge gclk) l2q <= RST_N ? l2 : '0;\r\n193:            always_ff @(posedge gclk) l3q <= RST_N ? l3 : '0;\r\n198:            always_ff @(posedge gclk) l4q <= RST_N ? l4 : '0;\r\n229:        always_ff @(posedge gclk) begin\r\n244:        always_ff @(posedge gclk) p <= RST_N ? psel : 32'd0;\r\n250:        always_ff @(posedge gclk) begin\r\n260:        always_ff @(posedge gclk) begin\r\n80:    wire mclk;\r\n81:    clk_gate u_cg (.clk(clk), .en(!RST_N | (|v_q[LAT-2:0])), .gclk(mclk));\r\n84:        u_mult (.clk(clk), .gclk(mclk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\n"]
