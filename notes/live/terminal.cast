[21219.893, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && grep -n \"last = maxh(cols) <= 2\" -B2 -A12 gen_tree.py\r\n353-        sf += nf; sh += nh\r\n354-        net.lines.append(f\"    // level {lv}: {nf} FA, {nh} HA, max height {maxh(cols)}\")\r\n355:        last = maxh(cols) <= 2\r\n356-        if lv in cuts or last:\r\n357-            if last and args.gp in (\"tree\", \"gt\"):\r\n358-                break\r\n359-            t = arr(cols)\r\n360-            cols, n = reg_cols(f\"r{stage}\", cols)\r\n361-            summary.append(f\"R{stage} after level {lv}: {sf} FA {sh} HA, model arrival {t:.2f}, {n} flops\")\r\n362-            ranks.append(n)\r\n363-            stage += 1; sf = sh = 0\r\n364-            emit_stage_comment(f\"stage {stage}: {args.mode} levels\")\r\n365-    tree_last_arr = arr(cols)\r\n366-    tree_desc = f\"{args.mode} cuts after levels {args.cuts}\"\r\n367-else:\r\n"]
[21242.385, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''        last = maxh(cols) <= 2\r\n        if lv in cuts or last:'''\r\nnew = '''        last = maxh(cols) <= 2\r\n        if last and args.res_budget > 0:\r\n            cols, nr, rlo = ripple_low(cols, args.res_budget)\r\n            net.lines.append(f\"    // ripple: columns below {rlo} resolved to one bit ({nr} adders)\")\r\n            summary.append(f\"S{stage}: low columns resolved below {rlo} by ripple ({nr} adders)\")\r\n        if lv in cuts or last:'''\r\nassert old in s; s = s.replace(old, new)\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--res-budget\", type=float, default=0.0, help=\"level mode: ripple-resolve low columns in the last tree stage up to this arrival\")\\nap.add_argument(\"--stats\"')\r\nold = \"# ---------------------------------------------------------------------------\\ndef emit_stage_comment\"\r\nnew = '''def ripple_low(cols, budget):\r\n    \"\"\"resolve the lowest columns (<= 2 bits each) to one bit with half / full adders\r\n    while the outputs stay within the budget (a ripple-carry adder on the LSBs)\"\"\"\r\n    cols = [list(c) for c in cols]\r\n    n = 0\r\n    c = 0\r\n    while c < W:\r\n        if len(cols[c]) <= 1:\r\n            c += 1; continue\r\n        bs = sorted(cols[c], key=lambda b: b[1])\r\n        if len(bs) == 2:\r\n            if max(b_[1] for b_ in bs) + DX > budget + EPS: break\r\n            s_, cy = ha(bs[0], bs[1])\r\n        else:\r\n            t_ = max(bs[0][1], bs[1][1]) + DX\r\n            if max(t_, bs[2][1]) + DX > budget + EPS: break\r\n            s_, cy = fa(bs[0], bs[1], bs[2])\r\n        n += 1\r\n        cols[c] = [s_]\r\n        if c + 1 < W: cols[c + 1].append(cy)\r\n        c += 1\r\n    return cols, n, c\r\n\r\n# ---------------------------------------------------------------------------\r\ndef emit_stage_comment'''\r\nassert old in s; s = s.replace(old, new, 1)\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor rb in 0 0.72 0.78 0.84 0.90; do python3 gen_tree.py /tmp/claude-0/y.sv --mode wallace --cuts 2,4 --gp cpa --k0 8 --k 5 --res-budget $rb | grep \"LAT\\|ripple\\|R5\"; done; iverilog -g2012 -Ptb_mult.LAT=6 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/y.vvp tb_mult.sv /tmp/claude-0/y.sv && vvp -n /tmp/claude-0/y.vvp | grep -v finish\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 12), (12, 17), (17, 22), (22, 27), (27, 32)]): 39 flops\r\nLAT=13 ranks=[40, 144, 86, 58, 54, 50, 46, 42, 38, 34, 32, 32, 32] datapath flops=688 FA=112 HA=147\r\n  S4: low columns resolved below 7 by ripple (3 adders)\r\n  S5: low columns resolved below 11 by ripple (3 adders)\r\n  R5 after level 5: 1 FA 24 HA, model arrival 0.72, 54 flops\r\n  S6: low columns resolved below 15 by ripple (3 adders)\r\n  S7: low columns resolved below 19 by ripple (3 adders)\r\n  S8: low columns resolved below 23 by ripple (3 adders)\r\n  S9: low columns resolved below 27 by ripple (3 adders)\r\n  S10: low columns resolved below 31 by ripple (3 adders)\r\n  S11: low columns resolved below 32 by ripple (0 adders)\r\nLAT=13 ranks=[40, 144, 86, 58, 54, 50, 46, 42, 38, 34, 32, 32, 32] datapath flops=688 FA=112 HA=147\r\n  S4: low columns resolved below 7 by ripple (3 adders)\r\n  S5: low columns resolved below 11 by ripple (3 adders)\r\n  R5 after level 5: 1 FA 24 HA, model arrival 0.72, 54 flops\r\n  S6: low columns resolved below 15 by ripple (3 adders)\r\n  S7: low columns resolved below 19 by ripple (3 adders)\r\n  S8: low columns resolved below 23 by ripple (3 adders)\r\n  S9: low columns resolved below 27 by ripple (3 adders)\r\n  S10: low columns resolved below 31 by ripple (3 adders)\r\n  S11: low columns resolved below 32 by ripple (0 adders)\r\nLAT=11 ranks=[40, 144, 86, 58, 53, 48, 43, 38, 32, 32, 32] datapath flops=606 FA=113 HA=132\r\n  S4: low columns resolved below 7 by ripple (3 adders)\r\n  S5: low columns resolved below 12 by ripple (4 adders)\r\n  R5 after level 5: 1 FA 24 HA, model arrival 0.84, 53 flops\r\n  S6: low columns resolved below 17 by ripple (4 adders)\r\n  S7: low columns resolved below 22 by ripple (4 adders)\r\n  S8: low columns resolved below 27 by ripple (4 adders)\r\n  S9: low columns resolved below 32 by ripple (4 adders)\r\nLAT=11 ranks=[40, 144, 86, 57, 52, 47, 42, 37, 32, 32, 32] datapath flops=601 FA=113 HA=127\r\n  S4: low columns resolved below 8 by ripple (4 adders)\r\n  S5: low columns resolved below 13 by ripple (4 adders)\r\n  R5 after level 5: 1 FA 23 HA, model arrival 0.84, 52 flops\r\n  S6: low columns resolved below 18 by ripple (4 adders)\r\n  S7: low columns resolved below 23 by ripple (4 adders)\r\n  S8: low columns resolved below 28 by ripple (4 adders)\r\n  S9: low columns resolved below 32 by ripple (3 adders)\r\nERROR p=80000000 exp=00000000\r\nERROR p=00000000 exp=00000001\r\nERROR p=00000000 exp=ffffffff\r\nERROR p=00000000 exp=00007fff\r\nERROR p=00000000 exp=ffff8000\r\nERROR p=00000000 exp=ffff8001\r\nERROR p=00000001 exp=00005555\r\nERROR p=ffffffff exp=ffffaaaa\r\nERROR p=00007fff exp=000000ff\r\nFAIL: 20902 checks, 20568 errors\r\n"]
[21269.037, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\na = s.index(\"def ripple_low(cols, budget):\")\r\nb = s.index(\"# ---------------------------------------------------------------------------\\ndef emit_stage_comment\")\r\nnew = '''def ripple_low(cols, budget):\r\n    \"\"\"resolve the lowest columns (<= 2 bits each) to one bit with half / full adders\r\n    while the outputs stay within the budget (a ripple-carry adder on the LSBs).\r\n    A step is kept only if it leaves no column with three bits.\"\"\"\r\n    global net\r\n    cols = [list(c) for c in cols]\r\n    n = 0\r\n    c = 0\r\n    while c < W and len(cols[c]) <= 1:\r\n        c += 1\r\n    while c < W:\r\n        # tentative: resolve column c, then any column the carry pushes to 3 bits\r\n        save_lines, save_n, save_fa, save_ha = len(net.lines), net.n, net.fa, net.ha\r\n        tc = [list(x) for x in cols]\r\n        k, ok, m = c, True, 0\r\n        while k < W:\r\n            bs = sorted(tc[k], key=lambda b: b[1])\r\n            if len(bs) <= 2 and k > c:\r\n                break\r\n            if len(bs) == 2:\r\n                s_, cy = ha(bs[0], bs[1])\r\n            elif len(bs) == 3:\r\n                s_, cy = fa(bs[0], bs[1], bs[2])\r\n            else:\r\n                break\r\n            m += 1\r\n            if max(s_[1], cy[1]) > budget + EPS:\r\n                ok = False; break\r\n            tc[k] = [s_]\r\n            if k + 1 < W: tc[k + 1].append(cy)\r\n            k += 1\r\n        if not ok:\r\n            del net.lines[save_lines:]\r\n            net.n, net.fa, net.ha = save_n, save_fa, save_ha\r\n            break\r\n        cols, n = tc, n + m\r\n        c = k\r\n        while c < W and len(cols[c]) <= 1:\r\n            c += 1\r\n    return cols, n, c\r\n\r\n'''\r\ns = s[:a] + new + s[b:]\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor rb in 0.72 0.78 0.84 0.90; do python3 gen_tree.py /tmp/claude-0/y$rb.sv --mode wallace --cuts 2,4 --gp cpa --k0 8 --k 5 --res-budget $rb | grep \"LAT\\|ripple\\|R4\\|R5\"; done; iverilog -g2012 -Ptb_mult.LAT=6 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/y.vvp tb_mult.sv /tmp/claude-0/y0.84.sv && vvp -n /tmp/claude-0/y.vvp | grep -v finish\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=56\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\n  R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=56\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\n  R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=56\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\n  R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=56\r\n  S4: low columns resolved below 5 by ripple (1 adders)\r\n  R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\n  R5 adder stage A (cinc, blocks [(5, 13), (13, 18), (18, 23), (23, 28), (28, 32)]): 39 flops\r\nPASS: 20902 checks, 0 errors\r\n"]
