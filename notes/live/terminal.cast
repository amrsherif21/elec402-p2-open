[21111.533, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && grep -n \"for bi, (l, h) in enumerate(blocks):\" -A 8 gen_tree.py | sed -n 1,60p; grep -n \"rG = \\|rP = \\|Gc, _ = ks(rG, rP)\\|cin = \\[ZERO\\] + Gc\" gen_tree.py\r\n484:    for bi, (l, h) in enumerate(blocks):\r\n485-        gs = [pg[c][1] for c in range(l, h)]; ps = [pg[c][0] for c in range(l, h)]\r\n486-        Gp, Pp = ks(gs, [tpr[c] for c in range(l, h)])\r\n487-        for kk, c in enumerate(range(l, h)):\r\n488-            s0[c] = ps[kk] if kk == 0 else net.xor(ps[kk], Gp[kk - 1])\r\n489-            if args.cpa == \"csel\" and bi > 0:\r\n490-                s1[c] = inv(ps[kk]) if kk == 0 else net.xor(ps[kk], net.or_(Gp[kk - 1], Pp[kk - 1]))\r\n491-        BG[bi] = Gp[-1]\r\n492-        BP[bi] = net.or_(Gp[-1], Pp[-1]) if args.cpa == \"csel\" else Pp[-1]\r\n493:    for bi, (l, h) in enumerate(blocks):\r\n494-        items += [s0[c] for c in range(l, h)]\r\n495-        if args.cpa == \"csel\" and bi > 0: items += [s1[c] for c in range(l, h)]\r\n496-        if bi < nb - 1: items.append(BG[bi])\r\n497-        if 0 < bi < nb - 1: items.append(BP[bi])\r\n498-    t_regA = stage\r\n499-    mA, nA = register(f\"r{stage}\", items)\r\n500-    ranks.append(nA)\r\n501-    summary.append(f\"R{stage} adder stage A ({args.cpa}, blocks {blocks}): {nA} flops\")\r\n--\r\n513:    for bi, (l, h) in enumerate(blocks):\r\n514-        if bi == 0:\r\n515-            prod += [mA[s0[c]] for c in range(l, h)]\r\n516-            continue\r\n517-        if args.cpa == \"csel\":\r\n518-            for c in range(l, h):\r\n519-                a0, a1 = mA[s0[c]], mA[s1[c]]\r\n520-                prod.append(net.or_(net.and_(inv(cin[bi]), a0), net.and_(cin[bi], a1)))\r\n521-        else:\r\n504:    rG = [mA[BG[bi]] for bi in range(nb - 1)]\r\n505:    rP = [ZERO] + [mA[BP[bi]] for bi in range(1, nb - 1)]\r\n508:        Gc, _ = ks(rG, rP)\r\n510:        Gc, _ = ks(rG, rP)\r\n511:    cin = [ZERO] + Gc\r\n"]
[21150.905, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--bpair\", action=\"store_true\", help=\"first block-prefix level in adder stage A\")\\nap.add_argument(\"--stats\"')\r\nold = '''    for bi, (l, h) in enumerate(blocks):\r\n        items += [s0[c] for c in range(l, h)]\r\n        if args.cpa == \"csel\" and bi > 0: items += [s1[c] for c in range(l, h)]\r\n        if bi < nb - 1: items.append(BG[bi])\r\n        if 0 < bi < nb - 1: items.append(BP[bi])\r\n'''\r\nnew = '''    if args.bpair:\r\n        # first Kogge-Stone level over the blocks in stage A: G[b:b-1], P[b:b-1]\r\n        G1 = {0: BG[0]}; P1 = {}\r\n        for bi in range(1, nb - 1):\r\n            G1[bi] = net.or_(BG[bi], net.and_(BP[bi], BG[bi - 1]))\r\n            if bi >= 2: P1[bi] = net.and_(BP[bi], BP[bi - 1])\r\n        BG, BP = G1, P1\r\n    for bi, (l, h) in enumerate(blocks):\r\n        items += [s0[c] for c in range(l, h)]\r\n        if args.cpa == \"csel\" and bi > 0: items += [s1[c] for c in range(l, h)]\r\n        if bi < nb - 1: items.append(BG[bi])\r\n        if bi in BP and 0 < bi < nb - 1 and (not args.bpair or bi >= 2): items.append(BP[bi])\r\n'''\r\nassert old in s; s = s.replace(old, new)\r\nold = '''    rG = [mA[BG[bi]] for bi in range(nb - 1)]\r\n    rP = [ZERO] + [mA[BP[bi]] for bi in range(1, nb - 1)]'''\r\nnew = '''    rG = [mA[BG[bi]] for bi in range(nb - 1)]\r\n    rP = [mA[BP[bi]] if bi in BP else ZERO for bi in range(nb - 1)]'''\r\nassert old in s; s = s.replace(old, new)\r\nold = '''    if args.cpa == \"csel\":\r\n        # carry out of block = co0 | (co1 & cin): prefix with g = co0, p = co1\r\n        Gc, _ = ks(rG, rP)\r\n    else:\r\n        Gc, _ = ks(rG, rP)'''\r\nnew = '''    # (carry-select: carry out of block = co0 | (co1 & cin), prefix with g = co0, p = co1)\r\n    Gc, _ = ks(rG, rP, 2 if args.bpair else 1)'''\r\nassert old in s; s = s.replace(old, new)\r\nold = '''def ks(G, P):\r\n    \"\"\"Kogge-Stone inclusive prefix: G[i] = generate of positions i..0\"\"\"\r\n    G, P = list(G), list(P)\r\n    d = 1'''\r\nnew = '''def ks(G, P, d=1):\r\n    \"\"\"Kogge-Stone inclusive prefix: G[i] = generate of positions i..0 (from span d)\"\"\"\r\n    G, P = list(G), list(P)'''\r\nassert old in s; s = s.replace(old, new)\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor o in \"--k0 4 --k 4 --bpair\" \"--k0 4 --k 4\" \"--k0 8 --k 5\"; do python3 gen_tree.py /tmp/claude-0/y.sv --mode wallace --cuts 2,4 --gp cpa $o | grep \"LAT\\|R5\"; iverilog -g2012 -Ptb_mult.LAT=6 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/y.vvp tb_mult.sv /tmp/claude-0/y.sv && vvp -n /tmp/claude-0/y.vvp | grep -v finish; done\r\nLAT=6 ranks=[40, 144, 86, 59, 42, 32] datapath flops=403 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 8), (8, 12), (12, 16), (16, 20), (20, 24), (24, 28), (28, 32)]): 42 flops\r\nPASS: 20902 checks, 0 errors\r\nTraceback (most recent call last):\r\n  File \"/home/user/elec402-p2-open/build/cand800b/gen_tree.py\", line 512, in <module>\r\n    rP = [mA[BP[bi]] if bi in BP else ZERO for bi in range(nb - 1)]\r\n          ~~^^^^^^^^\r\nKeyError: 'n642'\r\nPASS: 20902 checks, 0 errors\r\nTraceback (most recent call last):\r\n  File \"/home/user/elec402-p2-open/build/cand800b/gen_tree.py\", line 512, in <module>\r\n    rP = [mA[BP[bi]] if bi in BP else ZERO for bi in range(nb - 1)]\r\n          ~~^^^^^^^^\r\nKeyError: 'n678'\r\nPASS: 20902 checks, 0 errors\r\n"]
[21196.561, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && sed -i 's/    rP = \\[mA\\[BP\\[bi\\]\\] if bi in BP else ZERO for bi in range(nb - 1)\\]/    rP = [mA[BP[bi]] if bi in BP and bi >= (2 if args.bpair else 1) else ZERO for bi in range(nb - 1)]/' gen_tree.py && for o in \"--k0 4 --k 4 --bpair\" \"--k0 4 --k 4\" \"--k0 8 --k 5\" \"--k0 8 --k 8\"; do rm -f /tmp/claude-0/y.sv; python3 gen_tree.py /tmp/claude-0/y.sv --mode wallace --cuts 2,4 --gp cpa $o | grep \"LAT\\|R5\"; iverilog -g2012 -Ptb_mult.LAT=6 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/y.vvp tb_mult.sv /tmp/claude-0/y.sv && vvp -n /tmp/claude-0/y.vvp | grep -v finish; done; diff <(python3 gen_tree.py /dev/stdout --mode wallace --cuts 2,4 --gp cpa --k0 8 --k 5) w24cpa5/rtl/mult_pipe.sv | head\r\nLAT=6 ranks=[40, 144, 86, 59, 42, 32] datapath flops=403 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 8), (8, 12), (12, 16), (16, 20), (20, 24), (24, 28), (28, 32)]): 42 flops\r\nPASS: 20902 checks, 0 errors\r\nLAT=6 ranks=[40, 144, 86, 59, 43, 32] datapath flops=404 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 8), (8, 12), (12, 16), (16, 20), (20, 24), (24, 28), (28, 32)]): 43 flops\r\nPASS: 20902 checks, 0 errors\r\nLAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 12), (12, 17), (17, 22), (22, 27), (27, 32)]): 39 flops\r\nPASS: 20902 checks, 0 errors\r\nLAT=6 ranks=[40, 144, 86, 59, 37, 32] datapath flops=398 FA=92 HA=55\r\n  R5 adder stage A (cinc, blocks [(4, 12), (12, 20), (20, 28), (28, 32)]): 37 flops\r\nPASS: 20902 checks, 0 errors\r\n1313,1319d1312\r\n< LAT=6 ranks=[40, 144, 86, 59, 39, 32] datapath flops=400 FA=92 HA=55\r\n<   R1 operands + Booth digits: 40 flops\r\n<   R2 selected partial products + neg bits: 144 flops\r\n<   R3 after level 2: 66 FA 24 HA, model arrival 0.72, 86 flops\r\n<   R4 after level 4: 26 FA 31 HA, model arrival 0.66, 59 flops\r\n<   R5 adder stage A (cinc, blocks [(4, 12), (