[2119.25, "o", "\u001b[1;32m$\u001b[0m D=build/cand_retime/chk && mkdir -p $D/rtl && sed \"s/@R@/5/\" build/cand_retime/src/mkMultBuff.sv.in > $D/rtl/mkMultBuff.sv && sed \"s/@R@/5/\" build/cand_retime/src/rmult.sv.in > $D/rtl/rmult.sv && make check RUN=800 RTL_DIR=$D/rtl BUILD=$D REP=$D/rep 2>&1 | tail -5\r\n  PHASES   checks=       2  failures=0\r\n  WATCHDOG checks=       0  failures=0\r\n  STIMULUS checks=       0  failures=0\r\nALL PASS\r\nsubmission/testbench/rtl_checker.sv:420: $finish called at 7367500 (1ps)\r\n"]
[2126.473, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\nsrc = open('../../submission/rtl_400/mkMultBuff.sv').read()\r\nstart = src.index('module mkMultBuff')\r\nbody = src[start:]\r\nimport re\r\n# replace config block\r\na = body.index('    // multiplier pipeline configuration')\r\nb = body.index('    logic       rdy_mult_q')\r\nbody = body[:a] + \"    // latency of the multiplier pipeline (operand register .. product register)\\n    localparam int LAT = @LAT@;\\n\\n\" + body[b:]\r\na = body.index('    mult_pipe #(')\r\nb = body.index('    assign RDY_mult')\r\nbody = body[:a] + \"    mult_tree u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\\n\\n\" + body[b:]\r\nhdr = \"\"\"// mkMultBuff.sv -- 800 MHz candidate (1.25 ns clock), Nangate45 slow corner.\r\n// Pipelined signed 16x16 multiplier with a 64-entry fill/drain buffer (SPEC.md).\r\n// Datapath: mult_tree (Baugh-Wooley partial products, timing-driven carry-save\r\n// reduction with hand-placed pipeline registers, two-stage carry-select adder).\r\n// Control is identical to the 400 MHz implementation: registered ready flags form\r\n// the fill / drain state machine, acc_q counts accepted pairs (F5), ptr_q is the\r\n// shared write / read address (F13), a LAT-bit valid shift register drives\r\n// EN_writeMem (F4). Every register has a synchronous active-low reset (F14, F15).\r\n\"\"\"\r\nopen('top.sv.in','w').write(hdr + body)\r\nEOF\r\ngrep -n \"LAT\\|mult_tree\" top.sv.in; python3 gen.py v1 && ls v1\r\n3:// Datapath: mult_tree (Baugh-Wooley partial products, timing-driven carry-save\r\n7:// shared write / read address (F13), a LAT-bit valid shift register drives\r\n28:    localparam int LAT = @LAT@;\r\n32:    logic [LAT-1:0] v_q;                 // valid bit of each pipeline rank\r\n37:    wire wr  = v_q[LAT-1];\r\n44:            v_q <= {v_q[LAT-2:0], acc};\r\n58:    mult_tree u_mult (.clk(clk), .RST_N(RST_N), .en(acc), .a(mult_input0), .b(mult_input1), .p(p));\r\nLAT=12  datapath+control flops ~1049\r\n  stage 1: 1 FA, heights 16 max, 256 flops\r\n  stage 2: 84 FA, heights 11 max, 172 flops\r\n  stage 3: 55 FA, heights 7 max, 117 flops\r\n  stage 4: 34 FA, heights 5 max, 83 flops\r\n  stage 5: 22 FA, heights 4 max, 61 flops\r\n  stage 6: 9 FA, heights 3 max, 52 flops\r\n  stage 7: 2 FA, heights 3 max, 50 flops\r\n  stage 8: 2 FA, heights 3 max, 48 flops\r\n  stage 9: 1 FA, heights 2 max, 47 flops\r\n  stage 10 (CPA blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)]): 72 flops\r\n  stage 11: block prefix over 8 blocks (3 levels), product register 32 flops\r\nmkMultBuff.sv\r\nmult_tree.sv\r\n"]
[2146.259, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && python3 - <<'EOF'\r\ns = open('gen.py').read()\r\ns = s.replace(\"\"\"                if t_s > budget or (c + 1 < W and t_c > budget):\r\n                    break\r\n                for b in (x, y, z):\"\"\", \"\"\"                if t_s > budget + EPS or (c + 1 < W and t_c > budget + EPS):\r\n                    if len(bits) == target + 1 and ha_ok(c, vars_, budget):\r\n                        x, y = vars_[0], vars_[1]\r\n                        bits.remove(x); bits.remove(y)\r\n                        s, cy = ha(c, x, y, stage)\r\n                        bits.append(s)\r\n                        if cy is not None:\r\n                            carry_in.append(cy)\r\n                    break\r\n                for b in (x, y, z):\"\"\")\r\ns = s.replace(\"\"\"                if t_s > budget:\r\n                    break\r\n                bits.remove(consts[0])\"\"\", \"\"\"                if t_s > budget + EPS:\r\n                    break\r\n                bits.remove(consts[0])\"\"\")\r\ns = s.replace(\"\"\"def reduce_stage(\"\"\", \"\"\"EPS = 1e-6\r\nDA = 0.12\r\n\r\ndef ha_ok(col, vars_, budget):\r\n    if len(vars_) < 2:\r\n        return False\r\n    t = max(vars_[0][1], vars_[1][1])\r\n    return t + DX <= budget + EPS and t + DA <= budget + EPS\r\n\r\ndef ha(col, x, y, stage):\r\n    s = new(f\"s{stage}_\")\r\n    lines.append(f\"    wire {s} = {x[0]} ^ {y[0]};\")\r\n    if col + 1 < W:\r\n        c = new(f\"c{stage}_\")\r\n        lines.append(f\"    wire {c} = {x[0]} & {y[0]};\")\r\n        return (s, max(x[1], y[1]) + DX), (c, max(x[1], y[1]) + DA)\r\n    return (s, max(x[1], y[1]) + DX), None\r\n\r\ndef reduce_stage(\"\"\")\r\nopen('gen.py','w').write(s)\r\nEOF\r\npython3 gen.py v1\r\nLAT=7  datapath+control flops ~564\r\n  stage 1: 76 FA, heights 11 max, 181 flops\r\n  stage 2: 75 FA, heights 6 max, 106 flops\r\n  stage 3: 39 FA, heights 4 max, 67 flops\r\n  stage 4: 15 FA, heights 2 max, 52 flops\r\n  stage 5 (CPA blocks [(1, 5), (5, 9), (9, 13), (13, 17), (17, 21), (21, 25), (25, 29), (29, 32)]): 72 flops\r\n  stage 6: block prefix over 8 blocks (3 levels), product register 32 flops\r\n"]
[2152.45, "o", "\u001b[1;32m$\u001b[0m python3 submission/scripts/lib_dont_use.py tech/NangateOpenCellLibrary_slow.lib build/exp/lib_du1.lib 'OAI33_*' 'NOR3_*' 'NOR4_*' 'OR4_*' 'AND4_*' 'NAND4_*' 'AOI211_*' 'AOI221_*' 'AOI222_*' 'OAI211_*' 'OAI221_*' 'OAI222_*' && python3 submission/scripts/lib_dont_use.py tech/NangateOpenCellLibrary_slow.lib build/exp/lib_du0.lib 'NONE' && python3 - <<'EOF'\r\np='submission/scripts/synth.tcl'\r\ns=open(p).read()\r\ns=s.replace('''# optional list of cells ABC must not use (slow stacked cells at the slow corner)\r\nset dont_use {}\r\nif {[info exists ::env(ABC_DONT_USE)]} {\r\n    foreach c $::env(ABC_DONT_USE) { lappend dont_use -dont_use $c }\r\n}\r\n''','')\r\ns=s.replace(\"abc -D $abc_d -liberty $lib {*}$dont_use -constr\",\"abc -D $abc_d -liberty $maplib -constr\")\r\ns=s.replace('puts $cf \"set_driving_cell DFF_X1\\\\\\\\nset_load 23.5\"','puts $cf \"set_driving_cell BUF_X1\\\\\\\\nset_load 23.5\"')\r\ns=s.replace('''set out   $::env(OUT)''','''set out   $::env(OUT)\r\n# library used by ABC for mapping (may mark slow cells dont_use); everything\r\n# else (flip-flop mapping, area report) uses the original library\r\nset maplib [expr {[info exists ::env(MAPLIB)] && $::env(MAPLIB) ne \"\" ? $::env(MAPLIB) : $lib}]''')\r\nopen(p,'w').write(s)\r\nr=open('build/exp/run.sh').read()\r\nr=r.replace('-e ABC_DONT_USE=\"${ABC_DONT_USE:-}\"','-e MAPLIB=${MAPLIB:-}')\r\nopen('build/exp/run.sh','w').write(r)\r\nEOF\r\ngrep -n \"maplib\\|driving\" submission/scripts/synth.tcl; (MAPLIB=build/exp/lib_du1.lib SEL=1 CSL=1 PRE=1 build/exp/run.sh k800a 1.25 0 1111 0 1000 0 kogge-stone & MAPLIB=build/exp/lib_du1.lib PRE=1 build/exp/run.sh k400 2.5 0 0100 0 2000 0 kogge-stone & wait) 2>&1 | grep -v Warning; PRE=1 build/exp/run.sh k400b 2.5 0 0100 0 2000 0 kogge-stone 2>&1 | grep -v Warning\r\nlib_dont_use: 34 cells marked dont_use -> build/exp/lib_du1.lib\r\nlib_dont_use: 0 cells marked dont_use -> build/exp/lib_du0.lib\r\n16:set maplib [expr {[info exists ::env(MAPLIB)] && $::env(MAPLIB) ne \"\" ? $::env(MAPLIB) : $lib}]\r\n38:puts $cf \"set_driving_cell DFF_X1\\nset_load 23.5\"\r\n42:    abc -D $abc_d -liberty $maplib -constr [file rootname $out].abc.constr\r\nk400 P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2425.654000 rsz_area=2467 wns=-0.037 whs=0.053 pwr_est=6.6161e-04\r\nk800a P=1.25 enc=0 csa=1111 spl=0 abcD=1000 | yosys_area=5094.698000 rsz_area=5413 wns=-0.610 whs=0.028 pwr_est=2.9950e-03\r\nk400b P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2425.654000 rsz_area=2467 wns=-0.037 whs=0.053 pwr_est=6.6161e-04\r\n"]
[2160.206, "o", "\u001b[1;32m$\u001b[0m ls submission/testbench; grep -n -i \"DRV\\|#\" submission/testbench/sdf_checker_800.sv | head -30\r\nrtl_checker.sv\r\nsdf_checker_400.sv\r\nsdf_checker_800.sv\r\ntiming_fail\r\n8://   * Inputs are launched DRV_DLY_NS (20 ps) after each rising edge (the\r\n41:    localparam real DRV_DLY_NS = 0.020;  // input launch delay after the rising edge\r\n58:    mkMultBuff #(.N(N)) DUT (\r\n71:    memory_wrapper_2port #(.DEPTH(64), .LOGDEPTH(6), .WIDTH(N), .MEMTYPE(0)) MEM (\r\n77:    always #(HALF_NS * 1ns) clk = ~clk;\r\n164:                        fail($sformatf(\"X on memVal_data=%b, product #%0d (%0d * %0d)\",\r\n167:                        fail($sformatf(\"memVal_data=%h expected %h, product #%0d (%0d * %0d), xor=%h\",\r\n199:        #(DRV_DLY_NS * 1ns);\r\n"]
