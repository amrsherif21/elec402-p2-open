[3509.947, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/submission/pdf_report/src && python3 - <<'EOF'\r\np='report.md'\r\ns=open(p).read()\r\ns=s.replace(\"and at this corner a whole 16 \u00d7 16 multiply needs about 4.4 ns of logic (Section 4).\",\"and at this corner a whole 16 \u00d7 16 multiply needs about 4.4 ns of logic (Section 7).\")\r\ns=s.replace(\"\"\"| 8 | MUX2 also kept out of the mapping | +0.051 | 5893 |\r\n| 9 | Generate/propagate of the final rows computed before rank 5 | +0.136 | 5824 |\r\n| 10 | ABC told that its outputs are flip-flop inputs (1 fF), not ports (23.5 fF) | +0.150 | 5211 |\r\n| 11 | Levels 2 and 3 merged into one stage (final design) | +0.075 | 4755 |\"\"\",\"\"\"| 8 | Block carries of the carry-select adder resolved by a prefix instead of a ripple | \u22120.034 | 5933 |\r\n| 9 | MUX2 also kept out of the mapping | +0.051 | 5893 |\r\n| 10 | Generate/propagate of the final rows computed before rank 5 | +0.136 | 5824 |\r\n| 11 | ABC told that its outputs are flip-flop inputs (1 fF), not ports (23.5 fF) | +0.150 | 5211 |\r\n| 12 | Levels 2 and 3 merged into one stage (final design) | +0.075 | 4755 |\"\"\")\r\ns=s.replace(\"Step 10 was a constraint seen by ABC\",\"Step 11 was a constraint seen by ABC\").replace(\"That slack was then spent in step 11,\",\"That slack was then spent in step 12,\")\r\nopen(p,'w').write(s)\r\nEOF\r\ngrep -c \"Step 11\\|step 12\" report.md\r\n1\r\n"]
