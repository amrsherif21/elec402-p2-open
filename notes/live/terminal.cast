[22225.243, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && grep -n 'm2, n2 = register(\"r2\", pps)' -A 6 gen_tree.py\r\n343:m2, n2 = register(\"r2\", pps)\r\n344-ppr = [[(m2[f\"pp{i}[{j}]\"], 0.0) for j in range(17)] for i in range(8)]\r\n345-ngr = [(m2[f\"neg_q[{i}]\"], 0.0) for i in range(8)]\r\n346-summary.append(f\"R1 operands + Booth digits: 40 flops\")\r\n347-summary.append(f\"R2 selected partial products + neg bits: {n2} flops\")\r\n348-cols0 = booth_matrix([[b for b in row] for row in ppr], ngr)\r\n349-heights0 = [len(c) for c in cols0]\r\n"]
[22237.612, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''m2, n2 = register(\"r2\", pps)\r\nppr = [[(m2[f\"pp{i}[{j}]\"], 0.0) for j in range(17)] for i in range(8)]\r\nngr = [(m2[f\"neg_q[{i}]\"], 0.0) for i in range(8)]\r\nsummary.append(f\"R1 operands + Booth digits: 40 flops\")\r\nsummary.append(f\"R2 selected partial products + neg bits: {n2} flops\")\r\n'''\r\nnew = '''summary.append(f\"R1 operands + Booth digits: 40 flops\")\r\nif args.nosel:\r\n    # no register after the selection: the tree continues in the same stage\r\n    ppr = [[(f\"pp{i}[{j}]\", args.sel_t) for j in range(17)] for i in range(8)]\r\n    ngr = [(f\"neg_q[{i}]\", 0.0) for i in range(8)]\r\n    n2 = None\r\nelse:\r\n    m2, n2 = register(\"r2\", pps)\r\n    ppr = [[(m2[f\"pp{i}[{j}]\"], 0.0) for j in range(17)] for i in range(8)]\r\n    ngr = [(m2[f\"neg_q[{i}]\"], 0.0) for i in range(8)]\r\n    summary.append(f\"R2 selected partial products + neg bits: {n2} flops\")\r\n'''\r\nassert old in s; s = s.replace(old, new)\r\ns = s.replace(\"ranks = [40, n2]\", \"ranks = [40] + ([n2] if n2 is not None else [])\")\r\ns = s.replace(\"stage = 3\\n\", \"stage = 2 if args.nosel else 3\\n\", 1)\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--nosel\", action=\"store_true\", help=\"no register after the Booth selection (400 MHz)\")\\nap.add_argument(\"--sel-t\", type=float, default=0.55, help=\"model arrival of the selected bits with --nosel\")\\nap.add_argument(\"--stats\"')\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\ngrep -n \"^stage = \" gen_tree.py; for o in \"--cuts 4 --gp gt --cpa one\" \"--cuts 4 --gp gt --cpa one --res-budget 1.9\" \"--cuts 4 --gp gt --cpa one --res-budget 2.1\" \"--cuts 4 --gp cpa --cpa one --res-budget 2.1\"; do python3 gen_tree.py /tmp/claude-0/z.sv --mode wallace --rawlevels 3 --nosel $o | grep \"LAT\\|R2\\|ripple\"; done; iverilog -g2012 -Ptb_mult.LAT=3 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/z.vvp tb_mult.sv /tmp/claude-0/z.sv && vvp -n /tmp/claude-0/z.vvp | grep -v finish\r\n389:stage = 2 if args.nosel else 3\r\nLAT=3 ranks=[40, 52, 32] datapath flops=124 FA=100 HA=20\r\n  R2 tree end, generate / transmit per column (model arrival 1.93): 52 flops\r\nLAT=3 ranks=[40, 51, 32] datapath flops=123 FA=101 HA=26\r\n  S2: low columns resolved below 8 by ripple (7 adders)\r\n  R2 tree end, generate / transmit per column (model arrival 1.93): 51 flops\r\nLAT=3 ranks=[40, 50, 32] datapath flops=122 FA=102 HA=27\r\n  S2: low columns resolved below 10 by ripple (9 adders)\r\n  R2 tree end, generate / transmit per column (model arrival 2.17): 50 flops\r\nLAT=3 ranks=[40, 50, 32] datapath flops=122 FA=102 HA=27\r\n  S2: low columns resolved below 10 by ripple (9 adders)\r\n  R2 after level 4: 100 FA 20 HA, model arrival 2.05, 50 flops\r\nPASS: 20902 checks, 0 errors\r\n"]
[22292.195, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && for rb in 1.9 2.0; do python3 gen_tree.py /dev/null --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget $rb | grep \"LAT\\|ripple\"; done; ./run.sh 400 w4r3cpa --mode wallace --rawlevels 3 --nosel --cuts 4 --gp cpa --cpa one --res-budget 1.9 2>&1 | grep -v \"u_mult.[aont][1enw]\" | tail -16\r\nLAT=3 ranks=[40, 51, 32] datapath flops=123 FA=101 HA=26\r\n  S2: low columns resolved below 8 by ripple (7 adders)\r\nLAT=3 ranks=[40, 51, 32] datapath flops=123 FA=101 HA=26\r\n  S2: low columns resolved below 8 by ripple (7 adders)\r\n  R3 product: 32 flops\r\nPASS: 200902 checks, 0 errors\r\n== build/cand800b/w4r3cpa RUN=400\r\ncheck=PASS sim=PASS wns=0.151 whs=0.053\r\narea=2297.176 seq=658.350 comb=1638.8 flops=141 vectorless_uW=611.1\r\nactivity_uW: run:=604.25 fill:=1474.50 drain:=375.39 \r\nper register group (flops, worst slack):\r\nEN_writeMem                             1    1.790\r\nRDY_blockRead                           1    0.709\r\nRDY_mult                                1    0.939\r\nVALID_memVal                            1    1.552\r\nreadMem_addr                            6    0.592\r\nu_mult.prod                             8    0.151\r\nwriteMem_val                           32    0.155\r\nu_mult.prod                             8    0.151\r\nu_mult.r2                              43    0.151\r\n"]
