[2236.917, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime/src && cat > f14check.tcl <<'EOF'\r\n# f14check.tcl -- for every flip-flop of the netlist, prove (SAT, all other\r\n# signals and flop outputs free) that its D input is 0 whenever RST_N = 0.\r\n# env: LIB, NETLIST\r\nyosys -import\r\nread_liberty -ignore_miss_func $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nhierarchy -top mkMultBuff\r\nflatten\r\nopt_clean\r\nrename -hide w:* i:* %d o:* %d\r\nrename -enumerate w:*\r\nset ff [llength [select -list t:\\$_DFF_P_]]\r\nselect -set ds t:\\$_DFF_P_ %ci1:+\\$_DFF_P_\\[D\\] w:* %i\r\nset nets [select -list @ds]\r\nset ok 0; set bad {}\r\nforeach n $nets {\r\n    set w [lindex [split $n /] end]\r\n    if {[catch {sat -set RST_N 0 -prove $w 0 -verify -ignore_unknown_cells} msg]} { lappend bad $w } else { incr ok }\r\n}\r\nputs \"F14CHECK: flops $ff, distinct D nets [llength $nets], reset-gated $ok, NOT reset-gated [llength $bad]\"\r\nEOF\r\ncat > f14.sh <<'EOF'\r\n#!/usr/bin/env bash\r\ncd /home/user/elec402-p2-open\r\nIMG=openroad/orfs@sha256:d3505fd5f930fcd20d3d25a41f3047230b7db7b7797e3448561c9e556cca3774\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$1 $IMG \\\r\n  /OpenROAD-flow-scripts/tools/install/yosys/bin/yosys -q -l ${1%.v}.f14.log -c build/cand_retime/src/f14check.tcl >/dev/null 2>&1\r\ngrep F14CHECK ${1%.v}.f14.log\r\nEOF\r\nchmod +x f14.sh; ls /home/user/elec402-p2-open/submission/outputs/\r\nmkMultBuff_400_map.sdf\r\nmkMultBuff_400_map.v\r\n"]
[2240.904, "o", "\u001b[1;32m$\u001b[0m cp submission/outputs/mkMultBuff_400_map.v build/cand_retime/ref400.v && time build/cand_retime/src/f14.sh build/cand_retime/ref400.v; tail -5 build/cand_retime/ref400.f14.log\r\nreal\t0m0.579s\r\nuser\t0m0.020s\r\nsys\t0m0.015s\r\n5. Executing OPT_CLEAN pass (remove unused cells and wires).\r\nFinding unused cells or wires in module \\mkMultBuff..\r\nRemoved 328 unused cells and 3263 unused wires.\r\n<suppressed ~657 debug messages>\r\nERROR: TCL interpreter returned an error: wrong # args: should be \"rename oldName newName\"\r\n"]
[2242.019, "o", "\u001b[1;32m$\u001b[0m python3 - <<'EOF'\r\np='build/exp/mult_pipe.sv'\r\ns=open(p).read()\r\na=s.index(\"    generate if (CPA_CSEL) begin : g_csel\")\r\nb=s.index(\"    end else if (CPA_SPLIT) begin : g_split\")\r\nnew='''    generate if (CPA_CSEL) begin : g_csel\r\n        // two-stage carry-select adder with CSW-bit blocks. Stage A: per block,\r\n        // bit generate/propagate and an in-block Kogge-Stone prefix give the\r\n        // block sums for carry-in 0 and carry-in 1 and the two block carry-outs.\r\n        // Stage B: the block carries are resolved and each block sum selected.\r\n        localparam int NB = 32 / CSW;\r\n        logic [31:0]   s0, s1, s0q, s1q;\r\n        logic [NB-1:0] co0, co1, co0q, co1q, cin;\r\n        for (i = 0; i < NB; i++) begin : g_blk\r\n            logic [CSW-1:0] gg, pp_, G, P;\r\n            assign gg  = sx[CSW*i +: CSW] & sy[CSW*i +: CSW];\r\n            assign pp_ = sx[CSW*i +: CSW] ^ sy[CSW*i +: CSW];\r\n            assign {G, P} = prefix(gg, pp_);\r\n            assign s0[CSW*i +: CSW] = pp_ ^ {G[CSW-2:0], 1'b0};\r\n            assign s1[CSW*i +: CSW] = pp_ ^ {G[CSW-2:0] | P[CSW-2:0], 1'b1};\r\n            assign co0[i] = G[CSW-1];\r\n            assign co1[i] = G[CSW-1] | P[CSW-1];\r\n        end\r\n        always_ff @(posedge clk) begin\r\n            if (!RST_N) begin\r\n                s0q <= '0; s1q <= '0; co0q <= '0; co1q <= '0;\r\n            end else begin\r\n                s0q <= s0; s1q <= s1; co0q <= co0; co1q <= co1;\r\n            end\r\n        end\r\n        assign cin[0] = 1'b0;\r\n        for (i = 1; i < NB; i++) begin : g_cin\r\n            assign cin[i] = co0q[i-1] | (co1q[i-1] & cin[i-1]);\r\n        end\r\n        logic [31:0] psel;\r\n        for (i = 0; i < NB; i++) begin : g_sel\r\n            assign psel[CSW*i +: CSW] = cin[i] ? s1q[CSW*i +: CSW] : s0q[CSW*i +: CSW];\r\n        end\r\n        always_ff @(posedge clk) p <= RST_N ? psel : 32'd0;\r\n'''\r\ns=s[:a]+new+s[b:]\r\n# prefix function + CSW parameter\r\ns=s.replace(\"    parameter bit       CPA_CSEL  = 1'b0\\n\",\"    parameter bit       CPA_CSEL  = 1'b0,\\n    parameter int       CSW       = 8\\n\")\r\ns=s.replace(\"    genvar i;\\n\",\"\"\"    genvar i;\r\n\r\n    // Kogge-Stone prefix over a CSW-bit block: G[j] / P[j] = group generate /\r\n    // propagate of bits j..0 of the block\r\n    function automatic logic [2*CSW-1:0] prefix(input logic [CSW-1:0] g, input logic [CSW-1:0] p);\r\n        logic [CSW-1:0] G, P;\r\n        G = g; P = p;\r\n        for (int d = 1; d < CSW; d = 2 * d)\r\n            for (int j = CSW - 1; j >= d; j--) begin\r\n                G[j] = G[j] | (P[j] & G[j-d]);\r\n                P[j] = P[j] & P[j-d];\r\n            end\r\n        prefix = {G, P};\r\n    endfunction\r\n\"\"\",1)\r\nopen(p,'w').write(s)\r\nt=open('build/exp/top.sv').read()\r\nif 'CSW' not in t:\r\n    t=t.replace(\".CPA_CSEL(CPA_CSEL))\",\".CPA_CSEL(CPA_CSEL), .CSW(`CSWV))\")\r\nopen('build/exp/top.sv','w').write(t)\r\nr=open('build/exp/run.sh').read()\r\nr=r.replace(\"s/\\\\`CSL/1'b${CSL:-0}/\\\"\",\"s/\\\\`CSL/1'b${CSL:-0}/; s/\\\\`CSWV/${CSW:-8}/\\\"\")\r\nopen('build/exp/run.sh','w').write(r)\r\nEOF\r\ngrep -c CSWV build/exp/run.sh; for w in 8 4; do sed \"s/\\`PRE/1'b1/; s/\\`ENC/1'b0/; s/\\`CSA/4'b1111/; s/\\`SPL/1'b0/; s/\\`SEL/1'b1/; s/\\`CSL/1'b1/; s/\\`CSWV/$w/\" build/exp/top.sv > build/exp/ft/top.sv; iverilog -g2012 -s mkMultBuff_tb -P mkMultBuff_tb.CLK_HALF_NS=0.625 -o build/exp/ft/a.vvp submission/testbench/rtl_checker.sv starter/rtl/memory_wrapper_2port.sv starter/rtl/registerArray.sv build/exp/ft/top.sv build/exp/mult_pipe.sv 2>&1 | grep -v -i warn | head -3; echo \"CSW $w: $(vvp -n build/exp/ft/a.vvp | grep -E '^(ALL PASS|FAIL)')\"; done\r\n1\r\nCSW 8: ALL PASS\r\nCSW 4: ALL PASS\r\n"]
