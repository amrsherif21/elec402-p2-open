[2228.043, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_retime && sed -i 's|/usr/bin/time -f \"yosys %e s %M KB\" ||' src/run.sh && sed -i 's|^docker run --rm -v \\$PWD:\\$PWD -w \\$PWD -e RUN=800|SECONDS=0; docker run --rm -v $PWD:$PWD -w $PWD -e RUN=800|' src/run.sh && sed -i 's|^cp \\$D/syn.stat.rpt|echo \"yosys ${SECONDS}s\"; cp $D/syn.stat.rpt|' src/run.sh && grep -n SECONDS src/run.sh; (./src/run.sh b1_r5_fix 5 1 fix build/cand_retime/src/retime.script > b1_r5_fix.out 2>&1 &) ; (./src/run.sh b1_r5_naive 5 1 naive build/cand_retime/src/retime.script > b1_r5_naive.out 2>&1 &); echo started\r\n11:SECONDS=0; docker run --rm -v $PWD:$PWD -w $PWD -e RUN=800 -e RTL_DIR=$D/rtl -e LIB=tech/NangateOpenCellLibrary_slow.lib \\\r\n14:echo \"yosys ${SECONDS}s\"; cp $D/syn.stat.rpt $D/rep/yosys_area.rpt\r\nstarted\r\n"]
[2229.08, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand_dadda && cat > path1.tcl <<'EOF'\r\nset period $::env(PERIOD)\r\nread_liberty $::env(LIB)\r\nread_verilog $::env(NETLIST)\r\nlink_design mkMultBuff\r\nsource submission/scripts/constraints.tcl\r\nforeach p $::env(PINS) { report_checks -path_delay max -to $p -fields {fanout cap slew} -digits 3 }\r\nEOF\r\ncat > path1.sh <<'EOF'\r\n#!/bin/bash\r\n# path1.sh DIR \"pin1 pin2\" -- worst path to each given pin\r\ncd /home/user/elec402-p2-open\r\nD=$1\r\ndocker run --rm -v $PWD:$PWD -w $PWD -e LIB=tech/NangateOpenCellLibrary_slow.lib -e NETLIST=$D/map.v -e PERIOD=${P:-1.25} -e PINS=\"$2\" \\\r\n  --entrypoint /OpenSTA/build/sta openroad/opensta@sha256:4162b4be70ee69eaa42e5eb3c830433393ff46cf0370f9b6c5b814b48a221a7a -no_init -no_splash -exit build/cand_dadda/path1.tcl 2>&1 | grep -E \"^Startpoint|^Endpoint|/Q |/Z |/ZN |/CO |/S |slack\"\r\nEOF\r\nchmod +x path1.sh; ./path1.sh build/cand_dadda/v1 \"_5920_/D _5875_/D _5397_/D\"\r\nStartpoint: _5804_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5920_ (rising edge-triggered flip-flop clocked by clk)\r\n     1    3.136    0.021    0.311    0.311 v _5804_/Q (DFF_X1)\r\n     5   16.351    0.020    0.090    0.401 v _3209_/Z (BUF_X4)\r\n     1    6.242    0.079    0.141    0.542 ^ _3225_/ZN (AOI21_X4)\r\n     2    8.493    0.029    0.053    0.595 v _3227_/ZN (AOI21_X4)\r\n     3   14.952    0.118    0.140    0.736 ^ _4590_/ZN (AOI21_X4)\r\n     3   12.573    0.165    0.284    1.019 ^ _4591_/Z (XOR2_X2)\r\n     1    3.136    0.038    0.255    1.274 v _4597_/Z (MUX2_X1)\r\n     1    1.340    0.012    0.083    1.357 v _4598_/Z (BUF_X4)\r\n                                    -0.194   slack (VIOLATED)\r\nStartpoint: _5891_ (rising edge-triggered flip-flop clocked by clk)\r\nEndpoint: _5875_ (rising edge-triggered flip-flop clocked by clk)\r\n     2    9.103    0.032    0.331    0.331 v _5891_/Q (DFF_X1)\r\n     1    6.483    0.187    0.318   