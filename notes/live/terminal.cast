[20692.142, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nks = '''def ks(G, P):\r\n    \"\"\"Kogge-Stone inclusive prefix: G[i] = generate of positions i..0\"\"\"\r\n    G, P = list(G), list(P)\r\n    d = 1\r\n    while d < len(G):\r\n        G2, P2 = list(G), list(P)\r\n        for i in range(d, len(G)):\r\n            G2[i] = net.or_(G[i], net.and_(P[i], G[i - d]))\r\n            P2[i] = net.and_(P[i], P[i - d])\r\n        G, P = G2, P2\r\n        d *= 2\r\n    return G, P\r\n\r\n'''\r\ns = s.replace(\"tpr = [tp.get(c, pg[c][0]) for c in range(W)]\", ks + \"tpr = [tp.get(c, pg[c][0]) for c in range(W)]\")\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\nfor g in tree gt cpa; do python3 gen_tree.py /tmp/claude-0/x_$g.sv --mode wallace --cuts 2,4 --gp $g --k 8 | head -1; iverilog -g2012 -Ptb_mult.LAT=6 -Ptb_mult.NRAND=20000 -o /tmp/claude-0/x.vvp tb_mult.sv /tmp/claude-0/x_$g.sv && vvp -n /tmp/claude-0/x.vvp | grep -v finish; done\r\nLAT=6 ranks=[40, 144, 86, 58, 37, 32] datapath flops=397 FA=92 HA=55\r\nPASS: 20902 checks, 0 errors\r\nLAT=6 ranks=[40, 144, 86, 58, 37, 32] datapath flops=397 FA=92 HA=55\r\nPASS: 20902 checks, 0 errors\r\nLAT=6 ranks=[40, 144, 86, 59, 37, 32] datapath flops=398 FA=92 HA=55\r\nPASS: 20902 checks, 0 errors\r\n"]
