[1285.402, "o", "\u001b[1;32m$\u001b[0m sed -i 's/@tail -1 $(REP)\\/check.log | grep -q \"^ALL PASS\"/@grep -q \"^ALL PASS\" $(REP)\\/check.log/; s/@tail -1 $(REP)\\/sim.log | grep -q \"^ALL PASS\"/@grep -q \"^ALL PASS\" $(REP)\\/sim.log/' Makefile && (PRE=1 build/exp/run.sh p400a 2.5 0 0100 0 2000 & PRE=1 build/exp/run.sh p400b 2.5 0 1000 0 2000 & PRE=1 build/exp/run.sh p400c 2.5 0 0010 0 2000 & wait) 2>&1 | grep -v Warning; for d in p400a p400b p400c; do build/exp/path.sh build/exp/$d/sta.rpt | sed -n 3p; done\r\np400a P=2.5 enc=0 csa=0100 spl=0 abcD=2000 | yosys_area=2299.836000 rsz_area=2309 wns=-0.392 whs=0.053 pwr_est=6.2881e-04\r\np400b P=2.5 enc=0 csa=1000 spl=0 abcD=2000 | yosys_area=2246.104000 rsz_area=2311 wns=-0.354 whs=0.055 pwr_est=6.2068e-04\r\np400c P=2.5 enc=0 csa=0010 spl=0 abcD=2000 | yosys_area=2437.358000 rsz_area=2465 wns=-0.304 whs=0.053 pwr_est=6.5733e-04\r\n_2813_/Q (DFF_X1) fo=3 d=0.445 t=0.445\r\n_2783_/Q (DFF_X1) fo=3 d=0.448 t=0.448\r\n_2925_/Q (DFF_X1) fo=6 d=0.370 t=0.370\r\n"]
