[21319.328, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && sed -n '/# increment: s = s0 + cin/,/cpa_desc = /p' gen_tree.py\r\n            # increment: s = s0 + cin, all-ones prefix of s0 inside the block\r\n            sv = [mA[s0[c]] for c in range(l, h)]\r\n            andp = [sv[0]]\r\n            # Kogge-Stone AND prefix\r\n            A = list(sv); d = 1\r\n            while d < len(A):\r\n                A = [A[i] if i < d else net.and_(A[i], A[i - d]) for i in range(len(A))]\r\n                d *= 2\r\n            for kk in range(len(sv)):\r\n                if kk == 0: prod.append(net.xor(sv[0], cin[bi]))\r\n                else: prod.append(net.xor(sv[kk], net.and_(cin[bi], A[kk - 1])))\r\n    cpa_desc = {\"cinc\": \"two-stage carry-increment\", \"csel\": \"two-stage carry-select\"}[args.cpa] + f\", blocks {blocks}\"\r\n"]
[21454.195, "o", "\u001b[1;32m$\u001b[0m cd /home/user/elec402-p2-open/build/cand800b && python3 - <<'EOF'\r\ns = open(\"gen_tree.py\").read()\r\nold = '''            sv = [mA[s0[c]] for c in range(l, h)]\r\n            andp = [sv[0]]\r\n            # Kogge-Stone AND prefix'''\r\nnew = '''            sv = [mA[s0[c]] for c in range(l, h)]\r\n            # Kogge-Stone AND prefix'''\r\ns = s.replace(old, new)\r\nold = '''            for kk in range(len(sv)):\r\n                if kk == 0: prod.append(net.xor(sv[0], cin[bi]))\r\n                else: prod.append(net.xor(sv[kk], net.and_(cin[bi], A[kk - 1])))'''\r\nnew = '''            for kk in range(len(sv)):\r\n                if args.bsel:\r\n                    # incremented sum formed beside the block carry, then selected by it\r\n                    inc = inv(sv[0]) if kk == 0 else net.xor(sv[kk], A[kk - 1])\r\n                    prod.append(net.or_(net.and_(cin[bi], inc), net.and_(inv(cin[bi]), sv[kk])))\r\n                elif kk == 0: prod.append(net.xor(sv[0], cin[bi]))\r\n                else: prod.append(net.xor(sv[kk], net.and_(cin[bi], A[kk - 1])))'''\r\nassert old in s; s = s.replace(old, new)\r\ns = s.replace('ap.add_argument(\"--stats\"', 'ap.add_argument(\"--bsel\", action=\"store_true\", help=\"adder stage B: select the incremented block sum by the block carry\")\\nap.add_argument(\"--stats\"')\r\nopen(\"gen_tree.py\",\"w\").write(s)\r\nEOF\r\n./run.sh 800 w24cpa5s --mode wallace --cuts 2,4 --gp cpa --k0 8 --k 5 --bsel 2>&1 | tail -21 | grep -v \"u_mult.[aont][1enw]\"\r\n== build/cand800b/w24cpa5s RUN=800\r\ncheck=PASS sim=PASS wns=0.060 whs=0.041\r\narea=4155.718 seq=1998.724 comb=2157.0 flops=442 vectorless_uW=2209.9\r\nactivity_uW: run:=2512.80 fill:=4669.60 drain:=1964.20 \r\nper register group (flops, worst slack):\r\nVALID_memVal                            1    0.368\r\nu_mult.prod                            12    0.076\r\nwriteMem_val                           32    0.060\r\nu_mult.prod       